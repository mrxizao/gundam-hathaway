extends Node
func _ready() -> void:
	var panorama = load("res://scripts/ui/cockpit_panorama.gd").new()
	var faces: Dictionary = panorama.neue_faces()
	for key in ["front","left","right","top"]:
		assert(faces[key].size() == 4)
	assert(absf(faces.front[2].x)>absf(faces.front[1].x))
	assert(faces.front[2].y>faces.front[1].y)
	assert(faces.front[0].z < faces.rear[0].z)
	assert(absf(faces.front[0].x) < absf(faces.rear[0].x))
	panorama._create_view()
	panorama.family = 2
	panorama._build_body()
	assert(panorama.body.mesh.get_surface_count() == 1)
	assert(panorama.body.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX].size()>100)
	var layout = load("res://scripts/ui/cockpit_3d.gd").neue_instrument_layout(Vector2(1280,720))
	assert(not layout.center.intersects(layout.left))
	assert(not layout.center.intersects(layout.right))
	assert(layout.center.end.y <= 720)
	var shape_script = load("res://scripts/ui/cockpit_3d.gd")
	var shape: Array = shape_script.neue_panel_outline("center")
	assert(shape[1].x-shape[0].x > shape[2].x-shape[3].x)
	var left: Array = shape_script.neue_panel_outline("left")
	var right: Array = shape_script.neue_panel_outline("right")
	assert(left[2].y > left[3].y)
	assert(right[3].y > right[2].y)
	assert(load("res://scripts/ui/cockpit_surface.gd").can_instantiate())
	var cockpit = shape_script.new()
	var source := Control.new()
	add_child(source)
	source.add_child(cockpit)
	cockpit.setup(source)
	cockpit.set_process(false)
	cockpit.last_size = Vector2(1280,720)
	cockpit.last_family = 2
	cockpit._rebuild()
	var consoles := 0
	for child in cockpit.model.get_children():
		if str(child.name).begins_with("NeueLowerConsole"): consoles += 1
	assert(consoles == 2)
	assert(cockpit.model.get_child_count()>100)
	assert(cockpit.model.get_node_or_null("NeueShapedGlass_center") != null)
	var shell = cockpit.model.get_node_or_null("NeueUnifiedShell")
	assert(shell != null)
	assert(shell.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX].size() > 600)
	cockpit.last_size = Vector2(1920,1080)
	cockpit._rebuild()
	assert(cockpit.model.get_node_or_null("NeueUnifiedShell") != null)
	source.free()
	panorama.free()
	print("NEUE CABIN: 23 PASS / 0 FAIL")
	get_tree().quit()
