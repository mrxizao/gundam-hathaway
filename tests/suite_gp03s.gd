extends RefCounted
static func run(t: T, host: Node) -> void:
	t.suite("GP03S / escape-only profile and performance")
	var old_placeholder := FlightBody.use_placeholder
	var s:=SuitProfile.gp03s()
	t.near(s.target_height,18.2,0.001,"全高18.2米")
	t.near(s.player_top_speed(),SuitProfile.arizeus(SuitProfile.ArizeusForm.CORE_NU).player_top_speed(),0.001,"巡航速度与量产ν完全一致")
	t.near(s.turn_scale,SuitProfile.xi().turn_scale,0.001,"操控系数继承柯西")
	t.eq(s.ifield_hp,0.0,"无I立场")
	t.not_ok(s.has_missiles,"脱出后无大型导弹库")
	t.not_ok(s.cannon_enabled,"脱出后无MA光束炮")
	t.eq(s.weapon_slots(),["rifle","bazooka","saber"],"三种武器必须切换使用")
	t.not_ok(load("res://scripts/ui/main_menu.gd").SUITS.has(SuitProfile.Id.GP03S),"不独立选机")
	t.eq(SuitProfile.neue_ziel().transform_to_form,-1,"露维杰露不会误继承石斛兰脱出")
	var stage:=Node3D.new();host.add_child(stage)
	var projectiles:=Node3D.new();stage.add_child(projectiles)
	var pc:=PlayerController.new();pc.profile=SuitProfile.gp03d();pc.use_placeholder=true;pc.projectile_container=projectiles;stage.add_child(pc)
	pc.set_physics_process(false);pc.set_process(false)
	pc.ifield_hp=0.0;pc.hp=pc.max_hp*0.02;pc.invuln_until=-1.0
	pc.take_damage(pc.max_hp*0.009,null,Damage.Type.RAM)
	t.not_ok(pc.in_transform(),"1.1%血仍保留本体")
	pc.take_damage(pc.max_hp*0.002,null,Damage.Type.RAM)
	t.ok(pc.in_transform(),"跌破1%启动脱出")
	pc.use_placeholder=false
	pc._tick_transform(SuitProfile.TRANSFORM_COVER+0.1)
	t.eq(pc.profile.id,SuitProfile.Id.GP03S,"切成GP03S核心")
	t.near(pc.hp,pc.max_hp,0.001,"核心生命全满")
	t.eq(pc.ifield_hp,0.0,"不恢复I立场")
	t.ok(pc.alive,"脱出不判定死亡")
	t.ok(pc._escape_timer>0.0,"继承拉升脱出动作")
	t.ok(pc.anchor_from_model("bazooka_L") and pc.anchor_from_model("bazooka_R"),"双火箭筒真实挂点")
	t.eq(pc._plume_fx.size(),4,"背包与腿部四组喷焰")
	pc._escape_timer=0.0;pc.invuln_until=-1.0
	var count:=projectiles.get_child_count()
	t.not_ok(pc.fire_gun(true),"GP03S不能使用火神炮键")
	t.not_ok(pc.profile.has_vulcan(),"未安装火神炮")
	t.not_ok(pc.fire_gp03s_bazookas(),"步枪槽不能发射火箭筒")
	t.ok(pc.switch_weapon(),"切换到火箭筒")
	t.eq(pc.current_slot(),"bazooka","火箭筒为独立槽")
	t.not_ok(pc.raise_shield(),"火箭筒槽不能举盾")
	t.not_ok(pc.fire_beam(true),"火箭筒槽不能发射步枪")
	Input.action_press("fire_primary")
	pc._read_weapon_input(0.016)
	Input.action_release("fire_primary")
	t.eq(pc.bazooka_mag,14,"主攻击输入实际发射双火箭筒")
	t.eq(projectiles.get_child_count()-count,2,"双筒同时发射两枚")
	t.eq(pc.bazooka_mag,14,"一轮消耗两发")
	t.not_ok(pc.fire_gp03s_bazookas(),"发射动作有冷却")
	pc.bazooka_cd=0.0;pc.bazooka_mag=2
	pc.fire_gp03s_bazookas()
	t.ok(pc.bazooka_reload_left>0,"最后一轮自动装填")
	pc._tick_weapons(FlightBody.GP03_BAZOOKA_RELOAD)
	t.eq(pc.bazooka_mag,16,"双火箭筒自动补满")
	pc.bazooka_cd=0.0
	var rigged: Node3D=pc.model_root.find_child("GP03S",true,false)
	rigged.animate(0.0)
	t.not_ok(rigged.shield.visible,"装备火箭筒持续隐藏盾牌")
	t.not_ok(rigged.rifle.visible,"火箭筒槽收起步枪")
	t.ok(rigged.launchers[0].visible,"火箭筒槽显示双筒")
	pc.switch_weapon()
	t.eq(pc.current_slot(),"saber","火箭筒切到军刀")
	t.not_ok(pc.fire_beam(true),"军刀槽不能发射步枪")
	pc.switch_weapon()
	t.eq(pc.current_slot(),"rifle","军刀切回步枪")
	t.ok(pc.fire_beam(true),"光束步枪可以发射")
	t.eq(pc.rifle_mag,7,"步枪独立弹匣")
	t.ok(pc.raise_shield(),"核心可以举盾")
	pc.switch_weapon()
	t.not_ok(pc.shield_up,"切到火箭筒取消正在生效的格挡")
	t.ok(pc.shield_cooldown>0.0,"取消格挡不会绕过盾牌冷却")
	pc.switch_weapon();pc.switch_weapon()
	t.near(pc.model_bounds.size.y,18.2,0.3,"实物主体高度与18.2米标定一致")
	t.ok(pc.rig_anchor("bazooka_L").z<pc.rig_anchor("hand_L").z,"双炮真实炮口在握持点前方")
	pc.bazooka_mag=1;pc.bazooka_reload_left=0.0;pc._auto_reload_empty_weapons()
	t.ok(pc.bazooka_reload_left>0.0,"不足一轮双发也会自动换弹")
	pc.switch_weapon();pc.switch_weapon()
	t.ok(pc.try_saber(null),"核心可以挥刀")
	t.not_ok(pc.switch_weapon(),"挥砍中保持武器和收势连续")
	t.ok(is_instance_valid(pc._blade),"军刀实体光束刃已生成")
	pc._sync_blade_anchor()
	t.near(pc._blade_anchor.global_position.distance_to(pc._model_mounts["saber_R"].global_position),0.0,0.001,"光束刃准确绑定右手")
	pc.abort_saber()
	t.ok(rigged!=null,"真实主体成功加载")
	rigged.animate(0.0)
	t.ok(rigged.shield.visible,"举盾显示实物盾")
	pc.shield_up=false
	var old_host = rigged.host
	rigged.host = null
	var poses := {}
	for key in FlightBody.DASH_DIR_NAMES:
		var i: int = FlightBody.DASH_DIR_NAMES.find(key)
		rigged.preview_pose="dash"
		rigged.preview_direction=Vector3(sin(i*PI/4),0,-cos(i*PI/4))
		rigged.preview_time=0.2;rigged.animate(0.0)
		poses[key]=rigged.joints["leg1"].rotation
		t.ok(rigged.raw.transform.is_finite(),"冲刺姿态有限："+key)
	rigged.preview_direction=Vector3.UP;rigged.animate(0.0)
	var up_pose: Vector3=rigged.joints["leg1"].rotation
	rigged.preview_direction=Vector3.DOWN;rigged.animate(0.0)
	t.ok(up_pose.distance_to(rigged.joints["leg1"].rotation)>0.2,"垂直上下冲刺姿态不同")
	t.ok(poses["l"].distance_to(poses["r"])>0.2,"左右冲刺姿态不同")
	t.ok(poses["f"].distance_to(poses["b"])>0.3,"前后冲刺姿态不同")
	rigged.preview_pose="slash";rigged.preview_time=0.20;rigged.animate(0.0)
	var windup: Vector3=rigged.joints["arm1"].rotation
	rigged.preview_time=0.54;rigged.animate(0.0)
	t.ok(windup.distance_to(rigged.joints["arm1"].rotation)>1.0,"右臂大幅蓄势斩击")
	t.ok(absf(rigged.joints["leg1"].rotation.z-rigged.joints["leg-1"].rotation.z)>0.2,"双腿反向支撑重斩")
	rigged.preview_time=1.08;rigged.animate(0.0)
	t.near(rigged.joints["arm1"].rotation.z,0.55,0.001,"收势恢复持刀姿态，无循环挥刀")
	rigged.host=old_host

	pc.invuln_until=-1.0;pc.take_damage(pc.max_hp*2.0,null,Damage.Type.RAM)
	t.not_ok(pc.alive,"核心再次耗尽生命会正常击坠")
	var ar:=FlightBody.new();ar.profile=SuitProfile.arizeus(SuitProfile.ArizeusForm.NORMAL);ar.use_placeholder=true;stage.add_child(ar);ar.set_physics_process(false);ar.set_process(false);ar.ifield_hp=0.0;ar.invuln_until=-1.0
	ar.hp=ar.max_hp*0.5;ar.take_damage(0.1,null,Damage.Type.RAM)
	t.not_ok(ar.in_transform(),"阿利宙斯半血不再脱出")
	ar.hp=ar.max_hp*0.01;ar.take_damage(0.1,null,Damage.Type.RAM)
	t.ok(ar.in_transform(),"阿利宙斯1%血脱出")
	FlightBody.use_placeholder=old_placeholder
	stage.queue_free()
	await host.get_tree().process_frame
