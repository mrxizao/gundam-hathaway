extends RefCounted
const MS := preload("res://scripts/data/mission_script.gd")
const CS := preload("res://scripts/data/campaign.gd")
const RULES := preload("res://scripts/data/chapter_three_rules.gd")
static func run(t: T) -> void:
	t.suite("ChapterThree / five playable sorties and campaign migration")
	t.eq(CS.CHAPTERS.size(),3,"third chapter exposed")
	t.eq(CS.MASK_ORDER.slice(0,7),["M01","M02","M03","M04","M05","M06","M07"],"old save bits keep their meaning")
	t.eq(CS.ids_of_chapter(3),["M08","M09","M10","M11","M12"],"five requested missions in sequence")
	var expected := ["虎口拔牙","精确防御","再一次","壮志未酬·上","壮志未酬·下"]
	for i in 5:
		var m=MS.by_id("M%02d"%(i+8))
		t.eq(m.title,expected[i],"mission title exact")
		t.eq(m.chapter,3,"chapter number")
		t.eq(m.index,i+1,"chapter-local index")
		t.eq(m.map_id(),MapDef.Id.ADELAIDE,"real Adelaide map")
		t.not_ok(m.win_on_clear,"custom objective prevents premature clear")
		t.ok(not m.chapter_three_mode.is_empty(),"runtime controller route exists")
		t.eq(m.total_enemies(),m.enemy_roster.size(),"encounter totals match actual mixed roster")
		t.not_ok(m.all_required_done({}),"no automatic opening victory")
		t.ok(m.pending.is_empty(),"mission can launch")
	t.eq(MS.m08().ally_roster.size(),3,"Xi has three Messer allies")
	t.eq(MS.m08().player_suit,SuitProfile.Id.XI,"first raid Xi")
	t.eq(MS.m09().enemy_roster,[SuitProfile.Id.XI,SuitProfile.Id.MESSER_M01,SuitProfile.Id.MESSER_CMD,SuitProfile.Id.MESSER_M01],"Xi and three Messer deploy together")
	t.eq(MS.m10().player_suit,SuitProfile.Id.XI_FINAL,"final-battle Xi for second raid")
	t.eq(MS.m10().ally_roster.size(),0,"second raid is solo")
	t.eq(MS.m10().enemy_roster.count(SuitProfile.Id.REGZ_CUSTOM),1,"Re-GZ Custom opponent")
	t.eq(MS.m10().enemy_roster.count(SuitProfile.Id.GUSTAV00),3,"three Gustav opponents")
	t.eq(MS.m11().make_player_profile().id,SuitProfile.Id.XI_FINAL,"M11 player uses final-battle Xi")
	t.eq(MS.m12().enemy_roster,[SuitProfile.Id.XI_FINAL],"M12 pursued Xi is final-battle variant")
	t.eq(MS.m12().make_player_profile().form,0,"M12 launches full Penelope instead of Odysseus")
	t.ok(MS.m12().player_suit_name().contains("佩涅罗佩"),"brief uses Penelope player form name")
	t.near(MS.m12().player_start_hull_ratio,0.8,.0001,"M12 starts at 80 percent of full hull")
	t.eq(MS.m12().make_player_profile().ifield_hp,0.0,"M12 has no I-field capacity to recover")
	t.gt(SuitProfile.penelope().ifield_hp,0.0,"normal Penelope still has I-field")
	t.eq(MS.m11().player_start_hull_ratio,1.0,"other missions start with normal full hull")
	var old=CS.new_progress();old["cleared_mask"]=127
	t.ok(CS.is_unlocked(old,"M08"),"old fully-cleared save unlocks first third-chapter mission")
	t.not_ok(CS.is_unlocked(old,"M09"),"remaining new sorties progress normally")
	for i in 7: t.ok(CS.is_cleared(old,CS.MASK_ORDER[i]),"old progress preserved")
	t.suite("ChapterThree / marked M12 opening and interception net")
	t.eq(RULES.LURE_START,Vector3(-2500,3500,-47000),"blue marked opening")
	t.eq(RULES.S18,Vector3(42000,3500,36500),"red marked net")
	t.eq(RULES.DUEL_START,Vector3(3000,3500,37000),"previous duel location preserved")
	t.not_ok(RULES.in_lure_zone(RULES.LURE_START),"opening cannot instantly succeed")
	t.suite("ChapterThree / strict hull thresholds and target-only lure sphere")
	t.not_ok(RULES.below_hp(.2,.2),"exactly 20 percent is not below")
	t.ok(RULES.below_hp(.19999,.2),"below 20 percent finishes duel")
	t.ok(RULES.below_hp(0.0,.2),"fatal crossing still reaches threshold ending")
	t.not_ok(RULES.in_lure_zone(RULES.S18+Vector3(4000.1,0,0)),"outside 4km remains incomplete")
	t.ok(RULES.in_lure_zone(RULES.S18+Vector3(4000,0,0)),"exact 4km inclusive")
	t.ok(RULES.in_lure_zone(RULES.S18+Vector3(0,3999,0)),"vertical distance counted")
	t.not_ok(RULES.in_lure_zone(RULES.S18+Vector3(3000,3000,0)),"3D sphere rather than flat disc")
	t.not_ok(RULES.in_lure_zone(RULES.S18,RULES.S18,0.0),"invalid radius does not auto-complete")
	var defend=MS.m09()
	t.not_ok(defend.all_required_done({"mission_events":{"xi_repelled":true}}),"repelling Xi alone insufficient")
	t.not_ok(defend.all_required_done({"mission_events":{"messer_down":true}}),"three Messer alone insufficient")
	t.ok(defend.all_required_done({"mission_events":{"xi_repelled":true,"messer_down":true}}),"both defensive goals required")
	t.not_ok(MS.m12().all_required_done({"zones":{"S18":true}}),"player arriving cannot complete Xi lure")
	t.ok(MS.m12().all_required_done({"mission_events":{"lure":true}}),"Xi arrival completes lure")
	t.suite("ChapterThree / adaptation radio attribution")
	for id in CS.ids_of_chapter(3):
		t.ok(RULES.RADIO.has(id),"each mission has adapted script radio")
		for line in RULES.RADIO[id]:
			t.ok(float(line[0])>=0.0 and not str(line[1]).is_empty() and not str(line[2]).is_empty(),"radio timing speaker and text valid")

	t.suite("ChapterThree / seven-mission save on disk remains compatible")
	var path := "user://chapter3_old_progress_test.cfg"
	var config := ConfigFile.new()
	config.set_value("progress","cleared_mask",127)
	config.set_value("progress","chapter",2)
	config.set_value("progress","best_grade","A,B,C,D,S,A,B")
	config.set_value("wallet","credits",2500)
	t.eq(config.save(path),OK,"write isolated old-format fixture")
	var loaded := CS.load_progress(path)
	t.eq(loaded["cleared_mask"],127,"seven old bits unchanged on disk load")
	t.eq(loaded["best_grade"]["M07"],"B","last old grade maps to M07")
	t.eq(loaded["credits"],2500,"old wallet unchanged")
	t.ok(CS.is_unlocked(loaded,"M08"),"old clear unlocks new chapter")
	t.not_ok(CS.is_cleared(loaded,"M08"),"old save does not pre-clear new mission")
	CS.erase(path)
