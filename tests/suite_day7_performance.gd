extends RefCounted
static func run(t:T,host:Node) -> void:
 t.suite("Day7 / low-only GPU budget and high-quality restoration")
 var saved:Dictionary={}
 for key in Settings.PERSISTED_VARS:saved[key]=Settings.get(key)
 var budget=load("res://scripts/autoload/frame_budget.gd")
 Settings.set_quality_preset(0)
 t.ok(Settings.low_spec_mode(),"low preset selects 750 Ti budget")
 var low1080:Vector2=budget.scale_limits(Vector2i(1920,1080),.75,true)
 t.near(low1080.y,2.0/3.0,.0001,"1080 window caps 3D at 720p")
 t.near(low1080.x,1.0/3.0,.0001,"1080 adaptive floor is 360p")
 var low1440:Vector2=budget.scale_limits(Vector2i(2560,1440),.75,true)
 t.near(low1440.y,.5,.0001,"1440 window caps 3D at 720p")
 t.near(low1440.x,.25,.0001,"1440 adaptive floor is 360p")
 t.near(budget.scale_limits(Vector2i(1280,720),.75,true).y,.75,.0001,"720p retains selected 75 percent scale")
 t.near(budget.scale_limits(Vector2i(3440,1440),.75,true).y,1280.0/3440.0,.0001,"ultrawide also respects pixel width budget")
 Settings.set_quality_preset(1)
 t.not_ok(Settings.low_spec_mode(),"balanced does not inherit aggressive reductions")
 Settings.set_quality_preset(2)
 t.not_ok(Settings.low_spec_mode(),"high does not inherit aggressive reductions")
 t.near(budget.scale_limits(Vector2i(2560,1440),1.0,false).y,1.0,.0001,"high remains native 1440p")
 Settings.set_quality_preset(0);Settings.adjust_performance("render_scale",1)
 t.ok(Settings.low_spec_mode(),"custom derivative retains its low budget")
 var world:=WorldBuilder.new();world.defer_initial_map=true;host.add_child(world);world.set_process(false)
 var mat:=world._make_cloud_material(Color.WHITE,Color(.7,.8,.9),.35)
 mat.set_shader_parameter("sun_dir",Vector3(.2,.7,.3))
 t.eq(mat.shader.resource_path,"res://shaders/cloud_low.gdshader","low uses separate cheap GPU program")
 t.eq(mat.get_shader_parameter("cloud_quality"),0,"low clouds use cheap integration")
 t.eq(mat.get_shader_parameter("use_noise_lut"),false,"low does not sample 54 MiB lattice")
 t.ok(world._cloud_lut_a==null and world._cloud_lut_b==null,"low startup does not allocate lattice")
 Settings.set_quality_preset(2);world._process(0.0)
 t.eq(mat.shader.resource_path,"res://shaders/cloud.gdshader","high uses original GPU program")
 t.eq(mat.get_shader_parameter("sun_dir"),Vector3(.2,.7,.3),"shader switch preserves actual lighting direction")
 t.eq(mat.get_shader_parameter("cloud_quality"),2,"switch to high restores full cloud integration")
 t.eq(mat.get_shader_parameter("use_noise_lut"),true,"switch to high restores original lattice")
 t.ok(world._cloud_lut_a!=null and world._cloud_lut_b!=null,"high retains both shared lattices")
 Settings.set_quality_preset(0);world._process(0.0)
 t.ok(world._cloud_lut_a==null and mat.get_shader_parameter("noise_lut_a")==null,"switch to low releases cloud references")
 var env:=Environment.new();world._env=env
 world._process(0.0)
 t.not_ok(env.volumetric_fog_enabled,"low disables volume pass")
 var cached:=world._environment_quality_config.duplicate()
 world._process(.016)
 t.eq(world._environment_quality_config,cached,"unchanged quality retains renderer configuration")
 Settings.set_quality_preset(2);world._process(0.0)
 t.eq(env.volumetric_fog_enabled,WorldBuilder.supports_local_fog(),"high volume pass follows renderer capability")
 world.free()
 # Disabled fog must not run its spatial query. No camera is needed for this check.
 var local=load("res://scripts/world/local_cloud_volume.gd").new()
 host.add_child(local);local.set_process(false)
 local.elapsed=.123
 Settings.set_quality_preset(0);local._process(1.0)
 t.near(local.elapsed,.123,.00001,"disabled cloud CPU query clock stays unchanged")
 t.not_ok(local.quality_active,"disabled fog marks suspended state")
 Settings.set_quality_preset(2);local._process(.016)
 t.ok(local.quality_active,"high resumes cloud query state")
 local.free()
 var assets=load("res://scripts/flight/low_texture_models.gd")
 var file:=FileAccess.open("res://assets/models/low_spec/catalog.json",FileAccess.READ)
 var catalog:Array=JSON.parse_string(file.get_as_text())
 t.ok(catalog.size()>=7,"original low caches remain available alongside newer model and weapon caches")
 for item:Dictionary in catalog:
  Settings.set_quality_preset(0)
  t.eq(assets.resolve_model(item.source),item.target,"low selects generated texture model")
  Settings.set_quality_preset(2)
  t.eq(assets.resolve_model(item.source),item.source,"high selects untouched original model")
  Settings.set_quality_preset(1)
  t.eq(assets.resolve_model(item.source),item.source,"balanced selects untouched original model")
 Settings.set_quality_preset(0)
 t.eq(assets.resolve_model("res://missing_model.scn"),"res://missing_model.scn","missing cache retains original fallback")
 t.suite("Day7 / bounded immutable curve cache")
 var curve_before:Dictionary=ModelAnimator._curve_cache.duplicate(true)
 var fixture:=Node3D.new();fixture.name="CurveFixture"
 var player:=AnimationPlayer.new();fixture.add_child(player);player.owner=fixture
 var library:=AnimationLibrary.new();var animation:=Animation.new();animation.length=1.0
 var track:=animation.add_track(Animation.TYPE_ROTATION_3D);animation.track_set_path(track,NodePath("Skeleton3D:Tail"))
 animation.rotation_track_insert_key(track,0.0,Quaternion.IDENTITY)
 animation.rotation_track_insert_key(track,1.0,Quaternion(Vector3.RIGHT,.2))
 library.add_animation("form_on",animation);player.add_animation_library("",library)
 var packed:=PackedScene.new();t.eq(packed.pack(fixture),OK,"curve fixture packs")
 var path:="user://day7_curve_fixture.scn";t.eq(ResourceSaver.save(packed,path),OK,"curve fixture is a real saved source")
 var animator:=ModelAnimator.new();var bones:=PackedStringArray(["Tail"])
 var first:=animator.load_curve_from(path,bones)
 t.eq(first.bones.size(),1,"real source curve is extracted")
 var count:=ModelAnimator._curve_cache.size()
 var second:=animator.load_curve_from(path,bones)
 t.eq(first,second,"cached values match original extraction")
 t.eq(ModelAnimator._curve_cache.size(),count,"second call reuses cache entry")
 first.bones["Tail"]["t"][0]=-99.0
 var third:=animator.load_curve_from(path,bones)
 t.near(third.bones["Tail"]["t"][0],0.0,.00001,"caller mutation cannot corrupt cached curve")
 t.ok(ModelAnimator._curve_cache.size()<=ModelAnimator.CURVE_CACHE_LIMIT,"cache stays bounded")
 ModelAnimator._curve_cache=curve_before
 fixture.free();DirAccess.remove_absolute(path)
 for key in saved:Settings.set(key,saved[key])
 await host.get_tree().process_frame

