; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

"ï»¿config_version"=5

[application]

config/name="Mobile Suit GUNDAM·Hathaway"
config/description="Ace Combat 风格的 3D 空中缠斗原型。玩家机体：RX-104FF 佩涅罗佩。"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
Settings="*res://scripts/autoload/settings.gd"
FrameBudget="*res://scripts/autoload/frame_budget.gd"
Audio="*res://scripts/audio/audio_director.gd"
Game="*res://scripts/autoload/game.gd"
Net="*res://scripts/autoload/net_session.gd"
LanBrowser="*res://scripts/autoload/lan_browser.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

