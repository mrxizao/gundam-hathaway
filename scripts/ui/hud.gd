var _cockpit_readouts = preload("res://scripts/ui/cockpit_readouts.gd").new()

func cockpit_has_graduations() -> bool:
	return not (is_instance_valid(player) and player.profile.id in [SuitProfile.Id.SAZABI,SuitProfile.Id.FULL_ARMOR_TB] and first_person_view())

func _compact_cockpit() -> bool:
	return is_instance_valid(_cockpit_3d) and _cockpit_3d.visible and is_instance_valid(player) and not cockpit_only

func _messer_cockpit() -> bool:
	return _compact_cockpit() and preload("res://scripts/ui/messer_cockpit.gd").supports(player.profile.id)

func _draw_reticle() -> void:
	if _messer_cockpit():
		var aim := _fpv_reticle_position()
		if aim.is_finite():
			var ink := Color(0.84,0.48,0.58,0.72)
			for side in [-1,1]:
				draw_line(aim+Vector2(side*8,0),aim+Vector2(side*18,0),ink,1.3,true)
				draw_line(aim+Vector2(0,side*8),aim+Vector2(0,side*18),ink,1.3,true)
			_draw_cannon_charge_ring(aim)
		return
	if is_instance_valid(_cockpit_3d) and _cockpit_3d.visible:
		_draw_fpv_pitch_guides()
