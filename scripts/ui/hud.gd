## Neue Ziel uses amber dashed projected weapon sights, independent of mouse presence.
func _draw_neue_dashed_sight(p: Vector2) -> void:
	var k := clampf(size.y/720.0,0.65,2.0)
	var ink := Color(1.0,0.88,0.16,0.95)
	for side: float in [-1.0,1.0]:
		draw_dashed_line(p+Vector2(side*10,0)*k,p+Vector2(side*112,0)*k,ink,1.6*k,7*k,true,true)
		draw_dashed_line(p+Vector2(0,side*10)*k,p+Vector2(0,side*63)*k,ink,1.6*k,7*k,true,true)
	draw_circle(p,1.6*k,ink)

func _draw_neue_dashed_lock(p: Vector2,half: float,locked: bool) -> void:
	var k := clampf(size.y/720.0,0.65,2.0)
	var ink := Color(1.0,0.88,0.16,0.98 if locked else 0.68)
	var points := PackedVector2Array([p+Vector2(-half,-half),p+Vector2(half,-half),p+Vector2(half,half),p+Vector2(-half,half)])
	for n in 4:
		draw_dashed_line(points[n],points[(n+1)%4],ink,1.8*k,6*k,true,true)
	if locked:
		for point: Vector2 in points: draw_circle(point,2.2*k,ink)


