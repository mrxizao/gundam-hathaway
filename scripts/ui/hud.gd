## First-person sight is projected from the real weapon direction, including head look.
## A rearward or off-screen aim must not leave a false centered sight.
func _fpv_reticle_position() -> Vector2:
	if not is_instance_valid(player) or not is_instance_valid(camera):
		return Vector2.INF
	var point: Vector3 = camera.global_position + player.aim_forward() * 900.0
	if camera.is_position_behind(point):
		return Vector2.INF
	var projected := _project(point)
	return projected if Rect2(Vector2.ZERO, size).has_point(projected) else Vector2.INF

func _fpv_sight_line(p: Vector2, scale: float, a: Vector2, b: Vector2, col: Color) -> void:
	draw_line(p + a * scale, p + b * scale, col, UILayout.LINE_STRUCT, true)

## Graduations use world elevation and the suit heading, not the weapon cursor.
func _fpv_pitch_guide_point(elevation: float, azimuth_offset: float) -> Vector2:
	if not is_instance_valid(player) or not is_instance_valid(camera):
		return Vector2.INF
	var heading: Vector3 = player.forward()
	# At a vertical nose attitude, use the suit right axis to retain heading continuity.
	if Vector2(heading.x,heading.z).length_squared()<0.0001:
		heading = player.global_basis.x.cross(Vector3.UP)
	var yaw := atan2(heading.x,-heading.z)+deg_to_rad(azimuth_offset)
	var pitch := deg_to_rad(elevation)
	var direction := Vector3(sin(yaw)*cos(pitch),sin(pitch),-cos(yaw)*cos(pitch))
	var point := camera.global_position+direction*900.0
	return Vector2.INF if camera.is_position_behind(point) else _project(point)

func _draw_fpv_pitch_guides() -> void:
	if is_instance_valid(player) and player.is_nu():return
	if not cockpit_has_graduations(): return
	var limit := Rect2(size*0.5-Vector2(size.x*0.30,size.y*0.18),Vector2(size.x*0.60,size.y*0.36))
	for index in range(-34,35):
		var elevation := float(index)*2.5
		for side: float in [-1.0,1.0]:
			var a := _fpv_pitch_guide_point(float(elevation),side*12.0)
			var b := _fpv_pitch_guide_point(float(elevation),side*(14.2 if index%2==0 else 13.5))
			if not a.is_finite() or not b.is_finite(): continue
			if not limit.has_point(a) or not limit.has_point(b): continue
			var alpha := 0.88 if index==0 else 0.64
			alpha *= 1.0-smoothstep(0.85,1.0,absf(a.y-size.y*0.5)/(size.y*0.18))
			draw_line(a,b,Color(0.81,0.82,0.88,alpha),UILayout.LINE_STRUCT,true)

func _draw_panorama_reticle(p: Vector2) -> void:
	if player.profile.id == SuitProfile.Id.FULL_ARMOR_TB:
		preload("res://scripts/ui/full_armor_cockpit_overlay.gd").sight(self,p)
		return
	if player.profile.id == SuitProfile.Id.NEUE_ZIEL:
		_draw_neue_dashed_sight(p)
		return
	var scale := clampf(size.y / 900.0, 0.65, 1.5)
	var col := Color(0.81, 0.82, 0.88, 0.78)
	if player.cursor_seen and _cursor_target() != null:
		col = Color(WARN, 0.88)
	# Four small split center bars; the actual ray passes through the clear center.
	for y: float in [-3.0, 3.0]:
		for side: float in [-1.0, 1.0]:
			_fpv_sight_line(p, scale, Vector2(side*3,y), Vector2(side*10,y), col)
	for side: float in [-1.0, 1.0]:
		_fpv_sight_line(p, scale, Vector2(side*27,0), Vector2(side*105,0), col)
		_fpv_sight_line(p, scale, Vector2(0,side*25), Vector2(0,side*90), col)


## The surrounding marks belong to the attitude compass, never to mouse aim.
func _fpv_compass_point(offset: Vector2) -> Vector2:
	var scale := clampf(size.y/900.0,0.65,1.5)
	var focal := size.y*0.5/tan(deg_to_rad(camera.fov)*0.5)
	var elevation := rad_to_deg(atan(-offset.y*scale/focal))
	var azimuth := rad_to_deg(atan(offset.x*scale/focal))
	return _fpv_pitch_guide_point(elevation,azimuth)

func _fpv_compass_line(a: Vector2, b: Vector2, alpha: float) -> void:
	var start := _fpv_compass_point(a)
	var end := _fpv_compass_point(b)
	if not start.is_finite() or not end.is_finite(): return
	var area := Rect2(size*Vector2(0.18,0.12),size*Vector2(0.64,0.56))
	if not area.has_point(start) or not area.has_point(end): return
	draw_line(start,end,Color(0.81,0.82,0.88,alpha),UILayout.LINE_STRUCT,true)

func _draw_fpv_compass_marks() -> void:
	if is_instance_valid(player) and player.is_nu():return
	if not cockpit_has_graduations(): return
	for side: float in [-1.0,1.0]:
		_fpv_compass_line(Vector2(0,side*120),Vector2(0,side*155),0.48)
		for n in 3:
			var x := side*(215+n*22)
			var y := -128.0+n*43.0
			_fpv_compass_line(Vector2(x,y),Vector2(x+side*24,y-12),0.52)
		_fpv_compass_line(Vector2(side*185,0),Vector2(side*340,0),0.62)
		for n in 9:
			var x := side*(190+n*13)
			_fpv_compass_line(Vector2(x,7),Vector2(x+side*29,36),0.50)
	_fpv_compass_line(Vector2(0,-193),Vector2(0,-139),0.58)
	for n in range(-7,8):
		var x := float(n)*5.0
		_fpv_compass_line(Vector2(x,-144),Vector2(x,-144-(7 if n%3==0 else 4)),0.58)
	_fpv_compass_line(Vector2(-4,-133),Vector2(0,-139),0.78)
	_fpv_compass_line(Vector2(0,-139),Vector2(4,-133),0.78)



## 蓄力激光炮的**蓄力环**（阿利宙斯常态 / 巡航 2026-09-28；佩涅罗佩 2026-09-29）。
##
## 画在机头十字**外面那一圈**，中心就是弹道起点（准星）——
## 于是"从哪儿射出去"和"还要按多久"是同一个视觉锚点，不用玩家在屏幕上找两处。
##
## 三种状态各有自己的形状（**别合并**，它们对玩家的意思完全不同）：
##   · 按住了但没到 1.7 s → 一段**在长的弧**（WARN）。这是"快进蓄力了"的读数，
##     缺口的位置就是还差多少；底圈给 `HUD_FAINT` 的整圆，让缺口有参照。
##   · 已经进蓄力态       → **完整的环 + 脉动**。脉动不是装饰：
##     用户点名"蓄力模式可以一直蓄力"，如果环是静止的，玩家读不出"它还在蓄/已经蓄好了"。
##   · 大炮不可用         → 什么都不画（原因由武器面板那一行直说，见 `_draw_weapon_block`）。
##
## ⚠️ 线宽只用 `UILayout` 那两档（`LINE_STRUCT` / `LINE_HAIR`）——
## 装饰层也在 `suite_ui_style` 的闸门之内，写死一个数字就是 FAIL。
func _draw_cannon_charge_ring(c: Vector2) -> void:
	if player == null or not is_instance_valid(player):
		return
	if not player.cannon_available():
		return
	if player.cannon_charging():
		var pulse := 0.55 + 0.45 * absf(sin(player.cannon_charged_seconds() * 6.0))
		draw_arc(c, 30.0, 0.0, TAU, 48, Color(WARN.r, WARN.g, WARN.b, pulse),
			UILayout.LINE_STRUCT, true)
		return
	var hold: float = player.cannon_hold_ratio()
	if hold <= 0.0:
		return
	var a0 := -PI * 0.5
	draw_arc(c, 30.0, 0.0, TAU, 48, HUD_FAINT, UILayout.LINE_HAIR, true)
	draw_arc(c, 30.0, a0, a0 + TAU * hold, 48, WARN, UILayout.LINE_STRUCT, true)


## 鼠标准星 —— 轮 36 起鼠标**只管准星**：它决定弹道方向，**不参与锁定**。
