# ============================================================ 仪表

func _draw_speed_block() -> void:
	if _messer_cockpit(): return
	if _compact_cockpit():
		_cockpit_readouts.speed(self)
		return
	# ★★ 发射段（马夫蒂火箭）走的是**同一块**（老板：「把正常驾驶机体的……
	# 速度指示器拿过来」）—— 两处各画一套的话，"屏上那个速度数字"立刻变成
	# 两套单位。
	var rocket := _from_rocket()
	if not rocket and (player == null or not is_instance_valid(player)):
		return
	var x := UILayout.content_left(size)
	var y := size.y * 0.5
	# 显示缩放（批 12）：×SPEED_DISPLAY_SCALE 只改数字，速度本身不动
	var kmh := 0.0
	var thr := 0.0
	if rocket:
		# 真实域 km/h（`dash_readout` 只做 m/s → km/h，**不做**显示缩放）
		kmh = _rd("spd_kmh", 0.0)
		thr = _rd("thr01", 0.0)
	else:
		kmh = player.airspeed_kmh()
		thr = player.fm.throttle
	_text(Vector2(x, y), "%4d" % int(display_speed(kmh)), 34, HUD)
	_text(Vector2(x + 4, y + 20), "KM/H", 13, HUD_DIM)

	var bar := Rect2(x, y + 36, 116, 9)
	draw_rect(bar, Color(0, 0, 0, 0.35), true)
	draw_rect(Rect2(bar.position, Vector2(bar.size.x * thr, bar.size.y)), HUD_DIM, true)
	draw_rect(bar, HUD_FAINT, false, UILayout.LINE_STRUCT)

	# ---- 火神炮过热条（批 14，用户要求"加入过热条和cd"）----
	# 无限弹的代价必须看得见：热量常显（装了炮就画），> 60% 转警黄，
	# 过热卡住时整条转红并闪边框 —— "打不出去了"当场有原因。
	# 画在油门条正下方（同宽 116，与油门/燃料槽同一个视觉家族）。
	# ★ 火神炮 / 悬停 / 冲刺能量三条都是**机体专属**的，发射段一条都不画
	#（火箭没有炮、不会悬停、也没有辅助驾驶闪避能量）。
	if not rocket and player.profile != null and player.profile.has_vulcan():
		var hy := y + 48.0
		var hbar := Rect2(x, hy, 116, 7)
		draw_rect(hbar, Color(0, 0, 0, 0.35), true)
		var hcol := HUD_DIM if player.vulcan_heat < 0.6 else WARN
		if player.vulcan_overheated:
			hcol = DANGER
		draw_rect(Rect2(hbar.position, Vector2(
			116.0 * clampf(player.vulcan_heat, 0.0, 1.0), hbar.size.y)), hcol, true)
		draw_rect(hbar, HUD_FAINT, false, UILayout.LINE_STRUCT)
		if player.vulcan_overheated and int(_flash * 3.0) % 2 == 0:
			draw_rect(hbar, DANGER, false, UILayout.LINE_STRUCT)

	if not rocket and player.fm.hovering:
		_text(Vector2(x, y + 68.0), "HOVER", 17, IFIELD)
	# ---- 燃料槽（1.2 第十九轮：量产机专用）----
	#
	# ⚠️ 它必须**常驻可见**，理由和踏板耐久、威胁层一样（铁律 5 的同一类）：
	# 槽是"这一秒能不能加速"的唯一依据，看不见它玩家就只能在"按了没反应"里猜。
	# 所以画在**速度块下面**（加速状态的旁边），不走任何 `cursor_seen` 门控。
	#
	# 画法：一条横条 + 百分比不行（太小），直接**条 + 文字**：
	#   满/够用 = 青色；< 25% = 警告色；空了 = 危险色 + 闪。
	# ★ 火箭的推进剂走**同一个槽**（`fuel01`，来自 `RocketBody.fuel_fraction()`）：
		# 老板点名要的"燃料"就是它。槽的配色语义（青 / 警黄 / 危险红 + 空时闪）
		# 与机体那边逐字相同 —— 同一个物理量在两处出现，配色分家会被当成两件事。
	if rocket or player.has_jet_gauge():
		var jy := y + 88.0
		var jw := 116.0
		var jr: float = _rd("fuel01", 1.0) if rocket else player.jet_ratio()
		var jbar := Rect2(x, jy, jw, 9.0)
		draw_rect(jbar, Color(0, 0, 0, 0.45), true)
		var jcol := IFIELD
		if jr <= 0.0:
			jcol = DANGER
		elif jr < 0.25:
			jcol = WARN
		draw_rect(Rect2(jbar.position, Vector2(jw * jr, jbar.size.y)), jcol, true)
		draw_rect(jbar, HUD_FAINT, false, UILayout.LINE_STRUCT)
		# 空了就闪一下 —— "按 Shift 没反应"必须有个当场可见的原因
		if jr <= 0.0 and int(_flash * 3.0) % 2 == 0:
			draw_rect(jbar, DANGER, false, UILayout.LINE_STRUCT)
		_text(Vector2(x, jy + 20.0), "FUEL %d%%" % int(jr * 100.0), 13,
			DANGER if jr <= 0.0 else (WARN if jr < 0.25 else HUD_DIM))

	elif player.has_dash_limit():
		# ---- 冲刺限制条（批 10：ACE 机的辅助驾驶闪避能量，仅阿利宙斯巡航豁免）----
		# 画法与燃料槽同款（同一位置、同一配色语义：够用青色 / <25% 警告 /
		# 空了危险色 + 闪）—— ACE 机没有燃料槽，这条占的就是它的位置。
		# CD 中显示空条 + 秒数倒计时，"按 Shift 没反应"当场有原因可看。
		var dy := y + 88.0
		var dw := 116.0
		var dr: float = player.dash_ratio()
		var dbar := Rect2(x, dy, dw, 9.0)
		draw_rect(dbar, Color(0, 0, 0, 0.45), true)
		var dcol := IFIELD
		if player.dash_cd > 0.0:
			dcol = DANGER
		elif dr < 0.25:
			dcol = WARN
		draw_rect(Rect2(dbar.position, Vector2(dw * dr, dbar.size.y)), dcol, true)
		draw_rect(dbar, HUD_FAINT, false, UILayout.LINE_STRUCT)
		if player.dash_cd > 0.0 and int(_flash * 3.0) % 2 == 0:
			draw_rect(dbar, DANGER, false, UILayout.LINE_STRUCT)
		var dtext := "DASH CD %.1f" % player.dash_cd if player.dash_cd > 0.0 \
			else "DASH %d%%" % int(dr * 100.0)
		_text(Vector2(x, dy + 20.0), dtext, 13,
			DANGER if player.dash_cd > 0.0 else (WARN if dr < 0.25 else HUD_DIM))

	elif player.fm.boosting:
		if int(_flash * 8.0) % 2 == 0:
			_text(Vector2(x, y + 68.0), "BOOST ×1.5", 15, WARN)
	else:
		_text(Vector2(x, y + 68.0), "THROTTLE %3d%%" % int(player.fm.throttle * 100.0), 13, HUD_DIM)

	# ⚠️⚠️ 这两条是**独立**的 `if`（不在上面那个 `elif` 链里）⇒ 火箭段必须各加一次
	# `not rocket`。第一版漏了：发射段 `player` 是 `null`，`_draw()` 在
	# `Nil` 上取属性会**整帧中断** —— 后面的高度带 / 高度块 / 雷达**一个都不画**，
	# 而报错只是刷几行 `Invalid access to property 'fm'`（看着像"只是那块没画"）。
	if not rocket and player.fm.stalled:
		_text(Vector2(x, y + 90.0), "STALL", 15, DANGER)
	if not rocket and player.shield_up:
		_text(Vector2(x, y + 112.0), "SHIELD UP  -%d%%" % int(player.profile.shield_reduction * 100.0),
			14, IFIELD)


## 高度数字的色阶阈值（米）。
##
## ⚠️ **故意从 `PULL_UP_ALTITUDE` 派生，不另立一套 400 / 800**：
## `PULL_UP_ALTITUDE` 就是"拉起告警"那条线，数字变色和告警闪烁应该是**同一件事的
## 两种表达**。另立一套的话，改了一处忘了另一处，画面就会自相矛盾 ——
## "数字还是白的，可 PULL UP 已经在闪"，玩家只会以为其中一个坏了。
const ALT_WARN_M := PULL_UP_ALTITUDE * 2.0
const ALT_DANGER_M := PULL_UP_ALTITUDE


## 右中：高度 / 俯仰 / 过载 / 航向。
##
## 右端对齐到 `UILayout.alt_value_right()` —— **不是** `content_right()`。
## 批 2 加上垂直高度带之后，`content_right()` 落在**带里面**（1600 宽时是 1546，
## 而带宽是 [1530, 1576]），五个数字会整排压在刻度上。见 `UILayout.alt_value_right()`。
func _draw_altitude_block() -> void:
	if _messer_cockpit(): return
	if _compact_cockpit():
		_cockpit_readouts.altitude(self)
		return
	# ★★ 发射段走的是**同一块**（老板：「把正常驾驶机体的……高度指示器拿过来」）。
	var rocket := _from_rocket()
	if not rocket and (player == null or not is_instance_valid(player)):
		return
	var x := UILayout.alt_value_right(size)
	var y := size.y * 0.5
	# 批 2：数字 34 → 40 px，并按高度变色。这就是"高度不够明显"的正面修法 ——
	# 玩家要的不是"字更大"，而是"不用读数字就知道现在危不危险"。
	var alt := _rd("alt_m", 0.0) if rocket else player.global_position.y
	var alt_col := HUD
	if alt < ALT_DANGER_M:
		alt_col = DANGER
	elif alt < ALT_WARN_M:
		alt_col = WARN
	# ⚠️ 变色阈值走**真实米**（危险是真实的，不随显示缩放），
	# 数字走 ALT_DISPLAY_SCALE —— 两者各是各的，见常量区的一致性铁律。
	_text_right(Vector2(x, y), "%5d" % int(alt * ALT_DISPLAY_SCALE), 40, alt_col)
	_text_right(Vector2(x, y + 22), "ALT M", 13, HUD_DIM)

	# ⚠️ 这一行与 `attitude_readout()` 里的 pitch 是**同一个表达式**，必须一致：
	# 姿态仪的俯仰梯和这里的数字一旦对不上，玩家会先怀疑自己看错了。
	var pitch := _rd("pitch", 0.0) if rocket \
		else rad_to_deg(asin(clampf(player.forward().y, -1.0, 1.0)))
	_text_right(Vector2(x, y + 46), "PITCH %+5.1f" % pitch, 13, HUD_DIM)
	if rocket:
		# ★ 发射段第 4 行让给**阶段名**（`RocketBody.leg_name()`）：
		# `G` 是机体专属的量（火箭没有"过载告警"这回事），而上升段里
		# "我在哪一段"比"过载几个 G"有用得多。
		_text_right(Vector2(x, y + 64), str(cockpit_readout.get("leg", "")), 13, HUD_DIM)
	else:
		var g := player.fm.g_load
		# 9.0 是"黄色预警"，12.0（`OVER_G_THRESHOLD`）才是"告警行"那一档 —— 两档不同用途，
		# 所以这里不引用 `OVER_G_THRESHOLD`（引用了就等于说它们是一回事）。
		_text_right(Vector2(x, y + 64), "G %4.1f" % g, 13, HUD_DIM if g < 9.0 else WARN)

	var heading := 0.0
	if not rocket:
		var fwd := player.forward()
		heading = fposmod(rad_to_deg(atan2(fwd.x, -fwd.z)), 360.0)
	# 垂直速度（第十四轮 A2）。玩家实测"主要是看不到离海有多远"——
	# 光有一个瞬时的海拔数字判不出"我正在掉高度吗、掉多快"，
	# 而这两件事合起来才是"还有多久会撞上去"。落下得快就转成告警色。
	var vs := _rd("vs", 0.0) if rocket else player.fm.velocity.y
	# VS 同乘 ALT_DISPLAY_SCALE：右栏读数组必须同缩（"ALT ÷ VS ≈ 几秒撞地"的心算
	# 才不错 10 倍），见常量区的一致性铁律。告警色阈值（-60 m/s）仍走真实值。
	_text_right(Vector2(x, y + 86), "VS %+5d M/S" % int(vs * ALT_DISPLAY_SCALE), 13,
		HUD_DIM if vs > -60.0 else WARN)
	var hdg := _rd("hdg", 0.0) if rocket else heading
	_text_right(Vector2(x, y + 104), "HDG %03d" % int(hdg), 13, HUD_DIM)


## 姿态盘的**局部坐标 → 屏幕坐标**。纯函数，所以"盘转得对不对"能被断言。
##
## 局部系：原点在盘心、y 向下、**随姿态一起转**（地平线在局部系里永远是水平的）。
## 旋转角取 **−roll**：飞机向右滚时，地平线在视野里是"右边翘起来"（视觉上逆时针），
## 而屏幕坐标 y 向下，逆时针 = 负角。符号写反的话，盘会在滚转时朝反方向歪 ——
## 这是那种"看着有点怪但说不上哪怪"的错误，所以它必须被测试钉住。
static func attitude_local_to_screen(center: Vector2, roll_deg: float, local: Vector2) -> Vector2:
	var th := deg_to_rad(-roll_deg)
	return center + Vector2(local.x * cos(th) - local.y * sin(th),
		local.x * sin(th) + local.y * cos(th))


## 高度带的刻度间隔（米）。**每 500 m 一道**；标注密度见 `_draw_altitude_tape()`。
const TAPE_TICK_M := 500.0


## 人工地平仪（§4.2.1，**常驻**）。
##
## ## 两层坐标系，这是这一块唯一的难点
##   - **随姿态转的**：地平线 + 俯仰梯。位置由 `attitude_local_to_screen()` 算出来，
##     但**画在屏幕坐标里**（不引 `draw_set_transform`）。两个理由：
##     ① 俯仰梯上的数字必须**保持水平**（盘转了字还横着才是读得出来的；
##        真机上那些跟着盘转的数字是刻在金属上的，HUD 上不是）；
##     ② 没有"忘记恢复变换"这个失效模式 —— 那种 bug 的表现是**后面所有**
##        HUD 元素一起歪掉，离现场很远。
##   - **不随姿态转的**：固定机翼符号、顶部倒三角、±10..60° 刻度。
##
## ## 俯仰梯为什么能解析裁剪
## 局部系里一条横线到盘心的垂直距离是 `|o|`，所以它的半长就是 `sqrt(r² − o²)` ——
## 解析解。CanvasItem 没有矩形裁剪这套东西，硬画的话刻度会捅出圆外，
## 而那看起来像"盘裂了"。
##
## ⚠️ **铁律 2**：它挂在这里（`_draw()` 里与 `cursor_seen` 无关的分支），
## 不许挪进 `_draw_aim_cursor()` —— 手柄玩家没有鼠标，挪进去等于"手柄没有姿态仪"。
func _draw_attitude() -> void:
	if _messer_cockpit(): return
	if _compact_cockpit(): return
	var c := attitude_center(size)
	var r := ATTITUDE_RADIUS
	# ★★ 发射段（马夫蒂火箭）：**同一个盘、同一段几何**，只换"姿态从哪来"。
	# 老板 2026-09-30 晚：「另外开机体的UI系统也搬过来」——姿态仪是其中一块。
	#
	# ⚠️ 换了源之后**下面一行都不用改**：这段几何读的是
	# `off`（地平线竖直偏移）/ `roll`（滚转）/ `pitch`（俯仰）三个**派生量**，
	# 它们全部来自 `attitude_readout(b) + (-b.z).y` —— 一个 Basis 进、三个数出。
	# 这正是当初把姿态仪写成"纯函数 + 几何"而不是"直接读 player"的回报。
	#
	# ⚠️⚠️ 判据取 **`cockpit_only`**，不是 `_from_rocket()` —— 这两个不是一回事：
	# `_from_rocket()` 问的是"这一帧有没有读数"，而 `cockpit_only` 问的是
	# "这一层是不是发射段的座舱"。`_begin_launch()` 把两者设成真的那一刻
	# 到 `_sync_cockpit_hud()` 第一次喂数之间、以及 `rocket` 被 free 之后，
	# 都会出现"`cockpit_only` 真而读数为空"的中间态 ——
	# 那一帧按 `_from_rocket()` 走的话会去读 `player.global_transform`，
	# 而发射段 `player` 是 **null** ⇒ 炸 Nil（报错刷屏，画面只是少一块）。
	var b := cockpit_basis if cockpit_only else player.global_transform.basis
	var read := attitude_readout(b)
	var off := float(read["horizon_offset_px"])
	var roll := float(read["horizon_roll_deg"])
	var pitch := rad_to_deg(asin(clampf((-b.z).y, -1.0, 1.0)))
	# 极限：|pitch| > 60° 或 |roll| > 75° ⇒ 盘边框转 WARN。
	# 这两个阈值与 `ATTITUDE_PITCH_LIMIT` / `ATTITUDE_ROLL_LIMIT` 同源。
	var extreme := absf(pitch) > ATTITUDE_PITCH_LIMIT or absf(roll) > ATTITUDE_ROLL_LIMIT

	# 盘底压暗一层：刻度画在云/海面反光上也读得出来。不用渐变（§4.7：发光只做信息）。
	draw_circle(c, r, Color(0.02, 0.05, 0.05, 0.55))
	draw_arc(c, r, 0.0, TAU, 64, WARN if extreme else HUD_FAINT, UILayout.LINE_STRUCT, true)

	# ---- 随姿态转的那一层 ----
	var i0 := int(PITCH_TICK_DEG)
	var i1 := int(PITCH_LABEL_DEG)
	for p in range(-90, 91, i0):
		var o := off - float(p) * PITCH_PX_PER_DEG
		if absf(o) >= r:
			continue
		var half := sqrt(maxf(r * r - o * o, 0.0))
		var major := posmod(p, i1) == 0
		var col := HUD if p == 0 else (HUD_DIM if major else HUD_FAINT)
		if major:
			# 长刻度两侧各留 4 px 缺口，地平线才不会和刻度粘成一整条
			var w := maxf(half - 4.0, 0.0)
			draw_line(attitude_local_to_screen(c, roll, Vector2(-w, o)),
				attitude_local_to_screen(c, roll, Vector2(w, o)), col, UILayout.LINE_STRUCT, true)
			if p != 0 and half > 20.0:
				# 数字画在**刻度外侧**、且保持水平（见上面那段注释）
				_text_right(attitude_local_to_screen(c, roll, Vector2(-w - 3.0, o - 3.0)),
					"%d" % abs(p), 10, HUD_DIM)
				_text(attitude_local_to_screen(c, roll, Vector2(w + 3.0, o - 3.0)),
					"%d" % abs(p), 10, HUD_DIM)
		else:
			var sw := half * 0.45
			draw_line(attitude_local_to_screen(c, roll, Vector2(-sw, o)),
				attitude_local_to_screen(c, roll, Vector2(sw, o)), col, UILayout.LINE_HAIR, true)

	# ---- 固定机翼符号（不随盘转）----
	var wing := r * 0.42
	draw_line(c + Vector2(-wing, 0), c + Vector2(-5.0, 0), HUD, UILayout.LINE_STRUCT, true)
	draw_line(c + Vector2(5.0, 0), c + Vector2(wing, 0), HUD, UILayout.LINE_STRUCT, true)
	draw_rect(Rect2(c - Vector2(3.0, 3.0), Vector2(6.0, 6.0)), HUD_FAINT, false, UILayout.LINE_HAIR)

	# ---- 顶部倒三角（固定索引）+ 滚转刻度（固定）----
	var idx_col := WARN if extreme else HUD
	draw_colored_polygon(PackedVector2Array([
		c + Vector2(0.0, -(r - 17.0)),
		c + Vector2(-5.0, -(r - 6.0)),
		c + Vector2(5.0, -(r - 6.0))]), idx_col)
	for tk: float in ROLL_TICKS:
		for sgn: float in [-1.0, 1.0]:
			var ang := deg_to_rad(tk * sgn)
			var dir := Vector2(sin(ang), -cos(ang))
			var depth := 10.0 if tk >= 30.0 else 6.0
			draw_line(c + dir * r, c + dir * (r - depth), HUD_DIM if tk >= 30.0 else HUD_FAINT,
				UILayout.LINE_STRUCT if tk >= 30.0 else UILayout.LINE_HAIR, true)


## 垂直高度带（§4.2.2）。
##
## ## 它存在的理由不是"再显示一遍高度"
## 而是给右上角那个孤立数字一个**可比较的参照**。三条水平线就是全部的意义：
##   - **中央指针**：我在这里；
##   - **地面 / 海面实线**：离地还有多少 —— 玩家原话"看不到离海有多远"的正解；
##   - **红色虚线**：预测撞地，和 `PULL UP` 告警是**同一个量**
##     （`pull_up_clearance()`），所以画出来之后玩家能"看见"还有多久会撞上去，
##     而不是只看到一个在闪的单词。
##
## ## 两处与设计文档的有意偏差
##   ① 文档写"每 500 m 一道刻度、标数字"，这里刻度仍是 500 m 一道，
##      但**逢 1000 m 才标数字**：46 px 宽的带里，五位数（"12000"）在 10 px 字号下
##      正好占满，再密根本没法读。
##   ② 地面线**可能落在量程之外**（在 3000 m 飞时，5000 m 的量程是 [500, 5500]，
##      地面在下面）。这时把标记**贴到带的下缘**并把"离地多少米"写出来 ——
##      比"悄悄不画"好得多：玩家不会知道自己漏了什么，这是本工程反复踩的坑。
func _draw_altitude_tape() -> void:
	if _messer_cockpit(): return
	if _compact_cockpit(): return
	# ★★ 发射段走的是**同一条带**（老板：「把正常驾驶机体的……高度指示器拿过来」）。
	# ⚠️ 上升段末了在 **550 km**，远超带子的量程（`ALT_TAPE_SPAN_M`）——
	# 那不是 bug：越界那两处（地面线贴边 + "▼ 海面 540000 m" 的标注、
	# 刻度只画量程内那几道）在下面都**显式**处理过，而"贴边报距离"正是
	# 玩家要的"我还差多远"。所以这一段不需要第二套画法。
	var rocket := _from_rocket()
	if not rocket and (player == null or not is_instance_valid(player)):
		return
	var lay := altitude_tape_layout(size)
	var x := float(lay["x"])
	var w := float(lay["w"])
	var top := float(lay["top"])
	var bottom := float(lay["bottom"])
	var cur := _rd("alt_m", 0.0) if rocket else player.global_position.y

	draw_rect(Rect2(x, top, w, bottom - top), Color(0.02, 0.05, 0.05, 0.45), true)
	# 带左缘 = 结构线（1.0 px）。刻度从它向右伸，读数在带内右对齐。
	draw_line(Vector2(x, top), Vector2(x, bottom), HUD_FAINT, UILayout.LINE_STRUCT, true)

	# ---- 刻度 ----
	# 用**整数步进**而不是 `a += 500.0` 累加：浮点累加在边界上会漏掉或重复一条刻度，
	# 而"偶尔少一条刻度"没人能看出原因。
	var n0 := int(floor((cur - UILayout.ALT_TAPE_SPAN_M * 0.5) / TAPE_TICK_M))
	var n1 := int(ceil((cur + UILayout.ALT_TAPE_SPAN_M * 0.5) / TAPE_TICK_M))
	for i in range(n0, n1 + 1):
		var a := float(i) * TAPE_TICK_M
		var y := tape_y(lay, a, cur)
		if y < top or y > bottom:
			continue
		var major := posmod(i, 2) == 0          # 1000 m 的倍数（i 以 500 m 为单位）
		draw_line(Vector2(x, y), Vector2(x + (13.0 if major else 6.0), y),
			HUD_FAINT, UILayout.LINE_STRUCT if major else UILayout.LINE_HAIR, true)
		if major:
			# 刻度**位置**走真实米（几何是相对量），**标注数字**走显示缩放
			#（高度带的参照系必须和大数字同套单位）—— 见常量区的一致性铁律。
			_text_right(Vector2(x + w - 4.0, y + 4.0),
				"%d" % int(a * ALT_DISPLAY_SCALE), 10, HUD_DIM)

	# ---- 地面 / 海面线 ----
	var word := _ground_word()
	# 距离标注同乘 ALT_DISPLAY_SCALE（与大数字/刻度同套单位，见常量区铁律）；
	# 地面线的**位置**仍由真实米决定。
	var tag := "%s %d m" % [word, int(maxf(cur, 0.0) * ALT_DISPLAY_SCALE)]
	var gy := tape_y(lay, 0.0, cur)
	if gy > bottom or gy < top:
		# 地面在量程之外（飞得比量程高，或者在海平面以下）⇒ 贴边 + 箭头 + 距离。
		# ⚠️ **必须说出来**：悄悄不画的话玩家不知道自己漏了什么，
		# 而"地面线不见了"看起来像 bug、不像量程问题。
		var edge := bottom if gy > bottom else top
		var below := gy > bottom
		draw_line(Vector2(x, edge), Vector2(x + w, edge), WARN, UILayout.LINE_STRUCT, true)
		_text_right(Vector2(x + w - 4.0, edge + (10.0 if below else -4.0)),
			("▼ " if below else "▲ ") + tag, 10, WARN)
	else:
		draw_line(Vector2(x, gy), Vector2(x + w, gy), WARN, UILayout.LINE_STRUCT, true)
		# 带内右对齐 + 深色衬底：它右边是刻度数字、左边是高度块的数值列，
		# 不加衬底会和那两处糊在一起（衬底比"再加一个描边"更可控）。
		var tw := _font.get_string_size(tag, HORIZONTAL_ALIGNMENT_LEFT, -1, 10).x
		draw_rect(Rect2(x + w - 6.0 - tw, gy + 1.0, tw + 4.0, 12.0), Color(0.0, 0.0, 0.0, 0.72), true)
		_text_right(Vector2(x + w - 4.0, gy + 10.0), tag, 10, WARN)

	# ---- 预测撞地（与 PULL UP 同一个量）----
	var py := tape_y(lay, pull_up_clearance(cur,
		_rd("vs", 0.0) if rocket else player.fm.velocity.y), cur)
	py = clampf(py, top, bottom)
	draw_dashed_line(Vector2(x, py), Vector2(x + w, py), DANGER, UILayout.LINE_STRUCT, 5.0, true, true)
	draw_colored_polygon(PackedVector2Array([
		Vector2(x - 7.0, py - 4.0), Vector2(x - 7.0, py + 4.0), Vector2(x - 1.0, py)]), DANGER)

	# ---- 中央指针（我在这里）----
	var my := tape_y(lay, cur, cur)
	draw_line(Vector2(x, my), Vector2(x + w, my), HUD, UILayout.LINE_STRUCT, true)
	draw_colored_polygon(PackedVector2Array([
		Vector2(x + 1.0, my - 5.0), Vector2(x + 1.0, my + 5.0), Vector2(x + 8.0, my)]), HUD)


## 左下：机体血条 + **I 立场独立血条**。
func _draw_health_block() -> void:
	if _messer_cockpit(): return
	if _compact_cockpit():
		_cockpit_readouts.health(self)
		return
	var x := UILayout.content_left(size)
	# ⚠️ 这个 108 现在有第二个读者（姿态仪是"贴它上面排"的，见 `attitude_center()`），
	# 所以它升成常量 `HEALTH_BLOCK_TOP_FROM_BOTTOM`，两处不许各写一份。
	var y := size.y - HEALTH_BLOCK_TOP_FROM_BOTTOM
	var w := 240.0

	var bar := Rect2(x, y, w, 14.0)
	draw_rect(bar, Color(0, 0, 0, 0.4), true)
	var ratio := player.hp_ratio()
	var col := HUD if ratio > 0.5 else (WARN if ratio > 0.25 else DANGER)
	draw_rect(Rect2(bar.position, Vector2(bar.size.x * ratio, bar.size.y)), col, true)
	draw_rect(bar, HUD_FAINT, false, UILayout.LINE_STRUCT)
	_text(Vector2(x + w + 12.0, y + 13.0), "机体 %3d / %d" % [int(player.hp), int(player.max_hp)], 14, col)

	var ib := Rect2(x, y + 20.0, w, 12.0)
	draw_rect(ib, Color(0, 0, 0, 0.4), true)
	var ir := player.ifield_ratio()
	var icol := IFIELD if ir > 0.0 else IFIELD_DIM
	draw_rect(Rect2(ib.position, Vector2(ib.size.x * ir, ib.size.y)), icol, true)
	draw_rect(ib, IFIELD_DIM, false, UILayout.LINE_STRUCT)
	var itext := "I 立场 %3d / %d" % [int(player.ifield_hp), int(player.ifield_max)]
	if not player.has_ifield():
		itext = "I 立场 已击穿（不恢复）"
		icol = DANGER
	_text(Vector2(x + w + 12.0, y + 32.0), itext, 14, icol)


## 右下角装备行的键位在两种设备下的写法。
## 数据来源仍是 InputSetup.HELP_SECTIONS（键位改一次两边一起变），
## 这里只补"键盘写法 → 手柄写法"的对应。
## 键从**动作名**起（批 4 之前按键盘文本起键 —— 用户重绑之后那一列就会撒谎）。
const PAD_GLYPH := {
	"fire_primary": "R2",
	"fire_secondary": "L1",
	"fire_gun": "R1",
	"reload": "Y",
	"fire_missile": "L2",
	# ⚠️ 这里曾经是 C → "L3" —— 干扰弹 1.2 就挪到**十字键 ↓**、L3 给了变形。
	# 手柄模式下右下角那一行会印成 L3，**照抄就会按到变形**（第十五轮修）。
	"flares": "十字键 ↓",
	"shield": "B",
	"switch_weapon": "十字键 →",
}


## 按当前设备挑键位文案。键盘列走 `InputSetup.bind_label(action)`：
## 用户重绑之后右下角跟着变 —— 键位列从此和实际绑定同源（§4.8.6 的精神）。
static func _key(action: String) -> String:
	return InputSetup.hint(InputSetup.bind_label(action), str(PAD_GLYPH.get(action, "")))


## 本次扳机的火力分配预览，形如 ` → ①②`（按锁定组顺序，列出会分到弹的成员）。
##
## ⚠️ 用 `LockOnSystem.salvo_split()` 算，**绝不在 HUD 里重写一份**：
## 两处算法迟早会不一致，而症状是"HUD 说会打三个、实际只打了一个"这种最难查的偏差。
## 组里不足两人（K = 1）时返回空串 —— 单目标时的显示与改动前**逐字相同**。
func _salvo_spread_text() -> String:
	if lock == null or player == null or player.profile == null:
		return ""
	if not player.profile.has_missiles:
		return ""
	var group: Array[FlightBody] = lock.locked_in_group()
	if group.size() < 2:
		return ""
	var parts := LockOnSystem.salvo_split(player.profile.funnel_per_shot, group.size())
	var s := ""
	for i in group.size():
		if parts[i] <= 0:
			continue
		if i < LockOnSystem.GROUP_MARKS.size():
			s += str(LockOnSystem.GROUP_MARKS[i])
	if s == "":
		return ""
	return "  → " + s


func _draw_weapon_block() -> void:
	if player.thunderbolt_systems!=null:
		preload("res://scripts/ui/third_person_hud.gd")._thunderbolt_weapons(self,Rect2(Vector2(size.x-440,size.y-214),Vector2(380,176)));return
	if _messer_cockpit(): return
	if _compact_cockpit():
		_cockpit_readouts.weapons(self)
		return
	if player.is_sazabi():
		preload("res://scripts/ui/third_person_hud.gd")._sazabi_weapons(self,Rect2(Vector2(size.x-440,size.y-214),Vector2(380,176)))
		return
	if _compact_cockpit():
		_cockpit_readouts.weapons(self)
		return
	var locked := lock != null and lock.locked
	var y := size.y - UILayout.AMMO_TOP_FROM_BOTTOM
	var step := UILayout.AMMO_ROW_STEP
	var cols := UILayout.ammo_columns(size)

	# 每一行左侧都标着键位 —— 玩家不用记、也不用按什么帮助键，
	# 眼睛扫到右下角就知道"这件装备是按哪个键用的"。
	#
	# 第一行是"**当前武器**"：1.2 起左键用的是切出来的那一件
	#（光束步枪 / **腕部榴弹炮** / 光束军刀），所以名字与数值都跟着**当前槽位**走。
	# 原来这里永远印"光束步枪 ×N"，切到军刀之后就是错的；
	# 1.2 第二十六轮加了第三件（古斯塔夫00 的榴弹）之后，也不能再写"是不是军刀"了 ——
	# 判据统一读 `current_slot()`（和切武器、左键发射是同一个真源）。
	var slot := player.current_slot()
	var saber_state := "突进中" if player.saber_active() else (
		"冷却 %.1fs" % player.saber_cooldown if player.saber_cooldown > 0.0 else "就绪")
	var w_name := "光束步枪"
	var w_value := "×%d" % player.rifle_count
	var w_col := HUD if player.rifle_count > 0 else DANGER
	match slot:
		"bazooka":
			w_name = "双火箭筒"
			w_value = "装填 %.1fs" % player.bazooka_reload_left if player.bazooka_reload_left > 0 else "%d/16" % player.bazooka_mag
			if player.is_nu():
				w_name = "火箭筒"
				w_value = player.nu_systems.bazooka_status()
		"grenade":
			# 榴弹的数值写成"剩 / 共"：它是**每场 5 发的挂载弹药**，
			# 只写一个裸数字会被当成弹匣（然后等它自己回满）。
			var total := player.profile.grenade_count if player.profile != null else 0
			w_name = "腕部榴弹炮"
			w_value = "装填 %.1fs" % player.grenade_reload_left if player.grenade_reload_left > 0 else "%d / %d" % [player.grenade_count, total]
			w_col = HUD if player.grenade_count > 0 else DANGER
		"saber":
			w_name = "光束军刀"
			w_value = saber_state
			w_col = DANGER if player.saber_active() else (
				HUD_DIM if player.saber_cooldown > 0.0 else WARN)
	_weapon_row(y, _key("fire_primary"), w_name, w_value, w_col)

	# 弹匣行：键位 R，名称"弹匣"，值用一条带分隔线的条（比数字更快读出还剩几发）
	#
	# ⚠️ **无限弹的机体（梅萨M01）这一行整行换掉**：没有换弹键、没有分段、
	# 也不会闪"按 R 换弹" —— 它的弹匣在语义上不存在。
	# 做成"条恒满"是不够的：恒满的条看起来像"刚换完弹"，玩家会一直等它掉。
	# 所以直接画 `∞` 并把键位列清空（`_text_right` 传空串即可）。
	y += step
	if player.is_nu() and slot=="bazooka":
		_weapon_row(y,_key("reload"),"弹匣",player.nu_systems.bazooka_status(),HUD)
		y+=step
	elif player.has_infinite_rifle_ammo():
		_text_right(Vector2(cols["key"], y), "", 12, WARN)
		_text_right(Vector2(cols["name"], y), "弹匣", 14, HUD_DIM)
		_text_right(Vector2(cols["value"], y), "∞", 14, HUD)
		y += step
	else:
		_text_right(Vector2(cols["key"], y), _key("reload"), 12, WARN)
		var mag_w := UILayout.AMMO_BAR_W
		# 弹匣条的右端 = 数值列的右端（同一条线），所以它和上面几行的数字是齐的。
		# **这条占的就是数值列那一段**：名称列的右端在 `AMMO_NAME_BACK_FROM_VALUE`
		# 之外（= 条宽 + 间隙），否则条会压在"换弹"两个字上 —— 那个重叠是踩过的坑，
		# `suite_layout` 里有断言盯着这条不等式。
		var bar := Rect2(float(cols["value"]) - mag_w, y - 9.0, mag_w, 9.0)
		if player.rifle_reloading:
			# ---- 批 28：换弹中整条换成**滚动读条**（用户指定）----
			# 原来这里画的是 `mag_ratio()`：打空才换弹，所以那两秒里它**恒为 0** ——
			# 玩家看到的是一条空着的静止条，"还要等多久"完全没有读数。
			# 现在整条交给 `_draw_roll_bar()`，百分比补在名称列
			#（条只有 10 px 高，14 号的字塞不进去，压上去两边都读不清）。
			_draw_roll_bar(Rect2(bar.position.x, y - ROLL_BAR_H, mag_w, ROLL_BAR_H),
				player.reload_progress(), IFIELD)
			_text_right(Vector2(cols["name"], y),
				"换弹 %d%%" % int(roundf(player.reload_progress() * 100.0)), 14, IFIELD)
		else:
			_text_right(Vector2(cols["name"], y), "换弹", 14,
				DANGER if player.rifle_mag <= 0 and player.rifle_count > 0 else HUD_DIM)
			draw_rect(bar, Color(0, 0, 0, 0.45), true)
			var mcol := HUD if player.rifle_mag > 1 else (WARN if player.rifle_mag > 0 else DANGER)
			draw_rect(Rect2(bar.position, Vector2(bar.size.x * player.mag_ratio(), bar.size.y)), mcol, true)
			draw_rect(bar, HUD_FAINT, false, UILayout.LINE_STRUCT)
			if player.profile != null and player.profile.rifle_magazine > 1:
				var seg := bar.size.x / float(player.profile.rifle_magazine)
				for i in range(1, player.profile.rifle_magazine):
					var lx := bar.position.x + seg * float(i)
					draw_line(Vector2(lx, bar.position.y), Vector2(lx, bar.position.y + bar.size.y),
						Color(0, 0, 0, 0.55), UILayout.LINE_HAIR)
			if player.rifle_mag <= 0 and player.rifle_count > 0 and int(_flash * 3.0) % 2 == 0:
				draw_rect(bar, DANGER, false, UILayout.LINE_STRUCT)
		y += step
	# ---- 蓄力激光炮（阿利宙斯常态 / 巡航 2026-09-28；佩涅罗佩 2026-09-29）----
	#
	# ⚠️ **这一行本身就是需求的一部分**：大炮有两个"玩家看不见就会以为按键坏了"
	# 的门槛 —— 20 s 冷却和"必须满弹夹"。前者给数字、后者直说文案，
	# 不靠玩家去猜（本工程为"语义变了却不显示"栽过）。
	#
	# 没有这门炮的机体（柯西 / 古斯塔夫 / 梅萨M01 + 阿利宙斯核心形态）
	# **整行不出现** ——
	# 画一行恒为"无"的东西只是噪声。
	if player.cannon_available():
		var cannon_text := "就绪"
		var cannon_col := HUD
		if player.cannon_cd_left > 0.0:
			cannon_text = "冷却 %.1fs" % player.cannon_cd_left
			cannon_col = HUD_DIM
		elif player.rifle_reloading:
			cannon_text = "过热 %.1fs" % player.reload_timer
			cannon_col = WARN
		elif not player.cannon_ready():
			cannon_text = "弹夹不满"
			cannon_col = WARN
		_weapon_row(y, _key("fire_primary"), "蓄力炮（长按）", cannon_text, cannon_col)
		y += step
	# 火神炮：1.2 起**无限弹**（用户指定），所以显示 ∞ 而不是数字。
	# 没装这门炮的机体（靶机版古斯塔夫）仍然显示 0 且是警戒色 ——
	# "没有这门炮"与"打光了"是两件事，`has_vulcan()` 把它们分开了。
	var has_vulcan := player.profile != null and player.profile.has_vulcan()
	if player.profile.id == SuitProfile.Id.GP03S:
		_weapon_row(y,_key("switch_weapon"),"切换武器",player.next_slot_name(),HUD)
	else:
		_weapon_row(y, _key("fire_gun"), "火神炮", "∞" if has_vulcan else "0",HUD if has_vulcan else DANGER)

	y += step
	# 锁定状态用两字缩写：完整写"已锁定"会把这一行的数值列顶出屏幕右缘。
	# 1.1：核心形态根本没有导弹，那一行直接写"本形态无"，别让玩家对着 0 发呆。
	var lock_text := "已锁" if locked else ("不可锁" if _target_unlockable() else "未锁")
	# ---- 批 28：浮游导弹**装填中**这一行换滚动读条（用户指定）----
	# 此前这里**完全没有**装填显示：`flight_body` 里明明写着"HUD 浮游导弹一行会读
	# `funnel_reload_left` 显示进度"，而 HUD 从来没画过 —— 打空之后那 5 秒里
	# 玩家只看到一个停在 0 的数字，没有任何东西告诉他"在装、还有多久"。
	# 读条与弹匣条**共用同一条右端线**（数值列的右端），所以行与行还是齐的；
	# 百分比放名称列，理由同换弹行（条太薄，压字两边读不清）。
	var rearming := player.profile.has_missiles and player.funnel_reload_left > 0.0
	if player.is_nu():
		_weapon_row(y,_key("fire_missile"),"浮游炮",player.nu_systems.status_text(),HUD)
	elif rearming:
		var funnel_w := UILayout.AMMO_BAR_W
		_text_right(Vector2(cols["key"], y), _key("fire_missile"), 12, WARN)
		_text_right(Vector2(cols["name"], y),
			"装填 %d%%" % int(roundf(player.funnel_reload_progress() * 100.0)), 14, WARN)
		_draw_roll_bar(Rect2(float(cols["value"]) - funnel_w, y - ROLL_BAR_H, funnel_w, ROLL_BAR_H),
			player.funnel_reload_progress(), WARN)
	else:
		# ---- 批 1（多目标锁定）：把「这一扳机会分给谁」印出来 ----
		#
		# 这是需求里「火力分散」的**可见性**的一半：如果不显示，"锁了 3 个"在玩家看来
		# 只是"导弹莫名其妙变弱了"。K = 1 时后缀是空串 ⇒ 单目标时的显示与改动前逐字相同。
		var funnel_value := "本形态无"
		if player.profile.has_missiles:
			funnel_value = "%d  %s%s" % [player.funnel_count, lock_text, _salvo_spread_text()]
		_weapon_row(y, _key("fire_missile"), "浮游导弹", funnel_value,
			HUD if player.funnel_count > 0 else DANGER)

	y += step
	_weapon_row(y, _key("flares"), "干扰弹", "装填 %.1fs" % player.flare_reload_left if player.flare_reload_left > 0 else "%d" % player.flare_count,
		HUD if player.flare_count > 0 else DANGER)

	y += step
	# 拦截来袭飞弹：**右键点中飞弹框 → 选中并立刻发射拦截弹**（1.2 用户要求）。
	# 这一行的键位以前印的是"鼠标右键 = 光束军刀"—— 右键早就不是军刀了。
	# 数值列给 TTI（time-to-impact）：它是"还剩多久可以拦"的唯一读数。
	var threat_mark: Node3D = null
	var threat_tti := 0.0
	if player.has_method("selected_threat"):
		threat_mark = player.selected_threat()
		threat_tti = player.selected_threat_tti()
	# ⚠️ **这一行随"导弹系统模式"变**（第十八轮）：模式决定右键 / L1 干什么，
	# 所以这一行印的必须是**当前模式下的那件事** —— 在全弹发射模式里还印"拦截飞弹"
	# 就是"说明书印了一个按不出来的键"，正是本工程反复强调的禁忌。
	# 键位写法走 `_key("鼠标右键")`（手柄模式自动变 L1）✅。
	var row_name := "拦截飞弹"
	var row_val := "未选目标"
	var row_col := HUD_DIM
	var row_full := false
	var mmv = player.get("missile_mode")
	if mmv != null:
		row_full = int(mmv) == PlayerController.MissileMode.FULL_SALVO
	if row_full:
		row_name = "全弹发射"
		if player.profile.full_salvo_capacity > 1:
			row_val = player.full_salvo_charge_status()
			row_col = HUD if player.full_salvo_charges > 0 else HUD_DIM
		elif float(player.get("full_salvo_cooldown")) > 0.0:
			row_val = "冷却 %.0f s" % ceilf(float(player.get("full_salvo_cooldown")))
			row_col = HUD_DIM
		elif player.has_method("full_salvo_ready") and bool(player.call("full_salvo_ready")):
			row_val = "就绪 ×%d" % PlayerController.FULL_SALVO_COUNT
			row_col = HUD
		else:
			row_val = "弹药不足"
			row_col = DANGER
	else:
		# 数值列给 TTI（time-to-impact）：它是"还剩多久可以拦"的唯一读数。
		if threat_mark != null:
			row_val = "TTI %.1f s" % threat_tti
			row_col = DANGER
	if player.is_nu():
		row_name = "精准射击"
		row_val = "按住瞄准"
	_weapon_row(y, _key("fire_secondary"), row_name, row_val, row_col)

	y += step
	# 切换武器：键位是 **X / 十字键 →**。数值列写"切过去会变成哪一件"，
	# 比写"切换武器"四个字有用 —— 玩家想知道的正是"按下去会换成什么"。
	# ⚠️ 1.2 第二十六轮：古斯塔夫有**三件**（步枪 / 榴弹 / 军刀），
	# 所以这里读 `next_slot_name()`（和 `switch_weapon()` 同一套"跳过打空的"规则），
	# 而不是"是不是步枪 → 军刀 / 否则步枪"那个二元写法（三件时会预告错）。
	var nxt := player.next_slot_name()
	_weapon_row(y, _key("switch_weapon"), "切换武器",
		("→ %s" % nxt) if nxt != "" else "无可切换",
		WARN if nxt != "" else HUD_DIM)

	y += step
	# 举盾是"按一次 5 秒 + 冷却 1 秒"，所以数值列显示剩余秒数/冷却，
	# 而不是"按住"之类的操作说明（那种会顶出屏幕右缘）。
	var shield_text := "-%d%%" % int(player.profile.shield_reduction * 100.0)
	var shield_col := HUD_DIM
	if player.shield_up:
		shield_text = "%.1fs  -%d%%" % [player.shield_timer,
			int(player.profile.shield_reduction * 100.0)]
		shield_col = IFIELD
	elif player.shield_cooldown > 0.0:
		shield_text = "冷却 %.1fs" % player.shield_cooldown
		shield_col = WARN
	_weapon_row(y, _key("shield"), "举盾", shield_text, shield_col)


## 一行装备：三列全部**右对齐**（键位 / 名称 / 数值）。
##
## 三列的 x 是**右端**坐标，取自 `UILayout.ammo_columns()` ——
## 于是弹药栏的数值列、右上角高度块、结算菜单"损耗与战果"的数值列
## 落在同一条竖线上，三屏来回切换不会觉得"面板在飘"。
func _weapon_row(y: float, key: String, name: String, value: String, col: Color) -> void:
	var cols := UILayout.ammo_columns(size)
	_text_right(Vector2(cols["key"], y), key, 12, WARN)
	_text_right(Vector2(cols["name"], y), name, 14, col)
	_text_right(Vector2(cols["value"], y), value, 14, col)


# ============================================================ 批 28：换弹 / 装填的滚动读条
#
# 用户原话：「给换弹和浮游飞弹重新装填重新做一个滚动读条效果」。
#
# 两处进度此前**都是看不见的**：
#   - **光束步枪换弹**：那一条画的是 `mag_ratio()` —— 打空才换弹，所以那两秒里
#     它恒为 0，玩家看到的是一条**空着的静止条**，"还剩多久"没有任何读数；
#   - **浮游导弹装填**：`flight_body` 的注释写着"HUD 浮游导弹一行会读
#     `funnel_reload_left` 显示进度"，而 HUD 从来没画过。
#
# 所以这里补一条**两处共用**的读条。三件事必须同时成立，玩家才能在座舱里读出来：
#   ① **在推进** —— 填充段随进度从左往右长；
#   ② **在动** —— 填充段里的斜纹随 `_time` 滚动。"静止的条"会被读成"卡住了"，
#      滚动本身就是"正在装填"这个状态的字面表达（这也是"滚动读条"的要害）；
#   ③ **前沿可见** —— 填充前沿压一条亮边，眼睛跟得住"现在填到哪"。
#
# ⚠️ 斜纹相位必须**取模**（`fmod`）：拿 `_time * 速度` 直接当偏移的话数值会一直涨，
# 条画几分钟后斜纹就整个跑出填充段（看着像"读条停了"），而且大坐标会丢浮点精度。
# ⚠️ 进度换算**不在这一层**（见 `FlightBody.reload_progress()` /
# `funnel_reload_progress()`）—— HUD 只负责画，不许自己除换弹时长。
const ROLL_BAR_H := 10.0          ## 读条高度。比弹匣条的 9 px 略高：斜纹要有地方待
const ROLL_STRIPE_PITCH := 8.0    ## 斜纹周期（px）。再小就糊成实心块，"在动"看不出来
const ROLL_STRIPE_DUTY := 0.42    ## 一个周期里实心段的比例（0.42 ≈ 纹宽 3.4 px）
const ROLL_STRIPE_SPEED := 30.0   ## 滚动线速度（px/s）—— 慢到看得清、快到一眼看出在动
const ROLL_BODY_A := 0.30         ## 填充段底色透明度（斜纹压在上面，底色不能太亮）
const ROLL_STRIPE_A := 0.55       ## 斜纹透明度
const ROLL_EDGE_A := 0.95         ## 前沿亮边透明度
const ROLL_BREATHE_A := 0.06      ## 收尾"呼吸"幅度。**必须小**：大了就成闪烁，
                                  ## 而闪烁在这个 HUD 里是告警语义（§4.3）
const ROLL_BREATHE_FROM := 0.75   ## 过了这个进度才开始呼吸（暗示"快好了"）
const ROLL_BREATHE_HZ := 9.0


## 画一条滚动读条。`ratio` = 装填进度 0→1，`col` = 主色
## （换弹走 `IFIELD`（青，读作"系统在处理"）/ 装填走 `WARN`（橙，读作"发射器在忙"））。
##
## 只在**装填中**调用（门控在调用点），所以这里不做 `ratio <= 0` 的分支；
## 但仍要 clamp —— 换弹最后一帧的浮点误差会让 ratio 略微越界。
## 颜色一律由 `col` 派生（只改 alpha），**不引入第 6 个语义色**（§4.7）。
func _draw_roll_bar(bar: Rect2, ratio: float, col: Color) -> void:
	var r := clampf(ratio, 0.0, 1.0)
	# 槽底比弹匣条更暗一档：读条要"从空槽里长出来"，底太亮就看不出进度了。
	draw_rect(bar, Color(0, 0, 0, 0.62), true)
	var fw := bar.size.x * r
	if fw > 0.0:
		var fill := Rect2(bar.position, Vector2(fw, bar.size.y))
		# 收尾呼吸：越接近满，幅度越大（0 → ROLL_BREATHE_A）。正弦在进度刚到
		# `ROLL_BREATHE_FROM` 时从 0 起跳，所以不会有"过阈值闪一下"的台阶。
		var breathe := ROLL_BREATHE_A * sin(_time * ROLL_BREATHE_HZ) \
			* clampf((r - ROLL_BREATHE_FROM) / (1.0 - ROLL_BREATHE_FROM), 0.0, 1.0)
		draw_rect(fill, Color(col.r, col.g, col.b, ROLL_BODY_A + breathe), true)
		# 斜纹：只在**填充段内**滚动（出了前沿就不该有纹，否则像"已经填满了"）。
		# 起点往前退一个周期，再用 clamp 把越界的部分切掉 —— 于是最左那条纹是
		# 从半格"穿"进来的，相位在条内连续，不会每循环一格闪一下。
		var off := fmod(_time * ROLL_STRIPE_SPEED, ROLL_STRIPE_PITCH)
		var x := fill.position.x - ROLL_STRIPE_PITCH + off
		while x < fill.end.x:
			var sx := maxf(x, fill.position.x)
			var ex := minf(x + ROLL_STRIPE_PITCH * ROLL_STRIPE_DUTY, fill.end.x)
			if ex > sx:
				draw_rect(Rect2(Vector2(sx, fill.position.y), Vector2(ex - sx, fill.size.y)),
					Color(col.r, col.g, col.b, ROLL_STRIPE_A + breathe), true)
			x += ROLL_STRIPE_PITCH
		# 前沿亮边：上下各探出 1 px，读起来像"正在推进的刀口"（不是一根柱）。
		# 宽度取 `LINE_STRUCT` 这一档常量 —— §4.7 只允许两档线宽，
		# 而且**实参里不许出现数字**（`suite_ui_style` 扫源码逐条钉着）。
		draw_rect(Rect2(Vector2(fill.end.x - UILayout.LINE_STRUCT, bar.position.y - 1.0),
			Vector2(UILayout.LINE_STRUCT, bar.size.y + 2.0)),
			Color(col.r, col.g, col.b, ROLL_EDGE_A), true)
	# 外框走结构线（与弹匣条同一个壳，换弹前后"框"不跳）
	draw_rect(bar, HUD_FAINT, false, UILayout.LINE_STRUCT)


func _target_unlockable() -> bool:
	if lock == null or lock.target == null:
		return false
	var fb := lock.target as FlightBody
	return fb != null and fb.is_unlockable()


# ============================================================ 左上角：辅助驾驶 / 右上角：敌机列表
#
# 1.2 第十六轮（用户指定）：
#   「左上角显示辅助驾驶系统有没有开启，右上角显示周围的敌机列表（按 123 能切换已扫描的敌机）」
#   —— 第二轮补充：「不止 123，按数字键可以切换扫描到的敌机」。所以 1 – 9 全绑、
#   列表里每一架都带号（见 `PlayerController.CONTACT_KEYS`）。
#
# 两块都**无条件绘制**（只要玩家还活着），与"有没有鼠标移动事件"无关。
# 这一点是刻意针对手柄的：原来那个"辅助飞行 ON"角标画在 `_draw_aim_cursor()` 里、
# 又在 `not player.cursor_seen → return` 之后 —— **手柄玩家一条都看不见**
# （手柄没有鼠标移动事件，`cursor_seen` 恒为 false），而辅助飞行本来就是为手柄做的。
# 这一轮把它从那条死分支里搬出来，顺手把"右上角敌机列表"也放在同一条路上。


## 列表行高（px）。标题行在 `top`，第 n 行在 `top + 22 + （n−1) × 这个数`。
const CONTACT_ROW_STEP := 20.0
## 左上角纵向游标的行距：**辅助驾驶 / 踏板 / 系统状态三块共用同一个步进**，
## 这样三块排下来是等距的，不会一段挤一段松（1.2 第二十五轮）。
const ASSIST_ROW_STEP := 20.0
## 系统状态块的行距。比上面两块紧一档：它最多 5 行 + 一条按住进度条，
## 而"最多"这个上限由 `system_block_rows()` 保证（测试逐项验）。
const SYSTEM_ROW_STEP := 19.0
## 按住自动拦截的进度条宽度（画在左上角那块里，不再画在屏幕中央）。
const HOLD_BAR_W := 120.0
## 左上角"键位 → 名称"之间的间隙（px）。键位文本长度随设备变（"长按 G" / "长按 A"），
## 所以名称列的位置**按字体实测宽度算**，只有这个间隙是常量。
const ASSIST_KEY_GAP := 12.0


## 两块角标的几何（**纯函数**，`suite_round16` 直接断言它）。
##
## 抽出来的理由和 `result_layout` / `UILayout` 完全一样：版式靠肉眼看截图是说不清的，
## 而"右端到底落没落在 `content_right` 上""列表会不会压到右中的高度块"
## 是可以算出来的。两块共用一份，是因为它们的纵坐标必须一样（都在 `MARGIN + 14`），
## 各写一份的话，改版式时一定会对不上。
static func corner_layout(view: Vector2) -> Dictionary:
	var l := UILayout.content_left(view)
	var r := UILayout.content_right(view)
	return {
		"assist_x": l,
		"assist_top": UILayout.MARGIN + 14.0,
		"right": r,
		# 号牌列与机名列用**左端**坐标（左对齐，机名长短不一时不会左右抖）
		"tag_x": r - 280.0,
		"name_x": r - 250.0,
		"top": UILayout.MARGIN + 14.0,
		"row_step": CONTACT_ROW_STEP,
	}


## 辅助驾驶的**键位提示**（随设备切换）。
##
## 抽成纯函数是为了能被测试直接断言 —— "手柄模式下这一行会不会印出一个按不出来的键"
## 正是第十五轮 §2.4 那类事故（说明书印着按不出来的键）的复发面。
##
## ⚠️ 文案里必须带**「长按」**：辅助驾驶是**长按 0.45 s** 开关的（`HoldAction`），
## 只印一个 `G` 会让玩家点一下就以为按键坏了。手柄同理（长按 A）。
static func assist_hint(using_gamepad: bool) -> String:
	return "长按 A" if using_gamepad else "长按 G"


## 左上角第二行：**飞行踏板**（1.2 载具系统）。
##
## 用户要求："踏板要有搭乘键和脱离键，类似载具系统。按键还能呼叫飞行踏板到自己的位置来。"
##
## 这一行回答三个问题（骑与没骑，显示的东西不一样）：
##   - **没骑**：按什么键呼叫/搭乘 + 这**台机能不能骑**（ACE 机不可骑要当场说清，
##     否则玩家按半天以为是 bug —— "按了没反应"是本工程反复踩过的坑）；
##   - **骑了**：`[N] 已搭乘 · 空格 踏板火神炮 · [T] 脱离`。
##
## ⚠️ 它**不画耐久**：踏板耐久属于**目标框**那一块（打敌人的板时看），
## 自己板上的剩余量在右下角装备区还排不下，先不做 —— 记在这里免得被当成漏了。
func _draw_pedal_block(top: float) -> float:
	if _compact_cockpit(): return top
	if player == null or player.profile == null:
		return top
	var g := corner_layout(size)
	var x: float = g["assist_x"]
	# ⚠️ 起点由**上一块交出来**（1.2 第二十五轮改成纵向游标）。
	# 原来写死 `assist_top + 22` —— 而辅助驾驶开着时的第二行正好在 `assist_top + 20`，
	# 两条字只差 2 px，叠在一起；辅助驾驶开着又是常态，所以那是常态。
	var y: float = top
	var can_ride: bool = player.profile.can_ride_pedal()
	var riding: bool = player.has_pedal()
	# ⚠️ **键位与文案都按设备换**（`InputSetup.hint`）：手柄上没有 N / 空格 / T ——
	# 它们分别是"长按十字键 →"、"R1"、"B"。2026-09-21 补的（古斯塔夫/梅萨的手柄适配）。
	# 手柄上"呼叫踏板"是**长按十字键 →**（`InputSetup.PAD_HOLD`），不是独立按键。
	var ride_key := InputSetup.hint("N", "长按 →")
	# 键位列宽度**按实测文字宽度算**（"长按 →" 比 "N" 宽得多）——
	# 写死 22 px 会让键位和右边的说明叠字（辅助驾驶那块早就这么做了，见 `ASSIST_KEY_GAP`）。
	var key_w := _font.get_string_size(ride_key, HORIZONTAL_ALIGNMENT_LEFT, -1, 13).x
	var body_x := x + key_w + 12.0
	if riding:
		# 键位列照旧在最左、WARN 色 —— 和辅助驾驶、右下角装备行同一个约定。
		_text(Vector2(x, y), ride_key, 13, WARN)
		_text(Vector2(body_x, y), "已搭乘 · %s 踏板火神炮 · %s 脱离"
			% [InputSetup.hint("空格", "R1"), InputSetup.hint("T", "B")], 14, IFIELD)
		return top + ASSIST_ROW_STEP
	var key_col := WARN if can_ride else HUD_FAINT
	_text(Vector2(x, y), ride_key, 13, key_col)
	if can_ride:
		_text(Vector2(body_x, y), "呼叫 / 搭乘飞行踏板", 14, HUD_DIM)
	else:
		# ACE 机：**说清原因**，别让玩家对着一个没反应的键猜。
		_text(Vector2(body_x, y), "本机为 ACE 机 · 不可搭乘飞行踏板", 14, HUD_FAINT)
	return top + ASSIST_ROW_STEP


## 左上角第三块：**系统状态**（1.2 第二十五轮从屏幕中央搬过来的）。
##
## ## 为什么搬
##
## 用户原话：「战斗时候的 ui 需要优化，**屏幕中心太多字了**，你看看能不能放到其他地方去，
## 比如**辅助驾驶系统的下面**之类的」。
##
## 中央原来压着**五行常驻文字**（导弹系统模式 / 全弹发射状态 / 自动拦截 ON /
## 当前选中 + TTI / 威胁计数 + 换目标），它们的共同点是：
## **说的都是"我这边系统在干什么"，而不是"目标在哪儿"**。
## 所以正确的家是左上角那块系统状态区（辅助驾驶 → 踏板 → 仪表），
## 而屏幕中心只留**指向性的东西**：准星、目标框、飞弹框、拉升告警。
##
## ## 什么**故意不搬**（别顺手一起搬）
##
##   - 每一枚飞弹自己的 `TTI x.x s` —— 它必须贴在那一枚上，搬走就没法对应了；
##   - `已拦截` 角标与连线 —— 同上，是"这一枚被咬了"的指向信息；
##   - 目标框上的名称 / 距离 / 层 / I 立场 / 踏板 —— 都是"那一台"的属性。
##     （这一轮只把目标框上的**行数**压下去：两三行并成一行，见 `_draw_target()`。）
## 返回**自己底部的 y** —— 左上角那个纵向游标的约定（每块把底部交出来，下一块接着排）。
##
## ⚠️ 原来这个函数返回 `void`，于是新手教学面板**没法接在它后面**
##（`corner_y = _draw_system_block(...)` 会编译不过：不能取 void 的返回值）。
## 补成返回 float 而不是"给教学面板另找一个地方"：那样会多一个**手写坐标**，
## 而手写坐标正是这个游标当初要解决的问题（几块字叠在一起）。
func _draw_system_block(top: float) -> float:
	if _compact_cockpit(): return top
	if player == null or not is_instance_valid(player):
		return top
	var g := corner_layout(size)
	var x: float = g["assist_x"]
	if player.is_nu():
		_text(Vector2(x,top),"浮游炮 · "+player.nu_systems.mode_name()+" · Alt切换",13,WARN)
		return top+SYSTEM_ROW_STEP
	var rows := system_block_rows(_system_state())
	var y := top
	for row: Dictionary in rows:
		_text(Vector2(x, y), str(row.get("text", "")), int(row.get("size", 13)),
			row.get("col", HUD_DIM))
		y += SYSTEM_ROW_STEP
		# 按住进度条画在**这一行下面**（19 px 的行距里塞得下 4 px 的条）。
		var bar := float(row.get("bar", 0.0))
		if bar > 0.0:
			draw_rect(Rect2(x, y - 6.0, HOLD_BAR_W, 4.0), HUD_FAINT, true)
			draw_rect(Rect2(x, y - 6.0, HOLD_BAR_W * bar, 4.0), WARN, true)
	return y


## 把玩家的实时状态收成一个字典，交给**纯函数** `system_block_rows()` 排版。
##
## 抽这一层的理由和 `corner_layout` / `assist_hint` 一样：**能被测试直接喂数据**。
## 直接对屏幕截图断言"中央没有字了"是不可测的，而"这几行会怎么排、最多几行"可测。
func _system_state() -> Dictionary:
	var st := {}
	if player.has_method("missile_mode_name"):
		st["mode"] = str(player.call("missile_mode_name"))
	if player.has_method("missile_mode_hint"):
		st["hint"] = str(player.call("missile_mode_hint"))
	var mm = player.get("missile_mode")
	st["full"] = mm != null and int(mm) == PlayerController.MissileMode.FULL_SALVO
	st["cd"] = float(player.get("full_salvo_cooldown"))
	if player.has_method("full_salvo_ready"):
		st["ready"] = bool(player.call("full_salvo_ready"))
	st["count"] = PlayerController.FULL_SALVO_COUNT
	if player.has_method("auto_intercept_active"):
		st["auto"] = bool(player.call("auto_intercept_active"))
	if player.has_method("intercept_hold_progress"):
		st["hold"] = float(player.call("intercept_hold_progress"))
	var sel = null
	if player.has_method("selected_threat"):
		sel = player.selected_threat()
	st["sel"] = sel != null
	if sel != null and player.has_method("selected_threat_tti"):
		st["tti"] = float(player.selected_threat_tti())
	# ⚠️ 文案**必须按设备换**（手柄上没有右键）—— 印一句按不出来的键，
	# 正是本工程栽过两次的那类事故（见 `assist_hint` 的注释）。
	st["how"] = InputSetup.hint("右键直接拦 · 或按 F", "L1 点按拦 · 按住自动")
	var list: Array = []
	if player.has_method("threats"):
		list = player.call("threats")
	st["threats"] = list.size()
	st["cycle"] = InputSetup.hint("B 换一个目标 · 按完自动取消选中", "L1 按住 = 自动拦截")
	return st


## 系统状态块**要画哪几行** —— 纯函数：给状态字典，返回行的数组。
##
## 行 = `{"text": String, "size": int, "col": Color, "bar": float}`。
## `bar > 0` 的那一行会在下面补一条进度条（只有"按住自动拦截"用得上）。
##
## 三条不变量（`suite_round16` 逐项验）：
##   1. **导弹系统模式那一行永远在** —— 它决定"右键 / L1 干什么"，
##      藏起来的代价是玩家按下右键以为按键坏了；
##   2. 其余行**只在对应状态出现**（不然左上角就是新的"一堵字"）；
##   3. 行数是**有上界的**（最多 6 行）：这块接在辅助驾驶与踏板下面，
##      无上界的话它会一路长到半个屏幕，把左上角变成第二个中央。
static func system_block_rows(st: Dictionary) -> Array:
	var rows: Array = []
	# ---- ① 导弹系统模式：常驻 ----
	rows.append({
		"text": "导弹系统：%s（%s）" % [str(st.get("mode", "")), str(st.get("hint", ""))],
		"size": 13, "col": WARN, "bar": 0.0,
	})
	# ---- ② 全弹发射状态：只有在这个模式下才画 ----
	if bool(st.get("full", false)):
		var cd := float(st.get("cd", 0.0))
		var count := int(st.get("count", 0))
		var text := "全弹发射 就绪 · 一次 %d 发" % count
		var col := HUD
		if cd > 0.0:
			text = "全弹发射 冷却 %.0f s（换模式也不重置）" % ceilf(cd)
			col = HUD_DIM
		elif not bool(st.get("ready", false)):
			text = "全弹发射 弹药不足（需 %d 发）" % count
			col = HUD_DIM
		rows.append({"text": text, "size": 12, "col": col, "bar": 0.0})
	# ---- ③ 自动拦截：**按钮的状态**，不是威胁的信息 ----
	if bool(st.get("auto", false)):
		rows.append({"text": "自动拦截 ON", "size": 15, "col": HUD, "bar": 0.0})
	elif float(st.get("hold", 0.0)) > 0.05:
		rows.append({"text": "按住 = 自动拦截", "size": 12, "col": HUD_DIM,
			"bar": clampf(float(st.get("hold", 0.0)), 0.0, 1.0)})
	# ---- ④ 当前选中：它改变 `F` / 右键的语义，所以必须常驻可见 ----
	if bool(st.get("sel", false)):
		rows.append({
			"text": "当前选中：来袭飞弹   TTI %.1f s" % float(st.get("tti", 0.0)),
			"size": 15, "col": DANGER, "bar": 0.0,
		})
		var how := str(st.get("how", ""))
		if how != "":
			rows.append({"text": how, "size": 12, "col": HUD_DIM, "bar": 0.0})
	# ---- ⑤ 威胁总数：手柄玩家靠它才知道"按住 L1 还有别的可拦" ----
	var n := int(st.get("threats", 0))
	if n > 0:
		rows.append({"text": "威胁 ×%d   %s" % [n, str(st.get("cycle", ""))],
			"size": 12, "col": HUD_DIM, "bar": 0.0})
	return rows


## 左上角：**按什么键开关** + 辅助驾驶**开着还是关着** + 这一刻**是哪几个子系统在出力**。
##
## 版式（三轮需求叠出来的，别再往回改）：
##   `[键位]  辅助驾驶  开启/关闭/接管拉升`     ← 用户第二轮："要有按键提示"
##   `        姿态  距离  避障`                 ← 出力的亮、待命的暗
##
## 光写一个 "ON" 不够：辅助驾驶只做三件事（帮调朝向 / 保持索敌距离 / 规避障碍），
## 而玩家最容易误判的正是"机头自己在动是不是 bug"。把"现在是谁在出力"写在旁边，
## 它就从 bug 变成功能 —— 第十四轮反馈里"晕动 / 找不到敌机"很大程度上就是这个来源。
##
## ⚠️ 关着的时候**只画一行**（键位 + "辅助驾驶 关闭"）。三格灰字常驻会让左上角变脏，
## 而"关着"本身不需要解释 —— 但**键位提示关着也要画**：那正是玩家"想打开它"的时候。
##
## 返回值 = 这一块占到的**下一个 y**（左上角纵向游标，见 `_draw()`）。

## 左上角"辅助驾驶"这一行的三个 x 偏移（★63-9 · D2 提成常量）：
##   状态字（开启 / 关闭 / 接管拉升） → **倒飞格** → 系统提示行。
##
## ⚠️ 提成常量只有一个理由：**位置关系要能断**。"倒飞那一格挤到系统提示行上"
## 这种错属于"两条断言都绿、屏幕上却看不见"—— 只有三个数的大小关系抓得住它，
## 写成三个字面量就没法断言了（`suite_reverse_fly` 直接解析这三个常量）。
const ASSIST_STATE_X := 82.0
const ASSIST_REVERSE_X := 155.0
const ASSIST_EVENT_X := 230.0


func _draw_assist_block() -> float:
	if _compact_cockpit(): return _cockpit_readouts.assist(self)
	var g := corner_layout(size)
	var st: Dictionary = player.assist_state()
	var on: bool = st.get("on", false)
	var x: float = g["assist_x"]
	var y: float = g["assist_top"]
	# 键位列在最左 —— 和右下角装备行**同一个约定**：键位永远在名称左边、WARN 色。
	# 用户第二轮要求："左上角辅助驾驶要有按键提示"。
	# 于是左上角这块不复述说明书，直接告诉你"按什么能开关它"，和装备栏一致。
	var key_text := assist_hint(InputSetup.using_gamepad)
	if player.is_nu():key_text+=" 索敌/解除"
	var key_w := _font.get_string_size(key_text, HORIZONTAL_ALIGNMENT_LEFT, -1, 13).x
	var name_x := x + key_w + ASSIST_KEY_GAP
	_text(Vector2(x, y), key_text, 13, WARN)
	_text(Vector2(name_x, y), "辅助驾驶", 15, HUD_DIM)
	# ⚠️ 「接管拉升」（第十四轮的**地面硬兜底**）必须比"开启"更醒目：
	# 那几秒里**俯仰被系统写死、推杆是没反应的**（`_auto_pull_up`），
	# 画面中央的瞬时提示只闪一下，而这块角标是常驻的 —— 玩家低头看杆没反应时，
	# 一眼就该在左上角找到原因。数据由 `PlayerController.assist_state()` 的
	# `auto_pull` 送来（那个键是并行的第十四轮会话自己加进来的）。
	var hard: bool = st.get("auto_pull", false)
	# 倒着飞（★63-9 · D2）：`PlayerController.assist_state()["reverse"]`。
	# 与 `hard` 并列读，都在画字之前 —— 三个 x 偏移提成 const 是为了**位置关系可断**。
	var rev: bool = st.get("reverse", false)
	var state_text := "开启"
	var state_col := HUD
	if not on:
		state_text = "关闭"
		state_col = HUD_FAINT
	elif hard:
		state_text = "接管拉升"
		state_col = DANGER
	_text(Vector2(name_x + ASSIST_STATE_X, y), state_text, 15, state_col)
	# ---- 倒飞状态格（★63-9 · D2）----
	# 与"辅助驾驶 开启/关闭"**同一行、紧挨其右**（`ASSIST_STATE_X < ASSIST_REVERSE_X
	# < ASSIST_EVENT_X`，三个 x 都是函数上头那几个 const）。判据要断的是**位置关系**：
	# 这一格挤到系统提示行上就等于没画（同一行右侧被提示吃掉）。
	if rev:
		_text(Vector2(name_x + ASSIST_REVERSE_X, y), "反向巡航", 14, WARN)
	# ---- **系统提示行**（开/关 · 接管/交还 · 切导弹系统 · 切武器 · 俯仰反转）----
	# 画在**同一行的右边**，不进屏幕中央。
	#
	# 老板两轮反馈：
	#   ① "辅助飞行很容易抢控制权……另外**自动改出的这些提示也移开**"；
	#   ② "**切换拦截系统**和**切换手柄操作**的这些提示**都还在中间**啊"。
	#
	# 放在这一行右侧有三个好处：① 不占中央；② **不会让下面的块跳动** ——
	# 左上角是纵向游标，多占一行会把踏板和系统状态整块推下去；
	# ③ 紧挨着状态区（"辅助驾驶 开启"旁边就是"导弹系统：全弹发射"）。
	# 这类消息的共同点：**它是"我按了一下，某个东西换挡了"，不是战场上发生了什么** ——
	# 战场事件（击坠 / 波次 / 拦截弹 / 锁定 / 变形）仍然留在中央那摞 toast 里。
	if _system_event_timer > 0.0 and _system_event_seen != "":
		var ev_col := HUD_DIM
		if _system_event_seen.contains("接管") or _system_event_seen.contains("改出") or _system_event_seen.contains("地形警告"):
			ev_col = DANGER
		elif _system_event_seen.contains("交还"):
			ev_col = HUD
		_text(Vector2(name_x + ASSIST_EVENT_X, y), _system_event_seen, 14, ev_col)
	if not on:
		return y + ASSIST_ROW_STEP
	# 三个子系统：出力的亮、待命的暗。**三格一直在**，玩家才看得出"它只在某一项上动手"。
	# 这一行**缩进到名称列**，读起来就是"那个键管的东西，细分是这三项"。
	# 硬兜底期间「避障」转危险色 —— 那一项正是此刻在抢杆的东西。
	var tags := [["姿态", bool(st.get("aim", false)), HUD],
		["距离", bool(st.get("range", false)), HUD],
		["避障", bool(st.get("avoid", false)) or hard, DANGER if hard else HUD]]
	var tx := name_x
	for tag: Array in tags:
		var s := str(tag[0])
		var col: Color = HUD_FAINT
		if bool(tag[1]):
			col = tag[2] as Color
		_text(Vector2(tx, y + ASSIST_ROW_STEP), s, 13, col)
		tx += _font.get_string_size(s, HORIZONTAL_ALIGNMENT_LEFT, -1, 13).x + 12.0
	return y + ASSIST_ROW_STEP * 2.0


## 右上角：附近敌机列表。
##
## 与右下角装备栏同一套右对齐写法（`_text_right`），右端取 `UILayout.content_right()` ——
## 于是右上角这块和右下角装备栏、结算菜单的数值列落在**同一条竖线**上。
##
## 名单来自 `PlayerController.contacts()`，和数字键 **1 – 9** 选的是**同一份**
## （见 `PlayerController.CONTACT_KEYS`），不存在"HUD 画的和按键选的不是一回事"。
##
## ⚠️ 数字**不是排名**：编号由 `rank_contacts()` 发放、老面孔保号（理由见那边的注释）。
## 所以每一行都必须印距离 —— 序号不再说明"谁更近"，距离才说明。
func _draw_contact_list() -> void:
	if _compact_cockpit():
		_cockpit_readouts.contacts(self)
		return
	var g := corner_layout(size)
	var list: Array = []
	list = player.contacts()
	var right: float = g["right"]
	var top: float = g["top"]
	var n := list.size()
	_text_right(Vector2(right, top), "附近敌机 ×%d" % n, 14, HUD_DIM if n > 0 else HUD_FAINT)
	if n == 0:
		return
	var slots := PlayerController.CONTACT_KEYS.size()
	var tag_x: float = g["tag_x"]
	var name_x: float = g["name_x"]
	var row_y: float = top + 22.0
	for i in n:
		var raw = list[i]
		if raw == null or not is_instance_valid(raw):
			continue
		var fb := raw as FlightBody
		if fb == null:
			continue
		var is_target := lock != null and lock.target == fb
		var dist := player.global_position.distance_to(fb.global_position)
		# 「已扫描」（用户的说法）= 在导引头射程内、火控已经建立航迹。
		# 超距的**照旧列出来**（"周围有几架"不能少），但整行压暗 + 距离后面标「未扫描」，
		# 玩家一看就知道"这一架现在按数字键选不上"。
		var scanned: bool = lock != null and dist <= lock.seeker_range
		var col: Color = HUD_FAINT
		if is_target:
			col = DANGER
		elif not scanned:
			col = HUD_FAINT
		elif i < slots:
			col = WARN
		if i < slots:
			_text(Vector2(tag_x, row_y), "[%d]" % (i + 1), 13, col)
		else:
			# 第 10 架起没有数字键可用 —— 号牌位留一个占位符，
			# 而不是让它看起来"下面这几架也有号可以按"
			_text(Vector2(tag_x, row_y), "[·]", 13, HUD_FAINT)
		_text(Vector2(name_x, row_y), fb.display_name, 14, col)
		var dist_text := "%.1f km" % (dist / 1000.0)
		if not scanned:
			dist_text += " 未扫描"
		_text_right(Vector2(right, row_y), dist_text, 13, col)
		# 屏幕外的敌机：行首画一个小箭头说明"往哪边转"（和屏幕边缘那个大箭头同源）
		if camera.is_position_behind(fb.global_position):
			_draw_contact_arrow(Vector2(tag_x - 18.0, row_y - 4.0), fb.global_position, col)
		row_y += CONTACT_ROW_STEP
	# 超过三个槽位的敌机**必须有个交代**：否则列表看起来像"敌机就这么几架"
	if n > slots:
		_text_right(Vector2(right, row_y + 2.0),
			"其余 %d 架 · %s 循环" % [n - slots, InputSetup.hint("Tab", "十字键 ↑")], 12, HUD_DIM)


## 八方向表：下标 = `round(角度 / 45°)`，0 = 正上（屏幕坐标，y 向下）。
## 和 `_draw_off_screen_arrow()` 用的是同一套 `atan2(local.x, local.y)` 约定，
## 所以"列表说在左后方"和"屏幕边缘的大箭头指左后方"不会打架。
const CONTACT_ARROWS := [Vector2(0, -1), Vector2(1, -1), Vector2(1, 0), Vector2(1, 1),
	Vector2(0, 1), Vector2(-1, 1), Vector2(-1, 0), Vector2(-1, -1)]


func _draw_contact_arrow(at: Vector2, world: Vector3, col: Color) -> void:
	var dir := camera.global_position.direction_to(world)
	var local := camera.global_transform.basis.inverse() * dir
	var a := atan2(local.x, local.y)
	var v: Vector2 = CONTACT_ARROWS[posmod(int(round(a / (PI * 0.25))), 8)]
	var side := Vector2(-v.y, v.x)
	draw_colored_polygon(PackedVector2Array([
		at + v * 7.0, at - v * 4.0 + side * 4.5, at - v * 4.0 - side * 4.5]), col)


# ============================================================ 告警 / 提示

## 这个场地底下是海 / 地 / **再入线**。结算日志里"撞海"和"撞地"本来就是分开的，
## 这里跟着走，免得在地图二（艾尔斯岩）上对着沙丘喊"海面"。
##
## ⚠️ **轨道图（`has_ground == false`）那一条必须排在 `ISLANDS` 之前判**：
## 它是"这张图根本没有地表"，与"地表是海还是地"是两个不同的问题 ——
## 顺序写反的话，轨道图会落进最后那行 `return "地面"`，
## 于是高度带底下那条线一路写着"地面 0 m"，而那条线其实是**再入线**。
##
## 判据的顺序就是一个三值判据的**优先级**，所以它必须显式写出来：
##   ① 没有地面 ⇒ 「再入线」（这一条与地图的海/地无关）
##   ② 地表是海 ⇒ 「海面」
##   ③ 其余 ⇒ 「地面」
func _ground_word() -> String:
	var m := Game.active_map
	if m != null and not m.has_ground:
		return "再入线"
	if m != null and m.terrain == MapDef.Terrain.ISLANDS:
		return "海面"
	return "地面"


## 批 2（§4.3.1）：**告警状态机**的唯一写入点。每帧在 `_process` 里算一次。
##
## 五条告警全部由 `warn_state()` 这个纯函数从**原始量**算出来 ——
## 这里只负责两件事：取原始量、决定要不要出声。
##
## ⚠️ 语音只在 `Game.Phase.FIGHT` 出声。结算画面上玩家还在往下掉，
## 那时播"PULL UP"是纯噪音 —— 而且结算界面盖在 HUD 上，字幕也看不见，
## 于是它变成一条"只闻其声不见其字"的告警，比不播更差。
func _tick_warnings(delta: float) -> void:
	_warn_voice_since += delta
	_warn_clearance = pull_up_clearance(player.global_position.y, player.fm.velocity.y)
	_warn_state = warn_state(player.global_position.y, player.fm.velocity.y,
		not player.incoming_missiles().is_empty(), player.fm.stalled,
		player.fm.g_load, player.has_ifield())
	var picked := pick_voice(_warn_state, _warn_held, _warn_voice_last, _warn_voice_since)
	# ⚠️ `_warn_held` 必须在 `pick_voice()` **之后**才更新。
	# 它是"上帧成立的那条"；先更新的话 `pick_voice()` 拿到的就是本帧的值，
	# 规则 ②（边沿触发）永远不成立 —— 于是每条告警每帧都播一遍。
	_warn_held = highest_warning(_warn_state)
	if picked == "":
		return
	_warn_voice_last = picked
	_warn_voice_since = 0.0
	if Game.phase == Game.Phase.FIGHT:
		_play_warn_voice(picked)


## 播一条告警语音。**素材缺失时自动降级成合成音效**（§4.3.2）——
## 所以"语音还没录"不会变成"告警没了"：字幕照旧闪，耳朵也照样有动静。
func _play_warn_voice(key: String) -> void:
	var voice := str(VOICE_FOR.get(key, ""))
	if voice == "":
		return
	Audio.play_voice(voice)


## ★★ 发射段（马夫蒂火箭）的告警状态机。与 `_tick_warnings()` **共用同一组状态字段**
##（`_warn_state` / `_warn_held` / `_warn_clearance`）⇒ `_draw_warnings()` 一行不改就能画它 ——
## 这正是"把机体那一套搬过来"的含义，不是另做一块像它的。
##
## ## 与 `_tick_warnings()` 的三点不同
## ① **读数来自 `launch_warn`**（`main` 每帧塞的火箭量），不是 `player`：
##    发射段 `player` 是 `null`（他还在运输仓里，见 `_begin_launch()` 的头注）。
## ② **判据走 `launch_warn_state()`** —— 只判火箭真有的那两条（拉起 / 过载），
##    另三条恒假。理由与那张表一起写在 `launch_warn_state()` 上面。
## ③ **不出声**。玩家坐在一枚真火箭里，没有第二个乘员喊话；字幕照旧画 ——
##    "字幕"与"语音"本来就是两件事（§4.7 只要求"语音必须配字幕"，反向不成立）。
##    顺带也避开了 `VOICE_FOR` 那四条录音：它们的语气是"握杆的战斗机飞行员"。
##
## ⚠️ `_warn_held` 照旧维护（虽然这一支不播语音）：它决定"从哪条切到哪条"。
## 留空的话，将来一旦给发射段接了语音，边沿触发会从"上帧没有告警"重新起算
## ⇒ 每条告警都会连播两遍。现在按同一套规矩维护，等于把那个坑提前填掉。
func _tick_launch_warnings(delta: float) -> void:
	_warn_voice_since += delta
	if launch_warn.is_empty():
		# 倒计时中 / 不在发射段。`launch_warn` 是 `main` **点火之后**才写的 ——
		# 倒计时里箭一动不动，没有任何量值得报。
		# ⚠️ 用"空字典"表示这个态、而不是塞三个 0：
		# `pull_up_clearance(0, 0)` 恰好等于 0，正好卡在 `< 0` 的门限上，
		# 判据会随浮点末位漂（而它表现为"偶发地闪一下 PULL UP"）。
		_warn_state = no_warn_state()
		_warn_held = ""
		_warn_clearance = 0.0
		return
	var alt := float(launch_warn.get("alt", 0.0))
	var vs := float(launch_warn.get("vs", 0.0))
	_warn_clearance = pull_up_clearance(alt, vs)
	_warn_state = launch_warn_state(alt, vs, float(launch_warn.get("g", 0.0)))
	_warn_held = highest_warning(_warn_state)


## 中央告警（第十四轮 A2 起，批 2 改成只读状态）。
##
## ⚠️ **它同时是语音的字幕**。设计要求"语音必须配字幕"（玩家可能静音），
## 所以这里的文案不许比语音更简写（比如把 `MISSILE ALERT` 缩成 `MSL`）——
## 一旦简写它就不再是字幕，而是一个玩家要现解码的缩写。
##
## ## 拉起告警为什么按"预测高度"判（保留这一段，它是这一块的根因记录）
##
## 玩家反馈原话：「它说我撞海我都不知道海在哪」「主要是看不到离海有多远」——
## 撞海那一刻玩家才发现自己贴着海面飞。
##
## 旧判据是"当前高度 < 420 **且机头没有上仰**（`forward().y < 0.05`）"，两个毛病：
##   ① **俯冲进海时它反而不报**：俯冲的机头朝下（`forward().y` 远小于 0）本该报，
##      可真正危险的是"平飞但正在往下掉"那一类 —— 旧写法对俯冲是没有概念的；
##   ② 报的时候只印三个字母不给数字，玩家还是不知道"还有多远"。
##
## 现在按**预测高度**判（和 AI 的避地预警同一个量：2.6 秒后会到哪，
## 见 `pull_up_clearance()`），并把那个数字直接印在告警上。
## 爬升时预测高度高于当前高度，告警自动消失 —— 不需要再额外判"机头朝向"。
func _draw_warnings() -> void:
	var y := size.y*0.22 if _compact_cockpit() and player.profile.id == SuitProfile.Id.NEUE_ZIEL else 130.0
	var cx := size.x * 0.5
	# 文案 / 字号 / 闪烁 / 行距**全部**来自上面的表，这里只负责摆位置。
	# 于是"字幕和语音是不是同一句"可以在测试里问 `warn_lines()`，
	# 不需要去读 `_draw()` —— `_draw()` 在无头环境里画不出东西。
	for row: Dictionary in warn_lines(_warn_state, _warn_clearance, _ground_word()):
		var st: Dictionary = WARN_STYLE[str(row["key"])]
		var flash := float(st["flash"])
		if flash <= 0.0 or int(_flash * flash) % 2 == 0:
			_text_center(Vector2(cx, y), str(row["text"]), int(st["fs"]),
				DANGER if bool(st["danger"]) else WARN, UILayout.WEIGHT_EMPH)
		y += float(st["step"])


func _draw_notices() -> void:
	var neue := _compact_cockpit() and player.profile.id == SuitProfile.Id.NEUE_ZIEL
	var y := size.y * (0.60 if neue else 0.66)
	for i in _notices.size():
		var n: Dictionary = _notices[i]
		var a: float = clampf(n["t"] / maxf(n["life"], 0.01), 0.0, 1.0)
		_text_center(Vector2(size.x * 0.5, y + i * (-24.0 if neue else 24.0)), n["text"], 17,
			Color(WARN.r, WARN.g, WARN.b, a))


# ============================================================ 第一人称座舱框（轮 20）
#
# 需求原文：「做一个第一人称模式，然后把第一人称模式的开关放到设置里面，
# 再加一个开关提醒：开启本模式会导致强烈的 3d 眩晕，是否还要开启？」
#
# ## 为什么"第一人称"需要 HUD 里多画一圈框
#
# FPV 下自机模型是**藏起来**的（理由见 `FlightBody.set_model_visible()`：
# 座舱眼位在头部壳内，而这些机体是 AI 扫描的单层壳，留着只会看到穿透碎片）。
# 于是画面上"没有自己"这件事必须有个解释 —— 否则玩家的第一反应是
# "模型没加载出来 / 我卡进机体里了"。一圈很淡的取景框 + 一行角标，
# 成本几乎为零，但把"这是座舱视角"钉死在画面上。
#
# ## 三个刻意的约束
#
# ⚠️ **① 贴屏幕边、不进内容区**：内缩取 `UILayout.MARGIN` 的**一半**，
#    比所有 HUD 元素的边界更靠外 —— 雷达 / 高度带 / 弹药块一个都压不到。
#
# ⚠️ **② 用 HUD 绿而不是警报橙**：这是"模式标识"，不是"警告"。
#    晕动症的警告已经在设置页过了一道门（`Stage.FPV_CONFIRM`），
#    战斗里再来一遍是噪音，而且会把真正的受击/失速告警稀释掉。
#
# ⚠️ **③ 只在设置里开着的时候画**：默认关 ⇒ 本函数对既有截图与像素测试
#    **逐位无影响**（`Settings.first_person` 默认 false，`_draw` 里那一行是空操作）。
func _draw_cockpit_frame() -> void:
	if is_instance_valid(_cockpit_3d) and _cockpit_3d.visible:
		return
	if not first_person_view() and not cockpit_eye:
		return
	var v := size
	if v.x <= 0.0 or v.y <= 0.0:
		return
	var inset := UILayout.MARGIN * 0.5
	draw_rect(Rect2(inset, inset, v.x - inset * 2.0, v.y - inset * 2.0),
		Color(HUD.r, HUD.g, HUD.b, 0.26), false, UILayout.LINE_STRUCT)
	# 角标放在**框与内容区之间那条缝里**（y = inset + 26 落在 MARGIN 之内），
	# 不与任何一块 HUD 抢位置。
	_text_center(Vector2(v.x * 0.5, inset + 26.0), "座舱视角", 14,
		Color(HUD.r, HUD.g, HUD.b, 0.60))


# ============================================================ 第一人称 · 全周天刻度导轨（轮 21）
#
# 需求原文：「记得做全周天 720° 无死角的刻度线导轨，横轨和竖轨，
# 不然机体转体一下导轨贴图就消失了。」
#
# ⇒ 要的**不是**"屏幕边上的一圈刻度"，而是以相机为球心的一整层**刻度天球**：
#   横轨（纬线圈，整圈 360°）与竖轨（经线大圆，整圈 360°，含天顶与天底）
#   交叉成网格 —— 朝哪看都必然有刻度，这就是那句"无死角"。
#
# ## 一个真正要紧的决定：刻度钉在**世界（地平线）**上，不是机身上
#
# ⚠️ 两条理由，别改错：
#
#   ① **只有世界系才有信息。** 若把刻度钉在机体上，相机与刻度刚性相连 ⇒
#      画面上的刻度**永远一动不动**（玩家滚转 90°，它纹丝不动），
#      那就是一张贴纸，读不出"我歪没歪"。而这恰恰是第一人称藏掉自机模型
#      （`FlightBody.set_model_visible()`）之后最缺的那样东西。
#   ② **只有世界系才解释得了用户那句话。** 刻度既然相对地平线固定，
#      机体一转它就在画面里流动；这时若只画一段（只画头顶半球、或只画正前方
#      ±60°），转过去就真的空了 —— 全周天覆盖正是那句话的解。
#
# ⇒ 平飞时它看着就是"座舱内壁上的一圈圈横向刻度"（地平线在视野中央、刻度静止），
#   一滚转整层刻度跟着转：既像座舱，又真的在报姿态。
#
# ## 三条刻意的约束
#
# ⚠️ **① 只在 `Settings.first_person` 时画**：默认关 ⇒ 对既有截图与像素测试
#    **逐位无影响**（与 `_draw_cockpit_frame()` 同一条规矩）。
# ⚠️ **② 高对比，但不抢戏。** 它铺满全屏、每帧都在动，所以三档亮度**只用来分层**；
#    颜色则必须是**白**（轮 22 用户实测：原来的青绿「有点看不到」）——
#    工程那套青绿是「信息色」，压在装饰层上根本读不出来；而地平线圈仍是最亮的一档，
#    因为它直接回答「地平线在哪」。
# ⚠️ **②' 每条刻度先垫一道暗边**（`RAIL_A_BACKDROP`）：白线压在亮天空 / 亮沙漠上会糊掉。
# ⚠️ **③ 四档亮度、两档线宽。** 地平线圈 / 主刻度（30° 的整数倍）/ 次刻度 / 轨线 ——
#    **分层全部由 alpha 承担**（0.90 / 0.58 / 0.32 / 0.24）；线宽只有 `UILayout`
#    那两档可用（工程铁律，别再加档 —— 加了 `suite_ui_style` 直接判 FAIL）。
#
# ## 几何全部落在纯函数上（本工程的铁律）
#
# `rail_dirs()` 只吐**方向**（单位向量），不吐屏幕坐标、不碰相机 ——
# 于是"网格覆盖全周天、没有洞"这件事可以**直接断言**（见 `suite_fpv`），
# 而不是靠人对着截图找哪里缺一块。球半径留在 `RAIL_R`，两者彻底解耦。

## 刻度天球的半径（米）。**取值无关紧要** —— 它只是投影源，屏幕坐标只取决于方向。
## 挑一个"离相机不远不近"的数就行：别撞近平面 1.2 m，也别跑到远平面 90000 m 外。
const RAIL_R := 400.0
## 竖轨（经线大圆）的**方位间隔**（度）：每 30° 一条 ⇒ 12 条，合起来正好绕满 360°。
const RAIL_MERIDIAN_DEG := 30.0
## 横轨（纬线圈）的**仰角间隔**（度）：每 15° 一圈 ⇒ 从 −75° 到 +75° 共 11 圈。
## ⚠️ 两端各留 15°：仰角 ±90° 处的"一圈纬线"退化成一个点，画不出东西；
## 那两点由经线自己盖上（经线本来就是穿过天顶与天底的完整大圆）。
const RAIL_PARALLEL_DEG := 15.0
## 同一条轨上相邻刻度的**角间隔**（度）。
const RAIL_TICK_DEG := 5.0
## 主 / 次刻度的**角长度**（度 —— 天球上的长度，不是像素）。
const RAIL_TICK_MAJOR_DEG := 3.0
const RAIL_TICK_MINOR_DEG := 1.4
## 主刻度的判定间隔（度）：这条刻度的仰角（经线）或方位（纬线）是它的整数倍 ⇒ 加长。
const RAIL_MAJOR_EVERY := 30.0
## ---- 配色（轮 22 · 用户实测反馈）----
##
## 需求原文：「全周天导轨的 UI 颜色和仪表盘的 UI 颜色都改一下，现在的 UI 颜色
## 有点看不到，改成白色等等显眼的颜色」。
##
## ⚠️ 所以这一层**故意不再复用 `HUD` 那套青绿**：`HUD` 的语义是「信息色」
## （谁在告警、谁在续力），而这一层是「座舱内壁上的机械刻度」——
## 它要的是**在任意背景上都读得出来**，跟 HUD 撞色反而不算问题。
##
## ⚠️ 两条被 `suite_ui_style` 判 FAIL 过的弯路，记在这里**别再走**：
##
##   ① **不许新建颜色常量。** 这一步最初给导轨开了 `RAIL` / `RAIL_BACKDROP`，
##      给台面开了 6 个 `DASH_*` —— 一共 8 个，闸门立刻报
##      「hud.gd 没有表外的颜色常量」+「颜色常量恰好 9 个（got=17）」
##      （`suite_ui_style.ALLOWED_COLORS` 只认那 9 个名字）。
##      ⇒ 取色一律走下面的 `deco_white()`（工程的白 `NEUTRAL`）+ 内联纯黑底。
##   ② **线宽只有 `UILayout` 那两档可用。** 当初给导轨单开 2.0 / 1.5 / 1.6
##      （理由是"0.5 px 的刻度看不到"），也被判 FAIL。**真因是颜色**（青绿 +
##      alpha 0.09），不是线宽 —— 换成白之后 0.5 px 一样读得出来。
##
## ⇒ **分层全部由 alpha 承担**：地平线圈 > 主刻度 > 次刻度 > 轨线；
##   线宽上地平线 / 主刻度走 `LINE_STRUCT`，次刻度 / 轨线走 `LINE_HAIR`。
const RAIL_A_HORIZON := 0.90
const RAIL_A_MAJOR := 0.58
const RAIL_A_MINOR := 0.32
## 垫底暗线的 alpha。⚠️ 白刻度压在亮天空 / 亮沙漠上会糊掉，所以每条刻度
## **先垫一道暗线再压白线** —— 与文字那套 `OUTLINE` 是同一个手法。
const RAIL_A_BACKDROP := 0.55


## 装饰层（全周天导轨 / 座舱仪表台）的**唯一取色通道**：把工程的白配上给定 alpha。
##
## ⚠️ 为什么不直接写 `Color(1.0, 1.0, 1.0, a)`：工程只有五个语义色，而「白」的
## 真源是 `NEUTRAL`（`suite_ui_style` 的色相聚类里它属于「无彩」那一档）。
## 从它派生就永远和主 HUD 的白是同一种白，也不会多出一个颜色常量（见上 ①）。
static func deco_white(a: float) -> Color:
	return Color(NEUTRAL.r, NEUTRAL.g, NEUTRAL.b, a)

## 刻度表的缓存。刻度是常量，每帧重算 1236 条纯属白烧 CPU。
static var _rail_cache: Array = []


## 天球上「方位 / 仰角」对应的**单位方向**。
##
## 约定（只影响刻度的相位，不影响覆盖）：方位 0° 指向 +Z，仰角 0° 在水平面上，+Y 是天顶。
static func rail_dir(az_deg: float, el_deg: float) -> Vector3:
	var az := deg_to_rad(az_deg)
	var el := deg_to_rad(el_deg)
	var ce := cos(el)
	return Vector3(ce * sin(az), sin(el), ce * cos(az))


## 刻度线该朝哪个方向**加长**（切线）。
##
## 规则一句话：**刻度线垂直于它所在的那条轨** ——
##   - 经线是竖着走的 ⇒ 它上面的刻度线横着长（沿方位方向）；
##   - 纬线是横着走的 ⇒ 它上面的刻度线竖着长（沿仰角方向）。
## 这样横竖轨的交叉处两组刻度才对得上（交叉成一个小十字，而不是两条斜线）。
static func rail_tick_tangent(az_deg: float, el_deg: float, meridian: bool) -> Vector3:
	var az := deg_to_rad(az_deg)
	if meridian:
		return Vector3(cos(az), 0.0, -sin(az))
	var el := deg_to_rad(el_deg)
	return Vector3(-sin(el) * sin(az), cos(el), -sin(el) * cos(az))


## 这条刻度算不算「主刻度」。`v_deg` 传经线的仰角、或纬线的方位。
##
## ⚠️ 用容差而不是 `== 0`：角度是"整数次乘 5°"累加出来的，浮点末位不保证是 0。
static func rail_is_major(v_deg: float) -> bool:
	var m := fposmod(absf(v_deg), RAIL_MAJOR_EVERY)
	return m < 0.001 or m > RAIL_MAJOR_EVERY - 0.001


## 拼一条刻度：`{"a", "b", "major", "horizon", "meridian"}`。
##
## ⚠️ `a` / `b` 是**从球心出去的方向**，不是位置 —— 乘多少半径由调用方决定（`RAIL_R`）。
static func _rail_seg(az: float, el: float, meridian: bool) -> Dictionary:
	var pick := az
	if meridian:
		pick = el
	var major := rail_is_major(pick)
	var len_deg := RAIL_TICK_MAJOR_DEG if major else RAIL_TICK_MINOR_DEG
	var t := rail_tick_tangent(az, el, meridian) * (deg_to_rad(len_deg) * 0.5)
	var d := rail_dir(az, el)
	return {
		"a": (d - t).normalized(),
		"b": (d + t).normalized(),
		"major": major,
		"horizon": (not meridian) and absf(el) < 0.001,
		"meridian": meridian,
	}


## 整层刻度天球的**全部刻度线**（纯函数，可逐条断言；每帧只算一次，见 `rail_dirs()`）。
##
## 规模（按出厂常量）：竖轨 12 条 × 37 点 = 444，横轨 11 圈 × 72 点 = 792，共 **1236** 条。
static func rail_dirs_build() -> Array:
	var out: Array = []
	# ---- 竖轨：方位每 RAIL_MERIDIAN_DEG 一条，每条从 −90° 竖到 +90°（穿过天顶与天底）----
	var n_mer := int(round(360.0 / RAIL_MERIDIAN_DEG))
	var half := int(round(90.0 / RAIL_TICK_DEG))
	for i in range(n_mer):
		var az := float(i) * RAIL_MERIDIAN_DEG
		for j in range(-half, half + 1):
			out.append(_rail_seg(az, float(j) * RAIL_TICK_DEG, true))
	# ---- 横轨：仰角每 RAIL_PARALLEL_DEG 一圈，每圈方位绕满 360° ----
	# 从 ∓(90 − step) 起、到 ±(90 − step) 止：正好跳过退化成一个点的天顶 / 天底。
	var n_par := int(round(180.0 / RAIL_PARALLEL_DEG)) - 1
	var n_az := int(round(360.0 / RAIL_TICK_DEG))
	for k in range(1, n_par + 1):
		var el := -90.0 + float(k) * RAIL_PARALLEL_DEG
		for m in range(n_az):
			out.append(_rail_seg(float(m) * RAIL_TICK_DEG, el, false))
	return out


static func rail_dirs() -> Array:
	if _rail_cache.is_empty():
		_rail_cache = rail_dirs_build()
	return _rail_cache


## ---- 轨线（连续线）----
##
## ⚠️ **刻度与轨线是两样东西，缺一不可。**
## 第一版只画了刻度（每 `RAIL_TICK_DEG` 一根小短杠），真机截图（轮 22）里
## 整片天球看起来就是**散落的小短杠**，读不出「横轨 + 竖轨的网格」——
## 用户要的是**导轨**，轨线本身必须画出来，刻度只是压在轨线上的节拍。
##
## ⚠️ 轨线**切成小段**而不是"整圈一条 polyline"：整圈提交就没法逐段做视野剔除，
## 一圈只要有一小段露在屏幕外就得把整圈画出去（背后那半圈会镜像着压到画面上）。
## 切成 `RAIL_ARC_DEG` 一段之后，`rail_visible_of()` 那套逻辑原封不动就能用。
const RAIL_ARC_DEG := 5.0
## 轨线的亮度（alpha）。比主刻度淡（它是背景网格），但比次刻度亮。
## 地平线圈仍是单独一档（最亮）—— 见 `_draw_cockpit_rails`。
## 线宽不用单独规定：它同次刻度一样走 `UILayout.LINE_HAIR`。
const RAIL_A_ARC := 0.24

static var _rail_arc_cache: Array = []


## 一条轨线段：`{"a", "b", "meridian", "horizon"}`（`a` / `b` 都是单位方向）。
static func _rail_arc(az0: float, el0: float, az1: float, el1: float,
		meridian: bool) -> Dictionary:
	return {
		"a": rail_dir(az0, el0),
		"b": rail_dir(az1, el1),
		"meridian": meridian,
		"horizon": (not meridian) and absf(el0) < 0.001,
	}


## 全部轨线段（纯函数）。规模：经线 12 条 × 36 段 + 纬线 11 圈 × 72 段 = **1224** 段。
static func rail_arcs_build() -> Array:
	var out: Array = []
	var half := int(round(90.0 / RAIL_ARC_DEG))
	var n_mer := int(round(360.0 / RAIL_MERIDIAN_DEG))
	for i in range(n_mer):
		var az := float(i) * RAIL_MERIDIAN_DEG
		for j in range(-half, half):
			var e0 := float(j) * RAIL_ARC_DEG
			out.append(_rail_arc(az, e0, az, e0 + RAIL_ARC_DEG, true))
	var n_par := int(round(180.0 / RAIL_PARALLEL_DEG)) - 1
	var n_az := int(round(360.0 / RAIL_ARC_DEG))
	for k in range(1, n_par + 1):
		var el := -90.0 + float(k) * RAIL_PARALLEL_DEG
		for m in range(n_az):
			var a0 := float(m) * RAIL_ARC_DEG
			out.append(_rail_arc(a0, el, a0 + RAIL_ARC_DEG, el, false))
	return out


static func rail_arcs() -> Array:
	if _rail_arc_cache.is_empty():
		_rail_arc_cache = rail_arcs_build()
	return _rail_arc_cache


## 视野锥剔除的**余弦阈值**（纯函数）。
##
## 拿屏幕**对角**方向的视野锥当界限 —— 那个方向最宽，用它才不会在四角漏掉刻度。
##
## ⚠️ `camera.fov` 的语义随 `keep_aspect` 而变（本工程没改过，是默认的"垂直"）——
## 但这里不必赌：`tan_v` / `tan_h` 谁大谁小都只会让锥**偏大**，
## 而偏大 = 多画几条（无害）、偏小 = 漏画（致命：那就成了用户说的"转过去刻度就没了"）。
## 末尾那 15° 是因为刻度线自身有长度（最长 3°），贴着屏幕边缘那几条也得保住。
static func rail_cos_limit(fov_deg: float, aspect: float) -> float:
	var tan_v := tan(deg_to_rad(fov_deg) * 0.5)
	var tan_h := tan_v * maxf(aspect, 0.01)
	var half_diag := atan(sqrt(tan_v * tan_v + tan_h * tan_h))
	return cos(minf(half_diag + deg_to_rad(15.0), PI))


## 当前朝向 + 视野下**该画出来的刻度**（纯函数，返回 `rail_dirs()` 的下标）。
##
## 抽成纯函数的理由不止"好测"：这样**「任何朝向都看得到刻度」**才是一条能断言的
## 事实（见 `suite_fpv._rails` 里那 160 个朝向的扫描），而不是靠人转着镜头找哪里是空的 ——
## 屏幕每帧都在动，空掉一片根本发现不了，而那正是用户提这个需求的原因。
static func rail_visible_of(list: Array, fwd: Vector3, fov_deg: float,
		aspect: float) -> PackedInt32Array:
	var cos_lim := rail_cos_limit(fov_deg, aspect)
	var out := PackedInt32Array()
	# ⚠️ 两趟而不是一趟：`cos_lim` 算一次就够，别放进循环里（每帧上千条）。
	for i in range(list.size()):
		var d: Dictionary = list[i]
		var da: Vector3 = d["a"]
		var db: Vector3 = d["b"]
		# 两个端点有一个落在锥里就留下：线段一半在内一半在外时，露出来的那半也该画。
		if fwd.dot(da) >= cos_lim or fwd.dot(db) >= cos_lim:
			out.append(i)
	return out


## 刻度线的可见下标（`rail_visible_of` 的便捷包装，刻度与轨线共用同一套剔除）。
static func rail_visible_indices(fwd: Vector3, fov_deg: float,
		aspect: float) -> PackedInt32Array:
	return rail_visible_of(rail_dirs(), fwd, fov_deg, aspect)


## 画出整层刻度天球（只读相机与设置，不碰玩家 —— 所以它能在阵亡后照画不误）。
##
## 剔除分两道，**顺序不能反**：
##   ① **视野锥**（`fwd·d < cos_lim` 就丢）——纯点积，一次砍掉约七成；
##   ② **相机前后**（`_visible`）——`unproject_position` 对身后的点也会返回坐标，
##      只靠坐标判断的话，背后那半层刻度会**镜像**着画到屏幕上。
func _draw_cockpit_rails() -> void:
	if not cockpit_has_graduations(): return
	if is_instance_valid(_cockpit_3d) and _cockpit_3d.visible:
		return
	if not first_person_view() and not cockpit_eye:
		return
	if camera == null or not is_instance_valid(camera):
		return
	var view := size
	if view.x <= 0.0 or view.y <= 0.0:
		return

	# ---- ① 视野锥预剔除（整段走纯函数 `rail_visible_indices()`）----
	var fwd := -camera.global_transform.basis.z.normalized()
	var aspect := view.x / maxf(view.y, 1.0)
	var idx := rail_visible_indices(fwd, camera.fov, aspect)
	var list := rail_dirs()

	var o := camera.global_position
	var c_horizon := deco_white(RAIL_A_HORIZON)
	var c_major := deco_white(RAIL_A_MAJOR)
	var c_minor := deco_white(RAIL_A_MINOR)
	var c_back := Color(0.0, 0.0, 0.0, RAIL_A_BACKDROP)
	var c_arc := deco_white(RAIL_A_ARC)

	# ---- ① 轨线（连续经线 / 纬线）先画：**没有它，刻度就只是散落的小短杠** ----
	# 真机截图（轮 22）里这一条是"看不出是导轨"的根因 —— 刻度只标出节拍，
	# 轨线才划出"轨"本身。
	var arcs := rail_arcs()
	for i in rail_visible_of(arcs, fwd, camera.fov, aspect):
		var ad: Dictionary = arcs[i]
		var wa2 := o + (ad["a"] as Vector3) * RAIL_R
		var wb2 := o + (ad["b"] as Vector3) * RAIL_R
		if not _visible(wa2) or not _visible(wb2):
			continue
		var is_h := bool(ad["horizon"])
		var pa2 := _project(wa2)
		var pb2 := _project(wb2)
		# ⚠️ 线宽**只有 `UILayout` 那两档**可用（工程铁律，绘制处的实参原文必须
		# 字面出现 `UILayout.LINE_HAIR` / `LINE_STRUCT` 之一）。垫底暗线固定
		# `LINE_STRUCT` —— 它比次刻度（`LINE_HAIR`）宽一档，于是白线四周露出一圈
		# 暗边；地平线圈两档都是 `LINE_STRUCT`，暗线被完全盖住（无害）。
		draw_line(pa2, pb2, c_back, UILayout.LINE_STRUCT, true)
		draw_line(pa2, pb2, c_horizon if is_h else c_arc,
			UILayout.LINE_STRUCT if is_h else UILayout.LINE_HAIR, true)

	# ---- ② 刻度压在轨线上 ----
	for i in idx:
		var d: Dictionary = list[i]
		# ---- ② 相机前后 ----
		var wa := o + (d["a"] as Vector3) * RAIL_R
		var wb := o + (d["b"] as Vector3) * RAIL_R
		if not _visible(wa) or not _visible(wb):
			continue
		var pa := _project(wa)
		var pb := _project(wb)
		# ⚠️ 先暗后亮：白刻度压在亮天空 / 亮沙漠上会糊掉，
		# 垫一道暗线才谈得上「任何背景都看得见」（与文字那套 `OUTLINE` 同源）。
		# 三档分层全在 alpha 上（0.90 / 0.58 / 0.32），线宽只有两档可选。
		draw_line(pa, pb, c_back, UILayout.LINE_STRUCT, true)
		if bool(d["horizon"]):
			draw_line(pa, pb, c_horizon, UILayout.LINE_STRUCT, true)
		elif bool(d["major"]):
			draw_line(pa, pb, c_major, UILayout.LINE_STRUCT, true)
		else:
			draw_line(pa, pb, c_minor, UILayout.LINE_HAIR, true)


# ============================================================ 第一人称 · 座舱仪表台（轮 21 · 造型重做 轮 22）
#
# 需求原文（轮 21）：「第一人称模式最下方屏幕仪表盘素材」+ 一张机战座舱参考图；
# 追问里补了两点：显示什么 =「123」（推力 / 姿态 / 座舱饰条三样都要），
# 铺多大 =「雷达补充到这里面」（雷达是这块台的**中央主屏**）。
#
# 需求原文（轮 22）：「这个仪表台还是要对着原剧截图形式再优化再像一点」+ 同一张参考图，
# 以及「全周天导轨的 UI 颜色和仪表盘的 UI 颜色都改一下……改成白色等等显眼的颜色」。
#
# ## 参考图里到底有什么（**照抄的是这五条**，别凭印象改）
#
#   ① **三块各自带厚框的独立模块**，彼此留缝、底边对齐；中央那块明显更高
#      （236 vs 186），左右两块接近**正方形**。不是一整条板 ——
#      这三条缝是「像不像」的第一眼来源。
#   ② 每块模块的四个角都是**切角**（倒角），不是圆角。
#   ③ 中央模块的顶边**中段抬高一级**（一个台阶）。参考图底边也有，
#      但这里只能往上凸：台底距屏底只有 12 px，往下会顶出屏幕。
#   ④ 中央屏内壁是**倒梯形（大箭头）轮廓 + 一排六边形铆钉 + 底边一排链式六边形**。
#   ⑤ 左右两块的内部是**圆形仪表盘**（双环 + 径向刻度 + 三角指针），
#      底边一排**小方点**。轮 21 那版是两根横条 —— 那正是「不够像」的主因。
#
# ## 与轮 21 那版的另外两处刻意改动
#
#   - 机体名从「雷达圆下方」搬到**雷达圆上方**（见 `_draw_model_tag`）：
#     台底那条边现在要放链式六边形带与刻度饰条，圆下方只剩 9 px。
#   - 顶部那条「装饰刻度带」改成**底部刻度饰条**（同一个函数 `_draw_dash_ticks`）：
#     顶部现在是台阶 + 铆钉行，再塞一条刻度带会挤成一团。
#
# ## 与既有 HUD 的分工（不重复、不打架）
#
# - 屏幕底部左右两角**已经被占死**：左下血条 + I 力场条，右下弹药栏。
#   所以台宽是**算出来的**（`dash_layout()`），窄屏时**收窄侧格**、不许往外顶。
# - 左格圆表读**「现在在哪一档」**（巡航 / 加力 / 冲刺 CD / 超级加速），
#   与左侧速度块下那条油门条（读「油门给了多少」）是同一根杆的两种表达。
# - 右格圆表读**滚转**，取 `attitude_readout()` 的 `horizon_roll_deg`，不另算一遍
#   —— 两处各算一份的话，总有一处会先被改成另一种算法。
#
