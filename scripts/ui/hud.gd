class_name FlightHUD
extends Control
## 全代码绘制的抬头显示器。没有任何 .tscn、没有 Label 节点、**不落地任何图片文件**，
## 一切都在 `_draw()` 里用 draw_line / draw_arc / draw_string 画出来。
##
## 唯一的例外是轮 32 加的那一张：中央屏剪影的**内部线稿**是运行时从源码里的 base64
## 解出来的 `ImageTexture`（见 `silh_lines.gd`）—— 它照样不往工程里放资源文件，
## 与 `world_builder.gd` 的云影 / 植被遮蔽贴图是同一条路。
##
## 布局参照 Ace Combat：
##   中央十字 = 机炮准星；小圆 = 速度矢量（FPM）；方框 = 目标；小圆圈 = 提前量
##   来袭飞弹 = **菱形框**（与目标框刻意不同形，见 `_threat_box()`）
##   左上 = 机体与难度；左中 = 空速；右中 = 高度；左下 = **机体血条 + I 立场血条**；
##   右下 = 武器；底部中央 = 雷达；顶部 = 告警
##
## I 立场单独一条、单独配色（青蓝），因为它是**独立且不可恢复**的资源：
## 光束打上去机体不掉血但护盾在掉，玩家必须能从 HUD 上直接看出"盾还剩多少"。

const ThirdPersonHUD := preload("res://scripts/ui/third_person_hud.gd")

const HUD := Color(0.58, 1.0, 0.74)
const HUD_DIM := Color(0.40, 0.78, 0.58, 0.72)
const HUD_FAINT := Color(0.40, 0.78, 0.58, 0.30)
const WARN := Color(1.0, 0.74, 0.22)
const DANGER := Color(1.0, 0.30, 0.26)
const NEUTRAL := Color(0.92, 0.95, 1.0)
const IFIELD := Color(0.42, 0.86, 1.0)
const IFIELD_DIM := Color(0.30, 0.60, 0.78, 0.55)

const RADAR_RANGE := 6500.0
## 雷达的半径与圆心。**`_draw_radar()` 与 `_draw_model_tag()` 共用同一份** ——
## 机体编号要摆在雷达正下方，两处各写一份的话，改版式时一定会对不上
## （而那属于"看着只是差几像素、其实是两个真源"的那类坑）。
const RADAR_RADIUS := 86.0


## ---- ★63-10 · D3b 放大镜（屏幕右上角那块「对方机体的近景」）----
#
## 用户原话：「在屏幕的空白处有放大镜效果（在对方机体 0.4 km 处设置相机，来显示对方）」
#
## ⚠️ 它是**全工程第二台 `Camera3D`、也是唯一的 `SubViewport`**（在此之前全工程只有
## `chase_camera.gd` 那一台、且一个 `SubViewport` 都没有）。
## ⇒ 显式接主世界：`_mag_vp.world_3d = get_viewport().world_3d`。
## ⚠️ 这一句是**显式化**、不是「不写就黑」：`SubViewport` 默认**继承父视口的世界**。
## 轮 63-10 的负对照 `nc_noworld` 真机实测：摘掉它 ⇒ 镜面**结构照旧**
## （标准差 31.86 对 31.61 · 横向边缘 7.8k 对 7.9k · 88.7% 像素逐位相同）、推帧代价也照旧
## （2.30 对 2.23 ms）。留着它是因为它把「镜里是哪一份世界」写成**可断言的显式事实**，
## 不吃引擎的继承行为（`suite_magnifier` 第二节钉它）。
const MAG_SIZE := Vector2i(240, 135)
## 相机摆在「目标机 → 自机」连线上、目标机**前面** `MAG_CAM_DIST` 米处。
## 单位是米，与工程其余部分同一套（`400.0` = 用户原话的 0.4 km）。
const MAG_CAM_DIST := 400.0
## 放大镜相机的**垂直** `fov`。
##
## ⚠️ 与主相机（`base_fov 68`）差得很远是**刻意的**：0.4 km 上用 68° 看一台 20 m 的机体，
## 它在画面里只占 `20 / (2·400·tan(34°)) ≈ 3.7%` —— 那不叫放大镜，叫「更小的一张全屏」。
## 取 6° ⇒ 画面高 `2·400·tan(3°) ≈ 41.9 m` ⇒ 一台 20 m 机体占 **≈ 48%**（这条算式就是它的判据）。
const MAG_CAM_FOV := 6.0
## 最高30 Hz的时间节流；兼容计数常量表示60 Hz时约每两帧刷新。
const MAG_PUSH_EVERY := 2
const MAG_REFRESH_SECONDS := 1.0 / 30.0
## 放大镜右端与高度带之间的留白。
const MAG_PAD := 12.0
## 放大镜与「附近敌机列表」末行之间的留白。
const MAG_GAP_BELOW_LIST := 12.0

## 放大镜的底座（`_build_magnifier()` 里建一次）。
var _mag_vp: SubViewport
## 放大镜的专属相机。
var _mag_cam: Camera3D
## 诊断计数器；实际刷新由 _mag_elapsed 按时间控制。
var _mag_frame := 0
var _mag_elapsed := 0.0
var _mag_was_active := false
var _mag_render_suspended := false
const MAG_FADE_MIN := 0.05
var _mag_intro_age := 0.36
var _mag_focus := preload("res://scripts/ui/magnifier_focus.gd").new()
var _mag_opacity := 1.0
var _mag_ui_overlap := false
var _mag_collecting := false
var _mag_ui_scale := 1.0
var _mag_avoid_rect := Rect2()


static func radar_center(view: Vector2) -> Vector2:
	return Vector2(view.x * 0.5, view.y - 118.0)

## ---- 中央屏其余两种内容（轮 31：M 键切换雷达 / 机体剪影 / 等高线地形图）----
#
## 机体剪影的**颜色档**（用户轮 31 指定）：I 立场 > 血量四档。
##
## ⚠️ 「橙色」**不是第 10 个颜色常量**：调色板契约钉着 `hud.gd` 里恰好 9 个
## `const X := Color(...)`（`suite_ui_style` 扫源码数），所以它是 `WARN → DANGER`
## 的**派生** —— 沿"黄 → 红"这条线往里走 55%，落点就是橙。
## 这与"白 / 灰一律从 `NEUTRAL` 派生"（`deco_white`）是同一条规矩。
const SILH_ORANGE_MIX := 0.55
## 剪影的**底边**锚在圆内血条上方（半径的倍数）。锚底边而**不是**锚中心：
## 五台机的总高不同（见 `SILH_H_BY_KEY`），锚中心会让"脚"在换机体时上下乱跑。
## `0.53` 到血条顶 `0.60` 留 `0.07 r ≈ 6 px` —— 与轮 30 / 轮 31 那两处是同一份余量。
const SILH_BOTTOM_K := 0.53
## 每台机允许的**总高**（单位 = 圆半径 `r`）。**在真实轮廓点上二分算出来的，不是拍的**：
## 底边锚在 `圆心 + SILH_BOTTOM_K·r`，要求最远轮廓点 ≤ `0.92 r`（留 8% —— 贴着圆边
## 会被外圈那道 1 px 的弧切掉一块）。下标顺序见 `silhouette_key()`。
##
## ⚠️ 为什么不取**统一**高度：一次只看得见一台机，所以"五台一样大"并**不可观测**，
## 而"把圆填满"是看得见的 —— 统一取最紧那台（佩涅罗佩）的 `1.24` 时，窄机体
## （核心形态 0.58 宽高比）两侧会空出一整圈。
const SILH_H_BY_KEY: Array = [1.40, 1.24, 1.43, 1.44, 1.24, 0.89]
## ⚠️ 第 6 项（下标 5）= 阿利宙斯**巡航态**（轮 35 新增）：翼展平铺的横形，总高由「最远轮廓点
## ≤ 0.92 r」二分算出来 = **0.89 r**（不是拍的，也不是跟常态化共用 1.43）。
## 兜底件（没有线稿的机体）在 `SILH_UV` / `SILH_H_BY_KEY` 里的下标。
const SILH_KEY_FALLBACK := 4
## 外轮廓**底色填充**的不透明度。
##
## ⚠️ 轮 32 从 `0.30` 一路降到 `0.06`：机主先看完成品说「不要那么剪影，还是要有点
## 线稿在里面的」，改到 0.10 之后又说「还是没有很线稿啊」—— 因为那版贴图**没画上去**
## （见 `SilhLines` 的注释）；贴图修好后又发现它**自带明暗底**（墨最密处 0.32），
## 再叠 0.10 的全局填充等于两层底，屏上又往实心块靠。所以这里只留 0.06。
##
## 留这一层**不是为了体积感**，而是"亮背景上仍然看得出机体在哪"：中央屏底盘只有
## 55% 不透明，云层 / 亮地面会透上来，而结构线本身只有 1 px 宽，没有底就飘在背景里。
const SILH_FILL_A := 0.06
## 内部线稿的数据与解包（按**真实显示尺寸**烘出来的 4 bit alpha 掩码）。
##
## ⚠️ 走 `preload` 而**不是** `class_name`：全局类名要等 import 才会进
## `.godot/global_script_class_cache.cfg`，而写 / 跑这套流水线全程**不开编辑器**
## —— 新建脚本带 `class_name` 会让无头跑直接 `Parse Error`
##（`Identifier "SilhLines" not declared in the current scope`）。
const SilhLines := preload("res://scripts/ui/silh_lines.gd")
## 等高线地形图：圈数 / 每圈采样点数 / 相位系数（世界米 → 弧度）。
##
## ⚠️ 4 圈 × 48 段 = 192 点，在 86 px 半径里刚好读出"一层一层的山"；
## 再多就糊成一团（与雷达那 60 条刻度是同一条"密度上限"经验）。
const CONTOUR_N := 4
const CONTOUR_SEG := 48
## 地形随飞行滚动的系数。`0.002` 不是随手写的：它让"飞 500 m"大约推过一个
## 等高圈 —— 目视上是"地形在底下走"，而不是"等高线在抖"。
const CONTOUR_PHASE_K := 0.002


## 机体剪影的颜色（用户轮 31 指定）。**纯函数**，于是分档线能被单测钉住。
##
## 优先级：**I 立场 > 血量**。盾还在时，机体本身挨不挨打都还是"有壳"状态 ——
## 这正是 I 立场要单独一条血条、单独一套配色的全部理由（见文件头那段）。
static func silhouette_color(hp_ratio: float, ifield_up: bool) -> Color:
	if ifield_up:
		return IFIELD
	if hp_ratio > 0.8:
		return HUD
	if hp_ratio > 0.5:
		return WARN
	if hp_ratio > 0.3:
		return WARN.lerp(DANGER, SILH_ORANGE_MIX)
	return DANGER


## 把"以总高 100 单位设计"的归一化顶点表，缩放到 `h` 高、`c` 居中。
##
## 单独抽出来是为了**只写一份换算**：下面几张表加起来近千个点，就地各乘一次的话，
## 以后改 `h` 的语义（比如从"总高"改成"半高"）得改近千处，漏一处就是一个飘到圆外
## 去的部件。轮 32 把剪影换成真实线稿之后（4 台 × 145~197 点）更是非这样不可。
static func scale_pts_100(table: Array, c: Vector2, h: float) -> Array:
	var k := h / 100.0
	var org := c - Vector2(0.0, h * 0.5)   # `v = 0` 那一行的屏幕 y
	var out: Array = []
	for part in table:
		var pts := PackedVector2Array()
		for uv in part:
			pts.append(org + Vector2(float(uv[0]), float(uv[1])) * k)
		out.append(pts)
	return out


## 兜底剪影：**手写的 13 块**（正视图）。古斯塔夫 / 梅萨这类**没有线稿**的机体用它。
##
## ⚠️ 为什么兜底件是"多块拼装"而不是"一条闭合轮廓"：正视图的**腿间空隙**在单条轮廓
## 里必须回折，稍微动一个数就会自交成一条裙子；拆成部件之后每块都是简单多边形，
## 改哪块都不影响别块。真实线稿那边不必这样 —— 它是**扫描**出来的，
## 外轮廓本身就带着那些凹口（描图工具保证不自交）。
##
## ⚠️ 顶点表是**手写的、不用 for 生成**：哪个角往哪儿斜只有看成品图才知道，
## 循环生成只会把它变成一个对称的八边形 —— 那不像机体。
