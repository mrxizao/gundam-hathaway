## `operating = true` ⇒ 倒计时**暂停中**，这时候必须在读数旁边**明说**为什么不动 ——
## 否则玩家看着一条不走的条会以为卡住了（而它恰恰是"你正在操作"的正常表现）。
static func intermission_timer_text(left: float, operating: bool) -> String:
	var s := "%.1f s" % maxf(left, 0.0)
	return s + "（操作中 · 暂停）" if operating else s


func _draw_model_tag() -> void:
	if _messer_cockpit(): return
	if _compact_cockpit() and player.profile.id in [SuitProfile.Id.SAZABI,SuitProfile.Id.FULL_ARMOR_TB]: return
	if _compact_cockpit() and player.profile.id == SuitProfile.Id.NEUE_ZIEL:
		_text(Vector2(24.0,size.y*0.275),player.profile.model_name,11,HUD_DIM)
		return
	# ★★ 发射段（马夫蒂火箭）：**同一处、同一版式**，只换数据源。
	# 老板 2026-09-30 晚：「另外开机体的UI系统也搬过来」—— 机名标签是其中一块。
	#
	# ⚠️ 这里早退是**必须**的：下面第一行就是 `player.profile`，
	# 而发射段 `player` 是 `null` ⇒ 不早退就是 `_draw()` 里炸 Nil（报错刷屏、
	# 画面只是"少一块"，最难定位的一类）。
	# ⚠️⚠️ 判据取 **`cockpit_only`**（"这一层是不是发射段的座舱"），
	# **不是** `_from_rocket()`（"这一帧有没有读数"）—— 后者在
	# `cockpit_only` 刚打开、`_sync_cockpit_hud()` 还没喂数的那一帧是假的，
	# 而按它走就会掉进下面那行 `player.profile`。
	if cockpit_only:
		_draw_model_tag_rocket()
		return
	var p := player.profile
	var center := radar_center(size)
	# 机体编号（用户点名要留的那一项）。
	# ⚠️ 第一人称下**搬到雷达圆上方**（轮 22）：台底那条边现在要放链式六边形带
	# 与刻度饰条，圆下方只剩 9 px（两行字挤不下），而圆上方有 17 px 空档。
	# 颜色也换成台面白 —— 与导轨、仪表台同一套；原来那点淡绿在座舱里看不清。
	# ⚠️ 轮 32 补：这一行**只够放它自己**。下面的 `lines` 一旦也画在这里
	# 就会叠字（阿利宙斯的 "RX-94 MASS PRODUCTION ν GUNDAM" 被形态行
	# 整行盖掉）—— 所以状态行改画到台面顶边之上，见 `fp_tag_row_y()`。
	if first_person_view():
		_text_center(center - Vector2(0, RADAR_RADIUS + 8.0), p.model_name, 13,
			deco_white(DASH_A_TXT))
	else:
		_text_center(center + Vector2(0, RADAR_RADIUS + 18.0), p.model_name, 13, HUD_DIM)

	var lines: Array = []
	if p.form_count > 1:
		# 变形冷却也印出来：4 秒冷却不显示，玩家按 Z 没反应只会以为按键坏了
		var cd := "  冷却 %.1fs" % player.form_cooldown if player.form_cooldown > 0.0 else ""
		lines.append(["形态 %s%s" % [p.form_name(), cd],
			WARN if player.form_cooldown > 0.0 else p.accent])
		if player.in_transform():
			lines.append(["外壳剥离中…", DANGER])
		elif p.transform_hull_ratio > 0.0 and p.form == SuitProfile.ArizeusForm.CORE_NU:
			lines.append(["核心形态 · 无导弹 / 军刀", WARN])
		elif p.transform_hull_ratio > 0.0 and player.hp_ratio() <= p.transform_hull_ratio + 0.12:
			lines.append(["外壳即将剥离", WARN])
	if Game.match_mode == Game.MatchMode.TRAINING:
		lines.append(["训练模式   靶机 %d / %d 击破" % [Game.training_targets_down,
			Game.training_targets_total], WARN])
	elif Game.match_mode == Game.MatchMode.CHALLENGE and Game.active_challenge != null and not chapter_three_active():
		var enc := Game.active_challenge
		# ★ 轮 55：「波次 1 / 0」那句话的问题见 `challenge_progress_text()`。
		lines.append([challenge_progress_text(str(enc.title), Game.challenge_wave,
			ChallengeScript.wave_count(enc), Game.challenge_wave_remaining), WARN])
	elif Game.match_mode == Game.MatchMode.LAN:
		lines.append(["局域网对战 · %s" % Game.lan_status, WARN])

	var left := player.unlockable_seconds_left()
	if left > 0.0:
		lines.append(["无法被锁定  %4.1fs" % left, IFIELD])
	# ⚠️ 第一人称下这几行**不画在罩框条上**：那里只有一行的位置，
	# 而那一行已经被机体编号占了（轮 22）。原来两处共用
	# `center + (0, -RADAR_RADIUS - …)`：编号在 −8、状态行首条在 −10 —— 基线只差 2 px，
	# 两串居中字直接叠印（实测：阿利宙斯的机号被形态行整行盖掉）。
	# 现在整体上移到台面顶边之上（见 `fp_tag_row_y()`），
	# 编号那一行与轮 31 交付图**逐位不变**。
	for i in lines.size():
		var row_y: float = center.y - RADAR_RADIUS - 10.0 - 16.0 * float(i)
		if first_person_view():
			row_y = fp_tag_row_y(size) - FP_TAG_PITCH * float(i)
		_text_center(Vector2(center.x, row_y), str(lines[i][0]), 14,
			lines[i][1] as Color)


## ★★ 发射段（马夫蒂火箭）的机型标签：**箭名 + 阶段 + 「余 N s」**。
##
## 三行全部来自 `cockpit_readout`（造它们的是纯函数 `LaunchScript.dash_readout()`）
## —— 本文件依旧一个字段都不读 `RocketBody`。
##
## ## 摆位**一律按第一人称那一档**（雷达圆上方 + 台面顶边之上），不看 `Settings.first_person`
## ① 发射段本来就是**全周天座舱**（`cockpit_only` 就是它的眼位）——
##    老板要的正是"用全周天驾驶舱的代码"，而全周天那一档的摆位就是圆上方 + 台面上边；
## ② 圆**下方**在座舱仪表台里只剩 9 px（见 `_draw_model_tag()` 轮 22 那段），
##    非第一人称那一档摆到那儿会被台面底边整个吃掉 —— 而玩家不会知道漏了什么。
##
## ⚠️ **与 `_draw_dash_rocket_center()` 的分工：那块盘只画盘**，箭名与状态行归这里。
## 两处都画的话就是同一串字在屏上叠两遍，而位置（`center − (0, r + 8)`）**逐位相同**，
## 叠起来的表现是"字变粗" —— 看不出是错，也不会报任何错。
func _draw_model_tag_rocket() -> void:
	var center := radar_center(size)
	# 第一行：箭名（与机体第一人称那一行**同一位置、同一字号、同一颜色**）。
	_text_center(center - Vector2(0.0, RADAR_RADIUS + 8.0),
		str(cockpit_readout.get("name", "")), 13, deco_white(DASH_A_TXT))
	# 状态两行（阶段 / 剩余时间）走与机体第一人称**同一个真源** `fp_tag_row_y()` ——
	# 自己另算一个 y 的话，"台面顶边之上"这条约束就有两份答案。
	var row := fp_tag_row_y(size)
	_text_center(Vector2(center.x, row),
		str(cockpit_readout.get("leg", "")), 14, WARN)
	_text_center(Vector2(center.x, row - FP_TAG_PITCH),
		str(cockpit_readout.get("note", "")), 14, WARN)


func _difficulty() -> Difficulty:
