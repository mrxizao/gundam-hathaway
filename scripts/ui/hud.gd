## `is_instance_valid(player)` 一变成假就整个 return，**结算画面会连同 HUD 一起消失** ——
## 表现就是"结算画面秒没"，而且**只在自己阵亡时出现**（敌机死时玩家还在，所以看不出来）。
## 这个问题是用户先观察到的，线索就是"只有玩家死才秒没"。
var _result := {}


## 在结算阶段开始的那一刻把要显示的数据抄下来。
## 由 main 在玩家/敌机阵亡时调用 —— 那时 player 一定还活着。
##
## `outcome` 决定算不算任务评价：`PENDING` 是开局那次（INTRO 也要显示机体名），
## 那时没有胜负，评价块留空。
func capture_result(outcome := MissionRating.Outcome.PENDING) -> void:
	if player == null or not is_instance_valid(player):
		return
	var hp_ratio := player.hp_ratio()
	var ifield := player.ifield_hp
	var ifield_max := player.ifield_max
	_result = {
		"suit": player.profile.display_name,
		"hp": player.hp,
		"max_hp": player.max_hp,
		"hp_ratio": hp_ratio,
		"ifield": ifield,
		"ifield_max": ifield_max,
		"has_ifield": player.has_ifield(),
		"rifle_count": player.rifle_count,
		"rifle_max": player.profile.rifle_count,
		"funnel_max": player.profile.funnel_count,
		"rating": {},
		# 波次用时也在这里定格：结算画面读的是快照，不是还在跑的 Game。
		"wave_times": Game.challenge_wave_times.duplicate(),
		# ★63-24：无限强化演习的**两个数字**（到达波次 / 存活时长）。
		#
		# ⚠️ 同样必须在这里**定格**：玩法上"玩家唯一能带走的就是这两个数"（设计 §10），
		# 而结算画面比战斗活得久 —— 回头读 `Game.endless_wave` 的话，
		# 万一将来有人给"重开一局"加一条"不关结算页就地重开"的路，那两个数就会被清成 0。
		# 与上面 `wave_times` / 下面 `sally` 是同一条规矩：**一切取自快照**。
		"endless_wave": Game.endless_wave,
		"endless_time": Game.endless_elapsed,
		"endless_kills": Game.kills,
	}
	if outcome != MissionRating.Outcome.PENDING:
		_result["rating"] = MissionRating.evaluate(
			rating_stats(outcome, hp_ratio, ifield, ifield_max))
		# ★ 轮 C：**赢没赢**单独存一位。不从 `rating["graded"]` 反推 ——
		# 那是"有没有字母"的意思，与"这一局赢没赢"是两件事（失败时 `graded` 为假，
		# 但"没字母"还可能来自别的原因）。结算页的提示行要按**输赢**分家（§6.7）。
		_result["win"] = outcome == MissionRating.Outcome.WIN
	# ★ 轮 C：剧情模式的军资结算快照。**空字典 = 非剧情模式** ⇒ 结算页不显示军资那一行，
	# 于是四种现有模式的结算画面**逐像素不变**（DESIGN §9.4 的硬约束）。
	_result["sally"] = Game.sally_result.duplicate()


## 任务评价的输入。放在 HUD 上（而不是 main 里）是因为**唯一权威的那份快照就在这里** ——
## 分两处取数，结算画面就会出现"评价用的血"和"列表里的血"不一样。
##
## static 是为了让测试不必先造一个 HUD 实例就能断言取数是否正确。
static func rating_stats(outcome: int, hp_ratio: float, ifield: float,
		ifield_max: float) -> Dictionary:
	var win := outcome == MissionRating.Outcome.WIN
	var pr := MissionRating.progress(Game.match_mode, win,
		Game.training_targets_down, Game.training_targets_total,
		Game.challenge_killed, Game.challenge_total,
		Game.kills, Game.squad_units_per_side)
	return {
		"mode": Game.match_mode,
		"win": win,
		"downed": pr["downed"],
		"total": pr["total"],
		"units": pr["total"],
		"hp_ratio": hp_ratio,
		"ifield": ifield,
		"ifield_max": ifield_max,
		"elapsed": Game.elapsed,
		"accuracy": Game.accuracy(),
		"shots": Game.shots_fired,
	}


## 结算页底部提示行。**按输赢与模式分家**。
##
## `sally` 为空 ⇒ 四种现有模式的文案**一字不改**（README 里那条
## 「再战一局已按用户要求撤掉」仍然成立）。
##
## ★ 剧情模式给的**不是**"再战一局"—— 那是"回菜单重新选机体与难度"。
## §6.7 要的是**失败后就地重开同一关**（同一台机 / 同一张图 / 同一套 profile）。
## 两者是不同的东西，所以这里是**另加一个键**，不是把老行为改回来。
##
## **纯函数**（`static` 的理由同 `rating_stats()`：测试不必先造一个 HUD 实例）。
static func result_hint(sally: Dictionary, back_label := "回主菜单") -> String:
	if sally.is_empty():
		return "Enter / Esc  %s" % back_label
	if not bool(sally.get("win", false)):
		return "R 重来   ·   Enter / Esc  %s" % back_label
	return "Enter / Esc  %s" % back_label


## ★ 轮 C：剧情模式结算页那一行「军资 +N」。
##
## ## 空字典 ⇒ 空串 ⇒ **不画这一行**（§9.4 的硬约束：四种现有模式的结算画面逐像素不变）
##
## ## 为什么塞在一行里，而不是另起一块
## 720p 下两栏的框底已经贴住提示行了（`result_layout()` 里那句"框高 436 是死数"），
## 右栏最后一行基线离框底只剩 8 px —— **纵向一格都腾不出来**。
## 而箱底与提示行之间那 46 px 的间隔里本来就空着，于是这一行就落在**提示行同一基线**上：
##   左端 = 军资（本行），中间 = 操作提示（`result_hint()`）。
##
## ## 三个数各说各的
##   `delta`  = **实际到账**（首通 = 全额；重打只补差额；失败 = 0，见 `CampaignScript.settle()`）
##   `reward` = 这一局**值多少** —— 只在两者不等时补出来，否则那个数跟 `+N` 一模一样、白占宽度
##   `next`   = 通关顺带点亮的下一关
##
## ⚠️ 失败时的"击坠依然算数"落在 `reward`（`KILL_CREDITS`）里，但 `settle()` 在失败时
## **不入账** —— 那是轮 0 已落并有断言的既有行为（第三章的必败战怎么处理留给它自己），
## 这里只如实显示 `+0`，不替它改账。
static func sally_text(sally: Dictionary) -> String:
	if sally.is_empty():
		return ""
	var reward := maxi(int(sally.get("reward", 0)), 0)
	var delta := maxi(int(sally.get("delta", 0)), 0)
	if not bool(sally.get("win", false)):
		return "军资 +0　·　未达成"
	var out := "军资 +%d" % delta
	if delta < reward:
		out += "（最好 %d）" % reward
	var nxt := str(sally.get("next", ""))
	if not nxt.is_empty():
		out += "　·　解锁 %s" % nxt
	return out


func setup(p: PlayerController, cam: ChaseCamera, l: LockOnSystem) -> void:
	player = p
	camera = cam
	lock = l
	if p != null and not p.notice.is_connected(push_notice):
		p.notice.connect(push_notice)
	# 开局也抓一次快照：INTRO 画面要显示机体名，那会儿还没结算。
	# 这也是"快照而不是实时读"的好处 —— 两个阶段共用同一份数据，不会有一处忘了取。
	capture_result()


func push_notice(text: String, seconds := 1.4) -> void:
	_notices.append({"text": text, "t": seconds, "life": seconds})
	if _notices.size() > 5:
		_notices.pop_front()


func _process(delta: float) -> void:
	_time += delta
	_flash += delta
	_target_vitals.tick(lock.target if is_instance_valid(lock) else null, delta)
	_tick_third_person_motion(delta)
	# 辅助飞行那一行提示的倒计时（见 `_system_event_timer`）。
	# 边沿触发：**只有事件文字变了才重新计时**，于是"接管 → 交还"各显示一次，
	# 而同一件事持续着的那几秒里不会一直刷新（不然它会永远挂在屏幕上）。
	if player != null and is_instance_valid(player) and player.has_method("assist_state"):
		var ev := str(player.assist_state().get("event", ""))
		if ev != _system_event_seen:
			_system_event_seen = ev
			_system_event_timer = SYSTEM_EVENT_SECS
	_system_event_timer = maxf(_system_event_timer - delta, 0.0)
	for n: Dictionary in _notices:
		n["t"] = n["t"] - delta
	_notices = _notices.filter(func(n): return n["t"] > 0.0)
	if player != null and is_instance_valid(player):
		player.update_lock_feedback()
		# 新手教学导演（1.2 第二十六轮）：每帧喂一次 —— 完成当前步才推进。
		# 必须挂在 `_process`（真实输入时钟），不能挂 `_draw`（一帧可能画多次）。
		if Game.tutorial_mode:
			if _tutor == null:
				_tutor = TutorialDirectorScript.new()
				_tutor.start(player.profile)
			_tutor.poll(player, delta)
		# 批 2：告警状态每帧算一次 —— **播语音必须挂在 `_process` 上**，不能挂在 `_draw()` 里。
		# `_draw()` 受 `can_draw()` 与帧率影响，"一次事件"的语义放在那里会漏播。
		_tick_warnings(delta)
	elif cockpit_only:
		# ★ 发射段（马夫蒂火箭）：**没有机体，但有告警**。
		# `player` 要到 `_launch_match()` 才建，而发射演出走的是 `_begin_launch()`
		# ⇒ 这一段里 `player` 是 null，上面那一支整支走不到。
		# 状态由 `main` 每帧塞进 `launch_warn`（火箭的真实读数），这里只做仲裁。
		_tick_launch_warnings(delta)
	else:
		_warn_state = no_warn_state()
		_warn_held = ""
	# 轮 E：通讯每帧推一次。
	#
	# ⚠️ 它**在这个 if/else 之外** —— 与 `queue_redraw()` 同一条理由：
	# 玩家阵亡后电台还要把最后一句说完（"打完了"那一刻恰恰最需要台词），
	# 挂在玩家分支里等于自己一死、屏幕就永远静音。
	if comms != null:
		comms.tick(delta)

	# ★63-10 · D3b：放大镜的摆位与推帧。
	# ⚠️ 必须在 `queue_redraw()` **之前** —— 它自己会按需要再补一次重画。
	_tick_magnifier_fade(delta)
	_tick_magnifier(delta)
	queue_redraw()


# ============================================================ 绘制入口

## `_draw` 的入口守卫：**只看相机**，不看玩家。
##
## 抽成方法是为了能被测试直接断言 —— "玩家阵亡后结算画面秒没"这个 bug 的本质就是
## 绘制入口因为玩家对象被释放而整个关掉了。玩家相关的那批座舱 HUD 在 `_draw` 里单独判断。
func can_draw() -> bool:
	return camera != null and is_instance_valid(camera)


## The cockpit renderer stays intact; the AC-inspired layout is third-person only.
var _third_person_motion := ThirdPersonHUD.new()
var _third_person_motion_player_id := 0

func _tick_third_person_motion(delta: float) -> void:
	if not uses_third_person_hud() or not is_instance_valid(player):
		_third_person_motion.reset_motion()
		_third_person_motion_player_id = 0
		return
	var identity := player.get_instance_id()
	if identity != _third_person_motion_player_id:
		_third_person_motion.reset_motion()
		_third_person_motion_player_id = identity
	_third_person_motion.tick_motion(player.global_transform.basis, delta, Settings.cam_motion_scale())

func _draw_endless_intensity() -> void:
	if EndlessIntensityHUD.active(self):
		EndlessIntensityHUD.draw(self)

func uses_third_person_hud() -> bool:
	return not first_person_view() and not cockpit_only


func _draw_third_person() -> void:
	_begin_magnifier_ui()
	if player != null and is_instance_valid(player):
		ThirdPersonHUD.draw(self)
		_draw_threat_layer()
		_draw_allies()
		_draw_beacons()
		_draw_lock_group()
		_draw_warnings()
		if Game.tutorial_mode:
			_draw_tutorial_block(110.0)
	_draw_comms()
	_draw_endless_intensity()
	_draw_magnifier()
	# ★63-24：间歇轮三选一。⚠️ **第三人称这条路也必须接** ——
	# `uses_third_person_hud()` 在 `not Settings.first_person` 时为真，也就是**默认视角**；
	# 只在 `_draw()` 那条里接的话，玩家在默认视角下**永远看不到选卡面板**
	#（而切一次 F1 就出现了 —— 这种"按键/视角相关的灵异现象"最难查）。
	_draw_endless_intermission()
	_draw_phase_overlay()


func _draw() -> void:
	# Settlement owns the entire screen; no cockpit, combat HUD or trim on top.
	if Game.phase in [Game.Phase.WIN,Game.Phase.LOSE]:
		_draw_phase_overlay()
		return
	if not can_draw():
		return
	preload("res://scripts/ui/psycho_combat_overlay.gd").draw(self)
	if uses_third_person_hud():
		_draw_third_person()
		return
	if not cockpit_only and is_instance_valid(player) and player.profile.id==SuitProfile.Id.PSYCHO_ZAKU_TB:
		preload("res://scripts/ui/psycho_zaku_hud.gd").draw(self)
		return
	# 全周天刻度导轨（轮 21）：**画在最底层** —— 它是「座舱内壁」，
	# 后面每一块 HUD（雷达底盘 / 血条底 / 面板外框）都该压在它上面。
	# ⚠️ 它**不依赖 player**（纯相机 + 设置），所以放在玩家分支之外 ——
	# 与末尾的 `_draw_cockpit_frame()` 同一条规矩：层级不该随玩家对象存亡跳变。
	_draw_cockpit_rails()
	# ★★ 发射段（马夫蒂火箭）：**只画全周天座舱这一层**，画完就返回。
	#
	# 老板 2026-09-30：「**你驾驶舱做的好丑，直接用全周天驾驶舱的代码吧**」+
	# 「**正常驾驶模式的UI也使用啊，比如燃料和雷达啊高度和时速这些显示器，
	# 不需要屏幕左上角那么多白色文字了**」。
	#
	# ⇒ 那一版给火箭单独建的 3D 舱（含一块 7 行白字的 `Label`）整套删掉，
	# 换成**同一份**全周天代码：导轨（`_draw_cockpit_rails`，已经在上面画了）
	# + 仪表台（下面） + 取景框。读数走 `cockpit_readout` 那份字典。
	#
	# ⚠️ 早退是**刻意**的、不是省事：发射段没有机体，下面每一块战斗 HUD
	#（准星 / 威胁层 / 目标框 / 雷达 / 敌机列表 / 血条……）都会去读 `player` 的
	# `fm` / `profile` / `contacts()`，一读就是空指针或一屏红叉。
	if cockpit_only:
		# ★★ 老板 2026-09-30 晚第四改：
		# > 「**在现状没有白字的情况下，把正常驾驶机体的高度指示器和速度指示器
		# >   都拿过来**」
		# ⇒ 那一版给火箭单独做的两块**圆表**（`AIRSPEED` / `ALTITUDE` 表盘）撤掉，
		# 这一支改画**同一套**正常驾驶用的仪表面：
		#   · 左中 = `_draw_speed_block()`（时速数字 + KM/H + 油门条 + 燃料槽）
		#   · 右侧 = `_draw_altitude_tape()` + `_draw_altitude_block()`（高度带 + 读数块）
		#   · 下中 = `_draw_cockpit_dash()` 的中央格（雷达底盘 + 箭名 + 状态行）
		# ⚠️ 前三个函数原本**整段读 `player`**，而发射段 `player` 是 `null`
		# ⇒ 它们各自多了一个 `_from_rocket()` 分支。漏改任意一处，就是在
		# `_draw()` 里炸 `Nil` —— 报错刷屏，而画面只是"少一块"，最难定位的一类。
		#
		# ⚠️ 顺序：先仪表、后取景框。取景框是**压在一切之上**的那一层
		#（与 `_draw()` 末尾那条注释同一条规矩）。
		#
		# ★★ 2026-09-30 晚第五改：老板「**另外开机体的UI系统也搬过来（不搬雷达系统）**」
		# ⇒ 再补三块（与机体那一支**同一个函数**，各自多一个 `_from_rocket()` 分支）：
		#   · `_draw_model_tag()` —— 箭名 + 阶段 + 「余 N s」（火箭真有的读数）
		#   · `_draw_attitude()`  —— 姿态仪（姿态源换成 `cockpit_basis`）
		#   · `_draw_warnings()`  —— 告警（状态由 `_tick_launch_warnings()` 维护）
		# ⚠️ 不搬的（**火箭上没有那些数据，接上去就是恒零空框**）：
		# 准星 / 威胁层 / 目标框 / 友军标识 / 信标 / 锁定组 / **雷达系统**
		#（圆盘底盘由 `_draw_dash_rocket_center()` 画，但它**不接** contacts —— 见那个函数）。
		_draw_cockpit_dash()
		_draw_model_tag()
		_draw_speed_block()
		_draw_altitude_tape()
		_draw_altitude_block()
		_draw_attitude()
		_draw_warnings()
		_draw_cockpit_frame()
		return
	# 座舱 HUD 只在自己还有机体时画；
	# 但**结算叠加层必须与玩家对象是否存活无关** —— 详见 _result 的注释。
	# 这正是"自己阵亡时结算画面秒没"的根因：残骸 2.2 秒后释放，
	# 而这里原来是 `if not is_instance_valid(player): return`，一 return 什么都画不出来。
	if player != null and is_instance_valid(player):
		# 座舱仪表台（轮 21）：**最先画** —— 它是"座舱外壳"，
		# 后面每一块 HUD（雷达 / 机体名 / 目标框 / 告警）都该压在它上面。
		_draw_cockpit_dash()
		_draw_reticle()
		# 第十五轮：威胁层（飞弹框 / TTI / 当前选中 / 自动拦截状态）从 `_draw_aim_cursor()`
		# **搬出来**单独调用 —— 那个函数在 `not cursor_seen` 时会整个 return，
		# 而手柄玩家没有鼠标。详见 `_draw_threat_layer()` 的注释。
		_draw_threat_layer()
		_draw_flight_path_marker()
		_draw_target()
		# 阵营系统（2026-09-22）：友军 3D 标识 —— 抬头世界里僚机不再是隐形的，
		# 雷达绿点管"全局在哪"，菱形管"眼前在哪"。⚠️ 单独一个函数，
		# 不挂在 `_draw_target()` 末尾（那条路没有目标就整个 return）。
		_draw_allies()
		# 只读信标的 HUD 目标指示（运输仓 / 内阁成员所在酒店）。
		# ⚠️ 它们走的是**只读通道**（各自的专属组），不进锁定系统的候选表 ——
		# 所以「锁得上」与「打不到」两件事互不牵制，详见 `_draw_beacons()` 的注释。
		_draw_beacons()
		# 批 1（多目标锁定）：组内 1/2 号成员各补一个细框 + 圈号。
		# ⚠️ 单独一个函数、而不是挂在 `_draw_target()` 末尾：那个函数在"没有主目标"
		# 时会整个 return，而"组里有 2 个却只画 1 个框"这种偏差一旦混进去极难查。
		_draw_lock_group()
		_draw_radar()
		_draw_model_tag()
		_draw_speed_block()
		# 批 2：高度带紧贴屏幕右缘，高度块的数值列已经让开了带宽
		# （`UILayout.alt_value_right()`），所以这两块的先后不影响结果。
		_draw_altitude_tape()
		_draw_altitude_block()
		_draw_health_block()
		# 批 2：姿态仪**常驻**（屏幕中下偏左）。⚠️ 它挂在这个分支里、
		# 但**与 `cursor_seen` 无关** —— 手柄玩家没有鼠标，挂在那个门后等于没有姿态仪。
		_draw_attitude()
		_draw_weapon_block()
		# 第十六轮：左上角辅助驾驶状态 + 右上角敌机列表。
		# ⚠️ 放在**这个分支里、但不依赖 `cursor_seen`** —— 手柄玩家没有鼠标，
		# 而这两块恰恰是给手柄看的（详见 `_draw_assist_block` 的注释）。
		#
		# 1.2 第二十五轮：左上角改成**纵向游标**（每块把自己的底部交出来，下一块接着排）。
		# 原来每块自己写死 `assist_top + 22`，于是"辅助驾驶开着时的第二行"和"踏板行"
		# 只差 2 px、两条字叠在一起 —— 而辅助驾驶开着是常态。
		# 用户这一轮的反馈正是同一类问题（"屏幕中心太多字了，放到辅助驾驶下面之类的"）：
		# 中央那五行**系统状态**搬到了这个游标的末端（`_draw_system_block`）。
		var corner_y := _draw_assist_block()
		corner_y = _draw_pedal_block(corner_y)
		corner_y = _draw_system_block(corner_y)
		# 新手教学（1.2 第二十五轮）：接在同一个游标后面 ——
		# 位置由上面几块的实际高度决定，所以不会和它们叠在一起。
		if Game.tutorial_mode:
			_draw_tutorial_block(corner_y)
		_draw_contact_list()
		_draw_warnings()
	_draw_notices()
	# 轮 E：电台 / 字幕 / 对白 / 播报。
	# ⚠️ 排在**阶段叠加层之前** —— 叠加层（简报 / 发射 / 结算）是"停一屏"的东西，
	# 通讯是打起来才有的。放它后面的话，结算页上会浮着最后一句电台台词。
	_draw_comms()
	_draw_endless_intensity()
	# ★63-10 · D3b 放大镜：屏幕右上角那片「对方机体的近景」。
	# ⚠️ 排在阶段叠加层**之前** —— 叠加层（简报 / 发射 / 结算）是「停一屏」的东西，
	# 放大镜是打起来才有的；放它后面会浮在结算页上。
	_draw_magnifier()
	# ★63-24：间歇轮三选一。⚠️ 排在**结算叠加层之前** —— 玩家被打死的那一帧
	# 绝不能让选卡面板浮在结算页上面（`_draw_endless_intermission()` 自己也会
	# 因为 `endless_phase == OVER` 而早退，两道保险）。
	_draw_endless_intermission()
	_draw_phase_overlay()
	# 第一人称的座舱框**画在最后**（压在所有 HUD 元素之上）：它是取景框，
	# 而其它元素贴着**内容区**边界、它贴着**屏幕**边，两者本来也不重叠。
	_draw_cockpit_frame()



# ============================================================ 放大镜（★63-10 · D3b）

## 放大镜**这一刻该不该显示**。抽成方法是为了能被测试直接断言 —— 不靠画像素。
##
## 四条与用户原话一一对应：
##   ① 「辅助驾驶模式下自动开启」⇒ 模式门直接复用 D3a 那道 `aim_assist_enabled()`
##      （**只有一处真源**：再写一个自己的开关就会造出「辅助开着、放大镜没开」这种状态）；
##   ② 「光束步枪」⇒ 没枪时镜里没有意义；
##   ③ 「对方机体」⇒ 没有锁定对象就没有「对方」；
##   ④ 发射段（`cockpit_only`，那时 `player` 是 null）与结算后（残骸已释放）都不画。
func magnifier_active() -> bool:
	if _mag_vp == null:
		return false
	if cockpit_only or not visible or not is_inside_tree():
		return false
	if player == null or not is_instance_valid(player):
		return false
	if lock == null or lock.target == null:
		return false
	if not is_instance_valid(lock.target) or not lock.target.alive:
		return false
	if player.rifle_count <= 0:
		return false
	return player.aim_assist_enabled()


## 放大镜在屏幕上的矩形。
##
## 位置是**算出来的、不是拍的**：屏幕右侧从上到下依次是「附近敌机列表」
##（`corner_layout()` 里的 `top` 起、最多「标题 + 号牌槽 + 其余」那么多行）
## 和「高度带」（紧贴右缘、宽 `UILayout.ALT_TAPE_W`）。
## ⇒ 唯一算得出空白的落点 = **列表下方、高度带左侧**。
## 判据断的是「这个矩形与那两块都不相交」，不是「它等于某个坐标」——
## 后者在换分辨率 / 加一行名单时必然过期。
static func magnifier_rect(view: Vector2) -> Rect2:
	var s := Vector2(MAG_SIZE)
	var g := corner_layout(view)
	# 列表行数：1 行标题 + 号牌槽 + 至多 1 行「其余 N 架 · Tab 循环」。
	var rows := 1 + PlayerController.CONTACT_KEYS.size() + 1
	var y: float = float(g["top"]) + rows * CONTACT_ROW_STEP + MAG_GAP_BELOW_LIST
	# 右端让开高度带：`alt_tape_rect()` 是高度带的**真源**，
	# 不在这里手算 `view.x - MARGIN - ALT_TAPE_W`（那是第二处真源，改一处必错）。
	var right: float = UILayout.alt_tape_rect(view).position.x - MAG_PAD
	return Rect2(Vector2(right - s.x, y), s)


## 见 `_ready()` 调用点。
func _build_magnifier() -> void:
	if _mag_vp != null:
		return
	if not is_inside_tree():
		return
	_mag_vp = SubViewport.new()
	_mag_vp.name = "MagnifierViewport"
	_mag_vp.size = Vector2i(192,108) if Settings.magnifier_quality==0 else MAG_SIZE
	_mag_vp.positional_shadow_atlas_size = 0
	_mag_vp.msaa_3d = Viewport.MSAA_DISABLED
	_mag_vp.use_taa = false
	# 默认**关着**：由 `_tick_magnifier()` 按时间节流点一次 `UPDATE_ONCE`。
	_mag_vp.render_target_update_mode = SubViewport.UPDATE_DISABLED
	# 显式接主世界（见 MAG_SIZE 上方注释：引擎默认就继承，这一句是显式化、防回退）。
	_mag_vp.world_3d = get_viewport().world_3d
	add_child(_mag_vp)
	_mag_cam = Camera3D.new()
	_mag_cam.name = "MagnifierCamera"
	_mag_cam.fov = MAG_CAM_FOV
	_mag_cam.cull_mask = preload("res://scripts/ui/magnifier_focus.gd").LAYER
	_mag_cam.near = 1.0
	# 目标机可能远在几十 km 外 —— 主相机那个 far 值抄过来的话，
	# 超出部分会被裁掉 = 镜里只剩背景（而画面看起来「只是没对准」）。
	_mag_cam.far = 60000.0
	_mag_vp.add_child(_mag_cam)
	var source := get_viewport().world_3d.environment
	if source != null:
		var lightweight := source.duplicate() as Environment
		lightweight.ssao_enabled = false
		lightweight.ssil_enabled = false
		lightweight.ssr_enabled = false
		lightweight.sdfgi_enabled = false
		lightweight.volumetric_fog_enabled = false
		lightweight.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
		lightweight.ambient_light_color = Color(0.45, 0.52, 0.68)
		lightweight.ambient_light_energy = maxf(lightweight.ambient_light_energy, 0.6)
		_mag_cam.environment = lightweight


## 只绘制当前目标，以时间节流到最高30 Hz；低帧率时不补画历史帧。
##
## ⚠️ 不显示时必须显式写 `UPDATE_DISABLED`，而不是「不推就算了」：
## `SubViewport` 挂在树上就一直「可见」，默认档 `UPDATE_WHEN_VISIBLE` 会**每帧**渲染一次全场景
## —— 于是性能判据（开/关帧时差 ≤ 1.0 ms）直接红，而画面上完全看不出差别。
func _tick_magnifier(delta: float = 1.0 / 60.0) -> void:
	if _mag_vp == null:
		return
	if not magnifier_active():
		_mag_vp.render_target_update_mode = SubViewport.UPDATE_DISABLED
		_mag_frame = 0
		_mag_elapsed = 0.0
		_mag_was_active = false
		_mag_render_suspended = false
		_mag_intro_age = 0.0
		_mag_focus.clear()
		return
	if not _mag_was_active:
		_mag_was_active = true
		_mag_intro_age = 0.0
	_mag_intro_age = minf(_mag_intro_age + maxf(delta, 0.0), preload("res://scripts/ui/magnifier_intro.gd").DURATION)
	_mag_frame += 1
	# Keep the 5% portrait and its fade animation, but stop invisible 3D refresh work.
	if uses_third_person_hud() and _mag_opacity <= MAG_FADE_MIN + 0.00001:
		_mag_vp.render_target_update_mode = SubViewport.UPDATE_DISABLED
		_mag_elapsed = 0.0
		_mag_render_suspended = true
		_mag_focus.clear()
		return
	if _mag_render_suspended:
		# Refresh the current target immediately on recovery, with no catch-up burst.
		_mag_elapsed = 1.0 / Settings.magnifier_hz()
		_mag_render_suspended = false
	_mag_elapsed += maxf(delta, 0.0)
	var refresh := 1.0 / Settings.magnifier_hz()
	if _mag_elapsed + 0.000001 < refresh:
		return
	_mag_elapsed = maxf(_mag_elapsed - refresh, 0.0)
	if _mag_elapsed >= refresh:
		_mag_elapsed = fmod(_mag_elapsed, refresh)
	_mag_focus.sync(lock.target)
	_mag_vp.size = Vector2i(192,108) if Settings.magnifier_quality==0 else MAG_SIZE
	_aim_magnifier_at(lock.target)
	_mag_vp.render_target_update_mode = SubViewport.UPDATE_ONCE


## 把放大镜相机摆到目标机前方 `MAG_CAM_DIST` 处并看向它。
func _aim_magnifier_at(tgt: FlightBody) -> void:
	_mag_focus.sync(tgt)
	var eye := player.global_position
	var tp := tgt.global_position
	var dir := eye - tp
	if dir.length_squared() < 1.0:
		return
	var monitor_distance := MAG_CAM_DIST * (1.0 if uses_third_person_hud() else 1.3)
	if tgt.profile != null and tgt.profile.id in [SuitProfile.Id.GP03D,SuitProfile.Id.NEUE_ZIEL]:
		# Fit the 140 m MA at any view angle without rendering a larger viewport.
		var diagonal := tgt.model_bounds.size.length()
		monitor_distance = maxf(monitor_distance,diagonal*0.58/tan(deg_to_rad(_mag_cam.fov*0.5)))
	_mag_cam.global_position = tp + dir.normalized() * monitor_distance
	var up := Vector3.UP
	var look := _mag_cam.global_position.direction_to(tp)
	# ⚠️ 视线与 up 平行时 `look_at()` 会**报错并保持原朝向**。
	# 这不是假想：俯冲打地面目标时「自机—目标」连线可以接近竖直。
	# 兜底换成 `FORWARD` —— 判据 5 量的是「相机→目标」的夹角，换 up 不改那个夹角。
	if absf(look.dot(up)) > 0.999:
		up = Vector3.FORWARD
	_mag_cam.look_at(tp, up)


# Screen-space overlap excludes the magnifier's own drawing and decorative rails.
func _begin_magnifier_ui() -> void:
	_mag_ui_overlap = false
	_mag_collecting = uses_third_person_hud() and magnifier_active()
	_mag_ui_scale = float(ThirdPersonHUD.layout(size)["scale"])
	_mag_avoid_rect = ThirdPersonHUD.magnifier_rect(size).grow_individual(0, 18 * _mag_ui_scale, 0, 0)


func _magnifier_ui_rect(rect: Rect2, logical := false) -> void:
	if not _mag_collecting or _mag_ui_overlap:
		return
	var scale_factor := _mag_ui_scale if logical else 1.0
	var screen_rect := Rect2(rect.position * scale_factor, rect.size * scale_factor)
	_mag_ui_overlap = _mag_avoid_rect.intersects(screen_rect.grow(2), true)


func _magnifier_text_rect(pos: Vector2, text: String, fs: int, logical := false) -> void:
	if not _mag_collecting or text.is_empty():
		return
	var extent := _font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, fs)
	_magnifier_ui_rect(Rect2(pos - Vector2(0, _font.get_ascent(fs)), extent), logical)


func _magnifier_enemy_rect(foe: FlightBody) -> Rect2:
	if camera == null or not is_instance_valid(camera) or not is_instance_valid(foe) or not foe.alive:
		return Rect2()
	var projected := Rect2()
	var found := false
	for i in 8:
		var world := foe.global_transform * foe.model_bounds.get_endpoint(i)
		if not _visible(world):
			continue
		var point := _project(world)
		if not found:
			projected = Rect2(point, Vector2.ZERO)
			found = true
		else:
			projected = projected.expand(point)
	return projected.grow(3) if found else Rect2()


func magnifier_blocked(mouse_position: Vector2) -> bool:
	var rect := ThirdPersonHUD.magnifier_rect(size).grow_individual(0, 18 * _mag_ui_scale, 0, 0)
	if rect.has_point(mouse_position) or _mag_ui_overlap:
		return true
	if player == null or not is_instance_valid(player):
		return false
	for unit: Node3D in Game.live_hostiles_of(player):
		var foe := unit as FlightBody
		if foe != null:
			var bounds := _magnifier_enemy_rect(foe)
			if bounds.has_area() and rect.intersects(bounds, true):
				return true
	return false


static func magnifier_opacity_step(opacity: float, blocked: bool, delta: float) -> float:
	var target := MAG_FADE_MIN if blocked else 1.0
	var duration := 0.5 if blocked else 1.0
	return move_toward(clampf(opacity, MAG_FADE_MIN, 1.0), target, 0.95 * maxf(delta, 0.0) / duration)


func _tick_magnifier_fade(delta: float) -> void:
	if not uses_third_person_hud() or not magnifier_active():
		_mag_opacity = 1.0
		_mag_ui_overlap = false
		return
	_mag_opacity = magnifier_opacity_step(_mag_opacity, magnifier_blocked(get_local_mouse_position()), delta)


func _draw_magnifier() -> void:
	_mag_collecting = false
	# Full Armor uses the existing target camera in the upper right physical monitor.
	if first_person_view() and is_instance_valid(player) and player.profile.id == SuitProfile.Id.FULL_ARMOR_TB: return
	if not magnifier_active():
		return
	var third_person := uses_third_person_hud()
	if not third_person:
		preload("res://scripts/ui/cockpit_magnifier.gd").draw(self, _mag_vp.get_texture())
		return
	var rect := ThirdPersonHUD.magnifier_rect(size) if third_person else magnifier_rect(size)
	var tint: Color = ThirdPersonHUD.DIM if third_person else (_cockpit_readouts.DIM if _compact_cockpit() else HUD_DIM)
	var opacity := _mag_opacity if third_person else 1.0
	var intro: float = preload("res://scripts/ui/magnifier_intro.gd").progress(_mag_intro_age)
	opacity *= smoothstep(0.0, 0.32, intro)
	tint.a *= opacity
	# 先画面、后外框：框压在画面之上。反过来的话，画面边缘那圈同色像素会把 1 px 的框
	# 吃掉一段 —— 真机上表现为「框缺一个角」，而代码上两行都写着。
	draw_texture_rect(_mag_vp.get_texture(), rect, false, Color(1, 1, 1, opacity))
	draw_rect(rect, tint, false, UILayout.LINE_STRUCT)
	preload("res://scripts/ui/magnifier_intro.gd").overlay(self, rect, intro, false, _mag_opacity)
	var tgt: FlightBody = lock.target
	var d := player.global_position.distance_to(tgt.global_position) / 1000.0
	var title := "放大镜 · %s %.1f km" % [tgt.display_name, d]
	var title_at := Vector2(rect.position.x, rect.position.y - 6.0)
	var outline := OUTLINE
	outline.a *= opacity
	draw_string_outline(_font, title_at, title, HORIZONTAL_ALIGNMENT_LEFT, -1, 12,
		UILayout.outline_for(-1), outline)
	draw_string(_font, title_at, title, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, tint)


# ============================================================ 准星
#
# 1.1 起屏幕上有**两个**方向标记，各代表一件事（用户的两条要求分别对应一个）：
#   1. **屏幕中心的小十字** = 机头指向（`aim_forward()` 的退路）。
#      机头只由键盘/手柄操纵，鼠标碰不到它；
#   2. **跟着鼠标的准星** = 光束步枪与火神炮的**弹道方向**（`FlightBody.aim_dir`），
#      同时它也是"把光标罩到敌机身上就选中锁定"的那个光标。
# 于是"鼠标不影响视角、但要决定打哪儿"这件事在画面上是一眼看明白的：
# 十字不动、准星跟着手跑。

## **新手教学面板**（1.2 第二十五轮静态清单 → 第二十六轮**按键逐步引导**）。
##
## 用户原话：「新手教程关要有按键引导教学，玩家按下按键触发对应之后，
## 才提示下一步。」
##
## 画法（导演是 `TutorialDirector`，`_process` 里每帧喂）：
##   - 标题带进度（第 N / 共 M 步）；
##   - 已完成的步骤只留**最近 3 条** ✓ 存根（更早的收进一行计数）——
##     否则教学后期整块面板全是历史记录，把当前步挤出屏幕；
##   - **当前步骤**是最大最亮的一行："现在就做这个"；
##   - 下一步的提示**一概不画** —— 玩家完成当前步之后才见得到它（本次需求的字面义）；
##   - 全部完成（`done`）→ 一行完成态收尾。
##
## ## 两件必须守住的
##
## ⚠️ **① 只有 `Game.tutorial_mode` 才画**：普通打靶时多一列字只是噪音，
##    而打靶是老玩家常来的地方。
## ⚠️ **② 步骤是数据驱动的**（按机体字段裁剪，见 TutorialDirector）：
##    写死的话会让"没有军刀的机体"去练挥刀、"没有导弹的机体"去练全弹发射。
func _draw_tutorial_block(y0: float) -> float:
	# ⚠️ **不能写成三元 + null**（`var p := 条件 ? player.profile : null`）：
	# 一侧是 `null` 时推断出来的类型是 Variant，于是下一行 `p.tutorial_steps()`
	# 变成"值的类型未定" → **整个 hud.gd 编译不过**（实测报的就是
	# `Parse Error: Cannot infer the type of "steps" variable`，
	# 然后所有 HUD 静态函数一起变成 "Nonexistent function"）。
	# 本文件下端早就记过同类坑（"三元表达式不能直接赋给带类型标注的变量"），
	# 这里换成最朴素的两步写法 —— 显式标类型 + 早退。
	var p: SuitProfile = null
	if player != null and is_instance_valid(player):
		p = player.profile
	if p == null:
		return y0
	if _tutor == null:
		# 兜底：`_process` 还没轮到（或玩家后挂进来）时也能画出第一步。
		_tutor = TutorialDirectorScript.new()
		_tutor.start(p)
	var x := UILayout.content_left(size) if size.x > 0.0 else 24.0
	var y := y0 + 6.0
	if _tutor.done:
		_text(Vector2(x, y), "【新手教学 · 完成】自由练习 —— 靶机是无限血的，随便打",
			15, WARN)
		return y + 20.0
	# ⚠️ `_tutor` 是 preload 的无类型脚本（RefCounted），属性链全返回 Variant ——
	# `:=` 推不出类型会直接编译失败（本文件头记过同款坑），所以这里全部显式标类型。
	var total: int = _tutor.steps.size()
	_text(Vector2(x, y), "【新手教学 · 第 %d / %d 步】" % [_tutor.idx + 1, total],
		15, WARN)
	y += 20.0
	# ---- 已完成：✓ 存根（暗色小字，只留最近 3 条）----
	var show_from: int = maxi(int(_tutor.idx) - 3, 0)
	if show_from > 0:
		_text(Vector2(x, y), "（前 %d 步已完成）" % show_from, 12, Color(0.5, 0.58, 0.68))
		y += 16.0
	for i in range(show_from, _tutor.idx):
		var done_text := str(_tutor.steps[i]["text"])
		var colon := done_text.find("：")
		if colon > 0:
			done_text = done_text.substr(0, colon)
		_text(Vector2(x, y), "✓ " + done_text, 12, Color(0.5, 0.64, 0.56))
		y += 16.0
	# ---- 当前步骤：最大最亮的一行 ----
	# ⚠️ 下边界**不能借用菜单的 `HELP_TOP`**（那是 `main_menu.gd` 的常量，
