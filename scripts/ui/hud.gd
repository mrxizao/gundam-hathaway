## 仪表台的版式（纯函数，可逐条断言 —— 见 `suite_fpv`）。
##
## 返回 `{"rect": 整台, "center": 中央格, "left": 左格, "right": 右格}`。
##
## ⚠️ 屏幕不够宽时它**收窄侧格**，而不是往外顶 —— 那两个方向是血条与弹药栏的地盘。
## 这条约束是可断言的（`rect.position.x >= view.x * 0.5 - DASH_EDGE_CLEAR`）。
##
## ⚠️ 这里是**格子**不是**模块**：模块还要在格子里留缝、侧格还要变矮，见 `dash_modules()`。
static func dash_layout(view: Vector2) -> Dictionary:
	var cx := view.x * 0.5
	var min_half := DASH_CENTER_W * 0.5
	var half_max := maxf(cx - DASH_EDGE_CLEAR, min_half)
	var half := clampf(DASH_HALF_W, min_half, half_max)
	var bottom := view.y - DASH_BOTTOM_PAD
	var top := bottom - DASH_H
	var rect := Rect2(cx - half, top, half * 2.0, DASH_H)
	var cw := minf(DASH_CENTER_W, rect.size.x)
	var side_w := maxf((rect.size.x - cw) * 0.5, 0.0)
	return {
		"rect": rect,
		"center": Rect2(cx - cw * 0.5, top, cw, DASH_H),
		"left": Rect2(rect.position.x, top, side_w, DASH_H),
		"right": Rect2(cx + cw * 0.5, top, side_w, DASH_H),
	}


## 三个**模块**矩形：格子内缩留缝 + 侧格变矮且**底边与中央对齐**。
##
## 纯函数 ⇒「侧格更矮」「三块底边齐」「互不重叠」「窄窗下侧格宽 ≥ 0」都能直接断言。
static func dash_modules(lay: Dictionary) -> Dictionary:
	var g := DASH_GAP * 0.5
	var c: Rect2 = lay["center"]
	var bottom := c.end.y
	var out: Dictionary = {}
	out["center"] = Rect2(c.position.x + g, c.position.y,
		maxf(c.size.x - DASH_GAP, 0.0), c.size.y)
	for key: String in ["left", "right"]:
		var cell: Rect2 = lay[key]
		var w := maxf(cell.size.x - g, 0.0)
		var x: float = cell.position.x if key == "left" else cell.end.x - w
		var h := minf(DASH_SIDE_H, maxf(bottom - cell.position.y, 0.0))
		out[key] = Rect2(x, bottom - h, w, h)
	return out


# ---- 形状（全是纯函数：点数 / 夹取 / 包含关系都能断言，绘制里一行几何都不现算）----

## 圆角半径的夹取：超过半边长就夹到半边长（否则四个角会交叉成"蝴蝶结"）。
static func _corner_clamp(rect: Rect2, r: float) -> float:
	return clampf(r, 0.0, minf(rect.size.x, rect.size.y) * 0.5)


## 一个角的圆弧采样（**含**两端点 ⇒ `n + 1` 个点）。
##
## `a0` / `a1` 是**屏幕角**（0 = 正右、顺时针为正 —— 屏幕 y 向下）。
static func _corner_arc(c: Vector2, r: float, a0: float, a1: float,
		n: int) -> PackedVector2Array:
	var out := PackedVector2Array()
	for i in range(n + 1):
		var a := deg_to_rad(lerpf(a0, a1, float(i) / float(n)))
		out.append(c + Vector2(cos(a), sin(a)) * r)
	return out


## 四个圆角，顺序 **右上 → 右下 → 左下 → 左上**（顺时针，屏幕坐标）。
##
## ⚠️ 相邻两段圆弧的**首末点不在同一个位置**，中间那条直边是 `draw_polyline`
## 自己连出来的 —— 这正是想要的：圆角之间就该是直边。
static func _round_corners(rect: Rect2, rr: float, n: int) -> PackedVector2Array:
	var out := PackedVector2Array()
	out.append_array(_corner_arc(Vector2(rect.end.x - rr, rect.position.y + rr),
		rr, -90.0, 0.0, n))
	out.append_array(_corner_arc(Vector2(rect.end.x - rr, rect.end.y - rr),
		rr, 0.0, 90.0, n))
	out.append_array(_corner_arc(Vector2(rect.position.x + rr, rect.end.y - rr),
		rr, 90.0, 180.0, n))
	out.append_array(_corner_arc(Vector2(rect.position.x + rr, rect.position.y + rr),
		rr, 180.0, 270.0, n))
	return out


## 圆角矩形顶点表（顺时针，闭合靠 `draw_polyline` 自己连回首点）。
##
## 点数 = `4 * (seg + 1)`。轮 24 用它取代了上一版的**切角**矩形 ——
## 参考图里三块屏的四个角都是圆的。
static func round_rect_pts(rect: Rect2, r: float,
		seg := DASH_CORNER_SEG) -> PackedVector2Array:
	return _round_corners(rect, _corner_clamp(rect, r), maxi(seg, 1))


## 圆角矩形 + **顶边中段抬高一级**（中央模块用）。
##
## 为什么要这个台阶：参考图里中央屏的顶边不是一条直边，中段凸起一级 ——
## 那一级正是它看起来像「一块装上去的仪表面板」而不是「一个矩形框」的来源。
## ⚠️ 台阶**只往上**（往下会顶出屏幕：台底距屏底只有 12 px）。
##
## 点数 = `4 * (seg + 1) + 4`（多出来的是顶边那四个折点）。
static func round_rect_step_pts(rect: Rect2, r: float, step: float, frac: float,
		seg := DASH_CORNER_SEG) -> PackedVector2Array:
	var n := maxi(seg, 1)
	var rr := _corner_clamp(rect, r)
	var k := minf(rr, rect.size.x * 0.2)
	var cx := rect.position.x + rect.size.x * 0.5
	var hw := rect.size.x * clampf(frac, 0.0, 1.0) * 0.5
	var s := maxf(step, 0.0)
	var out := _round_corners(rect, rr, n)
	# 末点是左上圆角的终点（顶边左端），从这里往右铺顶边
	out.append(Vector2(cx - hw, rect.position.y))
	out.append(Vector2(cx - hw + k, rect.position.y - s))
	out.append(Vector2(cx + hw - k, rect.position.y - s))
	out.append(Vector2(cx + hw, rect.position.y))
	return out


## 中央屏那圈**罩框**（∩ 形）的顶点表 —— **开放折线，6 个点，不要 `_closed`**。
##
## 顺时针：左下端 → 左上斜角的上端 → 顶边左端 → 顶边右端 → 右上斜角的上端 → 右下端。
##
## ⚠️ `top_w` 必须 < 1：等于 1 时两个斜角消失、退化成三条边的方框；
## 大于 1 会跑出自交的顶点（`draw_polyline` 画出来是一团乱线）。
static func canopy_pts(rect: Rect2, top_w: float,
		cham: float) -> PackedVector2Array:
	var l := rect.position.x
	var t := rect.position.y
	var r := rect.end.x
	var b := rect.end.y
	var cx := l + rect.size.x * 0.5
	var tw := rect.size.x * clampf(top_w, 0.0, 1.0) * 0.5
	var c := clampf(cham, 0.0, rect.size.y * 0.5)
	return PackedVector2Array([
		Vector2(l, b), Vector2(l, t + c),
		Vector2(cx - tw, t), Vector2(cx + tw, t),
		Vector2(r, t + c), Vector2(r, b),
	])


## 正六边形（铆钉）顶点表，`r` 是外接圆半径。
static func hex_pts(c: Vector2, r: float) -> PackedVector2Array:
	var out := PackedVector2Array()
	for i in range(6):
		var a := deg_to_rad(60.0 * float(i) - 90.0)
		out.append(c + Vector2(cos(a), sin(a)) * r)
	return out


## 等边三角形的三个顶点：`deg_v` 方向是**一个顶点**的朝向
## （0 = 正上，顺时针为正 —— 与 `dash_dial_tip` 同一套角度语义）。
static func tri_pts(c: Vector2, r: float, deg_v: float) -> PackedVector2Array:
	var out := PackedVector2Array()
	for i in range(3):
		var a := deg_to_rad(deg_v - 90.0 + 120.0 * float(i))
		out.append(c + Vector2(cos(a), sin(a)) * r)
	return out


## 四角的**小 L 角标**：`corner` 0 = 左上 / 1 = 右上 / 2 = 右下 / 3 = 左下。
##
## 三个点：一条边上的端点 → 角点 → 另一条边上的端点。参考图里每块屏的四个角
## 都有这么一对角标 —— 它是那块屏"属于某个框架"的唯一线索；
## 没有它，圆角矩形看起来就是一张贴在屏幕上的贴纸。
static func bracket_pts(rect: Rect2, corner: int, arm: float,
		off: float) -> PackedVector2Array:
	var l := rect.position.x + off
	var t := rect.position.y + off
	var r := rect.end.x - off
	var b := rect.end.y - off
	var a := maxf(arm, 0.0)
	match posmod(corner, 4):
		0:
			return PackedVector2Array([
				Vector2(l, minf(t + a, b)), Vector2(l, t), Vector2(minf(l + a, r), t)])
		1:
			return PackedVector2Array([
				Vector2(maxf(r - a, l), t), Vector2(r, t), Vector2(r, minf(t + a, b))])
		2:
			return PackedVector2Array([
				Vector2(r, maxf(b - a, t)), Vector2(r, b), Vector2(maxf(r - a, l), b)])
		_:
			return PackedVector2Array([
				Vector2(minf(l + a, r), b), Vector2(l, b), Vector2(l, maxf(b - a, t))])


## 带**切角**的矩形（8 点，顺时针）。
##
## 参考图里几乎每一件结构件都不是直角矩形，四个角都切掉一小块 ——
## 「机加工件」与「贴纸」的区别，一半就在这四个切角上。
static func block_pts(rect: Rect2, cut: float) -> PackedVector2Array:
	var k := clampf(cut, 0.0, minf(rect.size.x, rect.size.y) * 0.5)
	var l := rect.position.x
	var t := rect.position.y
	var r := rect.end.x
	var b := rect.end.y
	return PackedVector2Array([
		Vector2(l + k, t), Vector2(r - k, t), Vector2(r, t + k), Vector2(r, b - k),
		Vector2(r - k, b), Vector2(l + k, b), Vector2(l, b - k), Vector2(l, t + k)])


## **等腰梯形**（4 点）：只把**上边**每侧收窄 `cut`，下边不动。
##
## 参考图里那两块「舱盖」是上窄下宽的梯形、不是矩形 —— 这一处收窄就是它读起来
## 像"一件装上去的盖板"而不是"一个方框"的全部原因。
static func trap_pts(rect: Rect2, cut: float) -> PackedVector2Array:
	var k := clampf(cut, 0.0, rect.size.x * 0.49)
	return PackedVector2Array([
		Vector2(rect.position.x + k, rect.position.y),
		Vector2(rect.end.x - k, rect.position.y),
		Vector2(rect.end.x, rect.end.y), Vector2(rect.position.x, rect.end.y)])


## 一条**阶梯竖轨**的顶点表（**多笔** ⇒ 返回 `Array`，每项一条折线）。
##
## `x` 是基准轴（屏幕 x）、`y0` 是第一条的上沿；相邻两条**交替**向两侧错开 `step`。
## 原剧那条轨就是这样一级一级错开的 —— 连成一条直边就退化成"一根竖条"。
## 每一条是一个带切角的短块（`block_pts`），沿 y 依次排下去。
static func stair_pts(x: float, y0: float, n: int, w: float, h: float,
		step: float, gap: float = 0.0) -> Array:
	var out: Array = []
	for i in range(maxi(n, 0)):
		var side := 1.0 if posmod(i, 2) == 0 else -1.0
		var cx := x + side * step * 0.5
		out.append(block_pts(Rect2(cx - w * 0.5, y0 + float(i) * (h + gap), w, h),
			minf(w, h) * 0.2))
	return out


## 把顶点的首点接到末尾 —— `draw_polyline` **不会自己闭合**。
static func _closed(pts: PackedVector2Array) -> PackedVector2Array:
	var out := pts
	if pts.size() > 0:
		out.append(pts[0])
	return out


## 中央模块内部：内容区 / 盾形那块区域 / 底边链式带的 y。
static func dash_center_layout(rect: Rect2) -> Dictionary:
	var pad := DASH_BEZEL + DASH_CENTER_INNER_PAD
	var inner := Rect2(rect.position.x + pad, rect.position.y + pad,
		maxf(rect.size.x - pad * 2.0, 0.0), maxf(rect.size.y - pad * 2.0, 0.0))
	# ⚠️ 罩框的底端必须**停在链式带上方**：两样东西都画在内容区里，
	# 底端压下来就会和六边形带叠在一起（真机截图里表现为一团乱线）。
	var band_y := inner.position.y + inner.size.y - DASH_HEX_BAND_R - 2.0
	var art_top := inner.position.y + 6.0
	var art_bot := band_y - DASH_HEX_BAND_R - 3.0
	return {
		"inner": inner,
		"band_y": band_y,
		"art": Rect2(inner.position.x + 6.0, art_top,
			maxf(inner.size.x - 12.0, 0.0), maxf(art_bot - art_top, 0.0)),
	}


# ---- 中央屏机型标签那一行的位置（纯函数：位置能被逐条断言）----

## 行距（向上堆）。
const FP_TAG_PITCH := 15.0
## 首条状态行离**台面顶边**的距离。
const FP_TAG_LIFT := 12.0


## 第一人称下「机体状态行」首条的基线 y。
##
## ⚠️ 为什么要从罩框里**搬出去**（轮 32 修）：中央屏罩框里
## 垂直方向**只放得下一行**。1600×900 下的实测尺寸 ——
## 罩框顶边 `art.position.y = 668`、雷达圆顶 `696`，中间还压着
## ∇ 徽标（662..673）与罩框内层线（677）：13 pt 一行正好占满。
## 轮 22 把机体编号搬进这一行之后，状态行的首条就落在
## **同一条基线**上（编号 688 / 状态行 686，差 2 px），两串居中字直接叠印。
##
## 真机截图实测：`RX-94 MASS PRODUCTION ν GUNDAM` 被
## `形态 核心 · 量产型ν高达` 整行盖掉 —— 而**阿利宙斯是唯一有形态的机体**，
## 偏偏就它读不出机号。
##
## 而且「挤一挤并排一行」这条路也走不通（用 `ThemeDB.fallback_font`
## 实量）：13 pt 下编号宽 237 px、形态行宽 149 px，而罩框内容区只有 220 px
## —— 光编号自己就已经超出去了。
## ⇒ 编号独占罩框那一行（与轮 31 交付图**逐位相同**），状态行整体上移到台面顶边之上。
static func fp_tag_row_y(view: Vector2) -> float:
	return dash_modules(dash_layout(view))["center"].position.y - FP_TAG_LIFT


## 侧格内部的三段式版式（纯函数）：标签行 / 圆表 / 底边点阵。
##
## ⚠️ 圆表半径**只能由格子自己算**：窄窗口下侧格会被收到 0 宽，
## 半径写死就会画到屏幕上别的地方去（表现为「一堆圆从血条上冒出来」）。
##
## ⚠️ 轮 24 把标签行从"占一行高度"改成"压在圆表上方的两个角里"（参考图侧屏
## 顶部两角本来就有东西），省下的那 20 px 全给了半径。
static func dash_side_layout(rect: Rect2) -> Dictionary:
	var pad := DASH_BEZEL + DASH_INNER_PAD
	var inner := Rect2(rect.position.x + pad, rect.position.y + pad,
		maxf(rect.size.x - pad * 2.0, 0.0), maxf(rect.size.y - pad * 2.0, 0.0))
	# ⚠️ 轮 30：+12 → +20。角标的横臂在 y = 内容区 + 3 上，标签字形顶正好也在那儿
	# （12 pt 的字，基线 +12 ⇒ 字形占 +3..+12）—— 两者**逐像素重合**。
	# 下移到 +20 之后字形占 +11..+20，与横臂留 8 px。
	var label_y := inner.position.y + 20.0
	var bar := Rect2(inner.position.x, inner.end.y - 13.0, inner.size.x, 13.0)
	var mode_y := bar.position.y - 8.0
	# ⚠️ 轮 30：上下各再让出 7 px（半径 67 → 60）。理由不是"留白好看"：
	# 原来的圆盘几乎顶满内容区，右侧只剩 35 px —— 原剧那块圆盘**是被一圈结构件
	# 夹着的**，没有地方放结构件，补多少细节都还是"细圆表浮在空框里"。
	var dtop := inner.position.y + 10.0
	var dbot := mode_y - 21.0
	var dc := Vector2(inner.position.x + inner.size.x * 0.5, (dtop + dbot) * 0.5)
	var dr := maxf(minf(inner.size.x * 0.5 - 6.0, (dbot - dtop) * 0.5), 0.0)
	return {
		"inner": inner, "label_y": label_y, "bar": bar, "mode_y": mode_y,
		"dial_center": dc, "dial_radius": dr,
	}


## 圆表指针角度（度）：`v01` ∈ [0,1] → −SWEEP..+SWEEP（0 在正上方，顺时针为正）。
static func dash_dial_angle(v01: float, sweep := DASH_DIAL_SWEEP) -> float:
	return (clampf(v01, 0.0, 1.0) * 2.0 - 1.0) * sweep


## 角度 → 针尖坐标（0° = 正上方、顺时针为正；屏幕 y 向下）。
static func dash_dial_tip(c: Vector2, r: float, deg: float) -> Vector2:
	var a := deg_to_rad(deg) - PI * 0.5
	return c + Vector2(cos(a), sin(a)) * r


## 推力表的环上刻度（±`DASH_DIAL_SWEEP`°，每 15° 一条）。
static func dash_thrust_ticks() -> Array:
	var out: Array = []
	var v := -DASH_DIAL_SWEEP
	while v <= DASH_DIAL_SWEEP + 0.01:
		out.append(v)
		v += 15.0
	return out


## 滚转表的环上刻度（±`DASH_ROLL_RANGE`°，每 `DASH_ROLL_TICK`° 一条）。
static func dash_roll_ticks() -> Array:
	var out: Array = []
	var v := -DASH_ROLL_RANGE
	while v <= DASH_ROLL_RANGE + 0.01:
		out.append(v)
		v += DASH_ROLL_TICK
	return out


## 仪表台总入口。**第一件事查设置**：默认关 ⇒ 对既有截图与像素测试逐位无影响。
##
## ⚠️ 2026-09-30 多了第二个开关 `cockpit_only`（发射段，马夫蒂火箭）——
## 那一段 `Settings.first_person` 可能是 `false`（玩家没开 FPV），
## 但仪表台**必须画**：老板要的正是"用仪表显示高度 / 时速 / 燃料 / 雷达，
## 不要左上角那 7 行白字"（原文见类头 `cockpit_readout` 那段）。
func _draw_cockpit_dash() -> void:
	if not cockpit_has_graduations(): return
	if is_instance_valid(_cockpit_3d) and _cockpit_3d.visible:
		return
	if not first_person_view() and not cockpit_only:
		return
	# ★ 读数源二选一：发射段走 `cockpit_readout` 那份字典，其余走 `player`。
	# ⚠️ 顺序不能反着"先判 player"：发射段 `player` 是 null（他还没出生）。
	var rocket := not cockpit_readout.is_empty()
	if not rocket and (player == null or not is_instance_valid(player)):
		return
	var view := size
	if view.x <= 0.0 or view.y <= 0.0:
		return
	var mods := dash_modules(dash_layout(view))
	var mc: Rect2 = mods["center"]
	var ml: Rect2 = mods["left"]
	var mr: Rect2 = mods["right"]

	# ---- 中央主屏（雷达那格）：更高、顶边带台阶 ----
	_draw_dash_module(mc, true)
	if mc.size.x > 40.0 and mc.size.y > 40.0:
		if rocket:
			_draw_dash_rocket_center(mc)
		else:
			_draw_dash_ticks(mc)
			_draw_dash_center_art(mc)

	if rocket:
		# ★ 发射段**到此为止**：左右两格不再画。
		# 老板要的"正常驾驶机体的高度指示器与速度指示器"由屏幕**左中**与**右侧**
		# 那两块接手（见 `_draw()` 里 `cockpit_only` 那一支）—— 再画两块圆表
		# 就是同一件事在屏上报两遍，而且报的数字还不是同一套单位。
		#
		# ⚠️ 这里**不是**省事：`_draw_dash_module(ml/mr)` 铺的是两圈金属框，
		# 留着它就是两块**空面板**，看起来像"仪表没做"。
		return

	# ---- 左右两块：底边与中央齐、内部是圆表 ----
	_draw_dash_module(ml, false)
	_draw_dash_module(mr, false)
	_draw_dash_thrust(ml)
	_draw_dash_attitude(mr)
	# ⚠️ 装饰必须画在**圆表之后**：那三颗卡箍是"骑在环上"的紧固件，得压在刻度之上。
	# 第一版反了（deco 在前），4× 放大图里卡箍被 60 条密齿埋掉，只剩三个小方框 ——
	# 纯逻辑断言全绿，是因为**没人断言过层序**。
	_draw_dash_side_deco(ml, false)
	_draw_dash_side_deco(mr, true)


## 画一块模块：**先铺满框色、再挖内容区**，中间剩的那一圈就是外框带。
##
## ⚠️ 别改成「画一个 1 px 的矩形轮廓」：参考图里那圈框是**有厚度的金属件**
## （带宽 `DASH_BEZEL`），1 px 的线看起来是「贴纸」，不是「面板」。
func _draw_dash_module(rect: Rect2, stepped: bool) -> void:
	if rect.size.x <= 1.0 or rect.size.y <= 1.0:
		return
	var inset := rect.grow(-DASH_BEZEL)
	var outer: PackedVector2Array
	var inner: PackedVector2Array
	if stepped:
		outer = round_rect_step_pts(rect, DASH_CORNER_R, DASH_STEP, DASH_STEP_FRAC)
		inner = round_rect_step_pts(inset, DASH_CORNER_R - DASH_BEZEL,
			DASH_STEP, DASH_STEP_FRAC)
	else:
		outer = round_rect_pts(rect, DASH_CORNER_R)
		inner = round_rect_pts(inset, DASH_CORNER_R - DASH_BEZEL)
	draw_colored_polygon(outer, deco_white(DASH_A_FRAME))
	draw_colored_polygon(inner, Color(0.0, 0.0, 0.0, DASH_A_FILL))
	draw_polyline(_closed(outer), deco_white(DASH_A_LINE), UILayout.LINE_STRUCT, true)
	draw_polyline(_closed(inner), deco_white(DASH_A_LINE_DIM), UILayout.LINE_HAIR, true)


## 中央屏内壁的装饰（对着参考图逐件抄的形式）：
## ∩ 形罩框双线 + 中轴竖脊 + 顶部倒三角徽标 + 左右两行人字纹 +
## 圆盘下方两个小卡角 + 左右两条竖排六边形 + 底边链式六边形带。
##
## ⚠️ 雷达（圆盘）是**后画**的：罩框压在它下面，所以罩框的每一段都必须在
## 圆的**外面**才看得见（见 `DASH_CANOPY_TOP_W` 那段注释 —— 上一版盾形就是死在这）。
func _draw_dash_center_art(rect: Rect2) -> void:
	var lay := dash_center_layout(rect)
	var inner: Rect2 = lay["inner"]
	var art: Rect2 = lay["art"]
	if art.size.x <= 20.0 or art.size.y <= 20.0:
		return
	var c_line := deco_white(DASH_A_LINE_DIM)
	var c_faint := deco_white(DASH_A_LINE_FAINT)
	_draw_dash_hexes(rect)

	# ---- 罩框（外 + 内两层双线；**开放折线，不封底**）----
	draw_polyline(canopy_pts(art, DASH_CANOPY_TOP_W, DASH_CANOPY_CHAM), c_line,
		UILayout.LINE_STRUCT, true)
	var art2 := art.grow(-DASH_CANOPY_LINE)
	if art2.size.x > 20.0 and art2.size.y > 20.0:
		draw_polyline(canopy_pts(art2, DASH_CANOPY_TOP_W, DASH_CANOPY_CHAM),
			c_faint, UILayout.LINE_HAIR, true)

	# ---- 中轴竖脊（三条平行线；上下两段露在圆盘外）----
	var cx := art.position.x + art.size.x * 0.5
	draw_line(Vector2(cx, art.position.y), Vector2(cx, art.end.y), c_faint,
		UILayout.LINE_HAIR, true)
	for sg: float in [-1.0, 1.0]:
		draw_line(Vector2(cx + sg * DASH_SPINE_HALF, art.position.y),
			Vector2(cx + sg * DASH_SPINE_HALF, art.end.y), c_faint,
			UILayout.LINE_HAIR, true)

	# ---- 顶部倒三角徽标（参考图中央屏顶上那个 ∇，骑在罩框顶边上）----
	draw_polyline(_closed(tri_pts(Vector2(cx, art.position.y),
		DASH_HEX_R + 1.5, 180.0)), c_line, UILayout.LINE_HAIR, true)

	# ---- 左右两行人字纹（`\/\/`：参考图中央屏名称两侧那两撮）----
	var chev := art.position.y + 24.0
	for sg: float in [-1.0, 1.0]:
		for i in range(3):
			var bx := cx + sg * (art.size.x * 0.28 + float(i) * 8.0)
			draw_polyline(PackedVector2Array([
				Vector2(bx, chev), Vector2(bx + 3.0, chev + 7.0),
				Vector2(bx + 6.0, chev)]), c_faint,
				UILayout.LINE_HAIR, true)

	# ---- 左右两条**阶梯竖轨**（轮 30：原剧中央屏左右沿那条一级一级错开的结构轨）----
	# ⚠️ 轮 24 在这里画的是两列「横短划线」（每列 4 道、离中轴 art/2−11）。
	# 真机放大图里那 8 道线读不出任何形状，而原剧同一位置是一条**齿条**。
	# 现在是 `stair_pts()`：4 级、交替错开 `DASH_STAIR_STEP`。
	# ⚠️ 整条轨必须落在雷达圆**外面**（同罩框那条判据，逐段算点到线段距离）——
	# 「罩框不封底」那轮的教训在这里同样适用：压进圆里就只是一堆划痕。
	var stair_h := DASH_STAIR_H * float(DASH_STAIR_N) \
		+ DASH_STAIR_GAP * float(DASH_STAIR_N - 1)
	var stair_y0 := art.end.y - DASH_STAIR_DY - stair_h
	# ⚠️ c_line 是全函数最暗的一档（DASH_A_LINE_DIM）：8 px 宽的块配它只剩孤点。
	# 轨是**结构件**、不是底纹，所以单独提一档到中灰（与侧屏结构柱同一档）。
	var c_stair := deco_white(DASH_A_LINE_MID)
	for sg2: float in [-1.0, 1.0]:
		for pts in stair_pts(cx + sg2 * DASH_STAIR_DX, stair_y0, DASH_STAIR_N,
				DASH_STAIR_W, DASH_STAIR_H, DASH_STAIR_STEP, DASH_STAIR_GAP):
			# ⚠️ 线宽必须是 **LINE_STRUCT（1.0）**，不能是 LINE_HAIR（0.5）：
			# 12× 放大图里看得很清楚 —— 0.5 px 的折线在深色底上被抗锯齿均摊，
			# 块的**四条直边整个消失**，只有四个 45° 切角边漏出亮度，
			# 整条轨于是读成"一列斜线对"而不是"一节一节的齿条"。
			# （这不违反「想更粗不许新造档位」那条：LINE_STRUCT 是既有的第二档。）
			draw_polyline(_closed(pts), c_stair, UILayout.LINE_STRUCT, true)

	# ---- 罩框下角的两份角配件（参考图底部那两个折角件）----
	for sg2: float in [-1.0, 1.0]:
		var ax := cx + sg2 * (art.size.x * 0.5 - 4.0)
		draw_polyline(PackedVector2Array([
			Vector2(ax, art.end.y - 24.0), Vector2(ax, art.end.y - 6.0),
			Vector2(ax - sg2 * 14.0, art.end.y - 6.0)]), c_faint,
			UILayout.LINE_HAIR, true)

	# ---- 圆盘下方那两个小卡角（参考图中央屏底部那两颗）----
	for sg: float in [-1.0, 1.0]:
		draw_polyline(_closed(tri_pts(
			Vector2(cx + sg * DASH_FOOT_DX, art.end.y - DASH_FOOT_R - 1.0),
			DASH_FOOT_R, 0.0)), c_faint, UILayout.LINE_HAIR, true)

	# ---- 底边那条更小更密（参考图里它是一条「链」，不是铆钉）----
	var band_y: float = lay["band_y"]
	var n := DASH_HEX_BAND_N
	var step := inner.size.x / float(n)
	for i in range(n):
		var hx := inner.position.x + step * (float(i) + 0.5)
		draw_polyline(_closed(hex_pts(Vector2(hx, band_y), DASH_HEX_BAND_R)),
			c_faint, UILayout.LINE_HAIR, true)
		# 每颗里那一道小横杠 —— 参考图的六边形里是**有字**的，空六边形读起来像铆钉
		draw_line(Vector2(hx - DASH_HEX_BAND_R * 0.5, band_y),
			Vector2(hx + DASH_HEX_BAND_R * 0.5, band_y), c_faint,
			UILayout.LINE_HAIR, true)



## 中央屏内壁左右两条**竖排六边形**（参考图中央屏左右沿那一列）。
##
## ⚠️ 位置用「离**中轴**的距离」定（`DASH_HEX_COL_DX`），不是「离内容区边沿」：
## 每一颗都要同时满足「在罩框**里面**」与「在雷达圆**外面**」——
## 那两个约束的基准都是中轴。上一版按"离边沿 7 px"摆，正好落在罩框外面。
func _draw_dash_hexes(rect: Rect2) -> void:
	var lay := dash_center_layout(rect)
	var inner: Rect2 = lay["inner"]
	var art: Rect2 = lay["art"]
	if DASH_HEX_COL_N < 1 or inner.size.x <= 0.0 or inner.size.y <= 0.0:
		return
	var c_faint := deco_white(DASH_A_LINE_FAINT)
	var cx := inner.position.x + inner.size.x * 0.5
	var y := art.position.y + DASH_HEX_R + 14.0
	for i in range(DASH_HEX_COL_N):
		for sg: float in [-1.0, 1.0]:
			draw_polyline(_closed(hex_pts(
				Vector2(cx + sg * DASH_HEX_COL_DX, y), DASH_HEX_R)),
				c_faint, UILayout.LINE_HAIR, true)
		y += DASH_HEX_R * 5.0



## 台**底边**那条刻度饰条（用户点名要的「纯座舱饰条」那一项）。
##
## 不承载任何读数 —— 它的全部作用是让这一圈边框看起来是「一块装上去的仪表板」，
## 而不是一个矩形框。每 5 条加长一档，给眼睛一个可数的节拍。
##
## ⚠️ 它画在**框带里面**（内容区底边之下、模块底边之上），不是画在内容区里。
func _draw_dash_ticks(rect: Rect2) -> void:
	var y := rect.end.y - DASH_BEZEL + 1.0
	var x := rect.position.x + DASH_TICK_EDGE
	var c_long := deco_white(DASH_A_LINE_DIM)
	var c_short := deco_white(DASH_A_LINE_FAINT)
	var i := 0
	while x <= rect.end.x - DASH_TICK_EDGE:
		var long := posmod(i, 5) == 0
		var h := DASH_TICK_LONG if long else DASH_TICK_SHORT
		draw_line(Vector2(x, y), Vector2(x, y + h),
			c_long if long else c_short, UILayout.LINE_HAIR, true)
		x += DASH_TICK_STEP
		i += 1


## 侧屏内壁的装饰：四角小 L 角标 + 压在圆表环上的三颗卡箍三角。
##
## `mirror` = 右屏（参考图左右两块是**镜像件**，不是把同一块复制两遍）。
func _draw_dash_side_deco(rect: Rect2, mirror: bool) -> void:
	if rect.size.x <= 40.0 or rect.size.y <= 40.0:
		return
	var lay := dash_side_layout(rect)
	var inner: Rect2 = lay["inner"]
	var dc: Vector2 = lay["dial_center"]
	var dr: float = lay["dial_radius"]
	if dr <= 8.0:
		return
	var c_line := deco_white(DASH_A_LINE)
	var c_mid := deco_white(DASH_A_LINE_MID)
	var c_dim := deco_white(DASH_A_LINE_DIM)
	var c_faint := deco_white(DASH_A_LINE_FAINT)
	var sgn := -1.0 if mirror else 1.0

	# ---- 四角**结构块**：外线走 LINE_STRUCT（厚件），内线走 LINE_HAIR（内衬）----
	# ⚠️ 轮 24 那版是「臂长 24、两条细线错 4 px」——放大图里像一只薄折角件。
	# 原剧那四只是**厚块**：臂 34、两层错 7 px，外线更实。
	# 「两档线宽」这条铁律下的唯一办法就是**拉开两层之间的距离 + 分开 alpha**。
	for i in range(4):
		draw_polyline(bracket_pts(inner, i, DASH_BRACKET_ARM, DASH_BRACKET_PAD),
			c_line, UILayout.LINE_STRUCT, true)
		draw_polyline(bracket_pts(inner, i, DASH_BRACKET_ARM - DASH_BRACKET_GAP,
			DASH_BRACKET_PAD + DASH_BRACKET_GAP), c_dim, UILayout.LINE_HAIR, true)

	# ---- 右沿（镜像时左沿）那根**结构柱** + 柱上两块**梯形舱盖** ----
	_draw_dash_side_column(inner, sgn, c_mid, c_faint)

	# ---- 底边那排**人字纹**（原剧侧屏下沿那排 `\/\/`）----
	# 位置**从圆盘底沿算**（不是写死 y）：圆盘半径由格子算出来，写死就会在窄窗口下
	# 反过来压到圆上或压到档位文字上。
	# ⚠️ 两处夹挤是 4× 放大图里量出来的：
	#   ① 整排必须停在**左下角标的横臂之上**（角标臂长 34 ⇒ 横臂在内容区底 −34 处）；
	#   ② 整排横向必须落在**游标刻度圈之外**（那圈最下方 12 px 横跨中轴 ±37 px）。
	# 所以它贴着圆盘底沿、并且**从内容区左沿起**（不是从角标右端起）。
	var hy := dc.y + dr - 3.0
	var hx := inner.position.x + 2.0
	if mirror:
		hx = inner.end.x - 2.0 \
			- DASH_SIDE_HATCH_STEP * float(DASH_SIDE_HATCH_N)
	# 同上：窄窗口下整排不画（否则 50 px 宽的一排会横穿那块只剩 14.5 px 半径的圆表）
	var hatch_n := DASH_SIDE_HATCH_N if inner.size.x >= DASH_SIDE_DECO_MIN_W else 0
	for k in range(hatch_n):
		var bx := hx + float(k) * DASH_SIDE_HATCH_STEP
		draw_polyline(PackedVector2Array([
			Vector2(bx, hy), Vector2(bx + DASH_SIDE_HATCH_W * 0.5,
				hy + DASH_SIDE_HATCH_H),
			Vector2(bx + DASH_SIDE_HATCH_W, hy)]), c_faint,
			UILayout.LINE_HAIR, true)

	# ---- 环上三颗卡箍（原剧那三颗骑在环带上的圆角三角）----
	for a: float in DASH_CLAMP_DEG:
		var ang := deg_to_rad(a * sgn) - PI * 0.5
		# ⚠️ `dr − 5` → `dr − 3`：卡箍要**骑在环带上**（环带在 [r−5, r]、游标在 [r+1, r+6]）。
		# 半径给小了它整个缩在盘面里，看着像一枚铆钉，不是紧固件。
		var p := dc + Vector2(cos(ang), sin(ang)) * (dr - 3.0)
		draw_polyline(_closed(tri_pts(p, DASH_CLAMP_R, a * sgn + 90.0 * sgn)),
			c_faint, UILayout.LINE_HAIR, true)


## 侧屏右沿（镜像时左沿）那根**结构柱** + 柱上两块**梯形舱盖**。
##
## 原剧侧屏最显眼的一件：一条竖柱 + 两扇上窄下宽的盖板。柱的上下端**正好接住**
## 右上 / 右下两个角标（`DASH_BRACKET_ARM`），所以三者读起来是一件东西，
## 而不是三件各摆各的构件。
##
## ⚠️ `sgn` 沿用调用方的语义：`+1` = 柱在**右沿**（左屏，不镜像）、
## `-1` = 柱在**左沿**（右屏，镜像）。
func _draw_dash_side_column(inner: Rect2, sgn: float, c_mid: Color,
		c_faint: Color) -> void:
	if inner.size.x < DASH_SIDE_DECO_MIN_W:
		return
	var x0 := inner.end.x - DASH_SIDE_COL_PAD - DASH_SIDE_COL_W
	if sgn < 0.0:
		x0 = inner.position.x + DASH_SIDE_COL_PAD
	var y0 := inner.position.y + DASH_BRACKET_PAD + DASH_BRACKET_ARM
	var y1 := inner.end.y - DASH_BRACKET_PAD - DASH_BRACKET_ARM
	# 装不下就整个不画（窄窗口 / 矮格子下宁可没有，也不要画成一团）
	if y1 - y0 < DASH_SIDE_TRAP_H * float(DASH_SIDE_TRAP_N) \
			+ DASH_SIDE_TRAP_GAP * float(DASH_SIDE_TRAP_N - 1):
		return
	var col := Rect2(x0, y0, DASH_SIDE_COL_W, y1 - y0)
	draw_polyline(_closed(block_pts(col, 2.0)), c_mid, UILayout.LINE_HAIR, true)
	# 柱心那条**双线**：工程只有两档线宽，所以"粗"只能靠两条线给
	draw_line(Vector2(col.position.x + DASH_SIDE_COL_W * 0.5, y0),
		Vector2(col.position.x + DASH_SIDE_COL_W * 0.5, y1), c_faint,
		UILayout.LINE_HAIR, true)
	var ph := (col.size.y - DASH_SIDE_TRAP_GAP * float(DASH_SIDE_TRAP_N - 1)) \
		/ float(DASH_SIDE_TRAP_N)
	for k in range(DASH_SIDE_TRAP_N):
		var pr := Rect2(col.position.x + 2.0,
			y0 + float(k) * (ph + DASH_SIDE_TRAP_GAP), DASH_SIDE_COL_W - 4.0, ph)
		draw_polyline(_closed(trap_pts(pr, DASH_SIDE_TRAP_CUT)), c_mid,
			UILayout.LINE_HAIR, true)
		var pi := pr.grow(-DASH_SIDE_TRAP_IN)
		if pi.size.x > 4.0 and pi.size.y > 4.0:
			draw_polyline(_closed(trap_pts(pi, DASH_SIDE_TRAP_CUT * 0.6)), c_faint,
				UILayout.LINE_HAIR, true)


## 圆表：外环带（双圈）+ 中间环 + 轮毂环 + 压在环带里的刻度 + 三角指针。
##
## 指针用三角形而不是线段 —— 参考图那两块侧屏的指针是有宽度的。
## 轮 24 把刻度从"贴着外环往里长"改成"压在 r−4 与 r−14 之间的一圈刻度带"，
## 并把环加到四层：参考图那块圆盘是**同心多环**的，两圈就太单薄。
func _draw_dash_gauge(c: Vector2, r: float, ticks: Array, needle_deg: float,
		needle_col: Color) -> void:
	if r <= 8.0:
		return
	var c_line := deco_white(DASH_A_LINE)
	var c_dim := deco_white(DASH_A_LINE_DIM)
	var c_faint := deco_white(DASH_A_LINE_FAINT)
	draw_arc(c, r, 0.0, TAU, 56, c_line, UILayout.LINE_STRUCT, true)
	# 外沿那圈环带：36 条径向短线把 r−DASH_BAND_W..r 填实
	for k in range(DASH_BAND_SEG):
		var ba := TAU * float(k) / float(DASH_BAND_SEG)
		var bd := Vector2(cos(ba), sin(ba))
		draw_line(c + bd * (r - DASH_BAND_W), c + bd * r, c_faint,
			UILayout.LINE_HAIR, true)
	# ---- 环带**内侧**那一圈密刻度（轮 30）----
	# 原剧那块圆盘的表盘是**密刻度**的（外沿一整圈小格），而轮 24 只有环带里那 36 条
	# 径向填充线 —— 4× 放大图里读作"一个带条纹的环"，读不出"一块表盘"。
	# ⚠️ 两样不是一回事：填充线把环带**填实**（长度 = 带宽），这一圈画在环带**内侧**，
	# 是**齿**（有间隙、可数）。第一版给 4 px 太短，看不出齿，加长到 9 px。
	var t_in := r - DASH_BAND_W - DASH_GAUGE_FINE_LEN
	for k in range(DASH_GAUGE_FINE):
		var fa := TAU * float(k) / float(DASH_GAUGE_FINE)
		var fd := Vector2(cos(fa), sin(fa))
		draw_line(c + fd * (r - DASH_BAND_W), c + fd * t_in,
			c_faint, UILayout.LINE_HAIR, true)
	# ---- 环**外**第二道弧（轮 30 第四轮：替掉那圈游标齿）----
	# 原来这里画的是 60 条环外游标齿 —— 4× 放大图里那是一圈**毛刺**（像静电噪点）。
	# 换成第二道弧：盘的边圈变成"双线"，与罩框 / 角标 / 轨道的语言一致。
	draw_arc(c, r + DASH_GAUGE_OUT, 0.0, TAU, 56, c_faint, UILayout.LINE_HAIR, true)
	draw_arc(c, r - DASH_BAND_W, 0.0, TAU, 56, c_faint, UILayout.LINE_HAIR, true)
	# ⚠️ 0.60/0.26 → 0.42/0.20：环带加厚到 9 px、主刻度跟着往里挪之后，
	# 0.60r 正好落在主刻度**带内**（两层线叠在一起），必须让到刻度带以内。
	draw_arc(c, r * 0.42, 0.0, TAU, 44, c_faint, UILayout.LINE_HAIR, true)
	draw_arc(c, r * 0.20, 0.0, TAU, 28, c_dim, UILayout.LINE_HAIR, true)
	# ⚠️ 主刻度的**起点**要跨过密齿与那圈**空档**：从 r−带宽−密齿长−空档 起，
	# 否则 19 条主刻度会压在 60 条密齿上，两层齿连成一片灰（4× 放大成"海胆"）。
	var t_maj := t_in - DASH_GAUGE_GAP
	for deg_v: float in ticks:
		var major := posmod(int(round(deg_v)), 30) == 0
		var ln := 13.0 if major else 5.0
		var dir := dash_dial_tip(Vector2.ZERO, 1.0, deg_v)
		draw_line(c + dir * t_maj, c + dir * (t_maj - ln),
			c_dim if major else c_faint, UILayout.LINE_HAIR, true)
	var nd := dash_dial_tip(Vector2.ZERO, 1.0, needle_deg)
	var np := Vector2(-nd.y, nd.x)
	draw_colored_polygon(PackedVector2Array([
		c + nd * (r - 14.0), c + np * 5.0, c - np * 5.0]), needle_col)
	draw_circle(c, 4.0, needle_col)


## 底边那排**小方点**（参考图侧屏底部就是一排方点）。
##
## `from_center` = true 时从**中间往两边**亮 —— 滚转是「往哪边歪、歪了多少」，
## 从一端往另一端填的话方向就读不出来了。
func _draw_dash_pips(bar: Rect2, v01: float, col: Color, from_center: bool) -> void:
	if bar.size.x <= 12.0 or bar.size.y <= 4.0:
		return
	var n := 10
	var gap := 2.0
	var pw := (bar.size.x - gap * float(n - 1)) / float(n)
	if pw <= 1.0:
		return
	var lit := int(round(clampf(v01, 0.0, 1.0) * float(n)))
	var c_off := deco_white(DASH_A_LINE_FAINT)
	for i in range(n):
		var x := bar.position.x + float(i) * (pw + gap)
		var on := false
		if from_center:
			on = i >= n / 2 - lit and i < n / 2 + lit
		else:
			on = i < lit
		draw_rect(Rect2(x, bar.position.y, pw, bar.size.y),
			col if on else c_off, true)


## 左格：**推力档位圆表** + 底边点阵。
##
## ⚠️ 与左侧速度块下那条油门条**不是一回事**，别当成重复删掉：
## 那条读「油门给了多少」（0→100% 的填充），这一格读「现在在哪一档」。
## 档位色与 `_draw_speed_block()` 里 BOOST 那一行的判据同源（`fm.boosting` /
## `fm.super_boost`），两处不会出现「这边写 BOOST、那边还写 CRUISE」。
func _draw_dash_thrust(rect: Rect2) -> void:
	if rect.size.x <= 40.0 or rect.size.y <= 40.0:
		return
	var lay := dash_side_layout(rect)
	var inner: Rect2 = lay["inner"]
	var bar: Rect2 = lay["bar"]
	var dc: Vector2 = lay["dial_center"]
	var dr: float = lay["dial_radius"]
	var label_y: float = lay["label_y"]
	var mode_y: float = lay["mode_y"]
	var th := clampf(player.fm.throttle, 0.0, 1.0)
	var col := HUD
	var mode := "CRUISE"
	if player.fm.super_boost:
		col = IFIELD
		mode = "SUPER"
	elif player.fm.boosting:
		col = WARN
		mode = "BOOST"
	elif player.has_dash_limit() and player.dash_cd > 0.0:
		mode = "DASH CD"
	var ct := deco_white(DASH_A_TXT)
	_text(Vector2(inner.position.x + DASH_SIDE_LABEL_INSET, label_y), "THRUST", 12, ct)
	_text_right(Vector2(inner.end.x - DASH_SIDE_LABEL_INSET, label_y),
		"%3d%%" % int(th * 100.0), 12, ct)
	_draw_dash_gauge(dc, dr, dash_thrust_ticks(), dash_dial_angle(th), col)
	_text_center(Vector2(inner.position.x + inner.size.x * 0.5, mode_y),
		mode, 13, ct)
	_draw_dash_pips(bar, th, col, false)


## 右格：**滚转圆表** + 底边点阵。
##
## 与中央那块全周天刻度导轨是同一条思路的「局部拉直」：导轨回答
## 「整片天球转了多少」，这一格只把**滚转**那一维拉出来给一个可读的数。
## 环上的刻度**固定不动**、指针随滚转走 —— 与姿态仪顶部那个固定倒三角同一语义
## （`_draw_attitude` 的 ROLL_TICKS 也是固定不转的，两边行为一致）。
##
## 滚转角取 `attitude_readout()` 的 `horizon_roll_deg`，**不另算一遍**：
## 那一处注释解释过为什么用 `asin(right.y)` 而不是欧拉分解（±90 处不跳变）。
func _draw_dash_attitude(rect: Rect2) -> void:
	if rect.size.x <= 40.0 or rect.size.y <= 40.0:
		return
	var lay := dash_side_layout(rect)
	var inner: Rect2 = lay["inner"]
	var bar: Rect2 = lay["bar"]
	var dc: Vector2 = lay["dial_center"]
	var dr: float = lay["dial_radius"]
	var label_y: float = lay["label_y"]
	var mode_y: float = lay["mode_y"]
	var read := attitude_readout(player.global_transform.basis)
	var roll := float(read["horizon_roll_deg"])
	var ct := deco_white(DASH_A_TXT)
	_text(Vector2(inner.position.x + DASH_SIDE_LABEL_INSET, label_y), "ROLL", 12, ct)
	_text_right(Vector2(inner.end.x - DASH_SIDE_LABEL_INSET, label_y),
		"%+5.1f°" % roll, 12, ct)
	_draw_dash_gauge(dc, dr, dash_roll_ticks(), roll, ct)
	_text_center(Vector2(inner.position.x + inner.size.x * 0.5, mode_y),
		"R" if roll >= 0.0 else "L", 13, ct)
	_draw_dash_pips(bar, clampf(absf(roll) / DASH_ROLL_RANGE, 0.0, 1.0),
		ct, true)


# ------------------------------------------------------------ 发射段那两格（马夫蒂火箭）
#
# 老板 2026-09-30：
# > 「**你驾驶舱做的好丑，直接用全周天驾驶舱的代码吧**」
# > 「**正常驾驶模式的UI也使用啊，比如燃料和雷达啊高度和时速这些显示器，
# >  不需要屏幕左上角那么多白色文字了**」
#
# ⇒ 发射段不再单独建一套 3D 舱（第一版那套已删），而是**复用这一层**仪表台，
# 只把「这几格读什么」换掉。老板点名要的四样：**燃料 / 雷达 / 高度 / 时速** ——
# 于是：雷达 = 中央那格、时速 = 左格、高度 = 右格、燃料 = 右格底边那条点阵。
#
# ⚠️ 为什么另开两个函数，而不是给 `_draw_dash_thrust` / `_draw_dash_attitude` 加分支：
# 那两格回答的是**机体的**问题（「现在在哪一档」/「滚了多少度」），而火箭两样都没有
#（它不滚 —— 全段制导；也没有档位 —— 油门是制导给的）。硬塞分支会让那两格的
# 源码形状在两种模式下互相污染，而 `suite_fpv` 正钉着它们的形状（逐字）。
#
# ⚠️ 这一整段**一个字段都不读 `player`**：读数全部来自 `cockpit_readout`，
# 由 `main.gd` 每帧塞进来（造它的是纯函数 `LaunchScript.dash_readout()`）。
# 本文件不认识 `RocketBody`，也不该认识 —— 发射段 `player` 是 **null**，
# 因为 `player` 要到 `_launch_match()` 才建，而发射演出走的是 `_begin_launch()`。


## 从 `cockpit_readout` 里取一个 [0,1] 的归一化读数（缺键 = 0）。
##
## ⚠️ 归一化在**塞进来的那一侧**算完（`LaunchScript.dash_readout()`）——
## 本文件不该知道"速度满量程是多少 m/s"这种发射段的量纲。
## ★ 这一帧的飞行读数**是不是从火箭来的**（而不是 `player`）。
##
## 发射段没有机体（老板：「**上太空之后开的是指挥官型梅萨，不是柯西**」那一段之前，
## 玩家坐在马夫蒂火箭里），但老板 2026-09-30 要的就是
## 「**把正常驾驶机体的高度指示器和速度指示器都拿过来**」——
## ⇒ `_draw_speed_block()` / `_draw_altitude_tape()` / `_draw_altitude_block()`
## 三个函数各自多一个"数从哪来"的分支，判据就是这个函数。
##
## ⚠️ 判据取 `cockpit_readout` 非空，**不取 `Settings` / `Game.phase`**：
## 它是 `main._sync_cockpit_hud()` 每帧写的那一份，也就是"这一帧真的有没有火箭读数"。
func _from_rocket() -> bool:
	return not cockpit_readout.is_empty()


## 从 `cockpit_readout` 里取一个数。
##
## ⚠️ 给 `fallback` 是**刻意**的：缺键时 `Dictionary.get` 回 `null`，而
## `float(null)` 是 0 —— 于是"键名打错一个字母"会静默变成"这一项一直是 0"，
## 画面正常、判据全绿。默认值让调用点至少挑一个**合理**的缺省
##（高度 / 速度 0、燃料 1、油门 0），而逐键核对由套件负责。
func _rd(key: String, fallback: float) -> float:
	return float(cockpit_readout.get(key, fallback))


## 中央格：**只画那口空雷达底盘**（圆底 + 外弧 + 十字准线 + 己机点）。
##
## ⚠️ **不调 `_draw_radar()`**：那个函数整段依赖 `player.contacts()` /
## `Settings.effective_dash_screen()`，而发射段 `player` 是 `null`。
## 而"空雷达"在这里**不是缺省值、是正确答案** —— 老板 2026-09-30：
## 「**到达近地轨道之后没有敌人，本关和下一关坠入地球都不设置敌人**」。
## ⚠️ 老板这一轮又补了一句「（**不搬雷达系统**）」—— 所以这里**只有盘**，
## 没有 contacts / 锁定 / 威胁层 / 敌机列表任何一样（那些块整段都没被 `_draw()` 调到）。
##
## ⚠️ 箭名与状态行**不在这个函数里**：它们归 `_draw_model_tag_rocket()`
##（老板要的是"机体那套 UI 搬过来"，机名标签本就是机体那一套里的一块）。
##
## 底盘那三行与 `_draw_radar()` 的**逐字相同**（同一个圆底 / 同一圈外弧 /
## 同一档 `HUD_DIM`）—— 它必须是"同一块屏在报没目标"，不是另一套美术。
func _draw_dash_rocket_center(rect: Rect2) -> void:
	if rect.size.x <= 40.0 or rect.size.y <= 40.0:
		return
	var c := radar_center(size)
	var r := RADAR_RADIUS
	draw_circle(c, r, Color(0.02, 0.08, 0.05, 0.55))
	draw_arc(c, r, 0.0, TAU, 48, HUD_DIM, UILayout.LINE_STRUCT, true)
	# 十字准线 + 己机点：底盘**开着但没目标**时的常态（与雷达盘同一套）。
	draw_line(Vector2(c.x - r * 0.92, c.y), Vector2(c.x + r * 0.92, c.y),
		HUD_FAINT, UILayout.LINE_HAIR, true)
	draw_line(Vector2(c.x, c.y - r * 0.92), Vector2(c.x, c.y + r * 0.92),
		HUD_FAINT, UILayout.LINE_HAIR, true)
	draw_circle(c, 3.0, HUD)
	# ---- 箭名 + 状态行**不在这里画** ----
	# ⚠️ 2026-09-30 晚第五改搬到 `_draw_model_tag()` 的火箭分支（`_draw_model_tag_rocket()`）：
	# 老板这一轮要的是"**开机体那套 UI 搬过来**"，而机名标签正是**机体那一套里的一块**。
	# 留在这里的话就是同一串字画两遍，且两处的位置（`c − (0, r+8)` /
	# `c − (0, r+26)`）与 `_draw_model_tag_rocket()` 的 `center − (0, RADAR_RADIUS+8)`、
	# `fp_tag_row_y()` **互相重叠** —— 表现是"字变粗"，肉眼看不出、也不报错。
	# ★ 本函数**只剩一件事**：把这口**空雷达底盘**画出来（十字准线 + 己机点）。
	# 它不读 `player.contacts()`（发射段 `player` 是 `null`），也不该读 ——
	# 老板 2026-09-30 晚：「（不搬雷达系统）」。
	# 而"空盘"在这里**不是缺省值、是正确答案**：「到达近地轨道之后没有敌人」。


# ============================================================ 通讯（轮 E：电台 / 字幕 / 对白 / 播报）
#
# 四种样式各有各的**兰**（lane），互不抢位：
#
# | 样式 | 位置 | 同时几条 | 版式 |
# |---|---|---|---|
# | 电台 `radio` | 左侧、血条之上、让开姿态仪 | **3**（窗口矮时自动收紧） | 方框 + 呼号 + 正文两行 |
# | 字幕 `subtitle` | 屏幕下中 | 1 | 半透明板 + 呼号 + 正文 |
# | 对白 `dialogue` | 屏幕下中（更大） | 1 | 名字牌 + 大字号 |
# | 播报 `alert` | 屏幕上方 | 1 | 方框 + 来源（**没有呼号**） |
#
# ## ★ 几何一律走 `CommsDirector` 的纯函数
#
# `radio_rect()` / `centered_rect()` / `alert_rect()` 都在那边。本文件只负责"往上画"。
# 两边各算一份的话，1280×720 上电台框会压住姿态仪 —— 而那要开一次游戏、
# 切一次分辨率才看得见（`attitude_center()` 里那段"约束冲突时以速度块为准"
# 讲的就是这类问题）。
#
# ## ★ 折行要按**完整文本**算，按**已揭示部分**画
#
# 打字机是"一个字一个字冒出来"。若拿**已揭示的部分**去折行并据此算框高，
# 每打一个字框就会变一次高、断行位置也会跳 —— 整条字幕在抖。
# 正解：**框高与断行点由完整文本决定**，只把"前 n 个字"画上去。
# 这两件事是同一次 `UILayout.wrap()` 的两个输入，所以断行必然自洽。

## 电台框内文字距框边的内边距（x）。
const COM_PAD_X := 12.0
## 电台正文最多折几行。**必须与 `CommsDirector.RADIO_ROW_H` 的推导一致**（那边 62 px 容两行）。
const COM_RADIO_MAX_LINES := 2
## 字幕 / 对白 / 播报条最多折几行。
const COM_BAND_MAX_LINES := 3
## 文字条的内边距（x）。
const COM_BAND_PAD_X := 18.0
## 播报条距屏幕顶端的距离。
##
## 54 = 让开"上一行 UI"（左上角游标从 `MARGIN` = 24 起，最高的一块也就二三十像素高）。
## 播报最多两行（`BAND_PAD` 18 + 26×2 = 70），于是 54 + 70 = 124 ——
## **刚好停在告警区（从 `y = 130` 起）上面**。这三条约束是连锁的：
## 改 `BAND_PAD` / `LINE_H` / 这里任何一个，都要回头看那 130。
const COM_ALERT_TOP := 54.0
const COM_ALERT_MAX_LINES := 2

## 电台框里的字号。
const COM_RADIO_FS := 15
## 字幕字号 / 对白字号 / 播报字号。对白最大：它是"有人在跟你说话"。
const COM_SUB_FS := 17
const COM_DLG_FS := 20
const COM_ALERT_FS := 16
## 呼号（说话人）那一行的字号。
const COM_NAME_FS := 13


## 把颜色的 r/g/b 保留、透明度乘 `a`（淡入淡出用）。
##
## 单独一个函数是因为四块都要用，而"手写 `Color(c.r, c.g, c.b, c.a * a)`"
## 在这种地方最容易漏掉 `.a`（常量色的 alpha 不一定是 1）——
## 漏掉的症状是"淡出到一半就不动了"，而且只在某一种样式上看得出。
func _fade(c: Color, a: float) -> Color:
	return Color(c.r, c.g, c.b, c.a * clampf(a, 0.0, 1.0))


func _draw_comms() -> void:
	if comms == null:
		return
	_draw_radio_lane()
	_draw_centered_lane(CommsData.STYLE_SUBTITLE)
	_draw_centered_lane(CommsData.STYLE_DIALOGUE)
	_draw_alert_lane()


# ------------------------------------------------------------ 电台
func _draw_radio_lane() -> void:
	var items: Array = comms.live_of(CommsData.STYLE_RADIO)
	if items.is_empty():
		return
	# 下界（底边）：血条块顶边再往上 `RADIO_BOTTOM_PAD`，**再让开下中那条带**。
	# ⚠️ 让开那一步不是可选的：电台兰在左、下中带居中且宽，两者的 y 区间
	# 本来就重叠 ⇒ 有一行字幕在场时，字幕框的左边会横切在电台框上。
	# 决定"谁让谁"的算式**只有一处**：`CommsDirector.radio_ceil_y()`。
	var ceil_y := _radio_ceil_y()
	# 上界：速度块的最低一行 —— 与 `attitude_center()` 里那个 `lo` 是**同一个约束**，
	# ⚠️ 改一处必须改另一处（那边的注释解释了为什么以速度块为准）。
	var floor_y := size.y * 0.5 + SPEED_BLOCK_BOTTOM_PAD + 8.0
	var cols := CommsDirectorScript.radio_columns(size, floor_y, ceil_y)
	var start := maxi(items.size() - cols, 0)
	var shown := items.size() - start
	for i in range(start, items.size()):
		var e: Dictionary = items[i]
		_draw_radio_box(
			CommsDirectorScript.radio_rect(size, i - start, shown, ceil_y), e)


## 电台兰的上界：血条上方，**并且**让开下中那条带。
##
## 抽成方法是为了让"决定谁让谁"这件事只有一处实现 ——
## 出图台（`tools/shots_comms.gd`）也调它来念读数，自己再摆一遍坐标就会与画面分家。
func _radio_ceil_y() -> float:
	return CommsDirectorScript.radio_ceil_y(
		size.y - HEALTH_BLOCK_TOP_FROM_BOTTOM - CommsDirectorScript.RADIO_BOTTOM_PAD,
		_band_top_y())


## 下中那条带的**上沿**（不在场 ⇒ `INF`，表示"不挡"）。
##
## ⚠️ 用它来决定电台兰抬到哪，而不是另算一遍 `_band_bottom_y() - 高度` ——
## 带子的高度随折行数变（1~3 行），拿常量顶必然有一天差一截。
func _band_top_y() -> float:
	var max_w := minf(CommsDirectorScript.SUBTITLE_MAX_W, size.x - 80.0)
	var stack := CommsDirectorScript.band_stack(size, _band_bottom_y(),
		_band_rows(CommsData.STYLE_SUBTITLE), _band_rows(CommsData.STYLE_DIALOGUE),
		max_w)
	var top := INF
	for k: String in ["subtitle", "dialogue"]:
		var r: Rect2 = stack[k]
		if r.size.y > 0.0:
			top = minf(top, r.position.y)
	return top


func _draw_radio_box(r: Rect2, e: Dictionary) -> void:
	var line: Dictionary = e["line"]
	var a := CommsDirectorScript.alpha_of(float(e["t"]), line)
	if a <= 0.01:
		return
	# 底板 + 外框 + 左缘亮条：不用图标素材，只用几何（与全工程其它块同一套做法）。
	draw_rect(r, Color(0.0, 0.03, 0.02, 0.62 * a), true)
	draw_rect(r, _fade(HUD_FAINT, a), false, UILayout.LINE_STRUCT)
	draw_rect(Rect2(r.position.x, r.position.y, 3.0, r.size.y), _fade(HUD, 0.85 * a), true)

	# 呼号行：左边一个"通讯中"的小方块（随 `comms.clock()` 闪，提示这是活的）
	var blink := 0.45 + 0.55 * absf(sin(comms.clock() * 3.4))
	draw_rect(Rect2(r.position.x + COM_PAD_X, r.position.y + 9.0, 6.0, 6.0),
		_fade(HUD, blink * a), true)
	var name := MS.plain(str(line.get("speaker", "")))
	_text(Vector2(r.position.x + COM_PAD_X + 13.0, r.position.y + 16.0),
		name, COM_NAME_FS, _fade(HUD_DIM, a))

	var tw := r.size.x - COM_PAD_X * 2.0
	var rows := UILayout.wrap(_font, MS.plain(str(line.get("text", ""))),
		tw, COM_RADIO_FS, COM_RADIO_MAX_LINES)
	var shown := UILayout.wrap(_font, MS.plain(
		CommsDirectorScript.shown_text(float(e["t"]), line)),
		tw, COM_RADIO_FS, COM_RADIO_MAX_LINES)
	for i in shown.size():
		_text(Vector2(r.position.x + COM_PAD_X, r.position.y + 36.0 + float(i) * 20.0),
			shown[i], COM_RADIO_FS, _fade(NEUTRAL, a))
	# ⚠️ 打字机还没打完时，在最后一个字后面画一个光标 ——
	# 没有它的话"字没打完"和"句子就这么短"看起来一样。
	if shown.size() < rows.size() and absf(sin(comms.clock() * 6.0)) > 0.35:
		var last := "" if shown.is_empty() else shown[shown.size() - 1]
		var y := r.position.y + 36.0 + float(maxi(shown.size() - 1, 0)) * 20.0
		var w := _font.get_string_size(last, HORIZONTAL_ALIGNMENT_LEFT, -1, COM_RADIO_FS).x
		draw_rect(Rect2(r.position.x + COM_PAD_X + w + 2.0, y - 12.0, 3.0, 14.0),
			_fade(HUD, 0.8 * a), true)


# ------------------------------------------------------------ 字幕 / 对白
## 下中那条兰里**现在这一条**按完整文本折几行（不在场 ⇒ 0）。
##
## ⚠️ 必须用**完整文本**量，与 `_draw_centered_lane()` 画的时候同一个输入 ——
## 拿"已揭示的部分"量的话框的位置和高度会随打字机一个字一个字地跳。
func _band_rows(style: String) -> int:
	if comms == null:
		return 0
	var items: Array = comms.live_of(style)
	if items.is_empty():
		return 0
	var line: Dictionary = (items[0] as Dictionary)["line"]
	var fs := COM_DLG_FS if style == CommsData.STYLE_DIALOGUE else COM_SUB_FS
	var max_w := minf(CommsDirectorScript.SUBTITLE_MAX_W, size.x - 80.0)
	return UILayout.wrap(_font, MS.plain(str(line.get("text", ""))),
		max_w - COM_BAND_PAD_X * 2.0, fs, COM_BAND_MAX_LINES).size()


func _draw_centered_lane(style: String) -> void:
	var items: Array = comms.live_of(style)
	if items.is_empty():
		return
	var e: Dictionary = items[0]
	var line: Dictionary = e["line"]
	var a := CommsDirectorScript.alpha_of(float(e["t"]), line)
	if a <= 0.01:
		return
	var is_dlg := style == CommsData.STYLE_DIALOGUE
	var fs := COM_DLG_FS if is_dlg else COM_SUB_FS
	var accent := HUD if is_dlg else NEUTRAL

	var max_w := minf(CommsDirectorScript.SUBTITLE_MAX_W, size.x - 80.0)
	var tw := max_w - COM_BAND_PAD_X * 2.0
	# ① 框高与断行点：**按完整文本** —— 在 `_band_rows()` 里算（它读的就是这条
	#    台词的完整 `text`），所以框**不会**随打字机一个字一个字地变高/跳断行。
	# ② 画的内容：**已揭示的前 n 个字**，同一个宽度折 ⇒ 断行与 ① 自洽
	var shown := UILayout.wrap(_font, MS.plain(
		CommsDirectorScript.shown_text(float(e["t"]), line)),
		tw, fs, COM_BAND_MAX_LINES)
	# ③ 框**在哪**：★ 交给 `band_stack()`（内部走 `_band_rows()` = ① 同一个算式）。
	#    字幕与人物对话是屏幕下中**同一条带上的两条** —— 各拿 `_band_bottom_y()`
	#    当底边的话，同时在场时会**像素级精确重叠**。见 `band_stack()` 的注释。
	var stack := CommsDirectorScript.band_stack(size, _band_bottom_y(),
		_band_rows(CommsData.STYLE_SUBTITLE), _band_rows(CommsData.STYLE_DIALOGUE),
		max_w)
	var r: Rect2 = stack["dialogue" if is_dlg else "subtitle"]

	draw_rect(r, Color(0.0, 0.02, 0.03, 0.52 * a), true)
	draw_rect(r, _fade(accent, (0.34 if is_dlg else 0.20) * a), false, UILayout.LINE_STRUCT)
	var name := MS.plain(str(line.get("speaker", "")))
	if name != "":
		_text(Vector2(r.position.x + COM_BAND_PAD_X, r.position.y + 15.0),
			name, COM_NAME_FS, _fade(accent, 0.85 * a))
	for i in shown.size():
		_text(Vector2(r.position.x + COM_BAND_PAD_X, r.position.y + 34.0 + float(i) * 26.0),
			shown[i], fs, _fade(NEUTRAL, a))


## 字幕 / 对白条**底边**落在哪。
##
## 第一人称时底下压着一整条座舱仪表台（`DASH_H` = 236 + 底距），字幕必须抬到它上面 ——
## 否则"字幕压在雷达上"。第三人称没有仪表台，就贴到屏幕下沿留一点余量。
## ⚠️ 这个判断只能在这里做：`CommsDirector` 是纯状态机，它不知道有没有座舱。
func _band_bottom_y() -> float:
	if first_person_view():
		return size.y - DASH_H - DASH_BOTTOM_PAD - 18.0
	return size.y - 132.0


# ------------------------------------------------------------ 播报（SPTV 这类单向广播）
func _draw_alert_lane() -> void:
	var items: Array = comms.live_of(CommsData.STYLE_ALERT)
	if items.is_empty():
		return
	var e: Dictionary = items[0]
	var line: Dictionary = e["line"]
	var a := CommsDirectorScript.alpha_of(float(e["t"]), line)
	if a <= 0.01:
		return
	var fs := COM_ALERT_FS
	var max_w := minf(CommsDirectorScript.SUBTITLE_MAX_W, size.x - 80.0)
	var tw := max_w - COM_BAND_PAD_X * 2.0
	var rows := UILayout.wrap(_font, MS.plain(str(line.get("text", ""))),
		tw, fs, COM_ALERT_MAX_LINES)
	var shown := UILayout.wrap(_font, MS.plain(
		CommsDirectorScript.shown_text(float(e["t"]), line)),
		tw, fs, COM_ALERT_MAX_LINES)
	var r := CommsDirectorScript.alert_rect(size, rows.size(), COM_ALERT_TOP)
	draw_rect(r, Color(0.04, 0.02, 0.0, 0.58 * a), true)
	draw_rect(r, _fade(WARN, 0.42 * a), false, UILayout.LINE_STRUCT)
	# 来源名：标注在框**上沿外侧**（不是在框里）—— 一眼看出"这不是场内谁在说话"
	var name := MS.plain(str(line.get("speaker", "")))
	if name != "":
		_text(Vector2(r.position.x + COM_BAND_PAD_X, r.position.y - 6.0),
			name, COM_NAME_FS, _fade(WARN, 0.9 * a))
	for i in shown.size():
		_text(Vector2(r.position.x + COM_BAND_PAD_X, r.position.y + 17.0 + float(i) * 24.0),
			shown[i], fs, _fade(NEUTRAL, a))


# ============================================================ 阶段叠加层

## ★63-24 间歇轮：局内三选一的面板（设计 §7）。
##
## ## 它长什么样
## 一层压暗底 + 标题（奖励轮另写一句）+ 倒计时条 + **三张并排的芯片卡** + 按键提示。
## 每张卡上是：类型（带类型色）、卡名、**收益那一行**、品质徽标；
## 激进卡多一行**代价**（`cost`）—— 代价看不见的卡就是个陷阱。
##
## ## 绘制入口的六道门，每一道都对应一种"画了不该画的"或"没画该画的"
##   ① `Game.is_endless()` —— 别的模式没有这个概念；
##   ② `phase` 是 `INTERMISSION` / `BONUS` —— `CLEARING` 那 1.2 s 里**不画**
##      （设计 §4.1 给 `CLEARING` 单开一个状态的理由就是这个：面板不该在爆炸特效里弹出来）；
##   ③ 手牌非空 —— 空手牌画出来的是一排空框。
##
## ## ⚠️ 位置：压在**电台之后**、结算叠加层**之前**
## 与结算页同一条规矩：这是"停下来做决定"的一屏，电台字幕被压暗是**有意的**；
## 但它必须**在结算之下** —— 玩家被打死的那一帧如果还浮着选卡面板就荒唐了。
func _draw_endless_intermission() -> void:
	if not Game.is_endless():
		return
	if Game.endless_phase != EndlessRules.Phase.INTERMISSION \
			and Game.endless_phase != EndlessRules.Phase.BONUS:
		return
	if Game.endless_hand.is_empty():
		return
	var bonus := Game.endless_phase == EndlessRules.Phase.BONUS
	var lay := intermission_layout(size, Game.endless_hand.size())
	var cards: Array = lay["cards"]
	var cx := float(lay["cx"])
	# 压暗底：比结算页（0.86）浅一档 —— 那一屏是"结束了"，这一屏是"接着打"，
	# 底下的天与地形还该看得见。
	draw_rect(Rect2(Vector2.ZERO, size), Color(0.01, 0.02, 0.04, 0.62), true)
	# ---- 标题 ----
	var tcol := CardStyle.tier_color(UpgradeCard.Tier.PERFECT) if bonus else HUD
	_text_center(Vector2(cx, float(lay["title_y"]) + 22.0), intermission_title(Game.endless_phase),
		26, tcol, UILayout.WEIGHT_EMPH)
	_text_center(Vector2(cx, float(lay["sub_y"]) + 22.0),
		"第 %d 波清空 · 本轮选 %d 张（已选 %d）"
			% [Game.endless_wave, Game.endless_hand_want, Game.endless_hand_got],
		14, HUD_DIM)
	# ---- 倒计时条 ----
	var bar: Rect2 = lay["bar"]
	# ⚠️ 回补会让 `left` **超过** `total`（§7.2 读法 A：把操作耗时加回去）
	# ⇒ 比例必须 clamp，不然条会画到框外面去。
	var ratio := clampf(Game.endless_intermission_left
		/ maxf(Game.endless_intermission_total, 0.001), 0.0, 1.0)
	var low := Game.endless_intermission_left <= 3.0
	var bcol := IFIELD if Game.endless_operating else (WARN if low else HUD)
	draw_rect(bar, Color(0.08, 0.14, 0.18, 0.85), true)
	draw_rect(Rect2(bar.position, Vector2(bar.size.x * ratio, bar.size.y)), bcol, true)
	draw_rect(bar, Color(bcol, 0.60), false, UILayout.LINE_STRUCT)
	_text(Vector2(bar.position.x, bar.position.y - 6.0), "剩余时间", 12, HUD_DIM)
	_text_right(Vector2(bar.end.x, bar.position.y - 6.0),
		intermission_timer_text(Game.endless_intermission_left, Game.endless_operating),
		12, bcol)
	# ---- 三张卡 ----
	for i in cards.size():
		_draw_endless_card(cards[i] as Rect2, i)
	# ---- 按键提示（键盘 / 手柄两列，借既有的 `InputSetup.hint()`）----
	# ⚠️ 鼠标那一路**必须**写进提示：这一屏上 Tab/Enter 之外就它一个入口，
	# 而"没写在提示里的操作等于不存在"（本工程反复踩过）。
	var hy := float(lay["hint_y"])
	var kb := "Tab / Shift+Tab 切换    Enter 选定    鼠标左键点哪张选哪张    倒计时走完自动选焦点那张"
	var pad := "十字键 ←→ 切换    A 选定    倒计时走完自动选焦点那张"
	_text_center(Vector2(cx, hy), InputSetup.hint(kb, pad), 14, HUD_DIM)


## 间歇轮的一张卡。几何由 `intermission_layout()` 给，这里只管画。
##
## ⚠️ 焦点标记用**实心方块**、不用 `▶` / `►` 那类字形 —— 与
## `MainMenu._draw_endless_row()` 画勾选框时同一条规矩：CJK 字库里有没有那个字形
## 取决于字库，而"画不出来"在 Godot 里是**豆腐块或不画**，**不报错**。
## 方块是零风险的写法。
func _draw_endless_card(r: Rect2, i: int) -> void:
	if i < 0 or i >= Game.endless_hand.size():
		return
	var card := UpgradeCard.by_id(Game.endless_hand[i], Game.endless_hand_tier)
	var focused := i == Game.endless_focus
	var col := CardStyle.type_color(card.type) if card != null else NEUTRAL
	draw_rect(r, Color(col, 0.20 if focused else 0.09), true)
	draw_rect(r, col if focused else Color(col, 0.45), false,
		UILayout.LINE_STRUCT if focused else UILayout.LINE_HAIR)
	if focused:
		draw_rect(Rect2(r.position + Vector2(8.0, 8.0), Vector2(10.0, 10.0)), col, true)
	if card == null:
		# 理论上到不了（`by_id()` 按 id + 同一档一定找得回来）——
		# 但真到不了的那一天，屏幕上得看得出来是"这张卡的数据没了"，
		# 而不是一片空白让人以为没抽到卡。
		_text(r.position + Vector2(26.0, 26.0), "（卡数据缺失：%s）" % Game.endless_hand[i],
			13, DANGER)
		return
	# 序号 + 类型（类型色就是卡片的颜色，两者同源 `CardStyle.type_color()`）
	_text(r.position + Vector2(26.0, 24.0), "%d  %s" % [i + 1, card.type_name()], 13,
		Color(col, 0.92))
	# 卡名
	_text(r.position + Vector2(14.0, 56.0), card.name, 20, col,
		UILayout.WEIGHT_EMPH if focused else -1)
	# 收益那一行（`line`）—— 长句自己折行，最多两行，超出的丢掉。
	# 芯片文案是人写的短句，"折不下"本来就是文案该短一点的信号。
	var lines := UILayout.wrap(_font, card.line, r.size.x - 28.0, 13, 2)
	for k in lines.size():
		_text(r.position + Vector2(14.0, 84.0 + float(k) * 17.0), lines[k], 13,
			Color(0.72, 0.82, 0.92))
	# 激进卡的**代价**：必须画出来（看不见代价的升级是个陷阱）。
	if card.cost != "":
		_text(r.position + Vector2(14.0, r.size.y - 46.0), "代价：%s" % card.cost, 12, WARN)
	# 品质徽标（右下角）：底纹 + 同色系的字 —— 三选一里"这张多好"比"这张是什么"更该先看见。
	var badge := card.tier_name()
	var bw := _font.get_string_size(badge, HORIZONTAL_ALIGNMENT_LEFT, -1, 13).x + 16.0
	var brect := Rect2(r.end - Vector2(bw + 12.0, 34.0), Vector2(bw, 22.0))
	draw_rect(brect, CardStyle.tier_bg(Game.endless_hand_tier), true)
	_text_center(Vector2(brect.position.x + brect.size.x * 0.5, brect.position.y + 16.0),
		badge, 13, CardStyle.tier_color(Game.endless_hand_tier))


func _draw_phase_overlay() -> void:
	match Game.phase:
		# ⚠️ 这里原来有一整段 `Game.Phase.INTRO` 的叠加层（标题 / 机体·地图 /
		# "按 空格 出击" / 出击前的几个键位）。1.2 用户要求删掉"按空格开始游戏"，
		# 开局直接进 FIGHT，于是那一整段**永远不会被画到** —— 已删除。
		# 键位提示没有丢：完整表在主菜单底部（`InputSetup.HELP_SECTIONS`），
		# 战斗中最要紧的几件装备的键位常驻右下角（`_draw_weapon_block`）。
		Game.Phase.WIN:
			_draw_result(result_title(Game.Phase.WIN, Game.match_mode), HUD)
		Game.Phase.LOSE:
			_draw_result(result_title(Game.Phase.LOSE, Game.match_mode), DANGER)


## ★63-24：结算页的大标题（纯函数 ⇒ 判据能直接查"演习那一局写的是哪一句"）。
##
## ⚠️ 演习**没有"通关"**（设计 §3 / §10）：玩家唯一的结果是"被击坠 ⇒ 终止"，
## 所以连失败页也不写 FAILED —— 写成 FAILED 会把一个"本来就没有终点"的模式
## 说成"你没打赢"，与它的玩法口径正好相反。
static func result_title(phase: int, mode: int) -> String:
	if mode == Game.MatchMode.ENDLESS:
		return "DRILL TERMINATED"
	if phase == Game.Phase.WIN:
		return "TRAINING COMPLETE" if mode == Game.MatchMode.TRAINING else "MISSION COMPLETE"
	return "TRAINING FAILED" if mode == Game.MatchMode.TRAINING else "MISSION FAILED"


## 游戏内**不再有**"按 H 打开操作说明"的面板。
## 第四轮改成把键位直接印在右下角每一件装备的左边（_draw_weapon_block），
## 那比"先按一个帮助键、再在一大张表里找"快得多，也不占屏幕。
## 完整键位表仍然留在主菜单底部（InputSetup.HELP_SECTIONS）。


## 结算菜单。
##
## 需求要四样东西：**战斗时长 / 战斗经过 / 损耗 / 胜利**。
## 做成两栏：左边是带时间戳的事件流水（"战斗经过"），右边是数值化的损耗与战果。
## 事件流水用左栏而不是居中一行，是因为它是"读"的，不是"扫"的。
## 结算画面两栏的几何。
##
## 抽成**纯函数**是为了能被测试直接断言 —— "对齐"这件事应该由构造保证，
## 而不是靠人对着截图看。左右栏共用同一个 Rect2 的高度与 y，所以框顶框底必然齐平。
##
## **外框用 `UILayout.MARGIN`，内部文字留白用 `UILayout.PAD`** ——
## 于是结算两栏的外框与主菜单底部操作说明面板的外框**完全重合**，
## 两栏里的数值列右端又与战斗 HUD 的数值列落在同一条竖线上。
## （早先这里用的是 content 宽度 + 18 px 内留白，结果三屏的右边界各差十几像素。）
##
## 高度是按内容倒推的：右栏 14 行（含 3 处分段）在 step 24 / para 34 下约占 420 px，
## 加 16 px 余量就是 436。留太多会变成"框很大、内容挤在上半边"。
static func result_layout(view: Vector2, cols := 2) -> Dictionary:
	var total_w := UILayout.frame_width(view)
	var gap := 52.0
	# 空隙只加在**栏与栏之间**（cols − 1 个），不是每栏后面都加。
	var col_w := (total_w - gap * float(cols - 1)) / float(cols)
	var box_h := 436.0
	# 152 = 标题带 104 + 任务评价两行（118 / 140 的基线）。
	# 评价是这一局的结论，它跟着 MISSION COMPLETE 走，不塞进右栏那堆数字里。
	var title_h := 152.0
	var hint_gap := 46.0
	# 整块内容垂直居中：标题 + 两栏 + 底部提示一起算。
	# 之前是硬编码 y（标题 104 / 框顶 212 / 提示 726），结果是"顶部挤、底部空一大片"。
	var total := title_h + box_h + hint_gap + 26.0
	var top := maxf(40.0, (view.y - total) * 0.5)
	var cx := view.x * 0.5
	var x0 := cx - total_w * 0.5
	var boxes: Array[Rect2] = []
	for i in cols:
		boxes.append(Rect2(x0 + float(i) * (col_w + gap), top + title_h, col_w, box_h))
	return {
		"boxes": boxes,
		"title_y": top,
		"hint_y": top + title_h + box_h + hint_gap,
		"box_h": box_h,
		# 供测试断言"三屏对齐"用的两条线：
		#   左栏行标签的左端 == UILayout.content_left()
		#   右栏数值列的右端 == UILayout.content_right() == HUD 弹药栏数值列
		"label_x": x0 + UILayout.PAD,
		"value_x": x0 + total_w - UILayout.PAD,
	}


func _draw_result(title: String, col: Color) -> void:
	draw_rect(Rect2(Vector2.ZERO, size), Color(0.01, 0.02, 0.04, 0.86), true)
	var cx := size.x * 0.5
	var d := _difficulty()

	# 一切数据都取自 capture_result() 的快照，不碰 player（那时它可能早被释放了）
	var sub := str(_result.get("suit", "—"))
	if d != null:
		sub += "   ·   难度 " + d.name_cn
	# 地图取代了原来的"时段"：三张图都是夜战，写"夜晚"没有信息量
	if Game.active_map != null:
		sub += "   ·   " + Game.active_map.name_cn
	if Game.match_mode == Game.MatchMode.TRAINING:
		sub = "%s   ·   训练模式   ·   靶机 %d / %d" % [str(_result.get("suit", "—")),
			Game.training_targets_down, Game.training_targets_total]
	elif Game.match_mode == Game.MatchMode.ENDLESS:
		# ★63-24：演习**没有"通关"**，所以这一行的副标题只报"这是什么模式"，
		# 真正的两个数字（到第几波 / 活了多久）放在下面评价那一块
		#（见 `_draw_result_rating()` 里那个 ENDLESS 分支）。
		sub = "%s   ·   %s" % [str(_result.get("suit", "—")), EndlessRules.MODE_TITLE]

	var geo := result_layout(size)
	var boxes: Array = geo["boxes"]
	var top: float = geo["title_y"]

	_text_center(Vector2(cx, top + 14.0), "机 动 战 士 高 达 闪 光 的 哈 萨 维", 15, HUD_DIM)
	_text_center(Vector2(cx, top + 60.0), title, 46, col)
	_text_center(Vector2(cx, top + 94.0), sub, 17, HUD_DIM)
	_draw_result_rating(cx, top)

	_draw_result_log(boxes[0])
	_draw_result_stats(boxes[1])

	# 结算后只能回主菜单重新选机体与难度 —— 用户要求撤掉"再战一局"
	# ★ 轮 C：剧情模式另走一条路（`sally` 非空）—— 回**战役图**，失败时另有"R 重来"。
	#   文案与口径全部收在 `result_hint()` / `sally_text()` 两个纯函数里，
	#   这里只负责把它们画在**同一根基线**上（箱底与提示行之间那 46 px 的空档）。
	var sally: Dictionary = _result.get("sally", {})
	var back_label := "回战役图" if not sally.is_empty() else "回主菜单"
	_text_center(Vector2(cx, geo["hint_y"]), result_hint(sally, back_label), 22,
		NEUTRAL if int(_flash * 2.0) % 2 == 0 else HUD_DIM)
	var credit := sally_text(sally)
	if not credit.is_empty():
		# 右对齐到内容区右边界 —— 与中间那行提示保持"两端各一"的读法，
		# 也避开"长文案与提示行撞在一起"（左对齐时 1280 宽下只剩几十像素余量）。
		_text_right(Vector2(UILayout.content_right(size), geo["hint_y"]), credit, 17,
			WARN, UILayout.WEIGHT_EMPH)


## 任务评价（S·A·B·C）。
##
## 全部读 `_result` 快照 —— 包括 `capture_result()` 那一刻定格的 `wave_times`。
## 结算画面可能比战斗活得久（玩家残骸 2.2 秒后就释放了），这里不许回头读 Game。
func _draw_result_rating(cx: float, top: float) -> void:
	# ★63-24：无限强化演习**没有"评价"这一回事**（设计 §10 原文："只显示两个数字"）。
	#
	# 所以这一块**不删、只换内容**：位置留着（删掉会在标题与两栏之间留一个空洞，
	# 而那正是"排版没排过"最典型的形状），把 S/A/B/C 换成它真正带得走的那两个数。
	# ⚠️ 数读 `_result` 快照，不回头读 `Game` —— 与 `rating` / `sally` 同一条规矩。
	if Game.match_mode == Game.MatchMode.ENDLESS:
		_text_center(Vector2(cx, top + 118.0),
			"演 习 终 止     到第 %d 波" % int(_result.get("endless_wave", 0)), 19,
			HUD, UILayout.WEIGHT_EMPH)
		_text_center(Vector2(cx, top + 140.0),
			"存活 %s   ·   击坠 %d" % [
				endless_time_text(float(_result.get("endless_time", 0.0))),
				int(_result.get("endless_kills", 0))], 14, HUD_DIM)
		return
	var rating: Dictionary = _result.get("rating", {})
	if rating.is_empty():
		return
	var graded := bool(rating.get("graded", false))
	var head := "任务未达成    不予评价"
	if graded:
		head = "评 价   %s     综合 %d" % [
			str(rating.get("grade", MissionRating.NO_GRADE)),
			int(roundf(float(rating.get("score", 0.0))))]
	_text_center(Vector2(cx, top + 118.0), head, 19,
		HUD if graded else HUD_DIM, UILayout.WEIGHT_EMPH)

	var detail := "战果 %d · 存续 %d · 效率 %d" % [
		int(roundf(float(rating.get("objective", 0.0)))),
		int(roundf(float(rating.get("survival", 0.0)))),
		int(roundf(float(rating.get("tempo", 0.0))))]
	var wt: Array = _result.get("wave_times", [])
	if wt.size() > 0:
		var parts := PackedStringArray()
		for w in wt:
			parts.append("%.0f s" % float(w))
		detail += "   ·   波次 " + " / ".join(parts)
	_text_center(Vector2(cx, top + 140.0), detail, 14, HUD_DIM)


func _result_box(r: Rect2, heading: String, col: Color) -> void:
	draw_rect(r, Color(0.03, 0.06, 0.10, 0.92), true)
	draw_rect(r, Color(col.r, col.g, col.b, 0.35), false, UILayout.LINE_STRUCT)
	draw_rect(Rect2(r.position, Vector2(r.size.x, 3.0)), col, true)
	_text(Vector2(r.position.x + UILayout.PAD, r.position.y + 32.0), heading, 18, col)


## 左栏：战斗经过（带时间戳的事件流水，最新的在下面）。
func _draw_result_log(r: Rect2) -> void:
	_result_box(r, "战 斗 经 过", HUD)
	var lx := r.position.x + UILayout.PAD
	var rx := r.position.x + r.size.x - UILayout.PAD
	var lines := Game.log_lines()
	if lines.is_empty():
		_text(Vector2(lx, r.position.y + 62.0), "（无记录）", 14, HUD_DIM)
		return
	# 尾部对齐：记录多的时候优先显示最后的（最近的战况最重要）
	var max_lines := int((r.size.y - 56.0) / 21.0)
	var start := maxi(lines.size() - max_lines, 0)
	var y := r.position.y + 62.0
	for i in range(start, lines.size()):
		var fade := 1.0 if i >= lines.size() - 6 else 0.62
		_text(Vector2(lx, y), lines[i], 14,
			Color(HUD.r, HUD.g, HUD.b, fade))
		y += 21.0
	if start > 0:
		# 右对齐到栏内右边界：原来用 _text 从右边界往右画，会直接冲出面板
		_text_right(Vector2(rx, r.position.y + 32.0), "（前 %d 条略）" % start, 12, HUD_DIM)


## 右栏：损耗与战果。
func _draw_result_stats(r: Rect2) -> void:
	_result_box(r, "损 耗 与 战 果", WARN)
	var x := r.position.x + UILayout.PAD
	var vx := r.position.x + r.size.x - UILayout.PAD
	var y := r.position.y + 62.0
	# 阵营系统（2026-09-22）：右栏要塞进"友军拦截 · 僚机损失"一行。
	# 框高 436 是死数（720p 下框底已经贴住提示行，加高会穿底），
	# 行距 24 → 22、新行只占一行 —— 收 22 px、支 24 px，净支 2 px，仍在余量内。
	var step := 22.0
	var para := 34.0

	_text(Vector2(x, y), "战斗时长", 15, NEUTRAL)
	_text_right(Vector2(vx, y), _fmt_time(Game.elapsed), 16, HUD)
	y += para

	_stat_pair(x, vx, y, "机体耐久",
		"%d → %d" % [int(_result.get("max_hp", 0)), int(_result.get("hp", 0))],
		DANGER if float(_result.get("hp_ratio", 1.0)) < 0.4 else HUD)
	y += step
	_stat_pair(x, vx, y, "I 立场",
		"%d → %d" % [int(_result.get("ifield_max", 0)), int(_result.get("ifield", 0))],
		DANGER if not bool(_result.get("has_ifield", true)) else IFIELD)
	y += step
	_stat_pair(x, vx, y, "承受伤害", "%d" % int(Game.damage_taken), NEUTRAL)
	y += step
	_stat_pair(x, vx, y, "造成伤害", "%d" % int(Game.damage_dealt), HUD)
	y += para

	_stat_pair(x, vx, y, "光束步枪",
		"丢弃 %d / %d · 发射 %d"
		% [Game.rifles_discarded, int(_result.get("rifle_max", 0)), Game.beam_shots],
		NEUTRAL)
	y += step
	_stat_pair(x, vx, y, "浮游导弹",
		# 批 14：总量无限 —— 结算页只报"打出去多少发"，不再除以出厂载弹
		"%d 发" % Game.funnels_fired, NEUTRAL)
	y += step
	_stat_pair(x, vx, y, "火神炮", "%d 发" % Game.gun_shots, NEUTRAL)
	y += step
	_stat_pair(x, vx, y, "光束军刀", "%d 次命中" % Game.saber_hits, WARN)
	y += step
	# 1.2 飞行踏板：它是这一版新加的一类战果（把敌机从踏板上打下来），
	# 不记在这里的话玩家在结算里看不到自己做过这件事。
	_stat_pair(x, vx, y, "击毁踏板", "%d 块" % Game.pedals_destroyed,
		WARN if Game.pedals_destroyed > 0 else NEUTRAL)
	y += step
	_stat_pair(x, vx, y, "干扰弹", "%d 组" % Game.flares_used, NEUTRAL)
	y += para

	_stat_pair(x, vx, y, "锁定敌机", "%d 次 · 丢失 %d" % [Game.locks_acquired, Game.locks_lost], NEUTRAL)
	y += step
	_stat_pair(x, vx, y, "步枪有效命中",
		"%d%%（%d / %d）%s" % [int(Game.rifle_stats.accuracy() * 100.0), Game.rifle_stats.effective_hits, Game.rifle_stats.shots,
		" · 待结算 %d" % Game.rifle_stats.pending.size() if not Game.rifle_stats.pending.is_empty() else ""], NEUTRAL)
	y += step
	_stat_pair(x, vx, y, "导弹命中", "%d / %d" % [Game.missiles_hit, Game.missiles_fired], NEUTRAL)
	y += step
	_stat_pair(x, vx, y, "来袭导弹", "%d 枚" % Game.missiles_incoming, DANGER if Game.missiles_incoming > 0 else NEUTRAL)
	y += step
	# 阵营系统（2026-09-22）：一行塞两个数 —— 僚机有损失优先红色，
	# 其次拦截数非零给琥珀（火力线蹭到过自己人），都干净就是灰。
	_stat_pair(x, vx, y, "友军拦截 · 僚机损失",
		"%d · %d" % [Game.friendly_fire_blocked, Game.allies_lost],
		DANGER if Game.allies_lost > 0 else (WARN if Game.friendly_fire_blocked > 0 else NEUTRAL))


func _stat_pair(x: float, vx: float, y: float, label: String, value: String, col: Color) -> void:
	_text(Vector2(x, y), label, 14, HUD_DIM)
	_text_right(Vector2(vx, y), value, 15, col)


func _fmt_time(t: float) -> String:
	return "%02d:%02d" % [int(t) / 60, int(t) % 60]


# ============================================================ 文本工具

## 世界坐标是否在镜头前方（unproject_position 对身后的点也会返回坐标，
## 所以必须先判可见性，不能靠坐标本身判断）。
func _visible(world: Vector3) -> bool:
	return not camera.is_position_behind(world)


func _project(world: Vector3) -> Vector2:
	return camera.unproject_position(world)


## HUD 文字一律先描一圈深色边。
## 亮天空（尤其贴云飞）下纯亮绿字的对比度非常差，"THROTTLE 75%" 这种小字基本糊掉，
## 描边是让 HUD 在任何背景下都能读的最低成本做法。
const OUTLINE := Color(0.0, 0.05, 0.02, 0.85)


## ## 字重只有两档（§4.7）
##
## `weight` 只认 `UILayout.WEIGHT_BODY` / `WEIGHT_EMPH`，映射表在
## `UILayout.outline_for()` —— 这里是**唯一**读描边宽度的地方，别处不许再写 `2`。
## 不传 = 正文（`-1` 会被 `outline_for()` 兜底成正文，见那里的注释）。
##
## ⚠️ 为什么"字重"落在了描边宽度上：工程只带一份默认字体（`ThemeDB.fallback_font`），
## 没有 bold 变体，也不允许往工程里塞字体文件 —— 这条规矩和"地形天空 HUD 全程序化"
## 是同一条。所以"强调"只能靠描边加粗表达：2 是正文、3 是强调，视觉上正好差一档。
func _text(pos: Vector2, s: String, fs: int, col: Color, weight := -1) -> void:
	_magnifier_text_rect(pos, s, fs)
	draw_string_outline(_font, pos, s, HORIZONTAL_ALIGNMENT_LEFT, -1, fs,
		UILayout.outline_for(weight), OUTLINE)
	draw_string(_font, pos, s, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, col)


## 右对齐：`pos.x` 是文本**右端**的位置。
##
## ⚠️ **不能靠 `HORIZONTAL_ALIGNMENT_RIGHT` 来做这件事。**
## Godot 的 `draw_string` / `draw_string_outline` 只在传了**正的排版宽度**时才按对齐
## 摆字；宽度写 −1（"不限制"）时对齐参数会被忽略，文本依旧从 `pos.x` 往右画。
## 这里原来正是 `HORIZONTAL_ALIGNMENT_RIGHT, -1`，于是整个 HUD 的右半边走样：
##   - 右上角高度 "3200" 只画出 "32"，长一点的 "PITCH +12.5" 被屏幕右缘切掉；
##   - 右下角弹药栏三列全部变成"从右边界往右画"，数值列的右端参差不齐；
##   - 结算菜单"损耗与战果"的长数值直接冲出面板。
## 修法就是先把字符串量出来，再自己往左挪 —— 和 `MainMenu._text_right` 同一套写法
## （菜单那边一直是对的，所以"主菜单齐、战斗界面不齐"这个现象才对得上）。
func _text_right(pos: Vector2, s: String, fs: int, col: Color, weight := -1) -> void:
	var w := _font.get_string_size(s, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x
	_text(pos - Vector2(w, 0.0), s, fs, col, weight)


func _text_center(pos: Vector2, s: String, fs: int, col: Color, weight := -1) -> void:
	var w := _font.get_string_size(s, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x
	var at := pos - Vector2(w * 0.5, 0)
	_magnifier_text_rect(at, s, fs)
	draw_string_outline(_font, at, s, HORIZONTAL_ALIGNMENT_LEFT, -1, fs,
		UILayout.outline_for(weight), OUTLINE)
	draw_string(_font, at, s, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, col)


