	var gap := 7.0
	draw_line(c + Vector2(-arm - gap, 0), c + Vector2(-gap, 0), HUD_FAINT, UILayout.LINE_STRUCT, true)
	draw_line(c + Vector2(gap, 0), c + Vector2(arm + gap, 0), HUD_FAINT, UILayout.LINE_STRUCT, true)
	draw_line(c + Vector2(0, -arm - gap), c + Vector2(0, -gap), HUD_FAINT, UILayout.LINE_STRUCT, true)
	draw_line(c + Vector2(0, gap), c + Vector2(0, arm + gap), HUD_FAINT, UILayout.LINE_STRUCT, true)
	draw_circle(c, 1.8, HUD_FAINT)
	_draw_cannon_charge_ring(c)
