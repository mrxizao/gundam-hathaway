static func endless_clock_text(elapsed: float, reinforce: float) -> String:
	return "演习时长 %s   敌机强化 ×%.2f" % [endless_time_text(elapsed), reinforce]


# ─────────────── ★63-24 · 间歇轮三选一（局内选卡面板，设计 §7）───────────────

## 一张卡的宽 / 高。
##
## ⚠️ **宽是上限不是定值**：`intermission_layout()` 会按窗口宽度收窄
##（三张 300 的卡并排要 952 px，小窗口放不下）。判据里对 `640×480` 也有一条。
const INT_CARD_W := 300.0
const INT_CARD_H := 186.0
const INT_CARD_GAP := 26.0
## 倒计时条的高 / 与上下两块的间距。
const INT_BAR_H := 14.0
const INT_BAR_GAP := 30.0
## 卡块与底部按键提示之间的间距。
const INT_HINT_GAP := 34.0
## 标题带的高（标题 + 副标题两行）。
const INT_TITLE_H := 46.0
## 提示带的高。
const INT_HINT_H := 30.0


## 间歇轮面板的几何（**纯函数** ⇒ 判据能直接查"三张卡不重叠、都在窗口内、
## 鼠标点每张卡的中心都命得中"），不靠截图。
##
## ## 为什么要算而不是写死坐标
## 工程里的窗口是**可缩放**的（`UILayout.content_left()` 那一套全按 `view` 算），
## 写死坐标在 1280 上看着没问题，到 640 就把两张卡画到屏幕外 ——
## 而"画到外面"不会有任何报错，只是"按了没反应"。
##
## ## ⚠️ `count <= 0` 也要给出**一个** `cards` 槽
## 调用方（`_draw_endless_intermission()`）在 `hand` 空时已经早退，
## 但本函数是 `static`、判据会直接拿 `0` 来试 —— 返回空数组会让
## `lay["cards"][0]` 这类下标在别处炸。这里统一按 `maxi(count, 1)` 算。
static func intermission_layout(view: Vector2, count: int) -> Dictionary:
	var n := maxi(count, 1)
	var gap := INT_CARD_GAP
	var avail := maxf(view.x - UILayout.MARGIN * 2.0, 120.0)
	var card_w := maxf(minf(INT_CARD_W, (avail - gap * float(n - 1)) / float(n)), 80.0)
	var block_w := card_w * float(n) + gap * float(n - 1)
	var total := INT_TITLE_H + INT_BAR_GAP + INT_BAR_H + INT_BAR_GAP \
		+ INT_CARD_H + INT_HINT_GAP + INT_HINT_H
	var top := maxf(UILayout.MARGIN, (view.y - total) * 0.5)
	var x0 := (view.x - block_w) * 0.5
	var bar := Rect2(x0, top + INT_TITLE_H + INT_BAR_GAP, block_w, INT_BAR_H)
	var card_top := bar.position.y + INT_BAR_H + INT_BAR_GAP
	var cards: Array[Rect2] = []
	for i in n:
		cards.append(Rect2(x0 + float(i) * (card_w + gap), card_top, card_w, INT_CARD_H))
	return {
		"cards": cards,
		"bar": bar,
		"title_y": top,
		"sub_y": top + 26.0,
		"hint_y": card_top + INT_CARD_H + INT_HINT_GAP,
		"cx": view.x * 0.5,
		"card_w": card_w,
	}


## 鼠标落在第几张卡上（−1 = 没落在任何一张上）。
##
## ⚠️ **与绘制共用同一份 `intermission_layout()`**（唯一真源）——
## 这里另写一套"卡片在屏幕上的位置"就是第二个真源：绘制改一行、命中不改，
## 表现是"看着点中了却没反应"（或者更糟：点上面那张选中了下面那张）。
static func intermission_hit(view: Vector2, count: int, at: Vector2) -> int:
	var cards: Array = intermission_layout(view, count)["cards"]
	for i in cards.size():
		if (cards[i] as Rect2).has_point(at):
			return i
	return -1


## 间歇轮面板的**大标题**（纯函数 ⇒ 判据直接查"奖励轮写的是哪一句"）。
static func intermission_title(phase: int) -> String:
	return "奖 励 轮 · 完 美" if phase == EndlessRules.Phase.BONUS else "强 化 选 择"


## 倒计时条右边那个读数（纯函数）。
