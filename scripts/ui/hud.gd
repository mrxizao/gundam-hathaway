## 否则每 5 波来的那批 ACE 只会显得"这一波怎么这么难"，而不是"我进了强敌波"。
static func endless_status_text(wave: int, remaining: int, total: int) -> String:
	var kind: String = "强敌波" if EndlessRules.is_ace_wave(wave) else "小波"
	if total <= 0:
		return "演习 · 第 %d 波（%s）" % [wave, kind]
	return "演习 · 第 %d 波（%s）   本波剩 %d / %d" % [wave, kind, remaining, total]


