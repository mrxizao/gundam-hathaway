## Shared target bars sit below the reticle in both cockpit and third-person HUDs.
func _draw_target_vitals(point:Vector2,top:float,width:float,hull_col:Color=HUD,field_col:Color=IFIELD,ui_scale:float=1.0)->void:
	if lock==null or not is_instance_valid(lock.target) or not lock.target.alive:return
	var target:FlightBody=lock.target
	var ratios:Vector2=_target_vitals.values(target)
	var pixel_scale:=get_viewport_transform().get_scale().abs()*ui_scale
	var bars:Array[Rect2]=_target_vitals.geometry(point,top,width,pixel_scale)
	for i in 2:
		var bar:Rect2=bars[i]
		var col:Color=field_col if i==0 else (DANGER if target.hp_ratio()<=.25 else hull_col)
		var ratio:float=ratios.x if i==0 else ratios.y
		# Solid, pixel-aligned strips avoid shimmering AA outlines during recoil.
		draw_rect(bar.grow_individual(1.0/pixel_scale.x,1.0/pixel_scale.y,1.0/pixel_scale.x,1.0/pixel_scale.y),Color(.005,.012,.02,.90))
		draw_rect(bar,Color(col,.24))
		var fill:Rect2=_target_vitals.fill_rect(bar,ratio,pixel_scale)
		if fill.size.x>0:draw_rect(fill,col)
	_text(Vector2(bars[0].position.x-18,bars[0].position.y+5),"I",9,field_col if target.has_ifield() else HUD_DIM)
	_text(Vector2(bars[1].position.x-18,bars[1].position.y+6),"HP",9,hull_col)
