## 解包缓存（每台机只做一次：`4 bit → RGBA8` 的展开是十几次乘加，一次性即可）。
static var _cache: Array = []


## 取该机体的线稿贴图。下标越界、或该机体没有线稿（兜底件）⇒ `null`。
##
## ⚠️ 返回 `null` 是**正常路径**，不是错误：没有线稿的机体照样有外轮廓可描。
static func texture(key: int) -> Texture2D:
	if key < 0 or key >= B64.size():
		return null
	if _cache.is_empty():
		_cache.resize(B64.size())
	var hit: Variant = _cache[key]
	if hit != null:
		return hit
	var chunks: Array = B64[key]
	if chunks.is_empty():
		return null
	# ⚠️ 不做 `int(...)` 转换：维度表里本来就是 int，多一层转换只会在表结构写错时
	# 报出 `Nonexistent 'int' constructor` 这种看不出所以然的错（第一版就栽过）。
	var dim: Array = WH[key]
	if dim.size() < 2:
		return null
	var w: int = dim[0]
	var h: int = dim[1]
	if w <= 0 or h <= 0:
		return null
	var src := Marshalls.base64_to_raw("".join(chunks))
	var n := w * h
	if src.size() * 2 < n:
		return null
	var px := PackedByteArray()
	px.resize(n * 4)
	for i in n:
		var byte := int(src[i >> 1])
		var q := (byte >> 4) if (i & 1) == 0 else (byte & 0xF)
		var o := i * 4
		px[o] = 255
		px[o + 1] = 255
		px[o + 2] = 255
		px[o + 3] = q * 17          # 4 bit → 8 bit（0..15 → 0..255）
	var img := Image.create_from_data(w, h, false, Image.FORMAT_RGBA8, px)
	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex
