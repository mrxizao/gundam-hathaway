# ============================================================ 查询
static func radio_ids() -> Array:
	return RADIO.keys()


static func has_radio(id: String) -> bool:
	return RADIO.has(id)


## `radio:ken_01` / `ken_01` 都能进（前缀剥掉再查）。
static func bare_id(id: String) -> String:
	var s := id.strip_edges()
	for pre in STYLES:
		if s.begins_with(pre + ":"):
			return s.substr(pre.length() + 1)
	if s.begins_with("radio_"):
		return s.substr(6)
	return s


## 取一条电台台词 —— **查不到返回空字典，绝不兜到别的 id 上**
## （与 `MissionScript.map_id_for()` 的"不许兜底"同源；兜底 = 静默说错台词）。
static func radio(id: String) -> Dictionary:
	var k := bare_id(id)
	if not RADIO.has(k):
		return {}
	var v: Array = RADIO[k]
	return _line(k, str(v[0]), str(v[1]), str(v[2]), str(v[3]))


## 统一入口：先当电台查，查不到再当场景查（场景返回**第一条**的那个字典，
## 但 `text` 换成场景名 —— 场景本身不是一句台词，别把它当台词播）。
static func line(id: String) -> Dictionary:
	var r := radio(id)
	if not r.is_empty():
		return r
	if has_scene(bare_id(id)):
		var sc := scene(bare_id(id))
		var v: Array = sc["lines"]
		if not v.is_empty():
			return v[0]
	return {}


static func style_of(id: String) -> String:
	var r := radio(id)
	return "" if r.is_empty() else str(r["style"])


static func has_scene(id: String) -> bool:
	return SCENES.has(id)


static func scene_ids() -> Array:
	return SCENES.keys()


## 场景的元信息 + **现从库里取出来的**台词数组。
## ⚠️ 每次调用都重新取（`BANK` 是常量、取的是引用，成本是几次数组读）。
static func scene(id: String) -> Dictionary:
	if not SCENES.has(id):
		return {}
	var d: Dictionary = SCENES[id]
	var style := str(d["style"])
	var out: Array = []
	for lid in d["ids"]:
		var sid := str(lid)
		var row := BANK.by_id(sid)
		if row.is_empty():
			# ⚠️ 库里没有这一条 ⇒ **跳过**，但不要静默：套件会逐条钉住
			# `scene` 里的每个 id 都真的存在，所以这条分支只在"库里改过 id"时走到。
			continue
		out.append(_line(sid, str(row[BANK.F_SPEAKER]), str(row[BANK.F_TEXT]),
			sid, style))
	return {"id": id, "title": str(d["title"]), "style": style, "lines": out}


static func _line(id: String, speaker: String, text: String, src: String,
		style: String) -> Dictionary:
	return {
		"id": id,
		"speaker": speaker,
		"text": text,
		"src": src,
		"style": style,
		"secs": hold_secs(text, style),
	}


# ============================================================ 时长
## 打字机速度（字/秒）。**一个数管两边**：显示时长与揭示速度都由它推，
## 所以"读得完"和"打得完"不会打架（两个数各管一头的话，
## 短句会打字机没打完就消失，长句会打完了干等 —— 两种都只在真机上才看得见）。
const CPS := 13.0

## 一条台词**在场**多久（秒）。下限保证短句来得及看，上限防止长句赖着不走
## （电台同时最多叠三条，一条不走后面全堵着）。
static func hold_secs(text: String, style: String) -> float:
	var n := float(text.length())
	if style == STYLE_RADIO:
		return clampf(1.1 + n / CPS, 1.6, 5.2)
	if style == STYLE_SUBTITLE:
		return clampf(0.9 + n / CPS, 1.6, 6.0)
	if style == STYLE_DIALOGUE:
		return clampf(1.2 + n / CPS, 2.0, 7.0)
	if style == STYLE_ALERT:
		return clampf(1.4 + n / CPS, 2.0, 6.5)
	return clampf(1.2 + n / CPS, 1.6, 6.0)


## 已经揭示到第几个字（打字机）。`elapsed` 是这条台词**进场后**的秒数。
static func reveal_count(text: String, elapsed: float, cps := CPS) -> int:
	if elapsed <= 0.0:
		return 0
	return clampi(int(elapsed * cps), 0, text.length())
