static func colony_ruins() -> MapDef:
	var m := MapDef.new()
	m.id = Id.COLONY_RUINS
	m.terrain = Terrain.COLONY_RUINS
	m.name_cn = "殖民卫星废墟"
	m.code = "COLONY_RUINS"
	m.blurb = "破碎筒体 · 废弃街区 · 漂浮残骸\n内部与附近宙域不定时电弧放电"
	m.accent = Color(0.48,0.73,1.0)
	m.ground_swatch = Color(0.12,0.16,0.19)
	m.has_ground = false
	m.ground_collision_damage = false
	m.orbit_alt = 12000.0
	m.reentry_alt = 3000.0
	m.body_radius = 0.0
	m.cloud_density = 0.0
	m.cloud_altitude_offset = 0.0
	m.time_of_day = TimeOfDay.space()
	m.time_of_day.sky_zenith = Color(0.001,0.002,0.005)
	m.time_of_day.sky_horizon = Color(0.004,0.007,0.015)
	m.time_of_day.sky_ground = Color(0.001,0.002,0.005)
	# Match Pacific night combat's cool moonlight; keep the space preset's clear vacuum.
	var night := pacific().time_of_day
	m.time_of_day.sun_rotation_deg = night.sun_rotation_deg
	m.time_of_day.sun_color = night.sun_color
	m.time_of_day.sun_energy = night.sun_energy
	m.time_of_day.exposure = night.exposure
	m.time_of_day.glow_intensity = night.glow_intensity
	# The bright star field must not wash the interior back up to daytime brightness.
	m.time_of_day.ambient_sky_contribution = 0.0
	m.time_of_day.ambient_color = Color(0.075,0.10,0.18)
	m.time_of_day.ambient_energy = night.ambient_energy
	m.time_of_day.disc_color = night.disc_color
	m.time_of_day.disc_amount = night.disc_amount
	return m
