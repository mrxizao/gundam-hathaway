static func by_id(id: int) -> MapDef:
	match id:
		Id.ULURU:
			return uluru()
		Id.RANGE:
			return training_range()
		Id.OENBELLI:
			return oenbelli()
		Id.DAVAO:
			return davao()
		Id.LEO:
			return leo()
		Id.AXIS:
			return axis()
		Id.COLONY_RUINS:
			return colony_ruins()
		Id.ADELAIDE:
			return adelaide()
	return pacific()


