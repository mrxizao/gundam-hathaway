static func arizeus_speed_scale(form: int) -> float:
	var base := penelope().speed_scale
	match form:
		ArizeusForm.CRUISE:
			base = penelope().speed_scale * ARIZEUS_CRUISE_VS_PENELOPE
		ArizeusForm.CORE_NU:
			base = xi().speed_scale * ARIZEUS_CORE_VS_XI
	return base * ARIZEUS_SPEED_NERF


## 阿利宙斯 TX-ff104（『閃光のハサウェイ キルケーの魔女』原创机，核心是 RX-94 量产型ν高达）。
##
## 三个形态共用"外壳"这一份耐久（巡航/常态的血与盾完全一样）：
## 巡航形态只是**飞行形态**，不是另一台机，所以耐久不该跟着变形变。
## 真正的耐久变化只发生在"外壳剥离"那一次 —— 那一次之后就是核心自己的血条了。
static func arizeus(form: int = ArizeusForm.NORMAL) -> SuitProfile:
	var p := SuitProfile.new()
	p.id = Id.ARIZEUS
	p.form = form
	p.form_count = 3
	p.form_names = ["巡航形态", "常态", "核心 · 量产型ν高达"]
	p.transform_hull_ratio = 0.01
	p.transform_to_form = ArizeusForm.CORE_NU
	p.turn_scale = 1.15
	p.rifle_damage = 7.0
	p.rifle_interval = 0.80
	p.rifle_count = 1
	p.funnel_damage = 10.0 * MISSILE_DAMAGE_MULT
	p.saber_damage = 22.0
	# 用户指定：阿利宙斯的巡航音沿用柯西那一条（三个形态都一样 ——
	# 引擎音挂在机体上、只在 _ready 里建一次，形态切换不会换音源）。
	p.engine_sound = "cruise_xi"

	# ---- ★ 保留「左右冲刺转身」的机体**之二**（2026-09-29 用户要求）----
	# 用户原话：「阿利宙斯可以做左右冲刺转身」。
	# ⚠️ **故意放在 `match form` 之外、不按形态分支**：三个形态（含巡航）都拿到
	#    `true`。巡航形态在 `PlayerController.assist_uses_translation()` 里恒 `false`
	#    ⇒ 不进平移模式 ⇒ 转身**结构上不可能发生**（配置空转，不是 bug）。
	#    ⛔ 别在这里挖一个 `if form != CRUISE` 的例外 —— 那等于把
	#       `assist_uses_translation()` 的约束**再写第二遍**（两处迟早打架、而且不报错），
	#       还会让"以后巡航形态被放行进入平移模式"时**静默地不转**。
	#    判据不靠配置表达"这台不适用"，而是靠探针的 `N/A` 分支（见 `probe_dash_spin_fleet.gd`）。
	p.dash_spin_visual = true

	match form:
		ArizeusForm.CRUISE:
			p.display_name = "阿利宙斯 · 巡航形态"
			p.model_name = "TX-ff104 ARIZEUS / FLIGHT FORM"
			p.model_path = "res://assets/models/arizeus/tx_ff104_arizeus_cruise.glb"
			# 模型自身（**2026-09-19 换过一版**，用 `tools/probe_model.tscn` 实测）：
			# 宽 X 0.6372、高 Y **0.5088**、长 Z 0.9673。
			#
			# ⚠️ 高 Y 之所以比上一版（0.4297）**高了 18%**：上一版被模型管线的
			# "扁平件判据"把**垂直尾翼**当废料删掉了，恢复之后包围盒向下长长了一段
			# （和常态同因：尾翼是往下垂的，机体本身没变高）。
			# 缩放读的是包围盒高度，所以下面的 target_height 必须同步放大。
			#
			# 下面的数按"**全长维持 38.9 m 不变**"反算（长度 0.9673 这次没动）：
			#   缩放 = 38.9 ÷ 0.9673 ≈ 40.25（与换模型前逐位相同）
			#   ⇒ target_height = 40.25 × 0.5088 ≈ 20.48（**含尾翼下垂段的包围盒高**）
			#   翼展 = 0.6372 × 40.25 ≈ 25.7 m（也没变）
			p.model_native_height = 0.5088
			p.target_height = 20.48
			# 背后 16 个推进器喷口：**淡紫色**发光 + 喷射轨迹（用户指定）。
			# 坐标见 `CRUISE_PLUMES` 的说明（从后视渲染图自动识别出来的）。
			p.engine_plumes = CRUISE_PLUMES
			# 淡紫。**alpha 不能高**：加色混合下 16 个喷口会叠成一团白，
			# 所以这里给的是"偏淡的紫 + 低不透明度"，靠数量堆出亮度而不是靠单个亮。
