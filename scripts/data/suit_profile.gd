	#   ② `form_off`    —— **退出**巡航时先播一次（N42·二十二）。`form_on` 的严格镜像：
	#                      首帧逐位 = 巡航待机姿态、末帧逐位 = `fly` 首帧，中间 smoothstep。
	#                      起因 = 用户实测「切回正常飞行时有点生硬」：原来回程只有
	#                      0.18 s 交叉淡入、且要先干等 0.23 s（逐帧轨迹在 `_relay/`）。
	#   ③ `cruise_idle` —— 巡航**待机循环**。姿态 = rest 身体 + 14 根形态驱动骨，
	#                      即 `柯西巡航2.0`（A 档实测 vs 参照 `max 0.0137 m`、202/203 件零差）。
	#
	# ## 与 `model_form_curve` 的关系
	#
	# `model_form_curve`（形态层曲线源）**保留但不再生效** —— `FlightBody._setup_cruise_form()`
	# 现在只要看到 `cruise_idle` 真的挂上了就让位（两套载体同时写同一批骨 ⇒ 必然打架）。
	# 保留它是**回滚抓手**：把下面两行清空 ⇒ 自动退回形态层那条老路。
	#
	# 证据：`gundam-anim/_relay/DESIGN-N42-21-cruise-form.md`（审查 + 方案）、
	#       `_relay/REPORT-N42-20-screen-verdict.md`（实机判决）。
	p.model_anim_idle_cruise = "cruise_idle"
	p.model_anim_form_on = "form_on"
	p.model_anim_form_off = "form_off"
	# 耐久（血量 + I 立场）。
	#
	# 演进史（每一轮的取值都是实测出来的，别凭手感改回去）：
	#   最初     115 / 190 —— 1v1 四十秒就结束，太快
	#   第七轮   ×3  → 345 / 570 —— 配合伤害整体下压，AI 对打落到 2:13 ~ 4:36
	#   第八轮   ×0.63 → **217 / 359** —— 用户实测"11 分钟还是太漫长"，
	#            要求**血量和护盾都砍到现在的 63%**（345×0.63≈217、570×0.63≈359）。
	#            相对最初始的 115 / 190 就是 **×1.89**。
	# 判据：`tools/probe_ttk.tscn`（两个真 AI 对打，量到的是"双方都打得准"的**下限**，
	# 真人只会更慢）；`suite_abilities` 里有断言盯着"血与盾被同一个比例削掉"。
	p.hull_hp = 217.0
	p.ifield_hp = 359.0
	p.shield_reduction = SHIELD_REDUCTION
	p.rifle_count = 3
	p.rifle_damage = 7.0
	p.rifle_interval = 0.78
	# 困难**柯西**已经很难 ⇒ 只能小幅上调（用户给的上限就是 20%）。
	p.hard_enemy_reinforce = 1.2
	# 批 14：浮游导弹总量无限，这里只定弹夹容量（150 发/夹，打空自动换弹）
	p.funnel_count = 150
	p.funnel_damage = 10.0 * MISSILE_DAMAGE_MULT
	p.saber_damage = 22.0
	p.turn_scale = 1.30
	# ---- 军刀刃色（2026-09-29，用户指定：「柯西的光束军刀应该是绿色的」）----
	#
	# 绿得**偏亮**（g = 1.0、r/b 都压到 0.40~0.50）：军刀是 additive 混合，
	# 外刃外面还叠一层近白内芯；主色若取暗绿，叠出来会读成灰绿而不是「一道光」。
	# 柯西的 `accent` 是琥珀橙，所以这里**必须**单独指定 —— 兜底走 accent 的话刀是橙的。
	p.saber_beam_color = Color(0.40, 1.0, 0.50, 1.0)
	p.rifle_beam_color = Color(0.40, 1.0, 0.50, 1.0)
	# ---- 柯西是**双头剑**（用户指定：「柯西是双头剑，上长下短」）----
	#
	# 上/前刃 15.0（与既有单头剑同长 ⇒ 前刃观感不变），下/后刃 9.0
	# （示意值，见 `DESIGN-2026-10-03-…` §5.6 —— 要改就改这一个数）。
	# ⚠️ 其余机体**不许**跟着变：`saber_double` / `saber_blade_rear` 的默认值
	#    就是为此留的（佩涅罗佩 / 阿利宙斯 / 古斯塔夫 / 梅萨 全是单头剑）。
	p.saber_double = true
	p.saber_blade_front = 15.0
	p.saber_blade_rear = 9.0
	# 批 8：三机速度整体上调并收敛到近似值 —— 柯西 1.50 / 佩涅罗佩 1.55 / 巡航 ×1.03
	p.speed_scale = 1.50
	p.can_discard_rifle = true
	p.discard_unlockable_seconds = 15.0
	p.accent = Color(1.0, 0.80, 0.42)
	p.cannon_beam_color = p.accent
	# ---- 尾焰（2026-09-25，用户三条指定一起落地）----
	# 「柯西的尾焰特效也应该在背部喷口处」⇒ 喷口从"机尾单点"改成背包那两个（2026-09-27 又补了左右小腿后侧各一个，见 `XI_PLUMES` 的说明）；
	# 「三台机体的尾焰特效要做区分，柯西是黄色的」⇒ **黄**。
	# 填充 alpha 给 0.70（阿利宙斯 16 个口才用 0.42 —— 口越少，单个可以越实）。
	p.engine_plumes = XI_PLUMES
	p.engine_plume_color = Color(1.0, 0.80, 0.22, 0.70)
	# 喷口口径 ~1 m：背包上下那两口本来就小（全高 28 m 上的 2%）。
	# 小腿后侧那两口（2026-09-27 增）用**同一个半径** —— 它们口径与背包口相近，
	# 而且 `engine_plume_radius` 是**逐机一个**、不分口的（要按口给得先改架构）。
	p.engine_plume_radius = 1.0
	p.engine_sound = "cruise_xi"
	p.blurb = "特色：可丢枪强行脱锁"
	# 背景文案由用户提供（官方设定）。整段不插 \n，交给主菜单按像素宽度自动折行 ——
	# 手写换行遇到卡片宽度变化就会变得难看。
	p.lore = ("本机是马夫蒂为袭击阿德莱德会议而准备的，由阿纳海姆电子公司制造的第五代 MS。"
		+ "本机与佩涅罗佩互为姐妹机，但其搭载的内置式米诺夫斯基飞行系统，"
		+ "则是一项更为划时代的技术。"
		+ "其头顶高超过 26 米，臂部也比标准的 MS 大上许多，"
		+ "虽冠有「高达」之名，造型上却尽显异形的轮廓。")
	return p


static func penelope() -> SuitProfile:
	var p := SuitProfile.new()
	p.id = Id.PENELOPE
	p.display_name = "佩涅罗佩"
	p.model_name = "RX-104FF PENELOPE"
	# ---- 引擎循环音：**全场唯一**用她自己那条的机体（轮 49 · 2026-09-30）----
	#
	# 用户：「把除了佩涅罗佩以外的机体的巡航声都使用成柯西的引擎声 ——
	#       因为佩涅罗佩的巡航声过于独特，只能这样使用。」
	# ⇒ 规则是"默认 = 柯西那条、**佩涅罗佩是唯一的例外**"。
	#   例外**必须显式写出来**，不能靠"默认值碰巧是佩涅罗佩那条"——那样默认值一改，
	#   例外就悄悄跟着变；而且没人能一眼看出"到底谁在用这一条"。
	#   写显式之后，全工程 `cruise_penelope` 的**赋值点只有这一处**（grep 一次就知道）。
	p.form = 0
	p.form_count = 2
	p.form_names = ["佩涅罗佩", "奥德修斯高达"]
	p.transform_hull_ratio = 0.01
	p.transform_to_form = 1
	p.engine_sound = "cruise_penelope"
	# ---- 模型换代（N44 · 2026-09-28）----
	# 用户：「把佩涅罗佩的新模型装进 godot 里」⇒ `model_path` 从 **09-17 的无骨架旧件**
	# 2026-10-13：新版佩涅罗佩，39 个兼容战斗关节 + 176 个刚性分件关节。
	# 常态和巡航形态使用新资产，现有射击 / 军刀 / 方向动作重新绑定。
	p.model_path = "res://assets/models/penelope_movie/penelope_movie_rigged.scn"
	p.model_native_height = 0.999
	p.target_height = 32.5
	# ---- 左右冲刺**不转身**（N45 · 2026-09-28；2026-09-29 起**全机体**如此）----
	# 用户 2026-09-28：「取消掉佩涅罗佩的左右冲刺转身，不然我没法看到八向冲刺动作
	# 到底实装没有」；2026-09-29：「除了柯西以外的其他机体都不做翻滚转身」。
	# ★ 现在这一行**与字段默认值相同**（默认已是 `false`）—— 保留它只为留一条
	#   可 grep 的显式记录，⛔ 不代表"佩涅罗佩是个例外"。
	# ★ 关的是**只改视觉层**的 `spin_pivot`，逻辑口径（`global_transform` / 速度矢量 /
	#   机头朝向 / 锚点 / 锁定）本来就不吃转身 ⇒ 物理行为**逐位不变**。
	# ⚠️ 连带关掉"转身期间形态收起"（共用 `_dash_spin_t` 窗口）—— 见字段注释。
	p.dash_spin_visual = true
	# 用户指定：佩涅罗佩的**血量与护盾都是柯西的 130%、飞行速度是 150%**，
	# 但**两机伤害差不多** —— 所以武器伤害不跟着涨，涨的只有耐久与速度。
	# 数值 = 柯西的 217 / 359 × 1.3（≈ 282 / 467），测试里有一条断言盯着这个比例。
	p.hull_hp = 282.0
	p.ifield_hp = 467.0
	p.shield_reduction = SHIELD_REDUCTION
	# 佩涅罗佩不能丢枪，多带几把没有意义 —— 用户要求只带一把
	p.rifle_count = 1
	p.rifle_damage = 7.0
	p.rifle_interval = 0.82
	# ---- 蓄力激光炮（2026-09-29 用户指定：「把阿利宙斯的光束大炮也给佩涅罗佩」）----
	#
	# ★ 只开 `cannon_enabled`，**刻意不开 `rifle_fire_on_release`**：
	#   用户在同一条指令里拍板「**保住连发**」—— 她的步枪是上面那行
	#   1 门 / 6 发 / 0.82 s 的洒水枪，改成"松手单发"等于把连射废掉。
	#   路由（`PlayerController.rifle_press_route()`）于是变成：
	#     · 按下那一刻 `cannon_ready()`（满弹匣 + 无冷却 + 不换弹）⇒ 这一按次蓄力；
	#     · 其余按次 ⇒ 逐帧走老路，按住照旧连发。
	#   ⚠️ 代价（用户已确认）：**大炮就绪时那一匣不能按住洒水、只能连点** ——
	#     这是"大炮只能在弹夹全满时使用"这条硬门槛的必然结果，不是 bug。
	#
	# ★ 数值全部读字段默认值（1.7 / 35 / 4 / 20 / 15），与阿利宙斯同源。
	#   用户说的是"**也给**"，不是"给一门不一样的"。
	p.cannon_enabled = true
	# ---- 光束色：粉紫（2026-09-30 用户指定：「佩涅罗佩的光束大炮和光束步枪的子弹颜色都改成粉紫色」）----
	#
	# ★ **一个字段管两条通道** —— `beam_color()` 是步枪弹体与大炮光柱**共用**的取色口：
	#         · 步枪：`FlightBody.fire_beam()` -> `Projectile.beam(..., profile.beam_color(), ...)`
	#         · 大炮：`FlightBody.fire_cannon()` -> `BeamCannon.launch(..., profile.beam_color())`
