static func hull_bar_ref() -> float:
	return maxf(maxf(xi().hull_hp, penelope().hull_hp),
		maxf(arizeus().hull_hp, messer_m01().hull_hp)) * 1.06


static func ifield_bar_ref() -> float:
	return maxf(maxf(xi().ifield_hp, penelope().ifield_hp),
