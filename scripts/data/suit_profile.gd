	p.model_anim_idle = ""
	p.model_anim_files = [
		# ---- 高速机动八向（8）：`dash_*` = `translate_dir` 的 8 个水平离散方向（N32 · U7）----
		"res://assets/models/messer/anim/messer_dash_b.glb",
