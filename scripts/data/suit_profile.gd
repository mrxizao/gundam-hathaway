	p.hull_hp = 90.0
	p.ifield_hp = 0.0
	# ⚠️ ★63-9 B6：**这台没有盾** ⇒ 显式 0.0，**不等于**统一值 `SHIELD_REDUCTION`。
	# 它是训练场里不还手的靶机，`suite_damage` 有一条断言专门盯住这个“例外”。
	p.shield_reduction = 0.0
	p.rifle_count = 0
	p.funnel_count = 0
	p.vulcan_ammo = 0
	# **没有导弹**：靶机与武装版都遵守这一条（用户点名）
	p.has_missiles = false
	p.has_saber = false
	p.speed_scale = 0.55
	p.turn_scale = 1.0
	p.can_discard_rifle = false
