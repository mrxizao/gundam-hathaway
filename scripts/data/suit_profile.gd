	p.model_yaw_deg = 90.0
	# 骨架同样由相似变换贴来（`transfer_rig_ms.py -- f01`），出口判据①最大偏差
	# **5.219e-05°** ⇒ 27 段动作同 `messer_cmd()` 一样直接复用派生来的那一份。
	# ★ 本机 `scale = 0.999997`（几乎正好 1）⇒ 连动画的位移通道都是精确的，
