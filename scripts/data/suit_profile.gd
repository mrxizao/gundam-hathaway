		"res://assets/models/gustav/anim/gustav_dash_r.glb",
		# ---- 常态飞行八向（8）：`fly_*` ----
		"res://assets/models/gustav/anim/gustav_fly_b.glb",
		"res://assets/models/gustav/anim/gustav_fly_bl.glb",
		"res://assets/models/gustav/anim/gustav_fly_br.glb",
		"res://assets/models/gustav/anim/gustav_fly_f.glb",
		"res://assets/models/gustav/anim/gustav_fly_fl.glb",
		"res://assets/models/gustav/anim/gustav_fly_fr.glb",
		"res://assets/models/gustav/anim/gustav_fly_l.glb",
		"res://assets/models/gustav/anim/gustav_fly_r.glb",
		# ---- 姿态微调（6）：`turn_*` = 输入动作语义，幅度 ≤12°（N32）----
