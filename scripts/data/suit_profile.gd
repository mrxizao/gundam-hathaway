static func xi() -> SuitProfile:
	var p := SuitProfile.new()
	p.id = Id.XI
	p.display_name = "柯西高达"
	p.model_name = "RX-105 Ξ GUNDAM"
	p.model_path = "res://assets/models/xi_movie/xi_movie_rigged.scn"
	# Movie source originally faces +X; the offline binding normalizes it to
	# the compatible +Z rig frame. The existing yaw correction still applies.
	p.model_yaw_deg = 180.0
	# 1.2 第二次重建：用户换了**常态模型**（柯西常态.glb），与巡航模型
	# **202 个部件 1:1 对应、顶点与面数完全一致** —— 比上一版干净得多
	# （上一版的常态模型有 23 个部件在巡航里不存在，只能靠"收缩成一点"掩盖）。
	# 全高回到 0.9814（与最早的 FBX 版一致），所以这一行也要跟着改。
	p.model_native_height = 0.9814
	p.target_height = 28.0
	p.cruise_morph = true
	p.cruise_morph_seconds = 0.45
	# ---- ★ 保留「左右冲刺转身」的机体**之一**（2026-09-29 用户要求）----
	# 用户原话：「除了柯西以外的其他机体都不做翻滚转身」。
	# 字段默认已是 `false`（见 `dash_spin_visual` 的注释）：显式打开的只有
	# **本函数**与 `arizeus()` **两处**，所以"谁在转"用一次 grep 就能查全
	# —— 这就是把默认值翻过来的目的。
	p.dash_spin_visual = true
	# ---- 模型自带骨骼动画（2026-09-26 · 棒 12）----
	#
	# 柯西是**目前唯一**有骨骼动画的机体（Blender 管线交付 `fly` / `burst` /
	# `burst_cruise` 三段，见 `gundam-anim` 的 `bodies\xi\out\`）。
	#
	# ★ 2026-09-26（棒 12）**已切换**：`model_path` 从老资产
	#   `rx105_xi_gundam.glb` 换到 `xi_fly.glb`（含骨架的那件）。
	#
	#   为什么现在能换了 —— 当初的顾虑与它的解除：
	#
	#   顾虑：柯西的巡航变形（按住 Shift 的 0.45 s）原来靠老资产那**一个
	#   blend shape** 驱动，而三件新 glb 的 `blend shape = 0`（探针实测），
	#   直接换过去 ⇒ **变形静默失效**（不动、不报错）。
	#
	#   解除：`CruiseFormModifier`（`scripts/flight/cruise_form_modifier.gd`）
	#   就是那个 **`cruise_on` 的骨骼版** —— 它挂到骨架的求值链上
	#  （`SkeletonModifier3D._process_modification()`），按 `cruise_morph`
	#   把 8 根形态骨从 `fly` 的姿态 slerp 到巡航姿态。巡航姿态基准直接取自
	#   `burst_cruise` 的**末帧**（上游 PIPELINE §9.2 明确它是"巡航形态的待机"），
	#   **不需要新动作**，所以不必等棒 8 的 `cruise_on`。
	#
	#   实测（探针 ⑩ 段 + `xi_form_*.png` 对照图）：按住 Shift 时
