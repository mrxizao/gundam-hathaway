	# 安装形态 = **剥壳件**（只留骨架 + 动画，删网格 / 贴图 / 材质）：
	#   交付的每个动作 glb 都是**完整场景导出**（203 网格 + 202 贴图 = 3.30 MB，占 78%），
	#   真正的动作数据 < 0.2 MB ⇒ 33 段原样装 = 139 MB（其中 109 MB 是同一套贴图重复 33 遍），
	#   而 `ModelAnimator._graft_extras()` 是**每次建体时逐个 load 全部 extras** 的
	#   ⇒ 每次柯西入场要读 142 MB、建 6700 个 `MeshInstance3D`。
	#   剥壳后合计 **5.4 MB**（缩小 25.7x），`MeshInstance3D` 0 个。
	#
	#   Godot 侧已实测（`glb_strip_anim.py` 自检 + Godot headless 探针）：
	#     剥壳件 `AnimationPlayer`=1、动画名一致、
	#     **轨道路径 `Xi_Rig/Skeleton3D:<骨名>` 与原文件逐字一致**、
	#     `Skeleton3D`=1 / **50 骨逐字一致** / 相对路径 `Xi_Rig/Skeleton3D` 相同。
	#     ⇒ Godot 导入器**不依赖网格节点生成骨架**（skin 成孤儿也照 `joints` 建）。
	#
	# ⚠️ `model_path`（= `xi_fly.glb`）**不剥** —— 它要显示模型，必须带网格贴图。
	#   旧清单里列了它自己：`_graft_extras()` 的同名判断会让它一个动作都加不上，
	#   纯粹白 load 4.12 MB 再 instantiate 203 网格 ⇒ **本轮去掉**。
	#   它的 `fly` 动作由主实例自带，见上面的 `model_anim_idle`。
	#
	# ⚠️ `xi_morph_anim3.glb` 也装在 `anim/` 但**刻意不登记**：骨架只有 **37 骨**
	#   （其余 32 段都是 50 骨），动画名是 Blender 默认的 `Xi_RigAction`，
	#   属**变形动画**而非骨骼动作段 ⇒ 登记进去会污染动作表。
	#   ★ 2026-09-27 起它**连曲线源也不是了**（`model_form_curve` 已改用
	#   `xi_cruise_on.glb`，因为用户要「6 根一起展开」而它是分段的）
	#   ⇒ 它当前**零消费者**，留在工程里备查。
	p.model_anim_files = [
		# ---- 一次性动作（6）----
		"res://assets/models/xi/anim/xi_burst.glb",
		"res://assets/models/xi/anim/xi_burst_cruise.glb",
		"res://assets/models/xi/anim/xi_cruise_on.glb",
		"res://assets/models/xi/anim/xi_shield.glb",
		"res://assets/models/xi/anim/xi_shoot.glb",
		"res://assets/models/xi/anim/xi_slash.glb",
		# ---- ★ 巡航形态（3 · N42·二十一 方案 B / N42·二十二 回程）----
		#   `form_on`     常态 → 巡航的过渡（0.4333 s；首帧 = 常态、末帧 = 巡航待机首帧）
		#   `form_off`    巡航 → 常态的过渡（0.4333 s；首帧 = 巡航待机、末帧 = `fly` 首帧）
		#   `cruise_idle` 巡航待机循环（rest 身体 + 翼展 = `柯西巡航2.0`）
		"res://assets/models/xi/anim/xi_form_on.glb",
		"res://assets/models/xi/anim/xi_form_off.glb",
		"res://assets/models/xi/anim/xi_cruise_idle.glb",
		# ---- 形态过渡（4）----
		"res://assets/models/xi/anim/xi_trans_burst_to_fly.glb",
		"res://assets/models/xi/anim/xi_trans_fly_to_burst.glb",
		"res://assets/models/xi/anim/xi_trans_fly_to_slash.glb",
		"res://assets/models/xi/anim/xi_trans_slash_to_fly.glb",
		# ---- 巡航八向（8）：`dash_*` = `translate_dir` 的 8 个水平离散方向（N32 · U7）----
		"res://assets/models/xi/anim/xi_dash_b.glb",
		"res://assets/models/xi/anim/xi_dash_bl.glb",
		"res://assets/models/xi/anim/xi_dash_br.glb",
		"res://assets/models/xi/anim/xi_dash_f.glb",
		"res://assets/models/xi/anim/xi_dash_fl.glb",
		"res://assets/models/xi/anim/xi_dash_fr.glb",
		"res://assets/models/xi/anim/xi_dash_l.glb",
		"res://assets/models/xi/anim/xi_dash_r.glb",
		# ---- 常态八向（8）：`fly_*` ----
		"res://assets/models/xi/anim/xi_fly_b.glb",
		"res://assets/models/xi/anim/xi_fly_bl.glb",
		"res://assets/models/xi/anim/xi_fly_br.glb",
		"res://assets/models/xi/anim/xi_fly_f.glb",
		"res://assets/models/xi/anim/xi_fly_fl.glb",
		"res://assets/models/xi/anim/xi_fly_fr.glb",
		"res://assets/models/xi/anim/xi_fly_l.glb",
		"res://assets/models/xi/anim/xi_fly_r.glb",
