	# 涂装：模型是**砂棕 + 米白 + 金**（比 M01 更浅、更"沙漠化"的一套）。
	p.accent = Color(0.92, 0.70, 0.32)
	p.blurb = "特色：与 M01 同规格 · 砂色涂装 · 哈萨维队的主力型"
	p.lore = ("梅萨F01型。与M01型并非出自同一生产线，外观形状差异很大，"
		+ "但内部骨架及基本规格皆为同一标准 —— 差别主要体现在零件构成与涂装。"
		+ "它是哈萨维等人作为主力使用的梅萨，在达沃一带的作战中与M型混编出击。")
	return p


