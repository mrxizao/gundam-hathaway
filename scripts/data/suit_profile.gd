## **新手教学的练习步骤**（1.2 第二十五轮）。
##
## 和 `features()` 同一个思路：**从字段里算**，不手写。
## 手写的清单会在"某台机没有军刀"这类情况下教错东西
##（比如让一台没有军刀的机去练挥刀）。
##
## 顺序按"先会飞、再会打、最后才讲这台机的特色"排 ——
## 教学最忌讳一上来就讲特色。
## 返回 `Array[String]`。
func tutorial_steps() -> Array[String]:
	var out: Array[String] = []
	out.append("① 起飞与巡航：W / S 推油门，先绕靶场飞一圈熟悉转弯半径")
	out.append("② 加速与减速：按住 Shift 加速、松开回巡航 —— 注意速度变化的迟滞")
	out.append("③ 锁定与开火：把机头对准靶机、等锁定框咬住，按 R2 开火")
	out.append("④ 提前量：对着**横向移动**的靶机打，瞄它前面一点 —— 这是核心")
	if has_missiles and funnel_count > 0:
		out.append("⑤ 浮游导弹：按 R1 全弹发射。靶机不会躲，先用它熟悉导弹手感")
	else:
		out.append("⑤ 没有导弹：这台机只能靠步枪与军刀，所以第 ④ 步的提前量更要练准")
	if has_saber:
		out.append("⑥ 军刀突进：按 L2。靶机不会挥刀，所以这里只练突进的时机与角度")
	if vulcan_ammo > 0:
		out.append("⑦ 拦截：对着靶机发射导弹（部分机体有），再用火神炮（Y）打下来")
	if has_jet_gauge:
		out.append("⑧ 燃料槽：一路按死 Shift，看槽怎么掉 —— 它只够 %.0f 秒" % jet_seconds)
	if can_ride_pedal():
		out.append("⑨ 飞行踏板：按 N 呼叫（它会从天而降）。骑上后加速响应更快、"
			+ "转向更钝、且不烧自己的槽；按 T 脱离")
	if cruise_morph:
		out.append("⑩ 变形：按住加速变成巡航形态（更快、更钝），松手倒放变回来")
	out.append("⑪ 自由练习：把上面这些连起来 —— 靶机不会还手，随便试")
	return out


## 一句话概括这台机的操作手感（给"特色详解"最后一条用）。
func _feel_word() -> String:
	if speed_scale >= 1.15:
		return "**快而钝**（直线最强、转弯最差）"
	if speed_scale <= 0.60:
		return "**慢而稳**（跑不掉，但也不容易被甩开）"
	if turn_scale >= 1.10:
		return "**灵活**（转得比别人快，能耗死对手）"
	return "**均衡**（没有明显短板，也没有明显长板）"


