static func by_id(id: int) -> SuitProfile:
	if is_thunderbolt(id): return thunderbolt(id == Id.PSYCHO_ZAKU_TB)
	if id == Id.ZORIN_SOUL: return zorin_soul()
	if id == Id.NU_GUNDAM: return nu_gundam()
	if id==Id.SAZABI:return sazabi()
	if id == Id.REGZ_CUSTOM: return regz_custom()
	if id == Id.XI_FINAL: return xi_final()
	if id == Id.GP03S: return gp03s()
	if id == Id.NEUE_ZIEL:
		return neue_ziel()
	if id == Id.GP03D:
		return gp03d()
	if id == Id.PENELOPE:
		return penelope()
	if id == Id.ARIZEUS:
		return arizeus(ArizeusForm.NORMAL)
	if id == Id.MESSER_M01:
		return messer_m01()
	if id == Id.MESSER_CMD:
		return messer_cmd()
	if id == Id.MESSER_F01:
		return messer_f01()
	if id == Id.GUSTAV00:
		# ⚠️ **默认给"武装版"**。
		#
		# 古斯塔夫有两副面孔：`gustav00()`（训练靶机，不还手）与
		# `gustav00_armed()`（挑战里的护航机，有步枪/火神炮/军刀、没有导弹）。
		# 剧情脚本里写的是 `SuitProfile.Id.GUSTAV00`，而 `_attach_ai()` 走的是
		# 这里 —— 所以这一行决定"挑战里那两架古斯塔夫会不会开枪"。
		#
		# 写成 `gustav00()`（靶机版）的代价是**静默的**：它们照样出生、照样能被锁定，
		# 只是 `rifle_count = 0 / vulcan_ammo = 0`，于是整场一枪不放，
		# HUD 还显示"古斯塔夫00（靶机）"——"要先清掉的两架杂兵"变成两个活靶子，
		# 而 `gustav00_armed()` 变成**全文零引用的死代码**（这个 bug 就是这么来的）。
		#
		# 靶机版只能被**显式**索取（`main.spawn_training()` 里就是这么写的），
		# 绝不作为 `by_id` 的默认值。
		return gustav00_armed()
	return xi()


## 这台机的全部形态（单形态机体返回 `[0]`）。
static func forms_of(id: int) -> Array[int]:
	if id == Id.REGZ_CUSTOM: return [0,1]
	if id == Id.PENELOPE: return [0,1]
	if id == Id.GP03D:
		return [0,1]
	if id == Id.ARIZEUS:
		return [ArizeusForm.CRUISE, ArizeusForm.NORMAL, ArizeusForm.CORE_NU]
	return [0]


static func by_id_form(id: int, form: int) -> SuitProfile:
	if id == Id.REGZ_CUSTOM: return regz_custom(form)
	if id == Id.PENELOPE and form == 1: return odysseus()
	if id == Id.GP03S or (id == Id.GP03D and form == 1): return gp03s()
	if id == Id.ARIZEUS:
		return arizeus(form)
	return by_id(id)


func form_name() -> String:
	if form >= 0 and form < form_names.size():
		return form_names[form]
	return ""


## 出生初速占柯西巡航的比例。
##
## 这是"开局时飞机有多快"这个**手感量**的唯一真源。0.275 不是新拍的：
## 它正好复现旧字面量 —— ×1.5 时柯西实际巡航 945 × 0.275 = **259.9 ≈ 260**。
const SPAWN_SPEED_RATIO := 0.275


## 出生初速（m/s，**实际域**）。= 柯西的**实际巡航** × `SPAWN_SPEED_RATIO`
## ⇒ ×2.4 下 = 1512 × 0.275 = **416 m/s**。
##
## ## 为什么必须是"从速度推出来"的，不能写成字面量
##
## 原来是 `main.gd` 里三处写死的 `260.0`。那个数在 ×1.5 的世界里没问题
##（柯西失速线 = 945 × 0.18 = 170.1 < 260），但**速度再涨一档就会静默出事**：
##
##   ×2.4 下柯西失速线 = 1512 × 0.18 = **272.2 > 260**
##
## ⇒ 出生的**第一帧** `stalled = speed < stall_speed` 就是 `true`（`FlightModel`
## 第 206 行），于是开局头几帧舵效只有 30%、机头还在自己往下掉。
## 佩涅罗佩（失速线 281.2）与阿利宙斯巡航态（289.7）比柯西更早越线。
##
## 几帧而已、肉眼看不出来 —— 但它是一条**真的断掉的不变量**
##（"出生速度必须在失速线之上"），而且坏法是"以后速度再涨就越来越明显"。
##
## 写成比例之后：速度涨多少、出生初速跟着涨多少，**永远在失速线上方**；
## 而且 `main.gd` 里不再有第二个速度真源。
## ⚠️ 顺带一个好处：HUD 在出生那一瞬读到的数字也是**不随倍率变**的
##（`real × 3.6 × 0.6 / SPEED_REAL_MULT` 里的倍率被这次乘法约掉了）。
static func spawn_speed() -> float:
	return xi().player_top_speed() * SPAWN_SPEED_RATIO


## 玩家侧的速度上限：巡航 = 基准 × 机体速度系数，加速 = 再 ×1.5。
##
## ⚠️ 2026-09-25 起这两个数**是实际速度**（已含 `SPEED_REAL_MULT`）。
## 需要屏上那个数字请走 `speed_to_display()`。
func effective_speed_scale() -> float:
	if id in [Id.NU_GUNDAM,Id.SAZABI] and Game.active_map != null and not Game.active_map.has_ground: return xi().speed_scale
	return speed_scale

func player_top_speed() -> float:
	return XI_REFERENCE_SPEED * effective_speed_scale() * SPEED_REAL_MULT


func player_boost_speed() -> float:
	return XI_REFERENCE_SPEED * PLAYER_BOOST_MULT * effective_speed_scale() * SPEED_REAL_MULT


## 敌机侧的速度上限：基准 × 难度倍率 × 机体速度系数（加速不额外提升）。
##
## ⚠️ **这是难度表的"原始契约"，不是实际战斗用的那个数**。
## 实战走 `enemy_top_speed_capped()` —— 它在这一条之上再压一道天花板，
## 原因见 `ENEMY_SPEED_CEILING_RATIO`。
func enemy_top_speed(speed_mult: float) -> float:
	return XI_REFERENCE_SPEED * speed_mult * effective_speed_scale() * SPEED_REAL_MULT


## ---- 敌机速度硬上限（第十四轮 B5，来自玩家实测）----
##
## 反馈原话："还有就是感觉**很难追上敌机**吧"（手柄 / 中等难度 / 三台机都试过）。
##
## 数值一算就明白，这**不是手感问题**：难度倍率只乘在敌机上，玩家侧不参与这个乘法 ——
##
## | | 巡航 | 加力 |
## |---|---|---|
## | 玩家默认那台柯西 | 420 | **630** |
## | 中等难度敌机 · 佩涅罗佩 | **737** | — |
## | 中等难度敌机 · 阿利宙斯巡航态 | **826** | — |
##
## 玩家把加力按死也只有 630，追尾在数学上不可能。连带后果是"近身的机会感觉很少"
## → 光束军刀永远用不上（同一位试玩者的下一条反馈）。
##
## 修法：给敌机速度压一道**跟着玩家加力上限走**的天花板。敌机仍然比玩家巡航快
## （仍然要玩家用加力才追得上），但不可能快到"怎么追都追不上"。
## 取 0.92 而不是 1.0：留出 8% 的追击余量 —— 只是"更快"而追不近，等于没修。
const ENEMY_SPEED_CEILING_RATIO := 0.92


## 敌机的速度天花板 = **玩家这台机的加力上限** × `ENEMY_SPEED_CEILING_RATIO`。
static func enemy_speed_ceiling(player_boost_speed: float) -> float:
	return player_boost_speed * ENEMY_SPEED_CEILING_RATIO


## 带上限的敌机速度上限 —— **实际战斗走这一条**（`BanditAI._apply_difficulty`）。
##
## 两道约束合起来才是完整的契约：
##   1. `enemy_top_speed()`：难度越高越快、机体速度系数照常生效；
##   2. 天花板：无论难度与机体怎么组合，都 ≤ 玩家加力上限 × 0.92。
## 回归门就是第 2 条的不变量（`suite_abilities` 里对全部组合枚举断言）。
func enemy_top_speed_capped(speed_mult: float, player_boost_speed: float) -> float:
	return minf(enemy_top_speed(speed_mult), enemy_speed_ceiling(player_boost_speed))


