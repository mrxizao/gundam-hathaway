## 古斯塔夫00 的公共部分（模型 / 全高 / 无导弹 / 近战射程等）。
static func _gustav_base() -> SuitProfile:
	var p := SuitProfile.new()
	p.id = Id.GUSTAV00
	# ---- 模型换代 + 动作资产（N49 · 2026-09-28）----
	# `model_path` 从**无骨架的旧件** `gustav_karl_00.glb`（实测 `skins: 0 / animations: 0`）
	# 换到绑定成品 **`gustav_fly.glb`**（46 骨 / 215 网格 / **自带 `fly`**）。
	#
	# ★ 换的理由**不是画质，是动作挂不上**：Godot 只在 glb 带 `animations` 时才建
	#   `AnimationPlayer`，而 `ModelAnimator.setup()` 见到没有播放器就早退
	#   ⇒ 下面登记的那 27 段**一件都摘不到**，而且**全链不报错**（T13）。
	# ★ 包围盒跨度与旧件**逐位相同**（X 0.7534 / Y 0.9995 / Z 0.4624）
	#   ⇒ `model_native_height` / `target_height` 都不用动。
	#   （新件把模型**几何居中**了、旧件是脚底压在 y=0 —— 这个差由
	#    `FlightBody._center_and_measure()` 自动吸收：它按可见网格重算包围盒，
	#    把"脚下 0.55H"对齐到 `model_root` 的原点。）
	p.model_path = "res://assets/models/gustav/gustav_fly.glb"
	p.model_native_height = 1.0
	# ⚠️ **不播飞行待机**（N49 用户指定「除了每一个的飞行待机动画」）：
	#   `fly` 动作随主模型自带（架构上**必须有它**才建得出 `AnimationPlayer`），
	#   但这里置空 ⇒ 飞行时静止在绑定姿态，与佩涅罗佩同一口径（N46）。
	p.model_anim_idle = ""
	# 27 段动作，全部是**剥壳件**（`anim/` 合计 4.4 MB；不剥壳的话是 27 × 5.6 ≈ 151 MB）。
	# 剥壳不改骨架、不改轨道路径、不改关键帧 —— 每件都由 `glb_strip_anim.py` 两道复核。
	p.model_anim_files = [
