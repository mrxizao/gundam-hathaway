## **高架桥**。用户："不仅需要做公路还需要做一些高架桥"。
##
## ## ⚠️⚠️ 2026-09-28 v3 换了三件事（治用户"**楼房间穿插断断续续的高架桥**"
## ## 与"**高架桥也都是直直的**"）
##
## | # | 旧 | 新 | 读数 |
## |---|---|---|---|
## | ① | 桥面**恒定** `CITY_VIA_DECK_Y = 360` | **沿线剖面**（`_city_via_profile()`：净空 + 3 点膨胀 + 正反限坡） | 旧做法实测 **桥面 ∩ 楼体 AABB = 31/144 = 21.5%** —— 楼高 200…3 965，`waterfront` 上界 806 就已经过不去，**不是偶发** |
## | ② | 环线 `yaw` **写死 0.0** | **从段的两端点推**（`atan2(Δx, Δz)`），并带 `pitch` | 旧做法实测偏航角直方图只有 `0°×108 / 90°×36` ⇒ **72 块同向平板拼成一圈** |
## | ③ | 走线 = **十字（`gx==0`/`gz==0`）+ 环线** | **按图给 `via_lines`**（奥恩贝利：环线 + 三条运河线；达沃：环线 + 一条南北线）。**十字删除** | `gx==0` 上空的 68 段是"穿最密的楼"那条；高架是**过境交通**，本来就该沿水走 |
##
## ## 三段构件（一件都不能少）
## | 构件 | 标高 | 碰撞 | 为什么 |
## |---|---|---|---|
## | 桥面 | 剖面（≥ 240） | **不进** | 撞"一条线"很别扭，而且它本来就是**给玩家钻的** |
## | 桥墩 | 从桥面落到地形/水下 | **进**（真的挡路） | 120 m 见方的柱子必须撞得到，否则"钻桥"变成"穿墙" |
## | 护栏 | 桥面两侧 | 不进 | 纯视觉，给桥面一条边线（高空俯视时靠它读出桥在哪） |
##
## ## ⚠️ 桥面为什么**不能**贴地（与地面路的分工）
## 高架桥的意义就是**不受地形约束**：跨运河、跨海湾、跨起伏。贴地就成了一条普通公路。
## 它的**下界** `CITY_VIA_MIN_Y = 240` 也不是随便取的 —— `suite_round20.gd:804` 守着
## "机体要从底下钻得过去"。而**上界**是"这一段跨过谁"算出来的。
##
## ⚠️ `CITY_VIA_DECK_Y` 这个常量**已弃用**（见它自己的注释）：名字留着是因为
## 6 处引用按名字读它，删了会编译不过 —— 但**读它的探针必须改**
##（把常量当桥面标高读，桥面改剖面之后会出**假绿**：满篇 360 m 上空无楼 ⇒ 报"0 处穿楼"）。
func _build_city_viaducts() -> void:
	var shape: Dictionary = CITY_SHAPE[map.city_layout]
	var cblock := CITY_CBLOCK
	var decks: Array[Transform3D] = []
	var rails: Array[Transform3D] = []
	var piers: Array[Vector3] = []
	var prof_lo := 1.0e18
	var prof_hi := -1.0e18
	# 墩位统计：挪了几根、挪了多远、丢了几根（B6 · 见 `_city_via_pier_t`）。
	var slid: Array = []
	# ---- ① 按图给的走线（**十字已删** · M2 = b）----
	# 每项 `[轴, 垂直方向坐标, 起点, 终点]`；"轴"是**桥延伸的方向**。
	# ⚠️ 端点在表里**显式给**（不从块表推）：算错只是"多/少几段"，
	# 而下面的日志会把实测段数打出来 ⇒ 一眼能核。
	for def: Array in shape.via_lines:
		var along_z := String(def[0]) == "z"
		var pos := float(def[1])
		var t0 := float(def[2])
		var t1 := float(def[3])
		var n := maxi(1, int(round(absf(t1 - t0) / cblock)))
		var step := (t1 - t0) / float(n)
		var xz: Array[Vector2] = []
		for i in range(n + 1):
			var t := t0 + step * float(i)
			xz.append(Vector2(pos, t) if along_z else Vector2(t, pos))
		var prof := _city_via_profile(xz, absf(step), false)
		for i in n:
			prof_lo = minf(prof_lo, minf(prof[i], prof[i + 1]))
			prof_hi = maxf(prof_hi, maxf(prof[i], prof[i + 1]))
			_append_via_seg(decks, rails, piers,
				Vector3(xz[i].x, prof[i], xz[i].y),
				Vector3(xz[i + 1].x, prof[i + 1], xz[i + 1].y),
				i % CITY_VIA_PIER_EVERY == 0, slid)
	# ---- ② 环线：半径按图给（0 = 该图不要环线）----
	var rr := float(shape.via_ring_r)
	var ring_segs := 0
	var ring_quads := 0
	if rr > 0.0:
		ring_segs = CITY_VIA_RING_SEGS
		var pts: Array[Vector2] = []
		for i in ring_segs:
			var a := TAU * float(i) / float(ring_segs)
			pts.append(Vector2(cos(a) * rr, sin(a) * rr))
		# ⚠️ **弦长**（不是弧长）：`rr·TAU/72` 是弧长，实际段是弦，差 0.095%
		#（在 420 m 宽上是 0.4 m）—— 剖面是按弦长算坡度的，取错等于限坡松 0.1%。
		var chord := (pts[1] - pts[0]).length()
		var prof := _city_via_profile(pts, chord, true)
		for i in ring_segs:
			prof_lo = minf(prof_lo, prof[i])
			prof_hi = maxf(prof_hi, prof[i])
		# ---- ⚠️⚠️ B7：环线**不再用 `_append_via_seg()` 出桥面** ----
		#
		# 旧写法是 72 块**独立直板**（每块各自一个 yaw）⇒ 接缝处外缘留 105 m 的
		# 楔形缝、内缘叠 105 m，轮廓是 72 边形而不是圆 —— 用户看到的
		# "**一堆直着的桥面摆了一个圈**"就是这件事（见 `CITY_VIA_RING_SUB`）。
		# 现在桥面 / 护栏 / 中线各由一条**连续曲面带**出（`_via_ring_ribbon()`）。
		# ⚠️ **墩仍然按 72 个结点、每 `CITY_VIA_RING_PIER_EVERY` 段一根**：
		#    `_city_via_pier_pos()` 的输入就是那两个端点，"挪墩"这套逻辑一个字没改。
		for i in ring_segs:
			if i % CITY_VIA_RING_PIER_EVERY != 0:
				continue
			var j := (i + 1) % ring_segs
			var ring_mid := Vector3((pts[i].x + pts[j].x) * 0.5,
				(prof[i] + prof[j]) * 0.5, (pts[i].y + pts[j].y) * 0.5)
			var pp := _city_via_pier_pos(
				Vector3(pts[i].x, prof[i], pts[i].y),
				Vector3(pts[j].x, prof[j], pts[j].y))
			if pp == Vector3.ZERO:
				slid.append(-1.0)
			else:
				slid.append(pp.distance_to(ring_mid))
				piers.append(pp)
		ring_quads = _via_ring_ribbon(pts, prof, rr)
	if not decks.is_empty():
		_add_multimesh("CityViaductDeck", decks,
			_city_material(Color(0.072, 0.074, 0.082)))
	if not rails.is_empty():
		_add_multimesh("CityViaductRail", rails,
			_city_material(Color(0.128, 0.132, 0.144)))
	# ---- 墩：**带碰撞**（这就是"撞得到"的那部分，同单轨的墩）----
	var vp_i := 0
	for p: Vector3 in piers:
		var g := _city_landform(p.x, p.z, map.city_layout)
		# ⚠️ 底面取 `maxf`：陆上落到地形下 40 m（看不见，视觉上就是"扎进地里"）；
		# 水上落到水面下 120 m（保证看起来是"插进水里"而不是"浮在水面上"）。
		# 用 `minf` 的话跨海湾那几根会变成 480 m 长的桩（扎到真正的海底）。
		var bot := maxf(g - 40.0, CITY_WATER_Y - 120.0)
		var hh := maxf(p.y - CITY_VIA_DECK_T * 0.5 - bot, 20.0)
		# ⚠️ 名字带序号，理由同 `CanalBridgePier`（重名会被引擎改名丢掉原名）。
		_add_box("ViaductPier%d" % vp_i, Vector3(p.x, bot + hh * 0.5, p.z),
			Vector3(CITY_VIA_PIER_W, hh, CITY_VIA_PIER_W),
			Color(0.086, 0.088, 0.098), 0.0)
		vp_i += 1
		_city_body_count += 1
	if prof_lo > prof_hi:
		prof_lo = 0.0
		prof_hi = 0.0
	# ⚠️ **剖面 min/max 必须打出来**（E-6）：G10 的 1 800 m 上限是**估计值**，
	# 要以这个日志为准回填文档，**不许再拿估算当结论**。
	print("[city] %s 高架：%d 段**直板**桥面（走线）/ %d 根墩 / 环线半径 %.1f km（%d 段）"
		% [map.name_cn, decks.size(), piers.size(), rr / 1000.0, ring_segs]
		+ " / **环线桥面 = 1 条连续带（%d 个断面 × %d 细分，含护栏与中线）** / "
		% [ring_quads, CITY_VIA_RING_SUB]
		+ "走线 %d 条 / **剖面 %.0f…%.0f m**（净空 %.0f / 下界 %.0f / 限坡 %.1f%%）" % [
			shape.via_lines.size(), prof_lo, prof_hi,
			CITY_VIA_CLEARANCE, CITY_VIA_MIN_Y, CITY_VIA_MAX_GRADE * 100.0])
	# ⚠️ **墩位是"挪"出来的**，这个数必须打出来（B6）：挪 0 根 ⇒ 说明避楼没生效；
	# 丢 > 0 根 ⇒ 有墩位整段都压着楼（要回头看 `CITY_VIA_PIER_SLIDE` 够不够）。
	# 名义墩位总数 = 走线（每 `CITY_VIA_PIER_EVERY` 段一根）+ 环线（每 `RING_…` 段一根）。
	var slid_n := 0
	var slid_max := 0.0
	var drop_n := 0
	for v: float in slid:
		if v < 0.0:
			drop_n += 1
		elif v > 0.5:
			slid_n += 1
			slid_max = maxf(slid_max, v)
	print("[city] %s 高架墩位：名义 %d 个（环线每 %d 段一根）⇒ 实建 %d 根 / "
		% [map.name_cn, slid.size(), CITY_VIA_RING_PIER_EVERY, piers.size()]
		+ "**挪位 %d 根（最远 %.0f m）/ 丢 %d 根**" % [slid_n, slid_max, drop_n])


## 高架桥面沿线的**剖面**（v3 · D1）。`xz` 是沿线采样点（只用 xz），
## `seg_len` 是每段的水平长度，`wrap` = 首尾相接（环线）。
##
## ## 为什么必须是剖面（而不是一个常量）
## 旧做法是 **`CITY_VIA_DECK_Y = 360` 恒定**，而楼高 200…3 965 m ⇒
## `waterfront` 档上界 `620 × 1.30 = 806` 就已经过不去 ——
## 实测 **桥面与楼体 AABB 真正相交 = 31/144 = 21.5%**（**不是偶发，是必然**）。
##
## ## 四步（**顺序不能换**）
## 1. `need(i) = max(地形 + 净空, 下界)`；**正下方有楼**则再取 `楼顶 + 净空`；
## 2. **3 点膨胀** `env(i) = max(need(i−1), need(i), need(i+1))` —— 把尖峰**提前**抬起来；
## 3. **正向 + 反向各一趟限坡** `deck(i) = max(deck(i), deck(i∓1) ∓ GRADE·Δs)`；
## 4. 最后过一遍下界。
##
## ⚠️⚠️ 第 3 步**不能**写成"先取 max 再滑动平均"（v1 的写法）：平均会**低于**包络
## ⇒ 桥面降到楼顶以下 ⇒ **整个方案自废**。两次**单调**扫掠才保证 `deck ≥ env` 恒成立。
func _city_via_profile(xz: Array[Vector2], seg_len: float, wrap: bool) -> Array[float]:
	var n := xz.size()
	var reach := CITY_VIA_W * 0.5
	var need: Array[float] = []
	for i in n:
		var p := xz[i]
		var v := maxf(_city_landform(p.x, p.y, map.city_layout) + CITY_VIA_CLEARANCE,
			CITY_VIA_MIN_Y)
		# ---- ⚠️⚠️ 2026-09-28 v3 · B6：**按段问**（不再按点问）----
		# 桥面是两个结点之间的一条**带子**（宽 `CITY_VIA_W` = 420）⇒
		# "正下方有楼吗"必须拿**整条带子**去问。旧写法是"以结点为中心的
		# `(2·reach)²` 方框"，而相邻结点相距**一整个段**（环线 2 408 m / 走线 4 025 m）
		# ⇒ **段的中段从来没被问到过**（一个结点只覆盖 ±210 m，段长的一半是 1 204～2 012 m）。
		# 实测后果（`tools/_r6_road_probe` 的精确 SAT 口径）：
		# **桥面与楼体真正相交 = 16 / 139 段，最小重叠深度 330 m** —— 扎进去了。
		# 一个结点挨着两条段（**前一条 + 后一条**），取两者的 max ⇒ 覆盖整条折线，
		# 且**每段至少被问一次**（首尾结点不落在任何段之外）。
		for s: int in [-1, 1]:
			var j := i + s
			if wrap:
				j = (j + n) % n
			elif j < 0 or j >= n:
				continue
			var q := xz[j]
			var top: float = _city_via_seg_lot_top(p.x, p.y, q.x, q.y, reach)
			if top > 0.0:
				v = maxf(v, top + CITY_VIA_CLEARANCE)
		need.append(v)
	# ---- 2. 3 点膨胀 ----
	var grown: Array[float] = []
	for i in n:
		var ia := (i - 1 + n) % n if wrap else maxi(i - 1, 0)
		var ib := (i + 1) % n if wrap else mini(i + 1, n - 1)
		grown.append(maxf(need[ia], maxf(need[i], need[ib])))
	# ---- 3. 正反两趟限坡 ----
	var deck: Array[float] = []
	deck.resize(n)
	for i in n:
		deck[i] = grown[i]
	var lim := CITY_VIA_MAX_GRADE * seg_len
	for i in range(1, n):
		deck[i] = maxf(deck[i], deck[i - 1] - lim)
	for i in range(n - 2, -1, -1):
		deck[i] = maxf(deck[i], deck[i + 1] - lim)
	# ---- 4. 下界 ----
	for i in n:
		deck[i] = maxf(deck[i], CITY_VIA_MIN_Y)
	return deck


## 一个**条带**（沿 `a → b`、半宽 `reach` 的**矩形**）**正下方**最高的楼顶标高（米）。
## 没有 ⇒ 0。`a == b` 时退化成"一个 `2·reach` 见方的**方柱**"。
##
## ## ⚠️⚠️ 2026-09-28 v3 · B6：这一个函数修掉了 16/139 那件硬伤
## 旧写法是**逐点**问"以这个点为中心的 `(2·reach)²` 方框里有楼吗"，三个错叠在一起：
##
## | # | 错 | 后果 |
## |---|---|---|
## | ① | 拿**地块半宽 `half`** 当"地块在垂直于带子方向上的支撑" | 地块是**轴对齐正方形**，桥面是**旋转的带子** ⇒ 真正的支撑是 **L1 支撑 `half·(|u.x| + |u.z|)`**：沿 X / 沿 Z 时 = `half`（1 247.75）；**45°（环线的弦就是这个角）时 = `half·√2`（1 764.4）** ⇒ **斜弦两侧 516 m 的楼全被漏掉** |
## | ② | 沿线只覆盖 ±`reach`（420 m） | 相邻采样点相距**一整段**（环线 2 408 m / 走线 4 025 m）⇒ **段的中段根本没被问到** |
## | ③ | 用**圆距离**去比（`dist ≤ reach + sup`） | 方块的四角在圆外 ⇒ **角区漏判**。实测：地块中心离弦 2 000 m（`half` 1 247.75、`reach` 210、沿 Z 的弦）时圆距离 2 000 > 1 974 判"无楼"，而地块的 z 半跨伸到 2 752、弦的 z 半跨 1 204 ⇒ **真重叠** |
## ⇒ 实测（`tools/_r6_road_probe` 的**精确**口径：真实四角 SAT ＋ y 区间）：
## **与楼体真正相交的桥面段 = 16 / 139**，**最小重叠深度 330 m** —— 不是"擦到"，是扎进去了。
##
## ⇒ 现在用**精确 SAT**（矩形的 2 个轴 + 方块自己的 2 个轴，共 4 条分离轴；
## 两个正方形在同一个投影区间上**有交**才继续看下一条，**没有任何一条能分离**才算相交）。
## 三个调用方：
## | 调用方 | `reach` | 段长 |
## |---|---|---|
## | 桥面剖面（`_city_via_profile`） | `CITY_VIA_W / 2`（210） | 一整个结点间距 |
## | 高架**墩**（经 `_city_via_lot_top`） | `CITY_VIA_PIER_W / 2`（60） | **退化成一个点** ⇒ 走"两方块"分支（墩是轴对齐方柱，与地块同一套轴） |
## | 单轨**墩**（经 `_city_monorail_pylon_at`） | `CITY_VIA_PIER_W / 2`（60） | 墩自己的 600 m 长条中心线（**旋转**的，必须走 SAT 分支） |
func _city_via_seg_lot_top(ax: float, az: float, bx: float, bz: float,
		reach: float) -> float:
	var half := CITY_CBLOCK * CITY_FILL * 0.5
	var dx := bx - ax
	var dz := bz - az
	var seg := sqrt(dx * dx + dz * dz)
	# ---- 退化（`a == b`）：**两个轴对齐正方形**的相交 ----
	if seg <= 0.0001:
		return _city_lot_top_box(ax, az, reach)
	# ---- 一般情形：**矩形 vs 轴对齐正方形**，精确 SAT ----
	var mx := (ax + bx) * 0.5
	var mz := (az + bz) * 0.5
	var ux := dx / seg
	var uz := dz / seg
	# 矩形沿 `u` 的半长 = `seg/2`，沿垂直 `p = (−uz, ux)` 的半长 = `reach`。
	# 把它投到世界 x / z 轴上：
	var ex := seg * 0.5 * absf(ux) + reach * absf(uz)
	var ez := seg * 0.5 * absf(uz) + reach * absf(ux)
	# 地块（轴对齐、半宽 `half`）沿 `u` 的支撑（**L1**）；沿 `p` 的支撑同值。
	var sup: float = half * (absf(ux) + absf(uz))
	var fu := seg * 0.5 + sup
	var fp := reach + sup
	var bx0 := ex + half
	var bz0 := ez + half
	var cb := CITY_CBLOCK
	var gx0 := int(floorf((mx - bx0) / cb)) - 1
	var gx1 := int(floorf((mx + bx0) / cb)) + 1
	var gz0 := int(floorf((mz - bz0) / cb)) - 1
	var gz1 := int(floorf((mz + bz0) / cb)) + 1
	var best := 0.0
	for gx in range(gx0, gx1 + 1):
		for gz in range(gz0, gz1 + 1):
			var key := Vector2i(gx, gz)
			if not _city_lot_h.has(key):
				continue
			var cx := (float(gx) + 0.5) * cb
			var cz := (float(gz) + 0.5) * cb
			var ox := cx - mx
			var oz := cz - mz
			# ① / ②：世界 x / z 这两条轴
			if absf(ox) > bx0 or absf(oz) > bz0:
				continue
			# ③ / ④：矩形自己的两条轴（`u` 与 `p`）
			if absf(ox * ux + oz * uz) > fu:
				continue
			if absf(-ox * uz + oz * ux) > fp:
				continue
			best = maxf(best, float(_city_lot_h[key]))
	return best


## **一个 `2·reach` 见方的轴对齐方柱**正下方最高的楼顶标高（米）。没有 ⇒ 0。
##
## 高架墩是 `_add_box(..., yaw = 0)` 的方柱，地块也是轴对齐的 ⇒ 两者相交就是**两个 AABB**
## 的相交：`|Δx| ≤ half + reach` **且** `|Δz| ≤ half + reach`。
## ⚠️ 不能写成"圆心距 ≤ `half + reach`"（那是**圆**判据）：方块的四角在圆外，
## 圆形判据会把**角区**的楼判成"没压到"。实测那就是"墩明明在楼里、
## `_city_via_lot_top()` 却说 0"的根因（`_r10` 读数：**高架墩在楼内 3 根**）。
func _city_lot_top_box(x: float, z: float, reach: float) -> float:
	var lim := CITY_CBLOCK * CITY_FILL * 0.5 + reach
	var cb := CITY_CBLOCK
	var gx0 := int(floorf((x - lim) / cb)) - 1
	var gx1 := int(floorf((x + lim) / cb)) + 1
	var gz0 := int(floorf((z - lim) / cb)) - 1
	var gz1 := int(floorf((z + lim) / cb)) + 1
	var best := 0.0
	for gx in range(gx0, gx1 + 1):
		for gz in range(gz0, gz1 + 1):
			var key := Vector2i(gx, gz)
			if not _city_lot_h.has(key):
				continue
			var cx := (float(gx) + 0.5) * cb
			var cz := (float(gz) + 0.5) * cb
			if absf(cx - x) <= lim and absf(cz - z) <= lim:
				best = maxf(best, float(_city_lot_h[key]))
	return best


## 以 `(x, z)` 为中心的**方柱**（半宽 `CITY_VIA_PIER_W / 2`）正下方最高的楼顶标高。没楼 ⇒ 0。
##
## ⚠️ 2026-09-28 v3 · B6：**它现在只是 `_city_via_seg_lot_top()` 的退化情形**（段缩成一点）。
## 旧版里那份独立的循环已经删掉 —— 它当时把 `reach` 写成了 `CITY_VIA_W / 2`（**桥面带子**
## 的半宽，那是它自己文档写的语义），拿带子的判据判**墩**等于凭空多一圈 150 m：
## 实测"落进楼体占地的墩位"台场 **24 → 21**、达沃 **7 → 4**（另 3 个是带子擦到楼角、
## 墩自己没事）。桩子只有 120 宽，判它就该用 60。
func _city_via_lot_top(x: float, z: float) -> float:
	return _city_via_seg_lot_top(x, z, x, z, CITY_VIA_PIER_W * 0.5)


## 高架桥的**一段**（桥面 + 两条护栏 + 可选一根墩）。
##
## ## ⚠️ v3：`yaw` 与 `pitch` **从两个端点推**，不再由调用者写死
## 旧签名收一个 `yaw` 参数，而环线那一路传的是**写死的 0.0** ⇒ 72 块同向平板。
## 现在由 `a → b` 推：`yaw = atan2(Δx, Δz)`（`_sized()` 的约定是"局部 +Z → yaw 方向"），
## `pitch` 由高度差推。**这样连"符号写反"都不可能** ——
## 判据 G6b `abs(dot(桥面长轴, 弦方向)) ≥ 0.9999` 因此恒成立。
##（v2 的写法是传 `-rad_to_deg(mid_a)`：能对，但**符号反了 G6a 照样绿**
## —— 那正是 G6b 被补出来的原因。）
func _append_via_seg(decks: Array[Transform3D], rails: Array[Transform3D],
		piers: Array[Vector3], a: Vector3, b: Vector3, with_pier: bool,
		slid: Array) -> void:
	var d := b - a
	var horiz := Vector3(d.x, 0.0, d.z)
	var hlen := maxf(horiz.length(), 0.001)
	var yaw := rad_to_deg(atan2(horiz.x, horiz.z))
	# ⚠️ 俯仰角**取负**：`Basis.from_euler` 是 YXZ，局部 +Z 的 y 分量是 `−sin(pitch)`。
	# 与 `_append_road_span()` **同一个公式**（路面已经在用、且是对的）。
	var pitch := -rad_to_deg(atan2(d.y, hlen))
	var seg_len := d.length()
	var mid := (a + b) * 0.5
	decks.append(_sized_pitch(mid,
		Vector3(CITY_VIA_W, CITY_VIA_DECK_T, seg_len + 6.0), yaw, pitch))
	# 护栏：沿桥面两侧各一条（局部 ±X 方向 = 桥宽的两条边）
	var side := CITY_VIA_W * 0.5 - CITY_VIA_RAIL_T * 0.5
	for s: float in [-1.0, 1.0]:
		var off := Vector3(cos(deg_to_rad(yaw)), 0.0, -sin(deg_to_rad(yaw))) * (s * side)
		rails.append(_sized_pitch(
			mid + off + Vector3(0.0,
				CITY_VIA_DECK_T * 0.5 + CITY_VIA_RAIL_H * 0.5, 0.0),
			Vector3(CITY_VIA_RAIL_T, CITY_VIA_RAIL_H, seg_len + 6.0), yaw, pitch))
	if with_pier:
		# **D3 墩位避楼**（B6 改成"挪"）：墩脚压到楼体占地就挪到**最近的空位**；
		# 挪不出（`Vector3.ZERO`）才丢墩、改成一段长跨。
		# ⚠️ 见 `CITY_VIA_PIER_SLIDE`：旧写法"落楼就不建墩"把环线墩丢了 39~44%
		#（奥 18→10、达 18→11）⇒ 最长无墩跨 38 537 / 78 540 m，比"柱子插在楼里"更假。
		var pp := _city_via_pier_pos(a, b)
		if pp == Vector3.ZERO:
			slid.append(-1.0)
		else:
			slid.append(pp.distance_to(mid))
			piers.append(pp)


## 环线的**连续曲面带**：把"桥面 / 两侧护栏 / 桥面中线"各做成一条**闭合的带**。
##
## 返回一圈的**横断面数**（= `CITY_VIA_RING_SEGS × CITY_VIA_RING_SUB`），只用于日志。
##
## ## 三个面的分工（材质按面挂，见 `MeshInstance3D.surface_set_material`）
## | 面 | 内容 | 反照率 | 几何 |
## |---|---|---|---|
## | 0 | 桥面（顶/外/底/内**四个面**挤成一根梁） | `0.072, 0.074, 0.082` | 宽 `CITY_VIA_W`、厚 `CITY_VIA_DECK_T` |
## | 1 | 两侧护栏（各一条带） | `0.128, 0.132, 0.144` | 厚 `RAIL_T`、高 `RAIL_H`，坐在桥面**外沿**上 |
## | 2 | **桥面中线标线** | `CITY_VIA_MARK_ALBEDO` | 宽 `CITY_VIA_MARK_W`，嵌进桥面顶（底面 `−MARK_T`） |
##
## ## ⚠️ 为什么用 `ArrayMesh` 而**不是** `MultiMesh`
## 环线要的是"**一整条**"（首尾相接、接缝不存在）—— 而 `_add_multimesh()` 的语义
## 就是"N 个各自独立的实例"，两者根本对立。这里因此走 `SurfaceTool` 直接挤出。
##
## ⚠️ **没有碰撞**（与旧写法一致）：桥面从来就不进碰撞层，撞的是**墩**
##（`ViaductPier*`，见 `_build_city_viaducts()` 末尾），分工不能乱。
##
## ⚠️ 法线用 `generate_normals()`（**分片**，不设 smooth group）：带子是**棱柱**，
## 顶面/外面/底面/内面本来就是四个不同的朝向，平滑法线会把棱边糊掉。
func _via_ring_ribbon(pts: Array[Vector2], prof: Array[float], rr: float) -> int:
	var n := pts.size()
	if n < 3:
		return 0
	var sub := CITY_VIA_RING_SUB
	var m := n * sub
	var cen: Array[Vector3] = []
	var rad: Array[Vector3] = []
	var yt: Array[float] = []
	cen.resize(m)
	rad.resize(m)
	yt.resize(m)
	for k in m:
		var a := TAU * float(k) / float(m)
		var f := float(k) / float(sub)
		var i0 := int(floorf(f)) % n
		var i1 := (i0 + 1) % n
		var u := f - floorf(f)
		cen[k] = Vector3(cos(a) * rr, 0.0, sin(a) * rr)
		rad[k] = Vector3(cos(a), 0.0, sin(a))
		yt[k] = prof[i0] + (prof[i1] - prof[i0]) * u
	var yb: Array[float] = []
	yb.resize(m)
	for k in m:
		yb[k] = yt[k] - CITY_VIA_DECK_T
	var st := SurfaceTool.new()
	# ---- 面 0：桥面 ----
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	_band_emit(st, cen, rad, 0.0, CITY_VIA_W * 0.5, yb, yt)
	st.generate_normals()
	var mesh: ArrayMesh = st.commit()
	var ring_road:=_road_material(0,_city_material(Color(0.072,0.074,0.082)))
	ring_road.set_shader_parameter("curved_frame",true)
	mesh.surface_set_material(0,ring_road)
	# ---- 面 1：两侧护栏 ----
	var yt2: Array[float] = []
	yt2.resize(m)
	for k in m:
		yt2[k] = yt[k] + CITY_VIA_RAIL_H
	var rail_off := CITY_VIA_W * 0.5 - CITY_VIA_RAIL_T * 0.5
	st.clear()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for s: float in [-1.0, 1.0]:
		_band_emit(st, cen, rad, s * rail_off, CITY_VIA_RAIL_T * 0.5, yt, yt2)
	st.generate_normals()
	mesh = st.commit(mesh)
	mesh.surface_set_material(1, _city_material(Color(0.128, 0.132, 0.144)))
	# ---- 面 2：桥面中线标线 ----
	var ym0: Array[float] = []
	var ym1: Array[float] = []
	ym0.resize(m)
	ym1.resize(m)
	for k in m:
		ym1[k] = yt[k] + CITY_VIA_MARK_LIFT
		ym0[k] = ym1[k] - CITY_VIA_MARK_T
	st.clear()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	_band_emit(st, cen, rad, 0.0, CITY_VIA_MARK_W * 0.5, ym0, ym1)
	st.generate_normals()
	mesh = st.commit(mesh)
	mesh.surface_set_material(2,_road_material(3,_city_material(CITY_VIA_MARK_ALBEDO)))
	var mi := MeshInstance3D.new()
	mi.name = "CityViaductRing"
	mi.mesh = mesh
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_terrain_root.add_child(mi)
	return m


## 沿一串**闭合的**横断面挤出一条棱柱带（顶 / 外 / 底 / 内 四个面）。
##
## * `cen[k]` —— 横断面中心（**只用 x/z**，y 由 `y_bot` / `y_top` 给）
## * `rad[k]` —— 该断面的**单位径向外法向**（决定"外面"朝哪边）
## * `off`   —— 整条带沿径向的**偏置**（护栏用它坐在桥面外沿上）
## * `half_w`—— 带的**半宽**
## * `y_top` / `y_bot` —— 每个断面的顶面 / 底面标高
##
## ⚠️ 绕向是**逐面推出来的**（顶 `+Y` / 外 `+R` / 底 `−Y` / 内 `−R`），
## 四个面各两个三角，共 6 个 → 8 个三角。改顺序会让某几个面**朝里**（背面剔除掉，
## 表现为"带子上少一个面"，而从别的角度又看得见 —— 极难查，所以写在这里）。
func _band_emit(st: SurfaceTool, cen: Array[Vector3], rad: Array[Vector3],
		off: float, half_w: float, y_bot: Array[float],
		y_top: Array[float]) -> void:
	var m := cen.size()
	for k in m:
		var k1 := (k + 1) % m
		var i0 := cen[k] + rad[k] * (off - half_w)
		var e0 := cen[k] + rad[k] * (off + half_w)
		var i1 := cen[k1] + rad[k1] * (off - half_w)
		var e1 := cen[k1] + rad[k1] * (off + half_w)
		var it0 := Vector3(i0.x, y_top[k], i0.z)
		var ot0 := Vector3(e0.x, y_top[k], e0.z)
		var ob0 := Vector3(e0.x, y_bot[k], e0.z)
		var ib0 := Vector3(i0.x, y_bot[k], i0.z)
		var it1 := Vector3(i1.x, y_top[k1], i1.z)
		var ot1 := Vector3(e1.x, y_top[k1], e1.z)
		var ob1 := Vector3(e1.x, y_bot[k1], e1.z)
		var ib1 := Vector3(i1.x, y_bot[k1], i1.z)
		# 顶面（+Y）
		_tri_add(st, it0, it1, ot1)
		_tri_add(st, it0, ot1, ot0)
		# 外面（+R）
		_tri_add(st, ot0, ot1, ob1)
		_tri_add(st, ot0, ob1, ob0)
		# 底面（−Y）
		_tri_add(st, ob0, ob1, ib1)
		_tri_add(st, ob0, ib1, ib0)
		# 内面（−R）
		_tri_add(st, ib0, ib1, it1)
		_tri_add(st, ib0, it1, it0)


func _tri_add(st: SurfaceTool, a: Vector3, b: Vector3, c: Vector3) -> void:
	st.add_vertex(a)
	st.add_vertex(b)
	st.add_vertex(c)


## 在桥面 `a → b`（一块梁）**底下**找**最近的一个不压楼**的墩脚位置；
## 找不到 ⇒ `Vector3.ZERO`（y = 0 在 240 m 以上的高架上不可能）。
##
## ## 墩位可动的**两个**方向（都保证墩**仍在梁下**）
## | 方向 | 上限 | 依据 |
## |---|---|---|
## | **沿弦** | `CITY_VIA_PIER_SLIDE × 段长`（环线 ±770 m） | 梁长 = 段长 + 6 |
## | **横向** | `210 − 60·(|u.x| + |u.z|)` = **125…150 m**（随朝向） | 梁宽 420、墩 120。**墩是轴对齐的**，它沿横向的支撑是 `60·(|u.x| + |u.z|)`（45° 时 = 85 m）⇒ 横向余量随朝向在 125…150 之间 |
##
## ⚠️ **只给一个方向是不够的**（实测）：奥恩贝利的环线段是 2 408 m 的**弦**，
## 而地块是 4 025 m 一格、2 495.5 m 见方 ⇒ **有的弦整条躺在一栋楼里**，
## 沿弦怎么挪都没有空位（v1 只许沿弦 ⇒ 名义 103 个墩位里**丢 11 根**）。
## 加上横向 150 m 之后，"梁下 300 × 段长" 这个矩形里总能绕开楼角。
##
## ## 为什么"挪"比"丢"好（2026-09-28 v3 · B6）
## 旧写法"墩心落楼 ⇒ 不建墩"一刀切，实测把**环线墩丢了 39~44%**：
## 奥恩贝利 18 → **10**、达沃 18 → **11** ⇒ 名义墩距 9 634 / 15 708 m × 2/3 ⇒
## **最长无墩跨 38 537 m（×2）/ 78 540 m** —— 420 m 宽的桥面凌空四万米，一眼假。
## 而"柱子插在楼里"只对**少数**墩位成立（台场 21 个落楼墩位里 **19 个挪得出来**）：
## ⇒ **挪墩两头都不占**（既不穿楼，也不出长跨）。
func _city_via_pier_pos(a: Vector3, b: Vector3) -> Vector3:
	var dx := b.x - a.x
	var dz := b.z - a.z
	var dy := b.y - a.y
	var seg := sqrt(dx * dx + dz * dz)
	if seg < 0.001:
		if _city_via_lot_top(a.x, a.z) <= 0.0:
			return a
		return Vector3.ZERO
	# 单位向量：弦向 `(ux, uz)`、横向 `(px, pz)`。
	var ux := dx / seg
	var uz := dz / seg
	var px := -uz
	var pz := ux
	var lim_s := seg * CITY_VIA_PIER_SLIDE
	# ⚠️ 横向上限**随朝向变**：墩是**轴对齐**方柱，它沿横向 `p` 的支撑是
	# `(CITY_VIA_PIER_W/2)·(|p.x| + |p.z|)` = `60·(|u.x| + |u.z|)`（45° 时 85 m）
	# ⇒ 45° 的斜弦上横向只有 125 m 可用（不是 150）。取固定 150 会让墩顶**越过梁边**。
	var lim_p := maxf(CITY_VIA_W * 0.5
		- CITY_VIA_PIER_W * 0.5 * (absf(px) + absf(pz)), 0.0)
	# 按"离名义墩位多远"从小到大试：先沿弦 0、横向三档，再沿弦 ±、横向三档……
	var n := 16
	var perms: Array[float] = [0.0, lim_p, -lim_p, lim_p * 0.5, -lim_p * 0.5]
	for k in range(0, n + 1):
		var ss: Array[float] = [0.0]
		if k > 0:
			var o := lim_s * float(k) / float(n)
			ss = [-o, o]
		for s: float in ss:
			var tt := 0.5 + s / seg
			# ⚠️ **必须留在梁下**：`[0.18, 0.82]` 而不是 `[0, 1]`
			#（梁的两端要和相邻段对接，墩顶偏到梁端之外就"梁脱离墩顶"了）。
			if tt < 0.18 or tt > 0.82:
				continue
			var bx := a.x + dx * tt
			var by := a.y + dy * tt
			var bz := a.z + dz * tt
			for po: float in perms:
				if _city_via_lot_top(bx + px * po, bz + pz * po) <= 0.0:
					return Vector3(bx + px * po, by, bz + pz * po)
	return Vector3.ZERO


## **百合海鸥号单轨**：一圈 420 m 高的高架梁 + 支撑墩 + 两列车。
##
## 它给这张城市图加了一件别的地图没有的东西：**一条空中的线性障碍**。
## 梁下缘有 300+ m 净空，机体可以从底下穿过去 ——
## 于是它既是导航线（沿海岸线绕一圈），也是"要不要钻过去"的判断点。
##
## ⚠️ 支撑墩进碰撞层（会撞），**梁不进**（撞到"一条线"很别扭，
## 而且 420 m 高的细梁本来就该让玩家自由穿越）。
func _build_city_monorail() -> void:
	# ⚠️ 半径**从表里读**（不是常量）：达沃表里 `monorail_r = 0` 表示"这张图没有单轨"。
	# 读常量的话达沃会照样建出一圈 27.6 km 的环线 —— 那不是它被删掉的那一条。
	var r := float(CITY_SHAPE[map.city_layout].monorail_r)
	# ⚠️ 2026-09-27：**半径 0 就直接不建**。达沃那一轮把单轨删了，而旧代码在 r = 0
	# 时会产出 96 段**零长度**的梁、一根立在图心的孤墩、以及一节退化到原点的车厢 ——
	# 不报错，只是画面里多一坨说不清的东西。
	# 它的功能（空中线性障碍 + 导航线）已由 `_build_city_viaducts()` 的环线接手。
	if r <= 0.0:
		print("[city] %s 无单轨（monorail_r = 0；环线高架接替它的角色）" % map.name_cn)
		return
	var y := CITY_MONORAIL_Y
	var segs := 96
	var beams: Array[Transform3D] = []
	var pylons: Array[Vector3] = []
	# 墩位统计（B6 · 见 `_city_monorail_pylon_at`）。
	var mp_slid := 0
	var mp_slid_max := 0.0
	var mp_drop := 0
	for i in segs:
		var a0 := TAU * float(i) / float(segs)
		var a1 := TAU * float(i + 1) / float(segs)
		var p0 := Vector3(cos(a0) * r, y, sin(a0) * r)
		var p1 := Vector3(cos(a1) * r, y, sin(a1) * r)
		var mid := (p0 + p1) * 0.5
		var d := p1 - p0
		beams.append(_sized(mid, Vector3(46.0, 54.0, d.length() + 14.0),
			rad_to_deg(atan2(d.x, d.z))))
		# ⚠️ 相位**半步错开**（v3 · P1）：环线高架墩在 `i % 4 == 0` ⇒ 方位 @20°，
		# 而单轨原本在 `i % 6 == 0`（96 段 ⇒ @22.5°）—— 两者在 **0° / 180° 完全重合**。
		# 改成 `i % 6 == 3` ⇒ `11.25° + 22.5k`。
		# ⚠️⚠️ **B6 修正**：这里原写"最小角距 **2.5°**（1 204 m）"是**只比了相邻两项**算出来的。
		# 真值是 **1.25° = 602 m**：环线墩方位步长 `5°×EVERY`，与单轨的 22.5° 的最小角距是
		# `gcd(5·EVERY, 22.5)/2 = gcd(10, 22.5)/2 = 2.5/2 = 1.25°`
		#（逐个比过：环线 102.5° 与单轨 101.25° 只差 1.25°）。
		# 602 m 仍然 ≫ 两个柱子加起来最多 145 m（`60√2 + 60`）⇒ 结论不变，但**数要写对**。
		if i % 6 == 3:
			var pp := _city_monorail_pylon_at(p0, r)
			if pp == Vector3.ZERO:
				mp_drop += 1
			else:
				if pp.distance_to(p0) > 0.5:
					mp_slid += 1
					mp_slid_max = maxf(mp_slid_max, pp.distance_to(p0))
				pylons.append(pp)
	_add_multimesh("MonorailBeam", beams,
		_city_material(Color(0.10, 0.10, 0.115)))
	# ---- 墩：**带碰撞**的立柱（这就是"撞得到"的部分）----
	# ## ⚠️ 2026-09-28 v3（P1）：从"内缩的小方柱"改成"**沿径向铺开的长条**"
	# 单轨梁只有 46 m 宽，而环线高架桥面 **420 m** 宽 ⇒ 两条线**同半径（27 600）**。
	# v2 曾打算"只把单轨墩径向内缩 250 m" —— 量了一下那样**梁会脱离墩顶**：
	# 梁内缘 `R − 23`、墩外缘 `R − 190` ⇒ 空 **167 m**（梁悬空，看着像浮在天上）。
	# ⇒ 改成径向 **600 m 长条**（跨 `R − 550 … R + 50`，把 46 m 的梁**兜住**），
	# 并给 `yaw`（沿径向铺开）；**零新增实例**。
	# ⚠️ `CITY_MONORAIL_R` **一个数没动**（M4 = a，且 `suite_worldscale.gd:127` 钉着它）。
	var mp_i := 0
	for p: Vector3 in pylons:
		var rl := maxf(sqrt(p.x * p.x + p.z * p.z), 1.0)
		var ux := p.x / rl
		var uz := p.z / rl
		# ⚠️ 名字带序号，理由同 `CanalBridgePier`（重名会被引擎改名丢掉原名）。
		_add_box("MonorailPylon%d" % mp_i,
			Vector3(p.x - ux * 250.0, (y + 60.0) * 0.5, p.z - uz * 250.0),
			Vector3(120.0, y + 60.0, 600.0), Color(0.115, 0.115, 0.128),
			rad_to_deg(atan2(ux, uz)))
		mp_i += 1
		_city_body_count += 1
	# ---- 两列车：绕圈跑，纯视觉（每帧推进，见 `_advance_city_train`）----
	var cars: Array[Transform3D] = []
	for i in 8:
		cars.append(_sized(Vector3(r, y + 40.0, 0.0),
			Vector3(130.0, 160.0, 470.0), 0.0))
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_colors = true
	mm.mesh = _city_cube
	mm.instance_count = cars.size()
	for i in cars.size():
		mm.set_instance_transform(i, cars[i])
		mm.set_instance_color(i, Color(0.80, 0.82, 0.86))
	var node := MultiMeshInstance3D.new()
	node.name = "MonorailTrain"
	node.multimesh = mm
	node.material_override = _city_material(Color(0.80, 0.82, 0.86),
		Color(0.35, 0.42, 0.52), 1.2)
	node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_terrain_root.add_child(node)
	_city_train = node
	_city_train_len = TAU * r
	print("[city] 单轨：半径 %.1f km、轨面 %.0f m、%d 根墩、%d 节车厢" % [
		r / 1000.0, y, pylons.size(), cars.size()])
	# ⚠️ **墩位是"挪"出来的**（B6）：B5 量出"单轨墩 11/16 落在 60 m 裙房里"
	#（墩顶 480 m ⇒ **穿屋顶**）。这个数必须打出来 —— 挪 0 根而丢 > 0 根 ⇒ 说明
	# 那 600 m 的切向行程不够，要回头看 `_city_monorail_pylon_at` 的上限。
	print("[city] 单轨墩位：名义 16 个 ⇒ 实建 %d 根 / **挪位 %d 根（最远 %.0f m）/ 丢 %d 根**"
		% [pylons.size(), mp_slid, mp_slid_max, mp_drop])


## 单轨墩的落点：名义点 `p`（在半径 `r` 的圆上）**压到楼就沿切向挪**；挪不出 ⇒ `Vector3.ZERO`。
##
## ## 墩的占地（判据的全部依据，与 `_build_city_monorail()` 的建法**必须一致**）
## 建出来的是 `Vector3(120, h, 600)`、`yaw = 径向` 的方柱，柱心在 `p − 250·u` ⇒
## 真实占地 = **径向 `R−550 … R+50`**（600 m 长）× **切向 ±60 m**。
## ⇒ 判据 = `_city_via_seg_lot_top(内端, 外端, reach = 60)` —— **长条**，不是点。
##（B5 的读数"11/16 落在 60 m 裙房里"就是因为**根本没有这道判据**：墩直接照建。）
##
## ## 为什么可以沿切向挪
## 单轨**梁是一整圈连续的**（96 段首尾相接）⇒ 墩只要还落在这条圆的附近，头顶就一定有梁
## （梁宽 46 m 是**径向**的，切向挪多少都还在梁下面）。
## 上限见 `CITY_MONORAIL_PIER_SLIDE`（±2 100 m = 半格）—— 取这么远是被几何逼的：
## 空档每 4 025 m 才出现一次、宽 1 529.5 m，而名义墩距 22.5° = 10 838 m。
##
## ⚠️ 哨兵用 `Vector3.ZERO`：单轨轨面 `CITY_MONORAIL_Y = 420` ⇒ 合法落点 y 恒非 0。
func _city_monorail_pylon_at(p: Vector3, r: float) -> Vector3:
	var a0 := atan2(p.z, p.x)
	var lim := CITY_MONORAIL_PIER_SLIDE
	var n := 42
	for k in range(0, n + 1):
		var offs: Array[float] = [0.0]
		if k > 0:
			var o := lim * float(k) / float(n)
			offs = [-o, o]
		for o: float in offs:
			var a := a0 + o / r
			var q := Vector3(cos(a) * r, p.y, sin(a) * r)
			var ux := cos(a)
			var uz := sin(a)
			if _city_via_seg_lot_top(q.x - ux * 550.0, q.z - uz * 550.0,
					q.x + ux * 50.0, q.z + uz * 50.0,
					CITY_VIA_PIER_W * 0.5) <= 0.0:
				return q
	return Vector3.ZERO


## 列车绕圈（纯视觉）。半径 12 km 的环线跑一圈要几分钟 ——
## 所以它就是"远处有东西在动"的程度，不抢戏。
func _advance_city_train(delta: float) -> void:
	if _city_train == null or not is_instance_valid(_city_train):
		return
	if _city_train_len <= 0.0:
		return
	# ⚠️ 半径从**环长反推**（`_city_train_len = TAU × r`），不读常量 ——
	# 常量是"奥恩贝利的单轨半径"，而半径现在按图给（达沃 = 0 ⇒ 根本没有车）。
	# 读常量的话，将来哪张图的环线半径一改，车就会**沿着错误的圆跑**
	#（不报错，只是慢慢飘出轨道）。
	var ring_r := _city_train_len / TAU
	_city_train_t = fmod(_city_train_t + delta * 190.0, _city_train_len)
	var mm := _city_train.multimesh
	if mm == null:
		return
	for i in mm.instance_count:
		var d := _city_train_t + float(i) * 480.0
		var a := d / ring_r
		var p := Vector3(cos(a) * ring_r, CITY_MONORAIL_Y + 40.0,
			sin(a) * ring_r)
		var tangent := Vector3(-sin(a), 0.0, cos(a))
		var b := Basis(Vector3.UP, atan2(tangent.x, tangent.z))
		mm.set_instance_transform(i, Transform3D(b, p))


## **彩虹桥 / 薛尔思桥**：跨海湾的通路。**几何按图给**（`CITY_SHAPE[·].bridge_*`）。
##
## ## ⚠️⚠️ 2026-09-28 v3：从"全局常量"改成"按图给"（这是"改一座城会改坏另一座"的病根）
## 在此之前，桥的几何**全写在本函数里**：`CITY_BRIDGE_Z` / `±0.82·ARENA_RADIUS` /
## 40 段 / 宽 560（字面量）。而**两城的海湾在相反方向** ——
## 奥恩贝利 `bay_side = +1`（湾在 +Z）、达沃 `bay_side = −1`（湾在 −Z）。
## 实测（`_r8_davao`）：达沃的 **40/40 段桥面下面全是陆**，两端在 `x = ±119 km` 处
## 沉进 **+1 170 / +1 056 m** 的山里 —— 桥面 560 m 只在山的半腰。
## ⇒ 改奥恩贝利的桥位（`CITY_BRIDGE_Z 36 400 → 56 350`）**会连带改坏达沃**。
##
## ## 两城的桥
## | | 奥恩贝利（彩虹桥 ×60） | 达沃（薛尔思桥） |
## |---|---|---|
## | 走向 | **沿 Z**（垂直岸线，`x = 0`） | **沿 X**（跨运河，`z = −20 125`） |
## | 全长 | 48 300 = **12 格** | 8 600 |
## | 主跨 | 24 150 = 6 格（塔 44 275 / 68 425 ⇒ **3:6:3**） | 5 160（塔 `x = 6 000 ± 2 580`） |
## | 桥面 | 560（**不变**） | **260**（桥位走廊 0 栋楼 ⇒ 低桥是薛尔思桥的剪影） |
## | 塔顶 | **3 200**（1 680 → 3 200） | **900** |
## | 桥宽 | **980**（现实 49 m × 20） | **460** |
##
## ## ⚠️ 两处"改前就在"的性质，本版**保留**
## 1. 桥面段是 `_add_box`（**带碰撞**）—— 与高架桥面（MultiMesh、不进碰撞）不同。
##    段数少（12 / 20）成本可接受，而桥面能站人是这张图上少有的"高处平台"。
## 2. 塔柱从 `CITY_WATER_Y − 60` 起（**伸到水面之下**）：水面这一轮从 0.2 降到
##    `CITY_WATER_Y = −12`，若塔柱从 `y = 0` 起算会**悬在水面上方 12 m**（"桥墩浮着"）。
##
## ## ⚠️ 删掉的两件（与旧版的有意差别）
## - **桥面弓高**（`bow = 1 + 0.06·sin`）：斜拉桥的桥面是**平的**，弓高是"梁桥"的形。
## - **桥塔红色航空灯**：死城不点灯（M6）。
func _build_city_bridge() -> void:
	var p: Dictionary = CITY_SHAPE[map.city_layout]
	# ⚠️ 字典取值是 `Variant`，`:=` 推不出类型 ⇒ **整份脚本解析失败**。全部显式标注。
	var along_z := String(p.bridge_axis) == "z"
	var bpos: float = p.bridge_pos          # 垂直方向坐标
	var bctr: float = p.bridge_center       # 沿轴桥心
	var span: float = p.bridge_span
	var segs: int = int(p.bridge_segs)
	var deck_y: float = p.bridge_deck_y
	var tower_y: float = p.bridge_tower_y
	var tower_t: float = p.bridge_tower_t
	var bw: float = p.bridge_w
	var a0 := bctr - span * 0.5
	var a1 := bctr + span * 0.5
	var seg_l := span / float(segs)
	var deck_col := Color(0.115, 0.118, 0.128)
	var tower_col := Color(0.145, 0.150, 0.165)
	var lower_y := deck_y - 60.0
	# ⚠️ `_add_box()` 的尺寸是**世界轴对齐**的（它没有 yaw 参数）⇒
	# 沿 Z 的桥"长度在 z"、沿 X 的桥"长度在 x"，两城的尺寸向量**必须分开写**。
	var deck_sz := Vector3(bw, CITY_BRIDGE_DECK_T, seg_l + 24.0) if along_z \
		else Vector3(seg_l + 24.0, CITY_BRIDGE_DECK_T, bw)
	var low_sz := Vector3(bw, 40.0, seg_l + 24.0) if along_z \
		else Vector3(seg_l + 24.0, 40.0, bw)
	var prom_sz := Vector3(bw * 0.47, 18.0, seg_l + 24.0) if along_z \
		else Vector3(seg_l + 24.0, 18.0, bw * 0.47)
	var cross_sz := Vector3(bw * 0.98, 160.0, 220.0) if along_z \
		else Vector3(220.0, 160.0, bw * 0.98)
	# ---- ① 桥面 + ② 下层 + ③ 彩虹游步道 ----
	for i in segs:
		var t := lerpf(a0, a1, (float(i) + 0.5) / float(segs))
		var dp := Vector3(bpos, deck_y, t) if along_z else Vector3(t, deck_y, bpos)
		var lp := Vector3(bpos, lower_y, t) if along_z else Vector3(t, lower_y, bpos)
		var pp := Vector3(bpos, lower_y + 22.0, t) if along_z \
			else Vector3(t, lower_y + 22.0, bpos)
		_add_box("BridgeDeck%d" % i, dp, deck_sz, deck_col, 0.0)
		# 下层（E3：复刻彩虹桥的三层构造）
		# 现实：上层 = 首都高 11 号台场线；下层两侧 = 临港道路（国道 357）+ 人行道，
		# 下层中央 = 百合海鸥号轨道 —— **本图单轨不上桥**（M4 = a）⇒ 中央改成
		# 「**彩虹游步道**」（铺装，不承载交通，现实里那条最出名的步行道）。
		_add_box("BridgeLower%d" % i, lp, low_sz, Color(0.098, 0.101, 0.110), 0.0)
		_add_box("BridgePromenade%d" % i, pp, prom_sz,
			Color(0.152, 0.150, 0.142), 0.0)
		_city_body_count += 3
	# ---- ④ 两座主塔（塔柱 + 横梁）----
	var pb := CITY_WATER_Y - 60.0
	var tw := bw * 0.19
	for s: float in [-1.0, 1.0]:
		var tt := bctr + s * tower_t * span
		for sz: float in [-1.0, 1.0]:
			var off := sz * bw * 0.30
			var tp := Vector3(bpos + off, (tower_y + pb) * 0.5, tt) if along_z \
				else Vector3(tt, (tower_y + pb) * 0.5, bpos + off)
			_add_box("BridgePylon%d%d" % [int(s), int(sz)], tp,
				Vector3(tw, tower_y - pb, tw), tower_col, 0.0)
			_city_body_count += 1
		var cp := Vector3(bpos, tower_y - 300.0, tt) if along_z \
			else Vector3(tt, tower_y - 300.0, bpos)
		_add_box("BridgeCross%d" % int(s), cp, cross_sz, tower_col, 0.0)
		_city_body_count += 1
	# ---- ⑤ 斜拉索：纯视觉（MultiMesh 细长条），**不进碰撞** ----
	var cables: Array[Transform3D] = []
	var cspan := span * 0.44
	for s: float in [-1.0, 1.0]:
		var tt := bctr + s * tower_t * span
		for k in 12:
			var t := bctr + lerpf(-cspan, cspan, float(k) / 11.0)
			if absf(t - tt) < span * 0.03:
				continue                      # 太靠近塔柱的索不画（会插进塔里）
			var top := Vector3(bpos, tower_y - 220.0, tt) if along_z \
				else Vector3(tt, tower_y - 220.0, bpos)
			var bot := Vector3(bpos, deck_y + 60.0, t) if along_z \
				else Vector3(t, deck_y + 60.0, bpos)
			var d := top - bot
			var horiz := Vector3(d.x, 0.0, d.z)
			cables.append(_sized_pitch((top + bot) * 0.5,
				Vector3(16.0, 16.0, d.length()),
				rad_to_deg(atan2(horiz.x, horiz.z)),
				-rad_to_deg(atan2(d.y, maxf(horiz.length(), 0.001)))))
	if not cables.is_empty():
		_add_multimesh("BridgeCables", cables,
			_city_material(Color(0.20, 0.21, 0.23)))
	# ---- ⑥ 两端引道（治"桥面悬空结束 / 扎进山里"）----
	var ramp_total := 0
	var ramps: Array[Transform3D] = []
	var rpiers: Array[Vector3] = []
	if map.city_layout == MapDef.CityLayout.OENBELLI:
		ramp_total = _build_bridge_ramps_oenbelli(bctr, span, deck_y, bpos,
			ramps, rpiers)
	else:
		ramp_total = _build_bridge_ramps_davao(bctr, span, deck_y, bpos,
			ramps, rpiers)
	if map.city_layout == MapDef.CityLayout.OENBELLI:
		_add_box("BridgeTunnelPortal", Vector3(bpos,deck_y+60.0,85700.0),Vector3(560,320,220),Color(0.058,0.060,0.066),0.0)
		_add_box("BridgeTunnelFace", Vector3(bpos,deck_y-40.0,85810.0),Vector3(620,620,40),Color(0.085,0.088,0.096),0.0)
		_city_body_count+=2
	if not ramps.is_empty():
		_add_multimesh("BridgeRamp", ramps,
			_city_material(Color(0.105, 0.108, 0.118)))
	# 引道墩：**带碰撞**（与高架 / 单轨同一套分工）
	var rp_i := 0
	for q: Vector3 in rpiers:
		var g := _city_landform(q.x, q.z, map.city_layout)
		var bot := maxf(g - 40.0, CITY_WATER_Y - 120.0)
		var hh := maxf(q.y - bot, 20.0)
		# ⚠️ 名字带序号，理由同 `CanalBridgePier`（重名会被引擎改名丢掉原名）。
		_add_box("BridgeRampPier%d" % rp_i, Vector3(q.x, bot + hh * 0.5, q.z),
			Vector3(CITY_VIA_PIER_W, hh, CITY_VIA_PIER_W),
			Color(0.086, 0.088, 0.098), 0.0)
		rp_i += 1
		_city_body_count += 1
	print("[city] %s 桥：沿 %s / 桥心 %.0f / 跨 %.0f m（%d 段）/ 桥面 %.0f / 塔顶 %.0f"
		% [map.name_cn, "Z" if along_z else "X", bctr, span, segs, deck_y, tower_y]
		+ "（塔位 ±%.0f）/ 宽 %.0f / 引道 %d 段 + %d 墩" % [
			tower_t * span, bw, ramp_total, rpiers.size()])


## 奥恩贝利的两端引道：**南端螺旋展线** + **北端高架引桥 + 隧道口**。
##
## ## 南端为什么必须"盘旋"
## 桥面 560 m，而主岛北缘的楼高到 **806 m**（waterfront 峰值）⇒
## **任何低于 560 m 的直线引道在主岛上都会穿楼**。
## 盘旋 ⇒ 在**一个点**上把 547 m 落完（`547 / 0.04 / (2π·900) = 2.42 圈`）。
##
## ## 为什么把螺旋放在**水上**（v3 的关键选择，E-5）
## 主岛**退线空带只有 644 m 宽**（`shrink = 0.84` ⇒ 楼离格线 322 m），
## φ1 800 的螺旋**放不进岛上任何位置**；而**岸线以北全是水**（§1.5 实测）⇒
## 把螺旋整个放在水面上，就**不可能碰到任何楼**（G18 = 0 是构造保证，不是运气）。
##
## ⚠️ v2 曾给 **φ400**（R 200）—— 那**装不下 420 m 宽的桥面**（内缘半径
## `200 − 210 = −10 m`），**几何上就是不可能的**。R 900 ⇒ 内缘 **690 m > 0** ✓。
##
## ## 北端为什么不能"落坡"
## §1.5 实测：北岸平地只有 **5.0 km**（79 000…84 500），山壁坡度 **56%** ⇒
## 落 560 m 要 **12.4 km** ⇒ 半路必钻山。而桥面 560 m 与地形正好交在
## **`z ≈ 85 600`** ⇒ **引桥（恒高）+ 隧道口**是唯一可做的形态。
func _build_bridge_ramps_oenbelli(bctr: float, span: float, deck_y: float,
		bpos: float, out: Array[Transform3D], piers: Array[Vector3]) -> int:
	var made := 0
	# ---- 南端 ①：连接高架（桥南端 → 螺旋切点，沿心连线，长度 = 心距 − 半径）----
	var cx := 4025.0
	var cz := 29000.0
	var sr := 900.0
	var south := Vector2(bpos, bctr - span * 0.5)
	var to_c := Vector2(cx, cz) - south
	var toward := to_c.normalized()
	var cut := Vector2(cx, cz) - toward * sr
	var link_len := to_c.length() - sr
	var nlink := maxi(1, int(round(link_len / 900.0)))
	for i in nlink:
		var p0 := south.lerp(cut, float(i) / float(nlink))
		var p1 := south.lerp(cut, float(i + 1) / float(nlink))
		var dd := p1 - p0
		out.append(_sized_pitch(
			Vector3((p0.x + p1.x) * 0.5, deck_y, (p0.y + p1.y) * 0.5),
			Vector3(420.0, CITY_VIA_DECK_T, dd.length() + 6.0),
			rad_to_deg(atan2(dd.x, dd.y)), 0.0))
		made += 1
	# ---- 南端 ②：螺旋 2.42 圈（`deck_y → 13 m`）----
	var a_start := atan2(cut.y - cz, cut.x - cx)
	var y_low := 13.0
	var turns := clampf((deck_y - y_low) / (CITY_VIA_MAX_GRADE * TAU * sr), 0.5, 6.0)
	var nsp := maxi(12, int(round(turns * 96.0)))
	for i in nsp:
		var ang0 := a_start + TAU * turns * float(i) / float(nsp)
		var ang1 := a_start + TAU * turns * float(i + 1) / float(nsp)
		var q0 := Vector3(cx + cos(ang0) * sr,
			lerpf(deck_y, y_low, float(i) / float(nsp)), cz + sin(ang0) * sr)
		var q1 := Vector3(cx + cos(ang1) * sr,
			lerpf(deck_y, y_low, float(i + 1) / float(nsp)), cz + sin(ang1) * sr)
		var dd := q1 - q0
		var hh := Vector3(dd.x, 0.0, dd.z)
		out.append(_sized_pitch((q0 + q1) * 0.5,
			Vector3(420.0, CITY_VIA_DECK_T, dd.length() + 6.0),
			rad_to_deg(atan2(hh.x, hh.z)),
			-rad_to_deg(atan2(dd.y, maxf(hh.length(), 0.001)))))
		made += 1
		if i % 12 == 0:
			piers.append(Vector3(q0.x, q0.y - CITY_VIA_DECK_T * 0.5, q0.z))
	# ---- 南端 ③：出口匝道（螺旋终点向南 1 400 m 落地，13 m → 1.6 m）----
	var ang_e := a_start + TAU * turns
	var ex := cx + cos(ang_e) * sr
	var ez := cz + sin(ang_e) * sr
	for i in 2:
		var f0 := float(i) * 0.5
		var f1 := float(i + 1) * 0.5
		var r0 := Vector3(ex, lerpf(y_low, CITY_ROAD_LIFT, f0), ez - 1400.0 * f0)
		var r1 := Vector3(ex, lerpf(y_low, CITY_ROAD_LIFT, f1), ez - 1400.0 * f1)
		out.append(_sized_pitch((r0 + r1) * 0.5,
			Vector3(420.0, CITY_VIA_DECK_T, (r1 - r0).length() + 6.0), 180.0,
			-rad_to_deg(atan2(r1.y - r0.y, 700.0))))
		made += 1
	# ---- 北端：引桥 5 100 m（恒高）+ 2 根墩 + 隧道口 ----
	var nz0 := bctr + span * 0.5
	var nz1 := 85600.0
	var nseg := maxi(1, int(round((nz1 - nz0) / 1700.0)))
	for i in nseg:
		var z0 := lerpf(nz0, nz1, float(i) / float(nseg))
		var z1 := lerpf(nz0, nz1, float(i + 1) / float(nseg))
		out.append(_sized(Vector3(bpos, deck_y, (z0 + z1) * 0.5),
			Vector3(420.0, CITY_VIA_DECK_T, absf(z1 - z0) + 6.0), 0.0))
		made += 1
		piers.append(Vector3(bpos, deck_y, (z0 + z1) * 0.5))
	# 隧道口：200 m 的暗口 + 端墙。
	# ⚠️ **隧道内部不建模** —— 本轮的桥只该"进得去"；隧道里怎么打光这件事
	# 与死城叙事打架，也超出"路/桥"这一轮的范围。
	return made


## 达沃的两端引道：**直线限坡引道**（各 ≈ 5 800 m，沿同一条格线）。
##
## 桥面 260、桥位走廊 **0 栋楼**（`_r8 §9a`）⇒ `260 / 0.045 = 5 780 m`
## 就能落到地面，**不需要盘旋**（盘旋是奥恩贝利为了绕开 806 m 的楼才需要的）。
func _build_bridge_ramps_davao(bctr: float, span: float, deck_y: float,
		bpos: float, out: Array[Transform3D], piers: Array[Vector3]) -> int:
	var made := 0
	var run := (deck_y - CITY_ROAD_LIFT) / CITY_VIA_MAX_GRADE
	for dir_s: float in [-1.0, 1.0]:
		var st := bctr + dir_s * span * 0.5
		var n := maxi(1, int(round(run / 950.0)))
		for i in n:
			var x0 := st + dir_s * run * float(i) / float(n)
			var x1 := st + dir_s * run * float(i + 1) / float(n)
			var y0 := lerpf(deck_y, CITY_ROAD_LIFT, float(i) / float(n))
			var y1 := lerpf(deck_y, CITY_ROAD_LIFT, float(i + 1) / float(n))
			# ⚠️ `_sized_pitch()` 的尺寸是**局部**的（局部 +Z = 长度方向），
			# 而 yaw = ±90 ⇒ 局部 +Z 指向 ±X ⇒ 长度写在**第 3 位**。
			# （写成第 1 位的话桥面会"横着铺"，看着像一排方墩 —— 但**不报错**。）
			out.append(_sized_pitch(
				Vector3((x0 + x1) * 0.5, (y0 + y1) * 0.5, bpos),
				Vector3(460.0, CITY_VIA_DECK_T, absf(x1 - x0) + 6.0),
				90.0 if dir_s > 0.0 else -90.0,
				-rad_to_deg(atan2(y1 - y0, absf(x1 - x0)))))
			made += 1
			if i % 2 == 0:
				piers.append(Vector3((x0 + x1) * 0.5, (y0 + y1) * 0.5, bpos))
	return made


## 每个地块的"标高随机种子"。**必须是格坐标（+ 本图城市种子）的纯函数**。
##
## ⚠️ 现在有两处在用：`_build_city_blocks()` 拿它当 `lot_rng` 的种子，
## 以及 `city_lot_for()` 拿它派生"立面类别"那个独立 rng。
##
## ⚠️ **纯函数**这条要求仍然要守住：以后谁再加一趟"按格查楼高"的逻辑
##（比如可选地给几栋楼点灯），必须能算出**同一个高度**，
## 否则灯会飘在没有楼的空气里。
##
## ⚠️⚠️ `seed_value` 是 1.3 批 M 新加的，默认值 = 老的常量 `CITY_SEED`。
## 带上它是**必须**的：`_city_land_color()` 只管地面配色，而地块/楼高/朝向全走这里 ——
## 第二座城如果沿用同一个种子，达沃与奥恩贝利就是**同一批地块、同一批楼高**，
## 只是灯和地面色不同。那不是"第二座城"，是"同一座城换了一层滤镜"。
static func _city_lot_seed(gx: int, gz: int, seed_value := CITY_SEED) -> int:
	return (gx + 512) * 4099 + (gz + 512) * 61 + seed_value


# ------------------------------------------------------------ 城市：几何与材质的小工具

## 单位立方体。**整个城市共用这一个网格**，尺寸全部烘进实例的局部变换。
##
## ⚠️ 为什么不一个个 `BoxMesh.new()`：几百栋楼 + 几千个装饰件如果各建一份网格，
## 资源池里就是几千份等价的顶点缓冲；共用一份则显存只占一份。
##
## ## ⚠️⚠️ 绕序（winding）必须**逐面**写对，不能"抄一个面然后换个顶点顺序"
## 第一版是手工列的六个面，靠"看起来对称"去推绕序 —— 结果**六个面全都是反的**
##（法线朝内）。Godot 默认背面剔除，于是每栋楼只剩**一个可见面**：
## 无论从哪个角度看都像一片薄板，楼是"空"的。
## 实测复现：`tools/cube_check.tscn` 把细高柱 / 薄板 / 大盒子各画一排、
## 从 (1,0.55,1) 斜看 —— 修复前三排全是单面，修复后才是立体的。
##
## 现在的做法：**先把六个面的外法线写出来当注释依据**，再用同一个四边面拆分
## (`q0,q1,q2` + `q0,q2,q3`) 逐面列出。每个四边面的顶点都按
## "从外面看逆时针"给 —— 底面的绕序与顶面相反，六个面才都朝外。
func _make_unit_cube() -> Mesh:
	var v := [
		Vector3(-0.5, -0.5, -0.5), Vector3(0.5, -0.5, -0.5),
		Vector3(0.5, 0.5, -0.5), Vector3(-0.5, 0.5, -0.5),
		Vector3(-0.5, -0.5, 0.5), Vector3(0.5, -0.5, 0.5),
		Vector3(0.5, 0.5, 0.5), Vector3(-0.5, 0.5, 0.5),
	]
	# 六个面：(**外法线**, 从面外侧看**逆时针**的四个顶点)。
	# 交叉积验算（取前三个顶点，右手定则）：
	#   -X 面外法线 (-1,0,0) ⇒ 0,4,7,3   → 验算：(4-0)×(7-4) = (0,0,1)×(0,1,1) = (-1,0,0) ✓
	#   +X 面外法线 ( 1,0,0) ⇒ 1,2,6,5   → 验算：(2-1)×(6-2) = (0,1,0)×(0,0,1) = (1,0,0) ✓
	#   +Y 面外法线 ( 0,1,0) ⇒ 3,7,6,2   → 验算：(7-3)×(6-7) = (0,0,1)×(1,0,0) = (0,1,0) ✓
	#   -Y 面外法线 ( 0,-1,0)⇒ 0,1,5,4   → 验算：(1-0)×(5-1) = (1,0,0)×(0,0,1) = (0,-1,0) ✓
	#
	# ## ⚠️⚠️ 这张表**只是"外侧逆时针"的参考**，发出去时必须**反着发**
	# Godot 的正面约定是「从外侧看**顺时针**」，与上表相反。照上表直接发 ⇒
	# **六个面全都判成背面**，从外面看到的是盒子的**内壁 / 内底**。
	#
	# ### 后果（2026-09-28 · B7c 定案，一个根因解释用户的三条抱怨）
	#   · **沥青的内底在 `mid.y − T/2 = 地形 + 1.6 − 4 = 地形 − 2.4 m`**，比城市地面低
	#     ⇒ 从空中看，路面整条被地面吃掉 ⇒ **"看不到公路路面"**（实测：只留沥青 84…113、
	#     加上地面掉到 ~44；把路面抬高 5 m、或给地面关深度、或把地面藏掉，立刻全亮）；
	#   · **楼的内底就在地面标高** ⇒ 俯瞰时每一块地块都是**一块平瓦**，
	#     屋顶、立面全被剔除 ⇒ **"房屋排列还是田字格一个地块一个房子"**；
	#   · 竖向的"墙"之所以还能看见，是因为那些是**内壁**（法线朝外、光从内侧来）。
	#
	# ### 判据（`tools/_b7_vis.gd` 的 E 系列，同一个实例变换、同一个材质、同一尺寸）
	#   E1 普通 `MeshInstance3D` + 本函数造的立方体 ⇒ 顶面**看不见**（读数 = 地面）
	#   E2 普通 `MeshInstance3D` + Godot `BoxMesh`  ⇒ 顶面**看得见**（读数 = 沥青色）
	# ⇒ 差别只在本函数的绕序。
	#
	# ⚠️ **法线必须显式给**：反绕之后 `generate_normals()` 会推出**朝内**的法线，
	# 那样面是画出来了、光照却是反的（顶面会变黑）。所以下面用 `set_normal()` 发外法线。
	var faces := [
		[Vector3(0.0, 0.0, -1.0), [1, 0, 3, 2]],   # -Z
		[Vector3(0.0, 0.0, 1.0), [4, 5, 6, 7]],    # +Z
		[Vector3(-1.0, 0.0, 0.0), [0, 4, 7, 3]],   # -X
		[Vector3(1.0, 0.0, 0.0), [1, 2, 6, 5]],    # +X
		[Vector3(0.0, 1.0, 0.0), [3, 7, 6, 2]],    # +Y
		[Vector3(0.0, -1.0, 0.0), [0, 1, 5, 4]],   # -Y
	]
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for f: Array in faces:
		var n: Vector3 = f[0]
		var q: Array = f[1]
		# 四边形 (a,b,c,d) 按"外侧逆时针"列出 ⇒ **反序**才是 Godot 的正面：
		# 三角形取 (a,d,c) 与 (a,c,b)。
		for idx: int in [q[0], q[3], q[2], q[0], q[2], q[1]]:
			st.set_normal(n)
			st.add_vertex(v[idx])
	return st.commit()


## 尺寸 → 变换矩阵（`Vector3.ONE` 上的缩放）。
##
## ## ⚠️⚠️ `Basis.scaled()` 是**父空间**缩放，不是局部缩放（2026-09-28 · B7c 定案）
##
## `Basis.scale(s)` 的实现是 `rows[i] *= s[i]`，而 Godot 的 `B·v` 取的是**行点积**
## ⇒ `B.scaled(s)·v = s ⊙ (B·v)` ⇒ 它等价于 **`diag(s) · B`**：
## **先旋转、后按世界轴缩放**。对 `yaw = 90°` 的实例，这会把 `size` 的三个分量
## 落到**错误的轴**上：
##
## ```
## _sized(Vector3(460, 8, 503), yaw = 90)   # 实测（tools/_b7_vis.gd）
##   修前：x 轴长 503、y 8、z 轴长 460      ← 「宽」与「长」对调
##   修后：x 轴长 460、y 8、z 轴长 503
## ```
##
## ## 后果（这就是"公路断断续续 / 看不到路面"的几何真因）
## 沿 X 的每一段路面，尺寸本该是 `长 503 × 宽 w`，实际被换成 `长 w × 宽 503`：
##   · 主干道 `w = 460` ⇒ 460 长、503 宽 ⇒ 相邻段只差 43 m ⇒ **看着像连续**（所以一直没被发现）；
##   · 次干道 `w = 260` ⇒ 260 长、503 宽 ⇒ 段间空 **243 m**；
##   · 支路   `w = 110` ⇒ 110 长、503 宽 ⇒ 段间空 **393 m**，而且**横向铺成 503 m 宽的板**。
## ⇒ 沿 X 的**地方路网整体碎成一排 110 m 的短桩**，而沿 Z 的那一半（`yaw = 0`）
## 完全正常 —— 这正是"一半路看得见、一半看不见"的观感来源。
##
## ⚠️ **只有 `yaw = 0` 时两种写法等价**（`diag(s)·I = I·diag(s)`），所以旧读数
## （`_r6_road_probe` / `_b7_*`）里凡是量"沿 Z 的路"的那部分**依然有效**。
## ⚠️ `_add_box()` 走的是 `Node3D.scale + rotation_degrees`（= `T·R·S`，**局部**缩放）
## ⇒ **它一直是对的**，只有 `_sized*()` 这一族错。
func _sized(pos: Vector3, size: Vector3, yaw_deg: float) -> Transform3D:
	return Transform3D(Basis(Vector3.UP, deg_to_rad(yaw_deg))
		* Basis.from_scale(size), pos)


## 与 `_sized()` 同，但**多一个沿长度方向的俯仰角**（度，抬头为正）。
##
## ## ⚠️ 为什么路面需要它（2026-09-27 · 用户："公路还是没建出来"）
## 城市地形 `_city_landform()` 的起伏是 **−7.9 … +7.9 m**，而一段路面只有 1 格长
##（4025 m）。用 `_sized()` 只能给出**水平**的路面 ⇒ 路面要么整段埋进高地，
## 要么整段悬在洼地上方 —— 一格之内的落差可以到十几米，两种都很难看。
##
## ⇒ 路面按格分段，**两端各取地形高度**，用俯仰角把整段连起来：
## `pitch = −atan2(Δh, 格距)`。于是段与段的接缝处**高度恒等**
##（后一段的起点就是前一段的终点），整条路连续贴合地面。
##
## ## 旋转顺序（⚠️ 容易写反）
## `Basis.from_euler(euler)` 默认是 **YXZ**（先绕 Y 偏航、再绕 X 俯仰）——
## 于是"俯仰轴"在偏航之后就是**路面的横向**（局部的右方向），正是我们要的。
## 反过来（先俯仰后偏航）会让俯仰轴留在世界 X 上，东向的路会**侧倾**而不是爬坡。
## ⚠️ 这也正是 `rotation_degrees` 的语义（`_add_box` 的 `tilt_deg` 那一位），
## 所以两条路径的朝向是一致的。
func _sized_pitch(pos: Vector3, size: Vector3, yaw_deg: float,
		pitch_deg: float) -> Transform3D:
	var b := Basis.from_euler(Vector3(deg_to_rad(pitch_deg), deg_to_rad(yaw_deg), 0.0))
	# ⚠️ 必须是**局部**缩放（`R·S`）。写成 `b.scaled(size)`（= `S·R`）会让 yaw = 90°
	# 的实例把"宽"与"长"落到错误的轴上，见 `_sized()` 的整段注释。
	return Transform3D(b * Basis.from_scale(size), pos)


## 一个**带碰撞**的盒体（结构 / 裙房 / 地标）。
##
## 与第一版的 `_add_block()` 的区别：共用单位网格与单位形状，
## 于是"几百栋楼"只有**一份**几何资源和**一个** `BoxShape3D`。
func _add_box(node_name: String, pos: Vector3, size: Vector3, color: Color,
		yaw_deg := 0.0, tilt_deg := 0.0, rot_z_deg := 0.0,
		emissive := Color(0, 0, 0, 0), facade := Facade.NONE) -> MeshInstance3D:
	var body := StaticBody3D.new()
	body.name = node_name
	body.collision_layer = FlightBody.WORLD_LAYER
	body.collision_mask = 0
	body.position = pos
	body.rotation_degrees = Vector3(tilt_deg, yaw_deg, rot_z_deg)
	var mi := MeshInstance3D.new()
	mi.name = "Mesh"
	mi.mesh = _city_cube
	# 楼体走**立面**材质（窗格 / 幕墙），构件走纯色材质（1.2.3 批 G）。
	#
	# ⚠️ 自发光优先：带 `emissive` 的一律走 `_city_material()` —— 立面材质没有自发光，
	# 而带自发光的两个调用点（立像背后的商场、会展中心塔）本来也不是"有窗格的办公楼"。
	# 这条判断放在这里而不是靠调用方自觉：漏传一次就是**静默丢掉自发光**。
	if facade != Facade.NONE and emissive.a <= 0.0:
		mi.material_override = _city_facade_material(color, facade)
	else:
		mi.material_override = _city_material(color, emissive, 2.4)
	if node_name.begins_with("BridgeDeck"):
		mi.set_meta("road_baseline",mi.material_override)
		mi.material_override=_road_material(0,mi.material_override)
		mi.material_override.set_shader_parameter("local_z_frame",false)
	mi.scale = size
	body.add_child(mi)
	var col := CollisionShape3D.new()
	col.shape = _city_cube_shape
	col.scale = size
	body.add_child(col)
	_terrain_root.add_child(body)
	return mi


## 楼体专用的 `_add_box()` 包装：只多一个"立面类别"，其余参数照原样转发。
##
## 加这一层是因为 `_add_box()` 的位置参数已经排到第 9 个（`emissive`）——
## 楼体的调用点本来一个自发光都不带，每处却要写一串 `0.0, 0.0, Color(0,0,0,0)`。
## 那是给读代码的人平添噪声，还容易**位置写错一位而不报错**（全是 float/Color，类型不挡）。
func _add_city_body(node_name: String, pos: Vector3, size: Vector3, color: Color,
		yaw_deg: float, facade: int) -> MeshInstance3D:
	return _add_box(node_name, pos, size, color, yaw_deg, 0.0, 0.0, Color(0, 0, 0, 0), facade)


## 一个**纯视觉**的 MultiMesh 批次（路灯 / 树 / 路面 / 桥索 / 窗）。
## **一次 draw call、零碰撞** —— 这正是它该有的样子。
##
## [param mesh] **第 4 个参数（1.2.3 批 K · 轮 1③ 新加，可选）**：
## 不给就用城市那个单位立方体（旧调用点一字不变）；绿洲的树需要一棵**树形**
## 网格，而它不属于城市那套几何 ⇒ 从这里传进来，而不是再写一个几乎一样的
## `_add_multimesh_tree()`（两份必然分叉）。
## Sparse visual service details use the actual pitched road frame; no collisions or RNG calls.
func _build_road_fittings(transforms:Array[Transform3D])->void:
	var drains:Array[Transform3D]=[]
	var covers:Array[Transform3D]=[]
	var patches:Array[Transform3D]=[]
	for i in range(23,transforms.size(),137):
		if drains.size()>=48:break
		var xf:=transforms[i]
		var x:=xf.basis.x.normalized();var y:=xf.basis.y.normalized();var z:=xf.basis.z.normalized()
		var width:=xf.basis.x.length()
		var frame:=Basis(x,y,z)
		var top:=xf.origin+xf.basis.y*0.5
		drains.append(Transform3D(frame.scaled_local(Vector3(3.5,0.12,8.0)),top+x*(width*0.49)+y*0.08))
		covers.append(Transform3D(frame,top-x*(width*0.17)+z*18.0+y*0.10))
		patches.append(Transform3D(frame.scaled_local(Vector3(minf(width*0.18,24.0),0.10,32.0)),top+x*(width*0.20)-z*48.0+y*0.07))
	for entry:Array in [["RoadServiceDrains",drains,4,Color(0.19,0.21,0.22)],["RoadServicePatches",patches,2,Color(0.048,0.048,0.047)]]:
		var mi:=_add_multimesh(entry[0],entry[1],_road_material(entry[2],_city_material(entry[3])))
		mi.visibility_range_end=4200.0;mi.visibility_range_end_margin=400.0
		mi.set_meta("road_added_detail",true)
	var cover_mesh:=CylinderMesh.new();cover_mesh.top_radius=3.0;cover_mesh.bottom_radius=3.0;cover_mesh.height=0.16;cover_mesh.radial_segments=16
	var mi:=_add_multimesh("RoadServiceCovers",covers,_road_material(4,_city_material(Color(0.22,0.23,0.24))),cover_mesh)
	mi.visibility_range_end=2400.0;mi.visibility_range_end_margin=300.0;mi.set_meta("road_added_detail",true)

const ROAD_SURFACE := preload("res://scripts/world/road_surface.gd")
var _road_materials:Array[ShaderMaterial]=[]
var _road_quality:=-1

func _road_material(role:int,source:StandardMaterial3D,grid:bool=false)->ShaderMaterial:
	var m:=ROAD_SURFACE.from_city(role,source)
	if grid:m.set_shader_parameter("junction_grid",CITY_CBLOCK)
	_road_materials.append(m)
	return m

func _add_multimesh(node_name: String, transforms: Array[Transform3D],
		mat: Material, mesh: Mesh = null) -> MultiMeshInstance3D:
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = mesh if mesh != null else _city_cube
	mm.instance_count = transforms.size()
	for i in transforms.size():
		mm.set_instance_transform(i, transforms[i])
	var node := MultiMeshInstance3D.new()
	node.name = node_name
	node.multimesh = mm
	node.material_override = mat
	if ROAD_SURFACE.ROAD_NAMES.has(node_name) and mat is StandardMaterial3D:
		node.set_meta("road_baseline",mat)
		node.material_override=_road_material(ROAD_SURFACE.ROAD_NAMES[node_name],mat,node_name=="CityRoads")
	node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_terrain_root.add_child(node)
	if node_name=="CityRoads":_build_road_fittings(transforms)
	return node


## 楼体线脚的几何：**只有四个侧面的开口方筒**（无顶面、无底面）。
##
## ## ⚠️⚠️ 为什么不能用实心盒（批 K · 轮 4 最贵的一个坑）
##
## 我一开始按"线脚是细环带"造它，用 `_city_cube` 缩成 `(tw+2δ, H, td+2δ)`
## —— **完全错了**。实心盒的**顶面**是 `(tw+2δ) × (td+2δ)` 的**完整矩形**，
## 而塔身宽度 `tw` 是 `base × 0.30~0.46`，`base`（地块尺寸）是
## `ARENA_RADIUS / CITY_GRID × CITY_FILL ≈ 4025 × 0.8` —— **数千米**。
## 于是**一道线脚的顶面就有 2 km²**。
##
## 相机停在塔身中部高度往下看时，下面每一道线脚的顶面**全部可见、层层叠加**，
## 实拍就是**一堵亮色巨墙盖住整栋楼**。染色归因把它钉死了：把
## `CITY_BAND_ALBEDO` 临时改成纯绿拍一张 —— 整栋楼正面被绿板盖满，
## 而且绿板一直延伸出画面**下边界**（因为盒子的水平半径是 750 m，
## 最近那个面离相机只剩 750 m，已经在近景里了）。
##
## ⇒ **"线脚占画面 19.7%" 这个读数，量到的从头到尾都不是线脚，是板顶面。**
##   我拿这个数去"调参数"调了两轮，方向就是错的。
##
## ## 开口筒为什么对
##
## · **俯视方向的投影面积是 0**：四个侧面都是**竖直面**，从正上方看只投影成
##   一根零宽的线。没有顶面，就没有那块 2 km² 的板。
## · **俯视时连"筒内部"也看不到**：筒的内径**恰好等于塔身外径**（都取 `tw`/`td`），
##   于是筒的内部被塔身本体填满 —— 从上往下看，看到的仍然是塔身自己。
## · **侧面看仍然是凸出的一圈**：外壁比塔身外 1.3 m，那一圈就是线脚。
## · 材质用 `cull_disabled`：从俯视方向看，筒**内壁**也会进视锥，单面材质会把它剔掉，
##   于是"筒"在俯视下会露出一条缝。双面之后几何是闭合的观感。
##   （⚠️ 双面**不会**带回那块板 —— 内壁同样是竖直面，投影照样是零宽。）
static func _make_band_shell() -> ArrayMesh:
	var vt := PackedVector3Array([
		# +X 侧
		Vector3(0.5, -0.5, -0.5), Vector3(0.5, -0.5, 0.5), Vector3(0.5, 0.5, 0.5),
		Vector3(0.5, -0.5, -0.5), Vector3(0.5, 0.5, 0.5), Vector3(0.5, 0.5, -0.5),
		# -X 侧
		Vector3(-0.5, -0.5, 0.5), Vector3(-0.5, -0.5, -0.5), Vector3(-0.5, 0.5, -0.5),
		Vector3(-0.5, -0.5, 0.5), Vector3(-0.5, 0.5, -0.5), Vector3(-0.5, 0.5, 0.5),
		# +Z 侧
		Vector3(0.5, -0.5, 0.5), Vector3(-0.5, -0.5, 0.5), Vector3(-0.5, 0.5, 0.5),
		Vector3(0.5, -0.5, 0.5), Vector3(-0.5, 0.5, 0.5), Vector3(0.5, 0.5, 0.5),
		# -Z 侧
		Vector3(-0.5, -0.5, -0.5), Vector3(0.5, -0.5, -0.5), Vector3(0.5, 0.5, -0.5),
		Vector3(-0.5, -0.5, -0.5), Vector3(0.5, 0.5, -0.5), Vector3(-0.5, 0.5, -0.5),
	])
	var nor := PackedVector3Array()
	var normals := [Vector3(1, 0, 0), Vector3(-1, 0, 0),
		Vector3(0, 0, 1), Vector3(0, 0, -1)]
	for i in 4:
		var n: Vector3 = normals[i]
		for j in 6:
			nor.append(n)
	var uv := PackedVector2Array()
	for i in 4:
		uv.append(Vector2(0, 0)); uv.append(Vector2(1, 0)); uv.append(Vector2(1, 1))
		uv.append(Vector2(0, 0)); uv.append(Vector2(1, 1)); uv.append(Vector2(0, 1))
	var arr := []
	arr.resize(Mesh.ARRAY_MAX)
	arr[Mesh.ARRAY_VERTEX] = vt
	arr[Mesh.ARRAY_NORMAL] = nor
	arr[Mesh.ARRAY_TEX_UV] = uv
	var am := ArrayMesh.new()
	am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	return am


## 开口筒的**单例缓存**（整座城只有一份几何，几百栋楼共用）。
func _city_band_shell() -> ArrayMesh:
	if _city_band_shell_mesh == null:
		_city_band_shell_mesh = _make_band_shell()
	return _city_band_shell_mesh


## 城市材质缓存：按 (基色, 自发光, 能量, 双面) 复用，避免几百份等价材质。
##
## `cull_off` 是给**楼体线脚**用的（那边是一个"只有侧面的开口筒"，
## 从俯视方向看，筒的内壁也会进入视锥 —— 见 `_make_band_shell()`）。
## ⚠️ 它必须进缓存 key：否则"先建纯色楼体、再建线脚"时，线脚会**拿到楼体那份
## 单面材质**（因为基色相同就不会走到 duplicate），于是俯视时筒的内壁消失。
func _city_material(col: Color, emissive := Color(0, 0, 0, 0),
		energy := 2.4, cull_off := false) -> StandardMaterial3D:
	var key := "%s|%s|%.2f|%d|%.3f" % [col.to_html(), emissive.to_html(), energy,
		1 if cull_off else 0, scene_gain]
	if _city_mat_cache.has(key):
		return _city_mat_cache[key]
	var mat := StandardMaterial3D.new()
	mat.albedo_color = _sg(col)
	mat.roughness = 0.90
	mat.metallic = 0.0
	if cull_off:
		mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	if emissive.a > 0.0:
		mat.emission_enabled = true
		mat.emission = emissive
		mat.emission_energy_multiplier = energy
	_city_mat_cache[key] = mat
	return mat


## 立面强度的**总开关**（0~1）。见 `city.gdshader` 里的 `facade_strength`：
## 0 = 逐字节等价于 1.2 的纯色楼体。像素探针的 `--facade=0` 就是把它拧到 0 做 A/B。
##
## 定在 0.75 而不是 1.0：窗格压暗与粗糙度变化**同时**到顶时，近处贴楼飞会显得"花"，
## 而 0.75 已经足够读出幕墙。这个数只有进游戏试玩才能最终定（工具测得了变化量、
## 测不了好不好看）。
const CITY_FACADE_STRENGTH := 0.75

## 立面窗格的**距离淡出**两端（米）。推导写在 `city.gdshader` 的 `near_f` 那一段：
## 按"最小开间 5.2 m 在本工程基准分辨率下占几像素"反推 —— 970 m 处还有 4 px（保满对比），
## 1950 m 处到 2 px 奈奎斯特极限（淡净）。
##
## ⚠️ 提成常量（而不是留在 shader 里当字面量）的两个理由：
##   ① **可测**：像素探针的 `--fadefar=<米>` 靠它把淡出拧掉，
##      才能把"淡出把这一项吃掉了"与"这项根本没接到楼体上"分开 ——
##      这两种情况的画面表现**都是"几乎没变"**（第一轮就卡在这儿查不下去）；
##   ② **单真源**：改观感只该改这一处，而不是去 shader 里找一个 `smoothstep` 里的数。
const CITY_FACADE_FADE_NEAR := 970.0
const CITY_FACADE_FADE_FAR := 1950.0


## 城市楼体的**立面**材质（1.2.3 批 G）。
##
## 与 `_city_material()` 的分工：那个是"一块颜色 + 一个粗糙度"的纯色材质，
## 给路灯 / 桥索 / 屋顶设备 / 地标构件用；这个是**楼体**用的，多了一套按米制铺开的窗格。
## 两者都按 `颜色|...` 缓存，所以整座城的材质数量仍然是几十份（不是几百份）。
##
## ⚠️ 类别参数是**刻意写死的小表**，不是"按每栋楼的尺寸算"：
## 参数会进缓存键，一旦逐栋不同，材质数就会跟着地块数一起涨（几百份材质 = 几百个 draw call，
## 这正是 `city_lot_for` 把颜色量化到 1/200 的原因）。要调观感请改这张表。
func _city_facade_material(col: Color, facade: int,
		facade_strength := CITY_FACADE_STRENGTH) -> ShaderMaterial:
	var key := "%s|%d|%.2f|%.3f" % [col.to_html(), facade, facade_strength, scene_gain]
	if _city_facade_cache.has(key):
		return _city_facade_cache[key]
	var mat := ShaderMaterial.new()
	if ResourceLoader.exists(CITY_SHADER):
		mat.shader = load(CITY_SHADER)
	# 表：粗糙 / 金属 / 开间 / 层高 / 框宽(x,y) / 玻璃板压暗 / 玻璃板粗糙
	#
	# 三个类别的差别就是"都市观感"的差别：
	#   · CONCRETE —— 混凝土墙 + 普通窗（粗糙 0.90，只有玻璃板才反光）
	#   · GLASS    —— 幕墙：框很薄（0.08）而玻璃板**极光滑**（0.05）⇒
	#                 整栋楼把天空（`BG_SKY`）反射下来，正是"玻璃幕墙亮起来有天空色"；
	#                 板面压暗 0.30 让窗格从远处也读得出来
	#   · METAL    —— 港区/机库那一类：金属度 0.40、粗糙 0.46，反射带一点自身颜色
	#   · PODIUM   —— 裙房：开口更大（9.0 × 5.5）的商铺玻璃
	var cfg := {
		Facade.CONCRETE: [0.90, 0.0, 5.6, 4.0, Vector2(0.16, 0.26), 0.26, 0.12],
		Facade.GLASS: [0.34, 0.22, 5.2, 4.0, Vector2(0.08, 0.16), 0.30, 0.05],
		Facade.METAL: [0.46, 0.40, 6.4, 4.6, Vector2(0.18, 0.22), 0.22, 0.18],
		Facade.PODIUM: [0.90, 0.0, 9.0, 5.5, Vector2(0.14, 0.30), 0.24, 0.14],
	}
	var c: Array = cfg.get(facade, cfg[Facade.CONCRETE])
	mat.set_shader_parameter("albedo_tint", _sg(col))
	mat.set_shader_parameter("roughness_value", c[0])
	mat.set_shader_parameter("metallic_value", c[1])
	mat.set_shader_parameter("specular_value", 0.5)
	mat.set_shader_parameter("bay_w", c[2])
	mat.set_shader_parameter("floor_h", c[3])
	mat.set_shader_parameter("frame_w", c[4])
	mat.set_shader_parameter("pane_dark", c[5])
	mat.set_shader_parameter("pane_rough", c[6])
	mat.set_shader_parameter("facade_strength", facade_strength)
	mat.set_shader_parameter("surface_detail", 1.0 if environment_detail_enabled else 0.0)
	mat.set_shader_parameter("facade_fade_near", CITY_FACADE_FADE_NEAR)
	mat.set_shader_parameter("facade_fade_far", CITY_FACADE_FADE_FAR)
	_city_facade_cache[key] = mat
	return mat


## 依地形分派。


func _build_target_ring(node_name: String, center: Vector3, radius: float) -> void:
	var root := Node3D.new()
	root.name = node_name
	root.position = center
	_terrain_root.add_child(root)
	var col := Color(1.0, 0.78, 0.28)
	for i in 4:
		var rr := radius * (1.0 - float(i) * 0.24)
		var torus := TorusMesh.new()
		torus.inner_radius = rr - 16.0
		torus.outer_radius = rr
		torus.rings = 40
		torus.ring_segments = 4
		var m := StandardMaterial3D.new()
		m.albedo_color = col
		m.emission_enabled = true
		m.emission = col
		m.emission_energy_multiplier = 1.6
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		torus.material = m
		var mi := MeshInstance3D.new()
		mi.mesh = torus
		mi.position = Vector3(0, 3.0, 0)
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		root.add_child(mi)
	# 靶心
	var disc := CylinderMesh.new()
	disc.top_radius = radius * 0.10
	disc.bottom_radius = radius * 0.10
	disc.height = 5.0
	disc.radial_segments = 24
	var dm := StandardMaterial3D.new()
	dm.albedo_color = Color(1.0, 0.42, 0.24)
	dm.emission_enabled = true
	dm.emission = Color(1.0, 0.42, 0.24)
	dm.emission_energy_multiplier = 1.8
	disc.material = dm
	var dmi := MeshInstance3D.new()
	dmi.mesh = disc
	dmi.position = Vector3(0, 3.0, 0)
	root.add_child(dmi)


# ------------------------------------------------------------ 云层

## Three altitude bands, with per-map clearance above terrain / city skylines.
## Small cumulus starts at the former largest puff size (2100 m).
## Every fifth main cluster is a bank with five times the former maximum
## horizontal extent: 2 * 1600 * 5 + 2100 * 5 = 26500 m.
## Main puff thickness is 1.8x; sparse bank puffs bound transparent overdraw.
## World-space ellipsoids integrate noisy optical depth and scene-depth clipping.
func _build_clouds(density := 1.0) -> void:
	var altitude_offset := map.cloud_altitude_offset if map != null else 0.0
	var d := maxf(density, 0.05)
	# Lower cumulus keeps a navigable, translucent base.
	var low_transforms: Array[Transform3D] = []
	_lay_cloud_band(low_transforms, int(round(30.0 * d)), 24, 40,
		CLOUD_LOW_LO + altitude_offset, CLOUD_LOW_HI + altitude_offset, 50600.0, 650.0, 1200.0, 0.62,
		1500.0, CLOUD_SMALL_SIZE, 1.30, 1.0)
	_add_cloud_layer("CloudLayerLow", low_transforms,
		_make_cloud_material(Color(0.13, 0.16, 0.26, 0.34), Color(0.05, 0.06, 0.12), 0.24))

	# Thick main cumulus and broad cloud banks.
	var mid_transforms: Array[Transform3D] = []
	_lay_cloud_band(mid_transforms, int(round(70.0 * d)), 40, 70,
		CLOUD_MAIN_LO + altitude_offset, CLOUD_MAIN_HI + altitude_offset, 55200.0, 700.0, 1600.0, 0.62,
		CLOUD_SMALL_SIZE, 2800.0, 1.0, CLOUD_THICKNESS_SCALE)
	# ★ 存住这一带的材质：发射点上空那垛云（`_build_launch_clouds()`）**复用它**。
	# 复用而不是另造一份的理由是**时段换色**：`apply_time_of_day()` 是按
	# `_cloud_mats` 的**下标**去配 `tod.cloud_tints[i]` 的，而那份预设只有 3 档。
	# 另造一份的话它会是第 4 个下标 ⇒ **永远拿不到换色**、永远停在建城那一刻的颜色，
	# 而画面上只是"天上有一片云和别的云不太一样"，不报错。
	# 共用同一个 `ShaderMaterial` 实例 ⇒ "换色"这件事对它自动成立。
	_cloud_mat_mid = _make_cloud_material(Color(0.17, 0.20, 0.31, 0.95),
		Color(0.05, 0.06, 0.12), 0.26)
	_add_cloud_layer("CloudLayerMid", mid_transforms, _cloud_mat_mid)

	# Higher, softer cloud sheets retain their lower opacity.
	var high_transforms: Array[Transform3D] = []
	_lay_cloud_band(high_transforms, int(round(70.0 * d)), 7, 12,
		CLOUD_HIGH_LO + altitude_offset, CLOUD_HIGH_HI + altitude_offset, 57500.0, 1200.0, 2400.0, 0.15,
		1500.0, 2400.0, 2.20, 0.80)
	_add_cloud_layer("CloudLayerHigh", high_transforms,
		_make_cloud_material(Color(0.12, 0.15, 0.26, 0.26), Color(0.06, 0.07, 0.14), 0.11))

	# ---- 顺手烘云影覆盖图（第十四轮）----
	# ⚠️ 建造完就把三带留在 `cloud_bands` 里：几何不变量（比如"3500 m 以下没有云"）
	# **只能在这份 CPU 侧数据上量** —— MultiMesh 在无头模式下读不回实例（见那个变量的注释）。
	cloud_bands = [low_transforms, mid_transforms, high_transforms]
	if environment_detail_enabled and DisplayServer.get_name() != "headless" and supports_local_fog():
		_local_cloud_volume = LOCAL_CLOUD_VOLUME.new()
		_local_cloud_volume.name = "LocalCloudVolumes"
		_local_cloud_volume.configure(cloud_bands)
		add_child(_local_cloud_volume)
	# 必须放在这里：三带的变换就在手边，而且**换图重建云之后覆盖图会跟着更新**
	# （艾尔斯岩的云量是 1.9 倍，影子自然也要密 1.9 倍）。
	_bake_cloud_shade([
		{"transforms": low_transforms, "weight": CLOUD_SHADE_WEIGHTS[0]},
		{"transforms": mid_transforms, "weight": CLOUD_SHADE_WEIGHTS[1]},
		{"transforms": high_transforms, "weight": CLOUD_SHADE_WEIGHTS[2]},
	])


# ------------------------------------------------------------ 云影

## 把这一层的云烘成"云影覆盖图"。
##
## 每个云盘 = 在地上投一个以它为中心的软圆斑，权重按高度带来（见 CLOUD_SHADE_WEIGHTS）。
## 累加后钳到 1：云团密集处影子更深，但不会叠成"全黑"。
##
## ⚠️ 半径用的是 `basis` 的缩放：圆盘是 `QuadMesh(size = 1)`，在 shader 里按 UV
## 画出圆来，所以世界半径 ≈ 0.5 × 缩放。乘 `CLOUD_SHADE_GROW` 放大成影子。
func _bake_cloud_shade(bands: Array) -> void:
	var res := CLOUD_FIELD_RES
	var cell := cloud_field_span / float(res)
	var half := cloud_field_span * 0.5
	_cloud_field = PackedFloat32Array()
	_cloud_field.resize(res * res)
	for entry: Dictionary in bands:
		var weight: float = entry["weight"]
		for tr: Transform3D in (entry["transforms"] as Array):
			var scl := tr.basis.get_scale()
			var radius: float = maxf(scl.x, scl.y) * 0.5 * CLOUD_SHADE_GROW
			if radius <= 0.0:
				continue
			var c := tr.origin
			var x0 := maxi(0, int(floor((c.x - radius + half) / cell)))
			var x1 := mini(res - 1, int(ceil((c.x + radius + half) / cell)))
			var z0 := maxi(0, int(floor((c.z - radius + half) / cell)))
			var z1 := mini(res - 1, int(ceil((c.z + radius + half) / cell)))
			for iz in range(z0, z1 + 1):
				var wz := (float(iz) + 0.5) * cell - half
				for ix in range(x0, x1 + 1):
					var wx := (float(ix) + 0.5) * cell - half
					var d := Vector2(wx - c.x, wz - c.z).length()
					if d >= radius:
						continue
					# 软边：(1 − d/r)² —— 线性衰减会在斑块边缘留下可见的圆圈
					var f := 1.0 - d / radius
					var idx := iz * res + ix
					_cloud_field[idx] = minf(_cloud_field[idx] + f * f * weight, 1.0)
	# GPU 侧：R 通道的浮点图。256² × 4 B = 256 KB，一次上传，之后只读。
	var img := Image.create_empty(res, res, false, Image.FORMAT_RF)
	for iz in res:
		for ix in res:
			img.set_pixel(ix, iz, Color(_cloud_field[iz * res + ix], 0.0, 0.0, 1.0))
	_cloud_shade_tex = ImageTexture.create_from_image(img)


## 某个世界坐标的云影系数（0 = 头顶没云，1 = 完全在云下）。**纯函数**（场建好之后只读），
## 所以"机体上的云影"可以脱离渲染单独做断言 —— 见 `suite_abilities` 的云影一组。
##
## 双线性插值：机体的 albedo 每帧都要乘这个系数，
## 用最近邻的话云影会一格一格地跳（203 m 一格，高速下非常明显）。
func cloud_shade_at(world_pos: Vector3) -> float:
	if _cloud_field.is_empty():
		return 0.0
	var res := CLOUD_FIELD_RES
	var cell := cloud_field_span / float(res)
	var fx := (world_pos.x + cloud_field_span * 0.5) / cell - 0.5
	var fz := (world_pos.z + cloud_field_span * 0.5) / cell - 0.5
	fx = clampf(fx, 0.0, float(res - 1))
	fz = clampf(fz, 0.0, float(res - 1))
	var x0 := int(floor(fx))
	var z0 := int(floor(fz))
	var x1 := mini(x0 + 1, res - 1)
	var z1 := mini(z0 + 1, res - 1)
	var tx := fx - float(x0)
	var tz := fz - float(z0)
	var a := lerpf(_cloud_field[z0 * res + x0], _cloud_field[z0 * res + x1], tx)
	var b := lerpf(_cloud_field[z1 * res + x0], _cloud_field[z1 * res + x1], tx)
	return lerpf(a, b, tz)


## 把云影覆盖图灌进所有会采样它的材质（地表 + 海面）。
## 建图顺序上它必须**晚于**地表与云的创建，所以由 `_rebuild_clouds()` 在最后调用。
func _refresh_cloud_uniforms() -> void:
	var strength := CLOUD_SHADE_STRENGTH if _cloud_shade_tex != null else 0.0
	for mat in _terrain_mats:
		_apply_cloud_uniforms(mat, strength)
	if _ocean_mat != null:
		_apply_cloud_uniforms(_ocean_mat, strength)


func _apply_cloud_uniforms(mat: ShaderMaterial, strength: float) -> void:
	mat.set_shader_parameter("cloud_shade_tex", _cloud_shade_tex)
	mat.set_shader_parameter("cloud_field_origin",
		Vector2(-cloud_field_span * 0.5, -cloud_field_span * 0.5))
	mat.set_shader_parameter("cloud_field_span", cloud_field_span)
	mat.set_shader_parameter("cloud_shade_strength", strength)


## 场景亮度增益的**唯一**乘法处（见 `SCENE_GAIN` 的说明）。
##
## 所有"吃光照的场景材质"都要经过它。漏掉一处的症状很隐蔽：
## 那类东西在提亮之后**仍然保持原亮度**，画面看上去只是"那块没变"——
## 不报错、不警告、`--check-only` 也是绿的。
##
## ⚠️ **只乘 albedo，不碰 emission**：带自发光的那些（路灯罩、地标灯箱、
## 商场立像背后的灯）是**光源**，把自发光也乘上去等于顺手改了灯的强度 ——
## 而需求只说了"场景更亮"，没说要动灯。
func _sg(c: Color) -> Color:
	if is_equal_approx(scene_gain, 1.0):
		return c
	return Color(c.r * scene_gain, c.g * scene_gain, c.b * scene_gain, c.a)


## 地表材质（第十四轮把原来那几份 StandardMaterial3D 收成一处）。
##
## 换过来的原因只有一个：**地表要有云影**，而 StandardMaterial3D 读不了自定义贴图。
## 其余属性刻意与原来对齐（顶点色当 albedo、粗糙度、镜面），所以画面不该有可见变化。
##
## 登记进 `_terrain_mats`，由 `_refresh_cloud_uniforms()` 统一灌云影 uniform ——
## 建材质的时候云影图还不存在（云是 `apply_map()` 最后一步才建的）。
##
## ## 换材质**只**多了云影，亮度/配色没有变化（实测过）
##
## 换材质这种事必须量，不能靠眼睛 —— 眼睛分不清"这是云影"还是"这是材质变了"。
## 做法：临时加一个开关让 `_terrain_material()` 退回 `StandardMaterial3D`（没有云影），
## 同一机位各抓一张，量同一块沙地：
##
## | 区域 | StandardMaterial3D（无云影） | terrain.gdshader（有云影） |
## |---|---|---|
## | x=1100 y=600 | R=115.7 G=91.2 B=90.0 | R=87.4 G=67.1 B=65.8 |
## | x=150 y=820 | R=110.4 G=93.6 B=94.9 | R=76.0 G=64.5 B=66.0 |
## | x=950 y=200（天空/云） | R=62.1 G=47.9 B=49.1 | R=62.1 G=47.9 B=49.1 |
##
## 结论有三条，都值得记住：
##   1. **差值就是云影本身**（约 −25%，而 `CLOUD_SHADE_STRENGTH` 是 0.45），
##      材质替换在亮度与色相上是**中性**的；
##   2. 天空那一行**逐字节相同** —— 也是"两张图确实同机位、可比"的证据；
##   3. 顺带验出一个反直觉的事实：`diffuse_lambert` 那一行加不加**完全没区别**
##      （见 `terrain.gdshader` 顶部的实测记录），所以它只是语义对齐。
func _terrain_material(tint: Color, roughness: float, use_vertex_color: bool,
		specular := 0.5, detail := 0.0, detail_wavelength := 1280.0,
		mat_blend := 0.0, mat_stretch := 3.0, mat_angle := 0.0,
		veg := 0.0, mottle := 0.0, mottle_wavelength := 24.0) -> Material:
	var mat := ShaderMaterial.new()
	if ResourceLoader.exists(TERRAIN_SHADER):
		mat.shader = load(TERRAIN_SHADER)
	mat.set_shader_parameter("albedo_tint", _sg(tint))
	mat.set_shader_parameter("use_vertex_color", use_vertex_color)
	mat.set_shader_parameter("roughness_value", roughness)
	mat.set_shader_parameter("metallic_value", 0.0)
	mat.set_shader_parameter("specular_value", specular)
	# ---- 地表细节（1.2.3 批 E）----
	# `detail` 是**法线扰动强度**，`detail_grain` 顺带按它的 **0.75** 给一点 albedo 颗粒
	#（同一份噪声，不多花采样）。
	#
	# ⚠️ **0.75 是批 H · 轮 2 从 0.5 提上来的**，理由是实拍归因：
	# 夜战地图（艾尔斯岩 / 奥恩贝利 / 太平洋）里，**法线扰动几乎不产明暗** ——
	# 月光入射角低、天空环境光又是各向同性的，扰动出来的坡度读不出来。
	# 实测：沙漠贴地机位下 `--detail=0` 与开着的两张图**肉眼完全无差别**。
	# 于是"夜里地表的质感"只能靠 **albedo 颗粒**，而它是唯一一条不依赖光照方向的路径
	#（`base *= 1 - grain * h0`，纯乘性、只压暗不吹亮，所以不会动 1.2 调好的亮度基线）。
	#
	# 法线那一半**不动**（还是 1.0 倍）—— 刻意不让它跟着涨，
	# 否则近景会出现"塑料浮雕"那种过冲的假立体感。
	#
	# ⚠️ **默认是 0**（"看不出区别"），而不是"默认就开"：这样任何忘了传第 5 个参数的
	# 老调用点行为一字不变，而且探针能用 `--detail=0` 把这一项**单独**拧回去做 A/B。
	#
	# 各表面对应关系（写在调用点那里，这里只做转交）。
	# 第 6 个参数是**最粗那一层的波长（米）**（1.2.3 批 E 第二版：语义从"频率倍率"
	# 改成了"米"，理由见 `terrain.gdshader` 里 `detail_wavelength` 的血泪注释 ——
	# 旧口径的 0.22~0.65 对应 1.5~4.5 m，在 3.2 km 的机位上只有 0.05~0.2 px，**必然隐形**）：
	#   沙丘 1280（沙丘起伏能一路读到 20 km 外）· 岛屿岩面 380 · 靶场地坪 250（混凝土板）
	#   城市地面 160（沥青）· 岩脊 320 · **远景地坪 0（不铺细节）**
	mat.set_shader_parameter("detail_strength", detail)
	mat.set_shader_parameter("surface_detail", 1.0 if environment_detail_enabled and detail > 0.0 else 0.0)
	# Existing material wavelengths distinguish hardscape from natural rock/sand.
	mat.set_shader_parameter("hardscape", 1.0 if detail_wavelength <= 250.0 else 0.0)
	mat.set_shader_parameter("detail_grain", detail * 0.75)
	mat.set_shader_parameter("detail_wavelength", detail_wavelength)
	# ---- 材质分层（1.2.3 批 H · 轮 2）----
	# 第 7~9 个参数：`mat_blend` = 分层强度（0 = 退回各向同性的单层噪声）、
	# `mat_stretch` = 层理方向上的拉伸倍率、`mat_angle` = 层理方向（弧度）。
	# 四张图各一套（见各调用点），所以同一份 shader 在不同图上读起来不是同一种料子。
	#
	# ⚠️ `mat_stretch` 只在 `mat_blend > 0` 时有意义（掩码为 0 的地方不拉伸）。
	mat.set_shader_parameter("mat_blend", mat_blend)
	mat.set_shader_parameter("mat_stretch", mat_stretch)
	mat.set_shader_parameter("mat_angle", mat_angle)
	# ---- 稀疏植被覆盖（1.2.3 批 I · 轮 5）----
	# 第 10 个参数 `veg` = 覆盖率强度（0 = 这块地不长东西）。
	# 目前**只有艾尔斯岩的沙丘**传非 0（用户参照要求"7% 左右不均匀的植被覆盖"）——
	# 覆盖率本身在 shader 里由离线钉的 `VEG_CUT`（场的 P93）决定，
	# 这个参数是"要不要这一层"的总开关，不是"覆盖率是多少"。
	# 想改覆盖率请改 shader 里的 `VEG_CUT`，并重跑 `_veg_frac.py` 核数。
	mat.set_shader_parameter("veg_amount", veg)
	# ---- 颜色斑驳（1.2.3 批 I · 轮 7）----
	# 第 11~12 个参数：`mottle` = 强度（0 = 关）、`mottle_wavelength` = 最粗层波长（米）。
	# 四张图各一套（见上面的 `MOTTLE_*` 常数与各调用点）。
	#
	# ⚠️ 默认 0（关）：与 `detail` / `veg` 同一个规矩 ——
	# 忘了传这一段的老调用点行为**一字不变**，探针也能用 `--mottle=0` 单独拧回去做 A/B。
	mat.set_shader_parameter("mottle", mottle)
	mat.set_shader_parameter("mottle_wavelength", mottle_wavelength)
	# 云影 uniform 先给一份"关"的：万一有人拿到材质却没走 refresh，也不会采样到空贴图
	_apply_cloud_uniforms(mat, 0.0)
	# ---- 绿洲掩码（1.2.3 批 K · 轮 1③）----
	# ⚠️ 与云影同一个规矩，而且这里**更需要**：`veg_amount` 只有艾尔斯岩那张图传非 0，
	# 但材质是共用的 ⇒ 别的图也会带上这个 sampler。给它一个"全 0"的默认值，
	# 那些图上这一支就是"读了 0 ⇒ 不长草"，不会去采样一张不存在的贴图。
	#（`_veg_mask_tex` 在非沙漠图上是 `null`，而 shader 那边标了 `hint_default_black`
	#  ⇒ 读到 0。两条防线叠着，这是有意的。）
	mat.set_shader_parameter("veg_mask_tex", _veg_mask_tex)
	mat.set_shader_parameter("veg_mask_origin",
		Vector2(-DESERT_OASIS_SPAN * 0.5, -DESERT_OASIS_SPAN * 0.5))
	mat.set_shader_parameter("veg_mask_span", DESERT_OASIS_SPAN)
	_terrain_mats.append(mat)
	return mat


## 在一条高度带里撒云团，并把每个圆盘的变换追加进 [param result]。
## 参数顺序：云团数 / 每团圆盘数上下限 / 高度上下限 / 撒团半径 /
## 团半径上下限 / 垂直压扁比（相对团半径）/ 单盘尺寸上下限 / 单盘横纵拉伸倍数。
##
## 先撒团心、再围着团心堆圆盘，是"云"能被眼睛读出来的关键：
## 直接在场地里均匀撒 1000 个圆盘只会得到一团均匀的噪点。
func _lay_cloud_band(result: Array[Transform3D], clusters: int, puffs_min: int, puffs_max: int,
		y_min: float, y_max: float, spawn_radius: float,
		spread_min: float, spread_max: float, vertical_ratio: float,
		puff_min: float, puff_max: float, stretch_x: float, stretch_y: float) -> void:
	for i in clusters:
		var a := _rng.randf() * TAU
		# sqrt 让团心在圆盘上按面积均匀落点；直接 randf() 会全挤在竞技场圆心附近
		var r := sqrt(_rng.randf()) * spawn_radius
		var center := Vector3(cos(a) * r, _rng.randf_range(y_min, y_max), sin(a) * r)
		var puffs := _rng.randi_range(puffs_min, puffs_max)
		var spread := _rng.randf_range(spread_min, spread_max)
		# Every fifth main cluster is a broad cloud bank. Reduce overlapping puffs
		# in those banks instead of multiplying transparent fill cost by 25.
		var large := is_equal_approx(stretch_y, CLOUD_THICKNESS_SCALE) and i % 5 == 0
		var horizontal_scale := CLOUD_LARGE_SCALE if large else 1.0
		if large:
			puffs = maxi(8, puffs / 4)
			spread = 1600.0
		for j in puffs:
			var off := _puff_offset(spread * horizontal_scale, spread * vertical_ratio * CLOUD_THICKNESS_SCALE)
			var s := 2100.0 if large else _rng.randf_range(puff_min, puff_max)
			var width := s * stretch_x * horizontal_scale
			var height := s * stretch_y
			var basis := Basis().scaled(Vector3(width, height, width))
			var at := center + off
			at.y = maxf(at.y, CLOUD_FLOOR + (map.cloud_altitude_offset if map != null else 0.0) + height * 0.5)
			result.append(Transform3D(basis, at))


## 在扁椭球内取一个偏移点（**用共享的 `_rng`**）。见 `_puff_offset_rng()`。
func _puff_offset(horizontal: float, vertical: float) -> Vector3:
	return _puff_offset_rng(_rng, horizontal, vertical)


## 在扁椭球内取一个偏移点。
## 先在单位球里取方向、再乘 randf() 的立方根 —— 立方根是为了体积均匀，
## 不然碟片全堆在团心，云团会变成一个实心球而不是"扁平的一坨"。
## 最后按水平/垂直两个半径拉伸，垂直半径远小于水平半径就得到了积云那种平底大盖。
##
## ⚠️ 随机源是**参数**而不是直接读 `_rng`。这不是洁癖：
## `_rng` 是**整张图共享**的一条流，从别处多抽一次会把后面所有消费者
##（岛屿 / 树 / 城 / 浮标）的随机序列**整体平移**。
## 发射点上空那一垛云（`_build_launch_clouds()`）就带了自己的 `rng` 走这条口子 ——
## 否则"给发射点加一片云"会顺带把整张图重新洗一遍，而且**不报任何错**。
func _puff_offset_rng(rng: RandomNumberGenerator, horizontal: float, vertical: float) -> Vector3:
	var dir := Vector3(
		rng.randf_range(-1.0, 1.0),
		rng.randf_range(-1.0, 1.0),
		rng.randf_range(-1.0, 1.0))
	# 抽到零向量的概率极低但不是零，归一化前先兜一下，
	# 否则会算出一个 NaN 变换，那一带云可能整层消失
	if dir.length_squared() < 0.000001:
		dir = Vector3.UP
	dir = dir.normalized() * pow(rng.randf(), 1.0 / 3.0)
	return Vector3(dir.x * horizontal, dir.y * vertical, dir.z * horizontal)


## 造一份这一带专用的云材质。
## shade_color 在 shader 里声明成 vec3，直接塞 Color 会被当成四分量，
## 所以这里显式拆成 Vector3 再给。
func _make_cloud_material(tint: Color, shade: Color, softness: float) -> ShaderMaterial:
	var mat := ShaderMaterial.new()
	if ResourceLoader.exists(CLOUD_SHADER):
		mat.shader = load(CLOUD_SHADER)
	mat.set_shader_parameter("tint", tint)
	_sync_cloud_quality(mat)
	mat.set_shader_parameter("shade_color", Vector3(shade.r, shade.g, shade.b))
	mat.set_shader_parameter("softness", softness)
	mat.set_shader_parameter("surface_detail", 1.0 if environment_detail_enabled else 0.0)
	# 主光方向（批 E）：先给一份，之后每次 `apply_time_of_day()` 都会重推。
	# 不在这里给的话，"建云"到"第一次 apply_time_of_day"之间云是按 shader 里那个
	# 写死的默认方向亮的 —— 那个窗口里云会朝一个**错误的方向**受光。
	# 有时段就按时段算（纯函数，可单测），没有就用一个"高空的太阳"当占位。
	var cdir := celestial_dir(time_of_day.sun_rotation_deg) \
		if time_of_day != null else Vector3(0.35, 0.62, 0.70)
	mat.set_shader_parameter("sun_dir", cdir)
	if time_of_day!=null:
		mat.set_shader_parameter("light_color",Vector3(time_of_day.sun_color.r,time_of_day.sun_color.g,time_of_day.sun_color.b))
		mat.set_shader_parameter("air_color",Vector3(time_of_day.fog_color.r,time_of_day.fog_color.g,time_of_day.fog_color.b))
		mat.set_shader_parameter("air_density",time_of_day.fog_density*0.8)
	# 按创建顺序登记，供 apply_time_of_day 换色（低空 → 主积云 → 高空）
	_cloud_mats.append(mat)
	return mat


## 把一批变换装进一个 MultiMeshInstance3D，即一整带云 = 一个 draw call。
## 阴影一直关着：朝相机的圆盘投出来的只会是一块跟着镜头动的假影子，
## 而且云不参与光照，开了纯属白烧一笔阴影开销。
##
## [param parent] **默认 `null` ⇒ 挂 `_cloud_root`**（三带照旧，一个字不用改）。
## 发射点上空那一垛给了自己那个 `launch_cloud_root` —— 它必须能跟着换图一起被清掉
##（见那个容器的声明），而**不能**混进 `_cloud_root`：`_cloud_root` 是
##"三带"的容器，`suite_gfx_map` / `suite_round` 的云量判据都按它数。
func _add_cloud_layer(layer_name: String, transforms: Array[Transform3D], material: ShaderMaterial,
		parent: Node = null, partitioned := false) -> void:
	# Spatial batches can be culled independently; shared material keeps tint updates unified.
	if environment_detail_enabled and parent == null and not partitioned and transforms.size() > 256:
		var groups: Dictionary = {}
		for xf: Transform3D in transforms:
			var key := Vector2i(floori(xf.origin.x / 12000.0), floori(xf.origin.z / 12000.0))
			if not groups.has(key): groups[key] = []
			groups[key].append(xf)
		var index := 0
		for key in groups:
			var chunk: Array[Transform3D] = []
			chunk.assign(groups[key])
			_add_cloud_layer(layer_name + "_%d" % index, chunk, material, parent, true)
			index += 1
		return
	var quad := SphereMesh.new()
	quad.radius = 0.5
	quad.height = 1.0
	quad.radial_segments = 12
	quad.rings = 6
	quad.material = material

	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = quad
	mm.instance_count = transforms.size()
	for i in transforms.size():
		var xf := transforms[i]
		xf.basis.z = Vector3.BACK * xf.basis.x.length()
		mm.set_instance_transform(i, xf)

	var inst := MultiMeshInstance3D.new()
	inst.name = layer_name
	inst.multimesh = mm
	# Explicit bounds include the complete ellipsoid volumes.
	if not transforms.is_empty():
		var bounds := AABB(transforms[0].origin, Vector3.ZERO)
		for xf: Transform3D in transforms:
			var r := maxf(xf.basis.x.length(), xf.basis.y.length()) * 0.5
			bounds = bounds.expand(xf.origin - Vector3.ONE * r)
			bounds = bounds.expand(xf.origin + Vector3.ONE * r)
		inst.custom_aabb = bounds
	inst.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	# 挂到 `_cloud_root` 而不是自己身上：换图要**整层换掉**，有容器才好 free。
	#（调用方给了 `parent` 就用它的 —— 理由见上面那条 `parent` 的说明。）
	var host_node: Node = parent if parent != null else _cloud_root
	host_node.add_child(inst)


