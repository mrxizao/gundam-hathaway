## **富士电视台本社大楼**（台场地标）：两栋塔楼 + 顶部连廊 + **球体**瞭望室。
##
## 真实比例：高 123 m、球体直径 32 m（挂在两塔之间的高处，银灰格子幕墙）。
## 这里按竞技场倍率 ×8.5 ⇒ 高约 1050 m、球体直径 270 m。
func _city_fuji_tv(c: Vector3) -> void:
	var glass := Color(0.300, 0.330, 0.365)
	var h := 1050.0
	# 两栋竖塔（东西向并排），中间留出球体的位置
	for s: float in [-1.0, 1.0]:
		_add_box("FujiShaft%d" % int(s), c + Vector3(s * 430.0, h * 0.5, 0.0),
			Vector3(300.0, h, 340.0), glass)
		_city_body_count += 1
	# 顶部横向连廊（球体就挂在这条"桥"上）
	_add_box("FujiDeck", c + Vector3(0.0, h * 0.82, 0.0),
		Vector3(1160.0, 130.0, 320.0), glass.darkened(0.10))
	# 球体瞭望室：**真的是个球**
	#
	# ⚠️⚠️ 血泪（1.2.3 批 E；起因是玩家的一张实机截图："这个球是啥"）——
	# **世界坐标只能交给 `body`，`mi` 必须保持局部零位。**
	#
	# 第一版把 `mi.position` 与 `body.position` **都**设成了世界坐标，然后把 `mi`
	# 挂到 `body` 底下 ⇒ 父节点又加了一次偏移，球被搬到**两倍坐标**。
	# 实测（探针 `--aim=FujiSphere:1500` 打出的同前缀命中表，修复前）：
	#     FujiSphereRing  global=(-3500,  923, -3500)   ← 环带，位置对
	#     FujiSphereBody  global=(-3500,  861, -3500)   ← 碰撞球，位置对
	#     FujiSphere      global=(-7000, 1722, -7000)   ← **视觉球，偏了 5024 m**
	#
	# 为什么一直没被发现：错得**不像 bug**。一个直径 270 m 的球孤零零挂在天上
	# 1.7 km 处、底下一整片空，看起来只是"远景里一个不明球体"（玩家的原话就是
	# "这个球是啥"）—— 而不是"富士台的球体瞭望室跑掉了"。
	#
	# ⚠️ 还有一层是**玩法**上的：碰撞球从来在正确位置，视觉球在错位位置 ⇒
	# **能撞到的地方和看得见的地方差 5 km**。撞上一团空气、或者穿过一个看得见的
	# 东西 —— 这类"幽灵碰撞"从来不会报错，只会被当成手感问题。
	#
	# 规矩（`_add_box()` 一直是对的、也一直是这么做的）：**从不给 `mi.position` 赋值**。
	var sphere_pos := c + Vector3(0.0, h * 0.82, 0.0)
	var sphere := SphereMesh.new()
	sphere.radius = 135.0
	sphere.height = 270.0
	sphere.radial_segments = 32
	sphere.rings = 16
	var mi := MeshInstance3D.new()
	mi.name = "FujiSphere"
	mi.mesh = sphere
	mi.material_override = _city_material(Color(0.40, 0.44, 0.50))
	var body := StaticBody3D.new()
	body.name = "FujiSphereBody"
	body.collision_layer = FlightBody.WORLD_LAYER
	body.collision_mask = 0
	body.position = sphere_pos
	var bs := SphereShape3D.new()
	bs.radius = 135.0
	var bc := CollisionShape3D.new()
	bc.shape = bs
	body.add_child(bc)
	body.add_child(mi)
	_terrain_root.add_child(body)
	_city_body_count += 2
	# 球体外的一圈环带：**不再发光**（死城）。它现在只是"球体外面那圈结构"，
	# 靠天光读出轮廓 —— 在阴天黄昏的散射光里，球形剪影本身比亮边更自然。
	var ring := TorusMesh.new()
	ring.inner_radius = 148.0
	ring.outer_radius = 170.0
	ring.rings = 24
	ring.ring_segments = 6
	var ring_mi := MeshInstance3D.new()
	ring_mi.name = "FujiSphereRing"
	ring_mi.mesh = ring
	ring_mi.material_override = _city_material(Color(0.30, 0.33, 0.38))
	# ⚠️ 这里原来写的是 `mi.position + ...` —— 修完上面那处之后 `mi.position`
	# 已经是局部零位，照旧写会把这圈环带**掉到世界原点**去。改成同一个真源
	# `sphere_pos`：环带、球体、碰撞球从此共用一份坐标，不存在"改一处漏两处"。
	ring_mi.position = sphere_pos + Vector3(0.0, 62.0, 0.0)
	ring_mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_terrain_root.add_child(ring_mi)
	# 底下的商业裙房（Aqua City / DiverCity 那一圈）
	_add_box("FujiPodium", c + Vector3(0.0, 70.0, 0.0),
		Vector3(2600.0, 140.0, 1700.0), Color(0.108, 0.112, 0.118), 0.0)
	_city_body_count += 1


## **地面露天停车场**（2026-09-28 起**取代** DiverCity 门口那台 1:1 独角兽立像）。
##
## 用户："中间的独角兽立象模型可以拆了换成停车场"，并在追问里选了
## **地面露天**这一档（另两档是"立体停车楼"与"地面场 + 一栋停车楼"）。
##
## ## ⚠️⚠️ 它落在 `(0, 3)` 格 —— 而不是立像原来站的那个 `(300, 4900)`
## 立像原来站在 `(300, 4900)`，而**它占掉的地标格是 `(0, 3)`**
##（见 `_city_landmark_cell` 的奥恩贝利那一行），格心在 `(2 012, 14 088)` ——
## 两者相差 **9.2 km**。后果是：`(0, 3)` 被压抑着长不出楼（白白空一整格），
## 而立像实际站的那两格（`(-1, 0)` / `(0, 0)`）**照常长楼** ⇒
## 那座 170 m 的立像连它背后的 `GundamMall` 一起，被 400~2 500 m 的楼群
## **埋在中间**。这正是本工程自己写明的规矩"**地标站在自己的地基上**"
##（`_city_cell_center` 的注释）被破掉的一处。
## ⇒ 换成停车场时**顺手摆回它自己那一格**：`_city_cell_center(0, 3)`。
## 于是"楼长进停车场里"在**几何上不可能发生**（那一格本来就不长楼），
## 而不是靠"记得把某几格也压抑掉"。
##
## ## 四件东西，缺一样就读不出"这是停车场"
## | 构件 | 节点 | 做法 | 为什么 |
## |---|---|---|---|
## | 场地 | `ParkDeck` | 一块 **20 m 厚的沥青板**（`_add_box`，**进碰撞**） | 顶面必须是**一个平面**：地形本身起伏 ±7.9 m，直接往地上摆车会**半辆悬空** |
## | 车位线 | `ParkStripes` | **MultiMesh**（一次 draw call、零碰撞） | 见下面那条 ⚠️ |
## | 车 | `ParkCar%d` | 20 辆（`_add_box`，四种车漆色） | 停车场的视觉签名是**一排排车**，不是"一块空地" |
## | 灯柱 | `ParkMast%d%d` | 4 根 ×（柱 + 灯架），**不带自发光** | 奥恩贝利是死城（`map.city_lights == false`）⇒ 在这里点亮灯等于把"死城"这件事破掉 |
##
## ## ⚠️⚠️ 车位线做成 **8 m 高的矮墙**，不是"平铺的白漆线"
## 本工程的 `MultiMesh` 构件在死城的**掠射天光**下，**朝上的面几乎不受光** ——
## `_build_city_street_infra` 那一轮踩过这个坑：正俯视拍路面，拍回来**一张纯黑**，
## 而且 `err=0`、退出码 0、不报任何错（"照片拍成功了，只是拍出来是黑的"）。
## 平铺的白线**只有顶面**能被看见 ⇒ 从任何俯视机位都是一条黑线。
## 立成矮墙之后**侧面**入画，掠射光正好打在侧面上。
## 代价：它是几何，低空掠过时会看到"一排矮篱笆" —— 与路灯（90 m）相比小两档，
## 而真实停车场本来也有挡车杆/矮栏，读起来不违和。
##
## ## 尺度（沿用 `ARENA_RADIUS / 3300` ≈ 8.5 倍那条"玩法尺度"法则）
## 真车位 2.5 × 5.3 m ⇒ 这里 **55 × 90 m**；16 列 × 8 行 = **128 个车位**。
## 真车 4.6 × 1.8 × 1.45 m ⇒ 这里 **40 × 18 × 14 m**。
## 只停 20 辆：**停满了会读成"一片车顶"**，留出空位才像停车场。
func _city_parking_lot(c: Vector3) -> void:
	# ---- ① 场地 ----
	# ⚠️ 20 m 厚是**必须**的：地形起伏 ±7.9 m，板厚小于这个数就会有一角陷进地里、
	# 另一角悬空十几米（俯视图上看得出来）。顶面抬到 `c.y + 20` 之后是一个平面。
	var deck_w := 2000.0
	var deck_d := 1500.0
	var deck_top := 20.0
	_add_box("ParkDeck", c + Vector3(0.0, deck_top * 0.5, 0.0),
		Vector3(deck_w, deck_top, deck_d), Color(0.070, 0.070, 0.074), 0.0)
	_city_body_count += 1
	# ---- ② 车位线：一个 (16+1) × (8+1) 的矮墙网格 ----
	var cols := 16
	var rows := 8
	var sw := 55.0                          # 车位宽（沿 x）
	var sd := 90.0                          # 车位深（沿 z）
	var gx0 := -float(cols) * sw * 0.5      # 网格左缘（相对场地中心）
	var gz0 := -float(rows) * sd * 0.5
	var lh := 8.0                           # 矮墙高（理由见函数头那条 ⚠️）
	var lt := 5.0                           # 矮墙厚
	var stripes: Array[Transform3D] = []
	for i in cols + 1:
		stripes.append(_sized(
			c + Vector3(gx0 + float(i) * sw, deck_top + lh * 0.5, 0.0),
			Vector3(lt, lh, float(rows) * sd + lt), 0.0))
	for j in rows + 1:
		stripes.append(_sized(
			c + Vector3(0.0, deck_top + lh * 0.5, gz0 + float(j) * sd),
			Vector3(float(cols) * sw + lt, lh, lt), 0.0))
	_add_multimesh("ParkStripes", stripes, _city_material(Color(0.66, 0.66, 0.62)))
	# ---- ③ 车 ----
	# ⚠️ 停放位置由**下标算术**给定，**一次 `_city_rng` 都不抽** ——
	# 那条序列是整座城共享的顺序序列（见 `_city_block_at` 那一处 ⚠️⚠️）：
	# 这里多抽一次，全城的楼高/配色会整体平移，而根因在几百行之外。
	var paints: Array[Color] = [
		Color(0.42, 0.43, 0.46), Color(0.52, 0.16, 0.15),
		Color(0.14, 0.20, 0.34), Color(0.58, 0.56, 0.50)]
	var placed := 0
	for i in cols:
		for j in rows:
			if placed >= 20:
				break
			# 每 5 个车位停 1 辆 ⇒ 空位**连成片**，一眼看出"这是没停满的停车场"。
			if (i * 2 + j * 3) % 5 != 0:
				continue
			_add_box("ParkCar%d" % placed,
				c + Vector3(gx0 + (float(i) + 0.5) * sw, deck_top + 7.0,
					gz0 + (float(j) + 0.5) * sd),
				Vector3(18.0, 14.0, 40.0), paints[(i + j) % paints.size()], 0.0)
			_city_body_count += 1
			placed += 1
	# ---- ④ 灯柱（四角；**无自发光**，见函数头那张表）----
	var mx := deck_w * 0.5 - 120.0
	var mz := deck_d * 0.5 - 120.0
	for s: float in [-1.0, 1.0]:
		for t: float in [-1.0, 1.0]:
			var base := c + Vector3(s * mx, deck_top, t * mz)
			_add_box("ParkMast%d%d" % [int(s), int(t)],
				base + Vector3(0.0, 45.0, 0.0), Vector3(20.0, 90.0, 20.0),
				Color(0.105, 0.108, 0.115), 0.0)
			_add_box("ParkMastHead%d%d" % [int(s), int(t)],
				base + Vector3(0.0, 92.0, 0.0), Vector3(150.0, 14.0, 40.0),
				Color(0.095, 0.098, 0.105), 0.0)
			_city_body_count += 2
	# 背后的商业楼（DiverCity）—— 保留：立像本来就站在商场前，拆的是立像不是商场。
	# ⚠️ 挪到**场地正后方**并收进同一格（`z = c.z − 1 250`、进深 1 000 m）：
	# 原来它在 `c.z − 1 050` 且进深 1 300 m ⇒ 与场地重叠 350 m，还会跨到
	# 隔壁那一格（那一格**不在**地标表里 ⇒ 会与楼长在一起）。
	_add_box("DiverCityMall", c + Vector3(0.0, 260.0, -1250.0),
		Vector3(2600.0, 520.0, 1000.0), Color(0.115, 0.118, 0.124), 0.0, 0.0, 0.0,
		Color(0.090, 0.084, 0.074))
	_city_body_count += 1


## **东京 Big Sight**（台场北侧的国际展示场）：四栋塔楼 + **倒金字塔**会议楼。
##
## 倒锥必须用 `CylinderMesh`（上大下小）而不是 BoxMesh —— 一眼就认得出。
func _city_big_sight(c: Vector3) -> void:
	var h := 1450.0
	var glass := Color(0.135, 0.150, 0.175)
	for sx: float in [-1.0, 1.0]:
		for sz: float in [-1.0, 1.0]:
			_add_box("BigSightTower%d%d" % [int(sx), int(sz)],
				c + Vector3(sx * 1350.0, h * 0.5, sz * 950.0),
				Vector3(480.0, h, 480.0), glass, 0.0, 0.0, 0.0,
				Color(0.090, 0.084, 0.074))
			_city_body_count += 1
	# 倒金字塔：底小顶大（`top_radius > bottom_radius`），4 边形就是方锥
	var cone := CylinderMesh.new()
	cone.top_radius = 640.0
	cone.bottom_radius = 90.0
	cone.height = 640.0
	cone.radial_segments = 4
	# ⚠️ 同 `_city_fuji_tv` 的球体：**世界坐标只交给 `body`，`mi.position` 保持零。**
	# 这里第一版也是"`body.position = mi.position` 之后 `body.add_child(mi)`"，
	# 于是倒锥被搬到两倍坐标 —— 实测 global=(-14400, 2090, -19000)，
	# 而它该在的塔顶是 (-7200, 1045, -9500)，**偏了 11966 m**。
	# 两个地标是同一天发现、同一行代码、同一个错法的两处。
	var cone_pos := c + Vector3(0.0, h * 0.5 + 320.0, 0.0)
	var mi := MeshInstance3D.new()
	mi.name = "BigSightCone"
	mi.mesh = cone
	mi.material_override = _city_material(Color(0.16, 0.175, 0.20))
	var body := StaticBody3D.new()
	body.name = "BigSightConeBody"
	body.collision_layer = FlightBody.WORLD_LAYER
	body.collision_mask = 0
	body.position = cone_pos
	# ⚠️ **碰撞体只能用 `CylinderShape3D` 近似这个倒锥**：
	# Godot 的 `CylinderShape3D` 只有 `radius` + `height`（**没有** `top_radius` /
	# `bottom_radius` —— 那两个是 `CylinderMesh` 的属性）。
	# 第一版照着网格的属性写，运行时直接报
	# `Invalid assignment ... on a base object of type 'CylinderShape3D'`，
	# 而且**不致命**：截图照样出，只有碰撞形状是默认半径。
	# 取半径 640（锥的最大半径）⇒ 碰撞略大于可见锥体，
	# 在这个尺度下"擦到倒锥就掉血"比"穿过去却没事"更符合直觉。
	var cs := CylinderShape3D.new()
	cs.radius = 640.0
	cs.height = 640.0
	var cc := CollisionShape3D.new()
	cc.shape = cs
	body.add_child(cc)
	body.add_child(mi)
	_terrain_root.add_child(body)
	_city_body_count += 2


## 城市的**灯火**：窗户亮带 / 航空障碍灯 / 路灯。
##
## ⚠️⚠️ **只有 `map.city_lights` 为真时才被调用**（`_build_city()` 末尾）。
## 这一条就是"死城 / 活城"的**全部**差别所在：
## 地形、路网、楼群、单轨、桥两座城共用同一条管线，唯一分开的是
## ① 种子（`city_seed`，地块与楼高）② 配色（`city_land_*`）③ 灯（本函数）。
##
## 前两样（窗带 / 障碍灯）的**位置**由 `_city_block_at()` 在遍历地块时填进
## `_city_window_xf` / `_city_beacon_xf`（只有那里知道塔高、偏心、桅杆高），
## 这里只负责**几何与材质** —— 见那两个成员变量的注释。
##
## ## 为什么三样灯要在一个函数里
## 它们**必须同生同灭**。分散在 `_city_block_at()` / `_build_city_landmarks()` /
## `_build_city_street_infra()` 里各判一次 `map.city_lights`，
## 只要漏一处，死城就会"只剩一种灯还亮着"—— 而那种半亮不亮的图
## 比全亮或全灭都更难归因（"看着像灯没关干净"）。
func _build_city_lights() -> void:
	var n_win := _city_window_xf.size()
	var n_bea := _city_beacon_xf.size()
	if n_win > 0:
		# ⚠️ 开口筒（与楼体线脚共用一份几何资源）。见 `CITY_WINDOW_BAND_H` 的 ⚠️⚠️：
		# 实心盒的顶面是一块 km² 级的**发光板**，会把整栋楼盖住。
		# `cull_off = true` 与线脚同源：俯视时筒的内壁也在视锥里，单面材质会露出一条缝。
		_add_multimesh("CityWindows", _city_window_xf,
			_city_material(CITY_WINDOW_ALBEDO, CITY_WINDOW_EMISSION,
				CITY_WINDOW_ENERGY, true),
			_city_band_shell())
	if n_bea > 0:
		# 障碍灯是**实体小盒**（不是开口筒）：它是一个点光源的替身，
		# 从任何角度都该看得见 —— 竖直面在俯视方向投影为零，用筒反而看不见。
		_add_multimesh("CityBeacons", _city_beacon_xf,
			_city_material(CITY_BEACON_ALBEDO, CITY_BEACON_EMISSION, CITY_BEACON_ENERGY))
	print("[city] %s 灯火（FULL）：%d 道窗带 / %d 盏障碍灯" % [
		map.name_cn, n_win, n_bea])


## 沿街路灯（**杆 + 灯头**两个 MultiMesh）。返回"灯头"那个（供 `_city_lights` 留引用）。
##
## ## ⚠️⚠️ 2026-09-28 v3 换了三件事
## | # | 旧 | 新 | 为什么 |
## |---|---|---|---|
## | ① | **自己重算格线**，三点**分开各判一点**（`city_is_land` / `is_water_at` / `city_is_dry`） | **直接消费 `_city_dry_spans`** | 两套判据本来就不一致；C1 改成"段内裁剪"之后，旧做法会让灯**在路已经收口的地方继续排**（灯站在水里 / 岸上）。**唯一真源 ⇒ 路、桥、灯不可能分叉** |
## | ② | 灯杆压在**格线上 = 路的中心线** | **两侧各一排**（横向偏移 `±(路宽/2 − 30)`） | 460 m 宽的主干道上，那是"路灯插在马路正中间" |
## | ③ | 灯头一律带自发光 | **三档**（`CityLights`） | 奥恩贝利是死城，但**杆与灯头都要有**（只是不亮） |
##
## ## ⚠️ 灯位**必须与路面同源**（F2）
## 判据只有一份：`_build_city_street_infra()` 在做 C1 段内裁剪时产出的
## `_city_dry_spans`（每条格线上的**干燥区间**，米）。本函数**不再自己判**。
##
## ## 为什么是"杆 + 头"两个实例
## 只有灯头 ⇒ 低空掠过街道时是一排**飘在空中的光点**，没有支撑，很假；
## 只有灯杆 ⇒ 从高空看是一排暗点，等于没点灯。两者都要，
## 代价只是多一个 MultiMesh（同一个 draw call，两次绘制）。
func _build_city_street_lamps(mode: int) -> MultiMeshInstance3D:
	if mode == MapDef.CityLights.NONE:
		return null
	var heads: Array[Transform3D] = []
	var poles: Array[Transform3D] = []
	for sd: Dictionary in _city_dry_spans:
		var axis: int = sd.axis
		var line: float = sd.line
		var w: float = sd.w
		var t0: float = sd.t0
		var t1: float = sd.t1
		# 两侧各留 30 m 边距 ⇒ 灯落在**铺装边缘之内**（不是"插在路面上"）
		var off := maxf(w * 0.5 - 30.0, 20.0)
		# ⚠️ 相位改用"**区间起点 + PITCH/2**"（不再是 `-ARENA_RADIUS + PITCH*0.5`）：
		# 灯的节奏跟着**路的节奏**走 —— C1 一改路，灯自动跟上。
		var t := t0 + CITY_LAMP_PITCH * 0.5
		while t <= t1:
			for s: float in [-1.0, 1.0]:
				var p := Vector3(line + s * off, 0.0, t) if axis == 0 \
					else Vector3(t, 0.0, line + s * off)
				# ⚠️ 灯必须**站在地形上**：旧版写死 `y = 0`，而地形起伏是 ±7.9 m
				# ⇒ 洼地里的灯悬在空中、高地上的只露出一小截；而路面本身是按地形
				# 俯仰的（`_sized_pitch`）—— 灯不跟就是"灯离开了路"。
				p.y = _city_landform(p.x, p.z, map.city_layout)
				poles.append(_sized(p + Vector3(0.0, CITY_LAMP_POLE_H * 0.5, 0.0),
					Vector3(17.0, CITY_LAMP_POLE_H, 17.0), 0.0))
				# ⚠️ 灯头**压在杆顶**（`+ HEAD.y/2`）：留一截空隙会让灯头看起来
				# 悬在杆上方（第一版就是那样，实拍像"杆上飘着一个球"）。
				heads.append(_sized(
					p + Vector3(0.0, CITY_LAMP_POLE_H + CITY_LAMP_HEAD.y * 0.5, 0.0),
					CITY_LAMP_HEAD, 0.0))
			t += CITY_LAMP_PITCH
	if not poles.is_empty():
		_add_multimesh("CityLampPoles", poles,
			_city_material(Color(0.055, 0.055, 0.058)))
	if heads.is_empty():
		return null
	# ---- ⚠️ 灯头的材质：**这就是"灯亮不亮"的唯一落点** ----
	if mode == MapDef.CityLights.POSTS_ONLY:
		# **与杆同材质、零 emission** ⇒ 一排排 150 m 短杆把路网读出来，
		# 但**一点光都没有**（用户："路灯灯柱得建，但是灯不亮"）。
		var mm_post := _add_multimesh("CityStreetLights", heads,
			_city_material(Color(0.055, 0.055, 0.058)))
		print("[city] %s 路灯（POSTS_ONLY）：%d 根杆 + %d 个灯头（**光全关**）"
			% [map.name_cn, poles.size(), heads.size()])
		return mm_post
	var mm := _add_multimesh("CityStreetLights", heads,
		_city_material(CITY_LAMP_ALBEDO, CITY_LAMP_EMISSION, CITY_LAMP_ENERGY))
	print("[city] %s 路灯（FULL）：%d 根杆 + %d 个灯头" % [
		map.name_cn, poles.size(), heads.size()])
	return mm


## 街道与广场：**路面 + 路灯**。
##
## ## 为什么路面不用 `_add_box()`（带碰撞）
## 路面是一块 1.2 m 高、几十 km 长的平板，全铺一遍就是几千个静态体，
## 而**地面碰撞已经存在**（`GroundCollision`）—— 路只需要被看见。
## 所以路面走 MultiMesh：一次绘制、零碰撞。
## 路网点的"可铺"判据：**干燥 ∧ 过城市边界门**。
##
## ⚠️ 门按图给（`CITY_SHAPE[·].road_gate`），两档的**形状**不同，不是参数不同：
## - `RADIAL`：`x² + z² < CITY_ROAD_R²` —— 圆 / 椭圆城（奥恩贝利）；
## - `ISLAND`：点的 **±1 格**邻域里**有一格是岛** —— 超椭圆城（达沃）。
##   ⚠️ 容差 ±1 格是**实测定的**（`_r8_davao` §9b）：救回 217 段、仍丢 222。
##   ⚠️⚠️ 这段判据**必须写在 `_build_city_street_infra()` 这一侧**，
##   不许折进 `city_is_land()` —— `suite_round20.gd:614-621` 钉着
##   "`city_is_land()` 不得引用 `map`"（那条断言用的是**源码字符串**）。
func _city_road_ok(x: float, z: float) -> bool:
	if is_water_at(x,z,map.city_layout) or not city_is_dry(x, z, map.city_layout):
		return false
	if String(CITY_SHAPE[map.city_layout].road_gate) == "ISLAND":
		var gx := floorf(x / CITY_CBLOCK)
		var gz := floorf(z / CITY_CBLOCK)
		for dx: int in [-1, 0, 1]:
			for dz: int in [-1, 0, 1]:
				if city_is_land(gx + float(dx), gz + float(dz), map.city_layout):
					return true
		return false
	return x * x + z * z < CITY_ROAD_R * CITY_ROAD_R


## 把一条格线上的干燥区间 `[t0, t1]`（可能 4 km 长）切成**若干 ≤ `CITY_ROAD_PIECE`
## 的小段**，逐段出**沥青 + 两侧路肩 + 中线/车道虚线**。
##
## ⚠️ 切细的理由见 `CITY_ROAD_PIECE`（不切的话路面会在中间**被地形吃掉**）。
## ⚠️ `_city_dry_spans` **不在这里记**（那条记录仍按"一格一条"，见调用点）。
func _emit_road_pieces(roads: Array[Transform3D], kerbs: Array[Transform3D],
		marks: Array[Transform3D], axis: int, line: float,
		t0: float, t1: float, w: float) -> Array[Vector2]:
	var emitted: Array[Vector2] = []
	var span := t1 - t0
	if span <= 0.0:
		return emitted
	var n := maxi(1, int(ceil(span / CITY_ROAD_PIECE)))
	var st := span / float(n)
	for i in n:
		var a := t0 + st * float(i)
		if _append_road_span(roads,kerbs,marks,axis,line,a,a+st,w):
			if not emitted.is_empty() and is_equal_approx(emitted[-1].y,a): emitted[-1].y=a+st
			else: emitted.append(Vector2(a,a+st))
	return emitted


## 沿一条格线铺**一段**路面（`t0 → t1` 是沿线的米坐标，`line` 是另一维）+ 路肩 + 标线。
##
## ## 横断面（B7）
## ```
##        ← 路肩 SHOULDER_W → ←—————— 沥青 w ——————→ ← 路肩 →
##   顶面：      +12 m              0（地形 + LIFT）       +12 m
##   反照率：    0.74                 0.055                 0.74
##   标线：      ——      中线 0.95（44 m）／车道虚线 ±w/4  ——
## ```
##
## ⚠️ 俯仰角**取负**：`Basis.from_euler` 是 YXZ，局部 +Z 的 y 分量是 `−sin(pitch)`，
## 所以"远端更高"要表达成**负**的俯仰角（与改前逐字一致，别"顺手改成好看的样子"）。
## ⚠️ 路肩与标线**必须跟着同一个 yaw/pitch** —— 否则会在坡道上**插进路面**或**浮起来**。
func _append_road_span(roads: Array[Transform3D], kerbs: Array[Transform3D],
		marks: Array[Transform3D], axis: int, line: float,
		t0: float, t1: float, w: float) -> bool:
	var len_m := t1 - t0
	if len_m <= 0.0:
		return false
	var x0 := line if axis == 0 else t0
	var z0 := t0 if axis == 0 else line
	var x1 := line if axis == 0 else t1
	var z1 := t1 if axis == 0 else line
	var center := Vector2((x0+x1)*0.5,(z0+z1)*0.5)
	var full_width := w+2.0*maxf(90.0,w*0.38)
	if not _city_surface_rect_clear(center,Vector2(full_width,len_m+6.0),0.0 if axis==0 else 90.0,12.0): return false
	var h0 := _city_landform(x0, z0, map.city_layout)
	var h1 := _city_landform(x1, z1, map.city_layout)
	var yaw := 0.0 if axis == 0 else 90.0
	var pitch := -rad_to_deg(atan2(h1 - h0, len_m))
	var seg_len := sqrt(len_m * len_m + (h1 - h0) * (h1 - h0)) + 6.0
	var mid := Vector3((x0 + x1) * 0.5,
		(h0 + h1) * 0.5 + CITY_ROAD_LIFT, (z0 + z1) * 0.5)
	roads.append(_sized_pitch(mid, Vector3(w, CITY_ROAD_T, seg_len), yaw, pitch))
	# 路面**顶面**标高（沥青板中心在 `mid.y`、厚 `CITY_ROAD_T`）。
	var top_y := (h0 + h1) * 0.5 + CITY_ROAD_LIFT + CITY_ROAD_T * 0.5
	# 横向单位向量：`_sized_pitch()` 的局部 +X 经 yaw 之后是 `(cos yaw, 0, −sin yaw)`
	#（与 `_append_via_seg()` 护栏那两个偏移量**同一个式子**）。
	var lat := Vector3(cos(deg_to_rad(yaw)), 0.0, -sin(deg_to_rad(yaw)))
	# ---- 两侧路肩 / 人行道 ----
	var sw := maxf(90.0, w * 0.38)
	var s_off := w * 0.5 + sw * 0.5
	# ⚠️ 断面必须**顶面 = 沥青顶 + `SHOULDER_H`、底面 = 沥青顶 − `CITY_ROAD_T`**。
	# `mid.y` 是沥青板的**中心**（= 顶面 − `CITY_ROAD_T/2`），所以：
	#   · 高度 = `SHOULDER_H + CITY_ROAD_T`
	#   · 中心相对 `mid.y` 偏 `SHOULDER_H/2`
	# 推一遍：顶 = `mid.y + H/2 + (H+T)/2 = mid.y + H + T/2 = top_y + H` ✓
	#        底 = `mid.y + H/2 − (H+T)/2 = mid.y − T/2 = top_y − T` ✓（埋进路基里）
	# ⚠️ 写成"高度取 `CITY_ROAD_T`、偏移取 `SHOULDER_H`"的话底面会落在
	#    `top_y + 4` —— 路肩**悬在沥青上方 4 m**，低空掠过时是一条缝。
	var s_h := CITY_ROAD_SHOULDER_H + CITY_ROAD_T
	var s_dy := CITY_ROAD_SHOULDER_H * 0.5
	for s: float in [-1.0, 1.0]:
		kerbs.append(_sized_pitch(mid + lat * (s * s_off) + Vector3(0.0, s_dy, 0.0),
			Vector3(sw, s_h, seg_len), yaw, pitch))
	# ---- 中线（实线）+ 车道虚线 ----
	_append_road_mark(marks, axis, line, t0, t1, 0.0, CITY_ROAD_MARK_W)
	if w >= CITY_ROAD_W_ARTERIAL - 1.0:
		# 每侧一条车道线（即 ±w/4），**虚线**（节距 1 400 m）—— 读得出"几条车道"。
		for s: float in [-1.0, 1.0]:
			_append_road_dashes(marks, axis, line, t0, t1,
				s * w * 0.25, CITY_ROAD_DASH_W)
	return true


## 在路面上放一条**连续标线**（`lat_off` 是横向偏置，`mw` 是线宽）。
##
## ⚠️ 标高必须**重新在两端采样地形**（不能沿用整段的 `mid`）：虚线是**子区间**，
## 用整段的标高会让它在坡道上**一头翘出路面、另一头埋进去**。

func _append_road_mark(marks: Array[Transform3D], axis: int, line: float,
		t0: float, t1: float, lat_off: float, mw: float) -> void:
	var len_m := t1 - t0
	if len_m <= 1.0:
		return
	var x0 := line if axis == 0 else t0
	var z0 := t0 if axis == 0 else line
	var x1 := line if axis == 0 else t1
	var z1 := t1 if axis == 0 else line
	var h0 := _city_landform(x0, z0, map.city_layout)
	var h1 := _city_landform(x1, z1, map.city_layout)
	var yaw := 0.0 if axis == 0 else 90.0
	var lat := Vector3(cos(deg_to_rad(yaw)), 0.0, -sin(deg_to_rad(yaw)))
	var pitch := -rad_to_deg(atan2(h1 - h0, len_m))
	var seg_len := sqrt(len_m * len_m + (h1 - h0) * (h1 - h0)) + 4.0
	var top_y := (h0 + h1) * 0.5 + CITY_ROAD_LIFT + CITY_ROAD_T * 0.5
	# 顶面比沥青顶高 `MARK_LIFT`，底面埋进沥青 `MARK_T − MARK_LIFT`（防共面闪）。
	var mid := Vector3((x0 + x1) * 0.5,
		top_y + CITY_ROAD_MARK_LIFT - CITY_ROAD_MARK_T * 0.5, (z0 + z1) * 0.5)
	marks.append(_sized_pitch(mid + lat * lat_off,
		Vector3(mw, CITY_ROAD_MARK_T, seg_len), yaw, pitch))


## 车道**虚线**：沿 `[t0, t1]` 找节距 `CITY_ROAD_DASH_PITCH` 的整数倍位置，
## 每个位置铺一条长 `CITY_ROAD_DASH_LEN` 的线（**只取与区间相交的部分**）。
##
## ⚠️ 相位必须**按绝对里程**算（`k · PITCH`），不能从每段的 `t0` 起算 ——
## 后者会让节距随着"每一段被切在哪"而漂移，几段之后就成了一条**密疏不均**的线。
func _append_road_dashes(marks: Array[Transform3D], axis: int, line: float,
		t0: float, t1: float, lat_off: float, mw: float) -> void:
	var p := maxf(CITY_ROAD_DASH_PITCH, 1.0)
	var d := minf(maxf(CITY_ROAD_DASH_LEN, 1.0), p * 0.8)
	var k := int(ceil(t0 / p))
	while true:
		var a := float(k) * p
		if a >= t1:
			break
		var b := a + d
		a = maxf(a, t0)
		b = minf(b, t1)
		if b - a >= d * 0.5:
			_append_road_mark(marks, axis, line, a, b, lat_off, mw)
		k += 1


## **运河上的地面桥**（C2）：把"被运河切断"的那一段接上（"断"要变成"桥"）。
##
## ## 与高架的分工（§D5 的上下两层）
## | 层 | 标高 | 墩在哪 |
## |---|---|---|
## | 下（本函数） | **两岸地形里高的那个 + 抬 1.6** ⇒ ≈ 1.6 m（水面 −12 ⇒ **净空 ≈ 13.6 m**） | **两岸岸上** |
## | 上（`_build_city_viaducts`） | 剖面（≥ 240 m） | **水中央** |
## ⇒ 两套墩**不可能碰**（一个在岸、一个在水）。
##
## ⚠️ **不要**把高架那套"恒定标高"套到地面桥上（v1 写过 260 m）——
## 那是把"机体能从**高架**底下钻过线"错套到**地面**桥上，机器会从桥与路面之间穿模。
func _append_canal_bridge(roads: Array[Transform3D], piers: Array[Vector3],
		axis: int, line: float, shore0: float, shore1: float, w: float) -> void:
	# 桥面标高 = **两岸地形里高的那个** + 抬 1.6（跨中不下凹，免得中间比两岸低）
	var hs0 := _city_landform(line if axis == 0 else shore0,
		shore0 if axis == 0 else line, map.city_layout)
	var hs1 := _city_landform(line if axis == 0 else shore1,
		shore1 if axis == 0 else line, map.city_layout)
	var dy := maxf(hs0, hs1) + CITY_ROAD_LIFT
	var mid_t := (shore0 + shore1) * 0.5
	var mid := Vector3(line, dy, mid_t) if axis == 0 else Vector3(mid_t, dy, line)
	var yaw := 0.0 if axis == 0 else 90.0
	roads.append(_sized(mid,
		Vector3(w, CITY_ROAD_T, shore1 - shore0 + 40.0), yaw))
	# 两墩在**两岸岸上**
	for t: float in [shore0, shore1]:
		var px := line if axis == 0 else t
		var pz := t if axis == 0 else line
		piers.append(Vector3(px, dy, pz))


## 格线 `gi` 在**格 `gk` 那一截**，是不是某个大格组的**内部线**（该被吃掉）？
##
## ## 判据（三条缺一不可）
## 1. `span ≥ 2`（奥恩贝利 = 1 ⇒ 恒 false，**一个字节都不变**）；
## 2. 这条线是**支路**（`CITY_ROAD_W_LOCAL`）—— 干道是城市骨架，不走这条；
## 3. 存在 `k ∈ [1, span)` 使得 `gi − k` 是**组首格**、那一组是**大格**、
##    且组内每格都可建（`_city_group_buildable()`，与建块那边**同一个判据**）。
##
## ## ⚠️⚠️ 第 3 条为什么要复用 `_city_group_buildable()`
## 建块那边"组内任一格不可建 ⇒ 这一组不合并"。如果这里不复用同一份判据，
## 就会出现"楼没合并、但路被吃掉了"—— 表现为**海岸边某条街凭空断了一截**，
## 而建块日志一切正常。一条判据、两个消费者，是唯一安全的写法。
##
## 2026-10-08: both axes now use the same ownership map as city_block_plan.
## Only local roads inside a shared block are removed; arterial roads survive.
func _city_road_inner_suppressed(axis: int, gi: int, gk: int) -> bool:
	if city_road_width(gi)!=CITY_ROAD_W_LOCAL: return false
	var a := Vector2i(gi-1,gk) if axis==0 else Vector2i(gk,gi-1)
	var b := a+(Vector2i(1,0) if axis==0 else Vector2i(0,1))
	var owners := _city_macro_blocks()
	return owners.has(a) and owners.has(b) and owners[a]==owners[b]


func _build_city_street_infra(staged := false) -> void:
	var slice_started := Time.get_ticks_usec()
	var half := CITY_GRID / 2
	var cblock := CITY_CBLOCK
	var shape: Dictionary = CITY_SHAPE[map.city_layout]
	var lay := map.city_layout
	var roads: Array[Transform3D] = []
	# B7 的两个**构造层**（见 `CITY_ROAD_SHOULDER_ALBEDO` 那张表）：
	# `kerbs` = 两侧路肩/人行道（亮），`marks` = 中线 + 车道虚线（近白）。
	var kerbs: Array[Transform3D] = []
	var marks: Array[Transform3D] = []
	var bpiers: Array[Vector3] = []
	var corners := 0
	var canal_bridges := 0
	var bridge_decks: Array[Transform3D] = []
	# B8：被大格吃掉多少截内部支路（**逐"格截"计**，不是逐 503 m 段）。
	var inner_eaten := 0
	_city_dry_spans.clear()
	# ## ⚠️⚠️ 2026-09-28 v3：本函数换了三件事（治用户"**道路在地上断断续续**"）
	#
	# | # | 旧 | 新 | 治什么 |
	# |---|---|---|---|
	# | ① | 每段 4 025 m 是**原子**：两端 + 中点**任一点**擦到水/滩涂就 `continue` ⇒ **整段消失** | **9 点扫描 + 取连续干燥子区间**，每个子区间出一段（两端各向内收 `inset`） | 岸线是**正弦**、运河壁是**格边界**，都不与格线对齐 ⇒ 旧做法把沿水的街咬成"1 段有 / 1 段无"（实测**一段不缺的格线只有 5/74**） |
	# | ② | **没有半径门**，而 `city_is_dry()` 在山上**恒真** | `CITY_ROAD_R = 77 975`（= `CITY_HILL_IN − 一格`）；达沃改用**岛门** | 实测 **256 / 1768 = 14.5%** 的路面段铺在 82 km 外，最远 **101 047 m** |
	# | ③ | 运河上**没有路**（整段被丢） | **C2：运河上架桥**（桥面 ≈ 1.6 m，净空 ≈ 13.6 m） | "断"应该变成"**桥**"，不是"消失" |
	#
	# ⚠️ **`city_road_width()` 的调用必须留在本函数里** —— `suite_round20.gd:840`
	# 用**源码字符串**钉着它（挪走会红，而且是"找不到子串"这种看不懂的红）。
	for axis in 2:
		for gi in range(-half, half + 1):
			if staged and Time.get_ticks_usec()-slice_started>8000:
				build_stage.emit(0.48+0.08*(float(axis)+float(gi+half)/(CITY_GRID+1))/2.0,"铺设道路……")
				await get_tree().process_frame
				slice_started=Time.get_ticks_usec()
			var line := float(gi) * cblock
			var w := city_road_width(gi)
			var inset := w * 0.5
			var arterial := gi % 5 == 0
			var n := CITY_ROAD_SAMPLES
			var step_m := cblock / float(n - 1)
			# ---- ① C1：**整条线一次**扫描（2026-09-28 v3 · B6）----
			#
			# ## 为什么必须跨格（上一版是逐格，量出来的代价）
			# 逐格写法里"一片干区"被**格边界切成几片**，而 `CITY_ROAD_MIN_SPAN`
			# 是**逐片**判的 ⇒ 片长 < 1 006 m 的那些片被整片丢掉，**哪怕整条干区
			# 有好几公里**。定点诊断（`tools/_b6_road_cell_probe.tscn`）实录：
			# ```
			# gk = -18（t -72450…-68425）  000000011   ← 末 2 点干 = 503 m ⇒ 被丢
			# gk = -17（t -68425…-64400）  100011110   ← 中 4 点干 = 1 509 m ⇒ 出段（对）
			# gk = +16（t  64400… 68425）  100000111   ← 末 3 点干 = 1 006 m ⇒ 出段（对）
			# gk = +17（t  68425… 72450）  110000000   ← 首 2 点干 = 503 m ⇒ 被丢
			# ```
			# ⇒ 实测（`_r6_road_probe` §2b「按 run 对账」）：**台场 11 条 run 真短缺
			#   / 5 534 m**（每条正好差 1 个采样点），达沃 0 条。
			#
			# ## 新写法（三件事，一件都不能少）
			# 1. **全线细采样一次**：点 `i` 的米坐标 = `-half·cblock + i·step_m`。
			#    ⚠️ `cblock / step_m = CITY_ROAD_SAMPLES − 1 = 8` **整好整除**
			#    ⇒ 格边界本身就是采样点 ⇒ 跨格不会漏判、也不会重复判。
			# 2. 取**极大连续干燥 run**，`CITY_ROAD_MIN_SPAN` **按 run 判**（跨格）。
			# 3. 出路面时**仍然逐格切**（一格一段）—— 这一条**不能省**：
			#    `_append_road_span()` 是用**两端点**的地形高度定俯仰的，一格一段
			#    才能让路面贴着地形起伏；整条 run 出一个长盒，路面就会变成
			#    "两端之间的一根直线"，中间脱离地形。
			# ⇒ `inset` 只在 run 的**真端**收（水边），格接口上**不收**
			#   （旧版那个 `cont_lo / cont_hi` 补丁就是为这件事打的，现在不需要了）。
			var tot := (half * 2) * (n - 1) + 1
			var t_lo := -float(half) * cblock
			var dry := PackedByteArray()
			dry.resize(tot)
			for i in tot:
				var t := t_lo + step_m * float(i)
				dry[i] = 1 if _city_road_ok(
					line if axis == 0 else t, t if axis == 0 else line) else 0
			var i0 := 0
			while i0 < tot:
				if dry[i0] == 0:
					i0 += 1
					continue
				var i1 := i0
				while i1 + 1 < tot and dry[i1 + 1] == 1:
					i1 += 1
				var rt0 := t_lo + step_m * float(i0)
				var rt1 := t_lo + step_m * float(i1)
				if rt1 - rt0 >= CITY_ROAD_MIN_SPAN:
					var ga := int(floorf(rt0 / cblock))
					var gb := int(floorf((rt1 - 0.001) / cblock))
					for g in range(ga, gb + 1):
						var a := maxf(rt0, float(g) * cblock)
						var b := minf(rt1, float(g + 1) * cblock)
						if b - a <= 0.0:
							continue
						# ---- ⚠️⚠️ B8：大格组**内部**那条格线在这一截被吃掉 ----
						#
						# 只吃支路（干道照留）—— 判据与建块那边**共用**一份，
						# 见 `_city_road_inner_suppressed()`。
						# ⚠️ `_city_dry_spans` 必须**跟着一起跳**：它有三个消费者
						#（路灯 / `_r10` / 探针）。留下"路没了、span 还在"的记录，
						# 路灯就会**飘在空地上**（看图只会觉得"这片地的灯怪怪的"）。
						if _city_road_inner_suppressed(axis, gi, g):
							inner_eaten += 1
							continue
						# ⚠️ `inset` 收在 run 的**真端**（水边），格接口上**不收**。
						#   （写反过一次：反过来之后格接口处又出现一条 `w` 宽的缝，
						#    长 run 每格少盖 1 个采样点 ⇒ 台场"短缺 run"从 11 条飙到 114 条。）
						var j0 := a + (inset if a <= rt0 + 0.001 else 0.0)
						var j1 := b - (inset if b >= rt1 - 0.001 else 0.0)
						# 收口之后若退得只剩一条缝，就居中留一小段（别反向）
						for emitted: Vector2 in _emit_road_pieces(roads,kerbs,marks,axis,line,j0,j1,w):
							_city_dry_spans.append({"axis":axis,"gi":gi,"line":line,"w":w,"t0":emitted.x,"t1":emitted.y})
				i0 = i1 + 1
			# ---- ③ C2：运河上的桥（只给 `gi % 5 == 0` 的干道；**仍是逐格**）----
			if not arterial:
				continue
			for gk in range(-half, half):
				var t_a := float(gk) * cblock
				var crun := -1
				var ck := 0
				while ck <= n:
					var wet := false
					if ck < n:
						var ct := t_a + step_m * float(ck)
						var cpx := line if axis == 0 else ct
						var cpz := ct if axis == 0 else line
						wet = city_is_canal(cpx, cpz, lay) \
							and not city_is_dry(cpx, cpz, lay)
					if wet:
						if crun < 0:
							crun = ck
						ck += 1
						continue
					if crun >= 0:
						var b0 := t_a + step_m * float(crun)
						var b1 := t_a + step_m * float(ck - 1)
						crun = -1
						# 桥面宽取"该档路宽的 0.6"，但至少 260（桥比路窄是常态）
						if b1 - b0 >= 240.0:
							_append_canal_bridge(bridge_decks, bpiers, axis, line,
								b0 - step_m, b1 + step_m, maxf(w * 0.6, 260.0))
							canal_bridges += 1
					ck += 1
	# ---- C3：路口补角 ----
	# 两条格线相交处，横向那条若被水切掉，纵向那条仍从中间穿过 ⇒ 十字路口缺一角。
	# 对每个"两条都是干道"的格点（`gi % 5 == 0 ∧ gj % 5 == 0`）铺一块方形铺装。
	for gi in range(-half, half + 1):
		if gi % 5 != 0:
			continue
		for gj in range(-half, half + 1):
			if gj % 5 != 0:
				continue
			var cx := float(gi) * cblock
			var cz := float(gj) * cblock
			if not _city_road_ok(cx, cz) or not _city_surface_rect_clear(Vector2(cx,cz),Vector2.ONE*maxf(city_road_width(gi),city_road_width(gj)),0.0,12.0):
				continue
			var side := maxf(city_road_width(gi), city_road_width(gj))
			roads.append(_sized(
				Vector3(cx, _city_landform(cx, cz, lay) + CITY_ROAD_LIFT, cz),
				Vector3(side, CITY_ROAD_T, side), 0.0))
			corners += 1
	if not bridge_decks.is_empty():
		_add_multimesh("CityCanalBridges",bridge_decks,_city_material(Color(0.055,0.053,0.052)))
	if not roads.is_empty():
		_add_multimesh("CityRoads", roads,
			_city_material(Color(0.055, 0.053, 0.052)))
	# ---- B7：路肩（亮）×2 面 + 标线 ----
	# ⚠️ 三层的**顺序无关**（都是不透明的 MultiMesh，深度测试自己会排），
	# 但**名字必须唯一**：`CityRoadKerbs` / `CityRoadMarks` 各只有一份。
	if not kerbs.is_empty():
		_add_multimesh("CityRoadKerbs", kerbs,
			_city_material(CITY_ROAD_SHOULDER_ALBEDO))
	if not marks.is_empty():
		# 死城的标线**不自发光**（`POSTS_ONLY`）—— 见 `CITY_ROAD_MARK_EMISSIVE`。
		var m_em := Color(0, 0, 0, 0)
		if map.city_lights == MapDef.CityLights.FULL:
			m_em = Color(CITY_ROAD_MARK_ALBEDO.r * CITY_ROAD_MARK_EMISSIVE,
				CITY_ROAD_MARK_ALBEDO.g * CITY_ROAD_MARK_EMISSIVE,
				CITY_ROAD_MARK_ALBEDO.b * CITY_ROAD_MARK_EMISSIVE, 1.0)
		_add_multimesh("CityRoadMarks", marks,
			_city_material(CITY_ROAD_MARK_ALBEDO, m_em, 1.2))
	# ---- 运河桥的墩：**带碰撞**（与高架墩同一套分工：桥面不进、墩进）----
	var cbp_i := 0
	for p: Vector3 in bpiers:
		var g := _city_landform(p.x, p.z, lay)
		# ⚠️ 底面取 `minf`：陆上落到地形下 40 m（视觉上"扎进地里"），
		# 水上落到水面下 120 m（"插进水里"而不是"浮在水面上"）。与高架墩同一口径。
		var bot := minf(g - 40.0, CITY_WATER_Y - 120.0)
		var hh := maxf(p.y - bot, 20.0)
		# ⚠️ 名字**必须带序号**：`_add_box("CanalBridgePier", …)` 在同一个父节点下被调
		# N 次 ⇒ Godot 4.7 把后来者改名成 `@StaticBody3D@1346`（**丢掉原名**），
		# 于是 `find_children("CanalBridgePier*")` **只回 1 个**，而读数看着完全合理。
		# 这个坑在本工程已经撞过一次（见 `tools/_r6_road_probe.gd` 的整段注释）。
		_add_box("CanalBridgePier%d" % cbp_i, Vector3(p.x, bot + hh * 0.5, p.z),
			Vector3(CITY_VIA_PIER_W, hh, CITY_VIA_PIER_W),
			Color(0.086, 0.088, 0.098), 0.0)
		cbp_i += 1
		_city_body_count += 1
	print("[city] %s 路网：%d 段沥青（每段 ≤ %.0f m）/ **%d 段路肩 / %d 段标线**；"
		% [map.name_cn, roads.size(), CITY_ROAD_PIECE, kerbs.size(), marks.size()]
		+ "含 %d 段运河桥面 / %d 个路口补角；干燥区间 %d 条；"
		% [canal_bridges, corners, _city_dry_spans.size()]
		+ "一格 = %.0f m，三档宽 %.0f/%.0f/%.0f m，门 = %s" % [
