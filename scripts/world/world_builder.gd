	_terrain_root.name = "Terrain"
	add_child(_terrain_root)
	var wake := SEA_FLIGHT_WAKE.new()
	wake.world = self
	add_child(wake)
	if not defer_initial_map:
		apply_map(MapDef.by_id(initial_map))


## 单轨列车每帧绕圈。只有城市图会有 `_city_train`（其余图恒为 null）。
##
## ⚠️ 这里**不查游戏是否暂停**：列车是纯视觉的"远处有东西在动"，
## 暂停时它跟着停不停都不影响判读；而且 `WorldBuilder` 挂在 main 下面，
## 暂停时本来就会被一起停掉（`process_mode` 继承）。
var _environment_quality_config:Array=[]
var _cloud_quality_config := -1
var _cloud_lut_a:Texture3D
var _cloud_lut_b:Texture3D

static func supports_local_fog() -> bool:
	return RenderingServer.get_current_rendering_method()=="forward_plus"

func _sync_cloud_quality(mat:ShaderMaterial) -> void:
	var low:=Settings.low_spec_mode()
	var desired_shader:Shader=load("res://shaders/cloud_low.gdshader" if low else CLOUD_SHADER)
	if mat.shader!=desired_shader:
		var parameters:Dictionary={}
		for key in ["tint","shade_color","softness","sun_dir","light_color","sun_shade","surface_detail","air_color","air_density"]:
			var value=mat.get_shader_parameter(key)
			if value!=null:parameters[key]=value
		mat.shader=desired_shader
		for key in parameters:mat.set_shader_parameter(key,parameters[key])
	mat.set_shader_parameter("cloud_quality",0 if low else 2)
	if not low and _cloud_lut_a==null:
		_cloud_lut_a=load("res://assets/textures/cloud_noise_lut_0.res")
		_cloud_lut_b=load("res://assets/textures/cloud_noise_lut_1.res")
	mat.set_shader_parameter("noise_lut_a",null if low else _cloud_lut_a)
	mat.set_shader_parameter("noise_lut_b",null if low else _cloud_lut_b)
	mat.set_shader_parameter("use_noise_lut",not low)

func _process(delta: float) -> void:
	var cloud_quality:=0 if Settings.low_spec_mode() else 2
	if cloud_quality!=_cloud_quality_config:
		_cloud_quality_config=cloud_quality
		for mat:ShaderMaterial in _cloud_mats:_sync_cloud_quality(mat)
		if cloud_quality==0:
			_cloud_lut_a=null
			_cloud_lut_b=null
	if is_instance_valid(_local_cloud_volume) and time_of_day != null:
		_local_cloud_volume.tint = time_of_day.cloud_tints[1]
	if _road_quality!=Settings.effects_quality:
		_road_quality=Settings.effects_quality
		for material:ShaderMaterial in _road_materials:material.set_shader_parameter("road_quality",clampi(_road_quality,0,2))
	_advance_city_train(delta)
	# 海面 / 星空的动画时钟（批 J）。**必须在这里推进**：以前它们用的是引擎内建的
	# `TIME`，而无头/探针的 A/B 因此不可复算（见 `_advance_anim_time()`）。
	# 暂停时 `_process` 本来就不被调用 ⇒ 时钟自然停住，与画面一致。
	_advance_anim_time(delta)
	# SSAO 设置跟随（批 10）：一个布尔赋值，直接读权威值 —— 不拉信号线、
	# 不需要在换图/重开时重连（与 main._apply_camera_settings 同一个取舍）。
	# Environment/light setters can invalidate renderer state. Only push on change.
	var quality_config:Array=[Settings.ssao,Settings.effects_quality,Settings.shadow_quality,_env,sun]
	if quality_config!=_environment_quality_config:
		_environment_quality_config=quality_config
		if _env != null:
			_env.ssao_enabled = Settings.ssao and Settings.effects_quality>0
			_env.volumetric_fog_enabled = Settings.effects_quality==2 and supports_local_fog()
			_env.glow_enabled = Settings.effects_quality>0
		if is_instance_valid(sun):
			sun.shadow_enabled = Settings.shadow_quality>0
			sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS if Settings.shadow_quality==1 else DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS
			sun.directional_shadow_max_distance = 1200.0 if Settings.shadow_quality==1 else 3200.0


# ------------------------------------------------------------ 地图

## 建图阶段进度信号（读条系统，批 10）。
## `apply_map_staged()` 在每个阶段之间发出；`frac` 是 0..1 的总进度、
## `label` 是给读条界面显示的阶段名。
signal build_stage(frac: float, label: String)


## 换地图：重搭地表 + 换夜色。
##
## 菜单里可以来回切地图，所以这必须是**幂等**的 —— 先把上一层地表整个 free 掉再建，
## 否则切两次图就会有两层地面叠在一起（z-fighting，看着像贴图坏了）。
##
## ⚠️ 同步版：一口气建完，中途一帧不打。**开新局请走 `apply_map_staged()`**
##（读条系统）—— 同步版是给测试与"菜单背景换图"这种小开销路径用的。
func apply_map(m: MapDef) -> void:
	if m == null:
		return
	_map_stage_free(m)
	_map_stage_terrain(m)
	_map_stage_clouds(m)
	_map_stage_tod(m)


## **分阶段**换地图（读条系统，批 10）。协程：每个阶段之间 `await` 一帧并广播进度，
## 让读条界面有帧可画 —— 否则整个建图还是冻在一帧里，读条就是一张死图。
##
## ⚠️ 与 `apply_map()` **共用同一套阶段函数**（下面的 `_map_stage_*`）：
## 两版行为必须一字不差，差别只在"阶段之间让不让出主线程"。
## `suite_loading` 会断言两版建出来的世界结构一致。
func apply_map_staged(m: MapDef) -> void:
	if m == null:
		return
	build_stage.emit(0.05, "清理旧战场……")
	_map_stage_free(m)
	await get_tree().process_frame
	# Let the renderer consume detach/free commands before allocating the next map.
	# Headless has no frame_post_draw signal to wait for.
	if DisplayServer.get_name() != "headless":
		await RenderingServer.frame_post_draw
	build_stage.emit(0.2, "重塑地表……")
	if m.terrain == MapDef.Terrain.ADELAIDE:
		_build_ocean()
		var city := preload("res://scripts/world/adelaide_builder.gd").new()
		_terrain_root.add_child(city)
		await city.build_staged()
	elif m.terrain == MapDef.Terrain.CITY:
		_rng.seed = 20260917
		await _build_city_staged()
	else:
		_map_stage_terrain(m)
	await get_tree().process_frame
	build_stage.emit(0.65, "铺云层……")
	_map_stage_clouds(m)
	await get_tree().process_frame
	build_stage.emit(0.9, "调夜色……")
	_map_stage_tod(m)
	build_stage.emit(1.0, "地图就绪")


## 阶段①：登记当前地图 + 清掉上一张图的地表与引用（`apply_map` 的开头几步）。
func _map_stage_free(m: MapDef) -> void:
	map = m
	for c in _terrain_root.get_children():
		c.free()
	# ⚠️ 地表材质也要一起清：与 `_cloud_mats` 同一个道理 ——
	# 不清的话 `_refresh_cloud_uniforms()` 会往上一张图的材质上灌云影 uniform
	# （不报错，只是白做，而且数组越堆越长）。
	_terrain_mats.clear()
	_road_materials.clear()
	_road_quality=-1
	ocean = null
	# ⚠️ 街道灯的引用也要清：它挂在 `_terrain_root` 下、会被上面那个循环 free 掉，
	# 但**引用还在** —— 不清的话下一张图上 `_city_lights` 会指向一个已释放节点
	#（换图之后任何读它的代码都会炸，而换图本身不报错）。
	_city_lights = null
	# ⚠️ 发射点上空那垛云的组节点同理（见它的声明处）：它整个挂在 `_terrain_root` 下、
	# 上面那个循环会把它 `free()` 掉，而引用还在。不清的话换到别的图之后
	# `launch_cloud_root` 就指向一个已释放节点 —— 不报错，只是读出来是野的。
	launch_cloud_root = null
	# ⚠️ 出水特效同理（它是个单个节点、没包装，所以只有这一行）。
	# 不清的话换图之后 `main._tick_launch()` 还会朝一个已释放节点调 `update()` ——
	# 那会**真的报错刷屏**（不是静默），但报错发生在幕布后面，玩家看不见、
	# 而日志被冲掉之后就查不出别的了。
	launch_splash = null
	# ⚠️ 绿洲的三份数据也一起清（1.2.3 批 K · 轮 1③），理由与 `_terrain_mats` 逐字相同：
	# `_veg_mask_tex` 会被 `_terrain_material()` 灌进**新图**的材质里，
	# 不清的话艾尔斯岩的绿洲会跟着长到奥恩贝利的马路上（不报错，只是荒唐）。
	# ⚠️ 而且**必须在 `_map_stage_terrain()` 之前清**：沙漠图自己会在
	# `_build_desert()` 里重新烘一份，清晚一步就是"新烘的被旧的一起清掉"。
	_veg_mask_tex = null
	desert_tree_xf.clear()
	desert_oasis_sites.clear()
	desert_tree_scale = 1.0


## 阶段②：按 `m.terrain` 建地表（最重的一步 —— 城市几百个方块、岛屿网格都在这里）。
##
## ⚠️⚠️ **`_` 兜底分支是 `_build_islands()`。** 所以新增一个 `Terrain` 值却忘了加
## 分支，后果是**静默建成太平洋群岛**（不报错、不警告，只是"宇宙图里有一片海和几座岛"）。
## 这个坑工程里**已经踩过一次**（`suite_round20` 那条"CITY 不是落进 ISLANDS 的默认分支"
## 就是当时的见证）⇒ `suite_space_map` 里有一条同款断言钉着 `SPACE`。
func _map_stage_terrain(m: MapDef) -> void:
	_rng.seed = 20260917
	match m.terrain:
		MapDef.Terrain.DESERT:
			_build_desert()
		MapDef.Terrain.RANGE:
			_build_range()
		MapDef.Terrain.CITY:
			_build_city()
		MapDef.Terrain.ADELAIDE:
			_build_ocean()
			var city := preload("res://scripts/world/adelaide_builder.gd").new()
			_terrain_root.add_child(city)
			city.build()
		MapDef.Terrain.AXIS:
			var axis:=preload("res://scripts/world/axis_surface.gd").new()
			_terrain_root.add_child(axis)
			axis.build()
		MapDef.Terrain.COLONY_RUINS:
			var colony := preload("res://scripts/world/colony_ruins.gd").new()
			_terrain_root.add_child(colony)
			colony.build()
		MapDef.Terrain.SPACE:
			_build_space()
		_:
			_build_islands(ISLAND_COUNT)

	if m.time_of_day.preset == TimeOfDay.Preset.SPACE and m.terrain != MapDef.Terrain.COLONY_RUINS:
		var storm := preload("res://scripts/world/colony_lightning.gd").new()
		storm.space_mode = true
		_terrain_root.add_child(storm)


## 阶段③：按这张图的云量重建三带云层（含云影烘焙）。
func _map_stage_clouds(m: MapDef) -> void:
	_rebuild_clouds(m.cloud_density)
	# ---- ★ 发射点上空那垛云（剧情模式发射段）。**只属于太平洋图** ----
	#
	# ⚠️⚠️ 它**必须建在这里、不能建在 `_build_islands()` 里**（阶段②）：
	# 它复用 `_cloud_mat_mid`，而那个引用是**上一行 `_rebuild_clouds()` 才写进去**的。
	# 放在阶段②的话引用还是 null ⇒ 云垛走"材质拿不到"的退路自建一份
	# ⇒ **不跟时段换色**（夜图里别的云都对、就这一垛白得发光，很难归因）。
	# ⚠️ 而且不能靠 `apply_map()` 的三步"顺序侥幸"：`apply_map_staged()` 会把这三步
	# **拆到不同的帧上**（读条），跨帧的时序更不可依赖 —— 所以是**同一条函数里前后两行**。
	#
	# 判据用 `map.id` 而不是 `terrain`：`Terrain.ISLANDS` 是 `_map_stage_terrain()`
	# 的 **`_` 兜底分支**（见那里的红字），将来若有新图落到那条分支上，
	# 按 terrain 判会让它在自己的天上凭空多出一垛云。
	if m != null and m.id == MapDef.Id.PACIFIC:
		_build_launch_clouds()


## 阶段④：应用时段（天空/主光/环境/海面/云的五处联动）。
func _map_stage_tod(m: MapDef) -> void:
	_sky_mat.shader=load("res://shaders/axis_sky.gdshader" if m.id in [MapDef.Id.AXIS,MapDef.Id.COLONY_RUINS] else SKY_SHADER)
	apply_time_of_day(m.time_of_day)


## 按这张地图的云量重建三带云层。
##
## ⚠️ **必须重建，不能只在 `_ready()` 建一次**：云量是**按地图**给的
## （用户要求"艾尔斯岩地图也加入更多的云层"），换图就要换云量。
##
## ⚠️ 重建时必须**连 `_cloud_mats` 一起清**：那份数组是给 `apply_time_of_day()`
## 按创建顺序取 tint 用的（低空 → 主积云 → 高空）。不清就会越堆越长，
## 换图之后云的配色会串到上一张图的带序上 —— 而且**不会报错**，只是颜色不对。
func _rebuild_clouds(density: float) -> void:
	if is_instance_valid(_local_cloud_volume):
		_local_cloud_volume.free()
	_local_cloud_volume = null
	for c in _cloud_root.get_children():
		c.free()
	_cloud_mats.clear()
	# ⚠️ 具名引用跟着一起清（见 `_cloud_mat_mid` 的声明）：不清的话它是**上一张图**的
	# 那份材质 —— 而它只是"发射点上空那垛云"用的，图一换那一垛就没了，
	# 留着等于把一份已经没人用的材质挂在身上。
	_cloud_mat_mid = null
	# ---- ★ 云量为 0 ⇒ **这一层根本不建**（剧情模式轮 B2 · 低地球轨道）----
	#
	# ⚠️ 不能只把 0 传给 `_build_clouds()`：那个函数第一行是
	# `var d := maxf(density, 0.05)`（它的注释解释了为什么必须有那个下限 ——
	# 老调用点靠它活着，密度一给 0 就会建出"一层空云"）。于是按参数传 0 的**实际效果**
	# 是"每条带还剩两三团云" —— 在轨道上就是**几朵云凭空挂在真空里**，
	# 而它**不报错、不告警**，探针上也只表现为"有一点糊"。
	# ⇒ 0 走这条**显式的另一条路**：不建云，并且把云影覆盖图也清掉
	#（`_cloud_shade_tex` 是上一次 `_build_clouds()` 烘的，不清的话它会跟着换到新图上 ——
	#  与 `_cloud_mats` 那个"不清就会串到上一张图的带序上"是同一类坑）。
	if density <= 0.0:
		cloud_bands.clear()
		_cloud_field.clear()
		_cloud_shade_tex = null
		_refresh_cloud_uniforms()
		return
	# ⚠️ 云要**用自己一个随机种子**：`_rng` 在 apply_map 开头刚被重设过，
	# 之后又被地表用掉了一大段。直接接着用会让云的布局跟着地表变 ——
	# 那样"只调云量、不动地表"就做不到（换任何地表都会把云的布点全打乱）。
	_rng.seed = CLOUD_SEED
	# `_build_clouds()` 结尾会把这一层的云烘成云影覆盖图（第十四轮）
	_build_clouds(density)
	# 云影 uniform 必须在**烘完之后**灌：地表材质是 `apply_map()` 前面几步建的，
	# 那时候覆盖图还不存在。
	_refresh_cloud_uniforms()


## 一次性把这个时段需要的五处全部改到位。
func apply_time_of_day(tod: TimeOfDay) -> void:
	if tod == null:
		return
	time_of_day = tod
	if _sky_mat != null:
		_sky_mat.set_shader_parameter("zenith", tod.sky_zenith)
		_sky_mat.set_shader_parameter("horizon", tod.sky_horizon)
		_sky_mat.set_shader_parameter("ground", tod.sky_ground)
		_sky_mat.set_shader_parameter("horizon_power", tod.sky_horizon_power)
		# ---- 地平线以下的过渡宽度（剧情模式轮 B2 新提上来的一行）----
		#
		# ⚠️ 它原来**只活在 shader 里**（`sky.gdshader` 的 `uniform float ground_blend = 0.18`），
		# 十个 sky uniform 里没有它 —— 也就是**没有任何时段能调**。
		# 夜里 0.18 够用（`night()` 的 `sky_ground` 本来就接近黑），
		# 但轨道图要靠它把**地球临边**做成一条有厚度的亮带（见 `TimeOfDay.space()`）。
		# `TimeOfDay.ground_blend` 的默认值**就是 0.18** ⇒ 拿默认值灌回去与从前逐位相同。
		_sky_mat.set_shader_parameter("ground_blend", tod.ground_blend)
		_sky_mat.set_shader_parameter("star_amount", tod.star_amount)
		_sky_mat.set_shader_parameter("star_brightness", tod.star_brightness)
		_sky_mat.set_shader_parameter("atmosphere", 0.0 if tod.preset == TimeOfDay.Preset.SPACE else 1.0)
		_sky_mat.set_shader_parameter("star_coverage", tod.star_coverage)
		_sky_mat.set_shader_parameter("haze_strength", tod.sky_haze)
		_sky_mat.set_shader_parameter("scatter_strength", tod.sky_scatter_strength)
		_sky_mat.set_shader_parameter("scatter_power", tod.sky_scatter_power)
		_sky_mat.set_shader_parameter("scatter_color", tod.sun_color)
		_sky_mat.set_shader_parameter("disc_amount", tod.disc_amount)
		_sky_mat.set_shader_parameter("disc_color", tod.disc_color)
		_sky_mat.set_shader_parameter("disc_size", tod.disc_size)
		_sky_mat.set_shader_parameter("disc_halo", tod.disc_halo)

	if sun != null:
		sun.light_color = tod.sun_color
		sun.light_energy = tod.sun_energy
		sun.rotation_degrees = tod.sun_rotation_deg
		# DirectionalLight3D 沿自身 −Z 照射，所以"从场景指向天体"就是 +basis.z
		if _sky_mat != null:
			_sky_mat.set_shader_parameter("disc_dir", sun.global_transform.basis.z.normalized())

	if _env != null:
		# ---- 环境光三件套（批 K · 轮 1②）----
		#
		# ⚠️ **顺序无关，但三行必须都在**：`sky_contribution` 决定
		# `ambient_color × ambient_energy` 那一项的权重（1.0 ⇒ 权重 0 ⇒
		# 后两行完全失效）。旧版只写了 `ambient_light_energy` 一行，
		# 于是阴天黄昏的填充光**从来没有生效过** —— 详见 `TimeOfDay.ambient_energy`
		# 那段与 `dusk_overcast()` 里的剂量表。
		#
		# ⚠️ 不要把 `ambient_light_source` 也一起写：`SKY` + `sky_contribution`
		# 已经能表达"纯天空 / 纯颜色 / 两者混合"三种情形，
		# 而改写 `source` 会让 `_render_config()` 记录的实况值多一个自由度、
		# 也更容易和 `sky.gdshader` 的存在耦合。
		_env.ambient_light_sky_contribution = tod.ambient_sky_contribution
		_env.ambient_light_color = tod.ambient_color
		_env.ambient_light_energy = tod.ambient_energy
		_env.fog_light_color = tod.fog_color
		_env.fog_density = tod.fog_density
		_env.fog_sky_affect = tod.fog_sky_affect
		_env.tonemap_exposure = tod.exposure
		_env.glow_intensity = tod.glow_intensity
		_env.glow_bloom = tod.glow_bloom
		_env.glow_hdr_threshold = tod.glow_hdr_threshold
		_env.adjustment_contrast = tod.grade_contrast
		_env.adjustment_saturation = tod.grade_saturation
		_env.fog_sun_scatter = tod.fog_sun_scatter
		_env.fog_aerial_perspective = tod.fog_aerial_perspective
		_env.volumetric_fog_anisotropy = tod.volume_anisotropy

	if _ocean_mat != null:
		_ocean_mat.set_shader_parameter("deep_color", tod.ocean_deep)
		_ocean_mat.set_shader_parameter("crest_color", tod.ocean_crest)
		_ocean_mat.set_shader_parameter("sky_color", tod.ocean_sky)
		_ocean_mat.set_shader_parameter("horizon_color", tod.ocean_horizon)
		# ---- 海面亮度增益（轮 12）----
		#
		# 用户明确要求"**海面一起提亮**"（太平洋 / 达沃都是海港图，贴海低飞时
		# 画面主体就是海）。不带上海面的话，本轮改动在太平洋图上**整帧 100% 逐位不变** ——
		# 实测过：`--seacam=45` 的贴海机位里根本没有一块地形/楼体材质，画面里只剩海和天。
		#
		# ⚠️ 海面走**着色器里的一个乘法**（`ocean.gdshader` 的 `ALBEDO *= scene_gain`），
		# **不是**像地形/楼体那样在这里乘颜色。第一个理由是硬约束：
		# 海面有一批"代码里从不设、用 shader 默认值"的颜色（`crest_sss_color` /
		# `shoal_color` / `foam_color`），而 `ShaderMaterial.get_shader_parameter()`
		# 对**没设过**的参数返回 `null` —— 它**不会**回落到 shader 的默认值
		#（第一版就是按"会回落"写的，实测拿到 9 条 null、静默失效，画面纹丝不动）；
		# 改成在这边把默认值写死，又等于把真源抄成两份。
		# 第二个理由是覆盖面：一个输出乘法把**全部**水面颜色一起盖住，
		# 没有"漏了某一项"的清单要维护。
		#
		# ⚠️ 与"海天分界"的关系：天空**不在**增益范围内（`sky.gdshader` 不动），
		# 所以海面提亮之后"海的地平色 ÷ 天空地平色"这个比值**只会变大**
		#（第十四轮那条分界靠的就是这个比值）⇒ 分界不会被糊掉，反而更清楚。
		_ocean_mat.set_shader_parameter("scene_gain", scene_gain * sea_boost)
		# 月光镜面带（第十四轮 A1）：方位取自天体方向，强度按时段给
		_ocean_mat.set_shader_parameter("moon_dir", celestial_dir(tod.sun_rotation_deg))
		# ⚠️ `moon_color` **刻意不乘增益**：它是月光**镜面高光**的颜色（= 光源本身），
		# 乘上去等于顺手把月亮调亮了一档 —— 需求说的是"场景更亮"，不是"天体更亮"。
		#（`glitter_strength` 同理，它是强度不是反照率。）
		_ocean_mat.set_shader_parameter("moon_color", tod.ocean_moon_color)
		_ocean_mat.set_shader_parameter("glitter_strength", tod.ocean_glitter)
		_ocean_mat.set_shader_parameter("glitter_sharp", tod.ocean_glitter_sharp)

	# ---- 贴海薄雾（1.2.3 批 J）----
	# 放在这里（而不是建的时候就定死）：它是**按时段/地图**的，
	# 与"海面颜色"同一个道理 —— 换图必须重新灌一遍。
	_apply_sea_mist(tod)

	for i in _cloud_mats.size():
		if i >= tod.cloud_tints.size() or i >= tod.cloud_shades.size():
			break
		var mat := _cloud_mats[i]
		mat.set_shader_parameter("tint", tod.cloud_tints[i])
		var sh: Color = tod.cloud_shades[i]
		mat.set_shader_parameter("shade_color", Vector3(sh.r, sh.g, sh.b))

	# ---- 云的主光方向（1.2.3 批 E）----
	#
	# ⚠️ **单独一个循环、而且要放在上面那个循环之前**：上面那个循环里有 `break`
	#（tint 数组短了就直接跳出），把 `sun_dir` 写在它里面的话，"数组短"那一刻
	# 后面几带就拿不到方向 —— 画面上的表现是"有的云朝光、有的云不朝光"，
	# 而且只在某些时段出现，属于极难查的一类。
	#
	# 方向沿用 `celestial_dir()`：**与天空 shader 的 `disc_dir`、海面的 `moon_dir`
	# 是同一个量**，所以"天上那个亮盘在哪、云朝哪边亮、海面的月光带在哪"三件事
	# 必然一致 —— 三处各算一次是这类 bug 的常见来源。
	var cdir := celestial_dir(tod.sun_rotation_deg)
	for cmat in _cloud_mats:
		cmat.set_shader_parameter("sun_dir", cdir)
		cmat.set_shader_parameter("light_color",Vector3(tod.sun_color.r,tod.sun_color.g,tod.sun_color.b))
		cmat.set_shader_parameter("air_color",Vector3(tod.fog_color.r,tod.fog_color.g,tod.fog_color.b))
		cmat.set_shader_parameter("air_density",tod.fog_density*0.8)

	# ---- 动画时钟（批 J）----
	# 放在最后：`_ocean_mat` / `_sky_mat` 都在这个方法里刚被灌过值，
	# 但它们**不知道时钟**。而 shader 那边已经不是 `TIME` 了（见 `ocean.gdshader`
	# 的 `wave_time` 那段），所以这里不推一次，海面与星空会**停在 0 秒**。
	_push_anim_time()
	if is_instance_valid(_terrain_root):
		var fleet:=_terrain_root.get_node_or_null("PacificFleet")
		if fleet!=null:fleet.apply_time(tod)


# ------------------------------------------------------------ 动画时钟（批 J）

## 推进海面与星空的动画时钟，并推给材质。
##
## ⚠️ **为什么不用引擎内建的 `TIME`（这是本轮最贵的一个发现）**：
## `TIME` 是"开机以来的墙钟时间"，两次跑探针必然不同 ⇒ 波浪相位每次都不一样。
## 实测（完全相同的参数连跑两次）画面上出现：
##   · 整帧均值只差 **+0.99%**（看起来"可复算"）；
##   · 但画面**下三分之一的水面**逐行差到 **−64%**（第 685 行）。
## 危害在于它**长得像"某个区域内亮度整体变了"** —— 与"加了一层雾"在数字上无法区分。
## 本轮就是这样被骗了一轮：海雾的 A/B 数字全是相位漂移。
##
## 换成脚本推进之后，探针能把它**钉住**（`pin_anim_time()` + `--animtime`）。
## 顺带一个真实收益：暂停时海面与星空**真的停住**（`_process` 不再推进），
## 与"暂停画面应当是静止的"一致。
func _advance_anim_time(delta: float) -> void:
	if _anim_frozen:
		return
	_anim_time += delta
	_push_anim_time()


## 把当前时钟灌进海面与天空两支 shader。
func _push_anim_time() -> void:
	if _ocean_mat != null:
		_ocean_mat.set_shader_parameter("wave_time", _anim_time)
	if _sky_mat != null:
		_sky_mat.set_shader_parameter("sky_time", _anim_time)


## 把动画时钟**钉死**在某一秒（供 `tests/pixprobe` 用；游戏里不会调用）。
##
## ⚠️ 这是"画质 A/B 可复算"的**前置条件**，不是可选优化：
## 不钉住的话，任何与海面/星空有关的 A/B（包括"海雾有没有效果"）都在量相位噪声。
func pin_anim_time(t: float) -> void:
	_anim_time = t
	_anim_frozen = true
	_push_anim_time()


# ------------------------------------------------------------ 环境

## 天体方向（从场景**指向**月亮/太阳的单位向量）。
##
## 与 `apply_time_of_day()` 里喂给天空 shader 的 `disc_dir` 是同一个量
## （DirectionalLight3D 沿自身 −Z 照射，所以"指向天体"就是 `+basis.z`），
## 但这里**刻意不读 sun 节点**：海面 uniform 不该依赖场景树的更新时机
## （`apply_time_of_day()` 在换图时可能早于旋转真正生效），
## 而且从 `TimeOfDay.sun_rotation_deg` 直接算出来的是**纯函数，可以单测**。
## Godot 的 `rotation_degrees` 用 YXZ 顺序，`Basis.from_euler` 默认也是 YXZ。
static func celestial_dir(rotation_deg: Vector3) -> Vector3:
	var b := Basis.from_euler(Vector3(
		deg_to_rad(rotation_deg.x), deg_to_rad(rotation_deg.y), deg_to_rad(rotation_deg.z)))
	var d := b.z
	return d.normalized() if d.length_squared() > 0.000001 else Vector3.UP


func _build_environment() -> void:
	var env := Environment.new()
	env.background_mode = Environment.BG_SKY

	# 天空改用自定义 sky shader（要画星星和月亮，ProceduralSkyMaterial 画不了）
	var sky := Sky.new()
	var sky_mat := ShaderMaterial.new()
	if ResourceLoader.exists(SKY_SHADER):
		sky_mat.shader = load(SKY_SHADER)
	_sky_mat = sky_mat
	sky.sky_material = sky_mat
	env.sky = sky

	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_sky_contribution = 1.0
	env.ambient_light_energy = 0.85

	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.tonemap_white = 6.0

	# SSAO（批 10 性能优化）：默认**关**（默认值在 `Settings.ssao` 上，含理由）。
	# 每帧的跟随写在这里的 `_process` —— 想开了设置页一行立即生效。
	env.ssao_enabled = Settings.ssao and Settings.effects_quality>0
	env.ssao_radius = 6.0
	env.ssao_intensity = 1.1

	env.glow_enabled = Settings.effects_quality>0
	env.glow_intensity = 0.45
	env.glow_bloom = 0.06
	env.glow_hdr_threshold = 1.1
	# ---- 辉光**分层**（1.2.3 批 B）----
	# 引擎默认只用了 level 2/3/4（权重 0.8 / 0.4 / 0.1），1 与 5..7 全是 0 ——
	# 于是所有发光物（夜航灯 / 尾焰 / 光束 / 爆炸）的光晕都是**同一个尺寸**，
	# 看着像"贴上去的一层光斑"而不是"发光"。分层之后：
	#   · level 1（最细）= 0.25 —— 给夜航灯、光束一根**紧的亮核**；
	#   · level 2/3（中）= 0.45 / 0.30 —— 主光晕，从默认的 0.8 压下来（原来一坨全在这层）；
	#   · level 4/5/6（粗）= 0.20 / 0.10 / 0.05 —— 让爆炸、尾焰有**大范围的弥散**。
	# 权重和 1.35 与默认的 1.30 基本持平 —— **不是把辉光调亮，是把它摊开**，
	# 否则夜景会糊成一片（1.2 好不容易把夜战可读性调出来，不能在这一步糊掉）。
	# level 7（最粗）保持 0：整屏发白只需要它，本作不需要。
	# ⚠️ 这一组**不受时段影响**（`apply_time_of_day()` 只写 `glow_intensity`），
	# 所以层次在各个时段一致，只有总强度随时段变。
	env.set("glow_levels/1", 0.25)
	env.set("glow_levels/2", 0.45)
	env.set("glow_levels/3", 0.30)
	env.set("glow_levels/4", 0.20)
	env.set("glow_levels/5", 0.10)
	env.set("glow_levels/6", 0.05)
	env.set("glow_levels/7", 0.0)

	# ---- 色彩分级（1.2.3 批 B）----
	# `adjustment` 是**色调映射之后**的最终分级，零几何成本。
	#
	# ⚠️ 两个值都刻意压得很轻（1.06 / 1.05），理由有两条，都不是"保守"而是"避免倒退"：
	#   ① **对比度会放大 cel_post 的色阶**。三渲二后处理把画面量化到 6 阶
	#      （`posterize_mix = 0.6`），量化之后的画面再提对比度 = 把量化台阶**拉开**，
	#      色带会变明显。要提对比度，本该在量化**之前**提，而那是 1.18 的饱和度那一步
	#      已经在做的事（`cel_post.gdshader`）。
	#   ② **饱和度与 cel_post 重叠**。`cel_post` 的 `saturation`（1.18）是"绕亮度插值"，
	#      与 `adjustment_saturation` 是同一件事、同一条式子。两边都开就是叠加，
	#      1.18 × 1.05 ≈ 1.24 —— 所以这里只给 1.05，把"提饱和"的主场留给 cel_post
	#      （它在量化之前，不会放大色带）。
	env.adjustment_enabled = true
	env.adjustment_contrast = 1.06
	env.adjustment_saturation = 1.05
	env.adjustment_brightness = 1.0

	env.fog_enabled = true
	env.fog_mode = Environment.FOG_MODE_EXPONENTIAL
	env.fog_light_color = Color(0.62, 0.75, 0.92)
	env.fog_density = 0.000045
	env.fog_aerial_perspective = 0.45
	env.fog_sky_affect = 0.18

	# ---- 体积雾（给"贴海面的薄雾"用，1.2.3 批 J）----
	#
	# ⚠️ 这几项是**全局**的，所以必须在这里一次性配好，不能等 `apply_time_of_day()`：
	# 那里每张图都会走一遍，把"全局是否开体积雾"写在那里会让**换图的顺序**影响画面。
	# 开关的**唯一**依据是 `_sea_mist.visible`（由海里那条薄雾自己决定），
	# 而 `volumetric_fog_enabled` 只是"允不允许这一遍 pass 跑"。
	env.volumetric_fog_enabled = Settings.effects_quality==2 and supports_local_fog()
	# ⚠️ **给一个近乎 0 的基底，不能给默认的 0.05**。
	# 0.05/m 意味着 1 km 光程就 `exp(-50)` —— 整张画面（包括天空和机体）会变成一块牛奶。
	# 给 2e-6 有两个作用：① 保证这一遍 pass 真的跑起来（0 有可能被优化掉）；
	# ② 在"全局密度是**加**在 FogVolume 之上"的语义下，贡献可以忽略。
	env.volumetric_fog_density = 0.000002
	# 灯光灌进雾里（夜里只有月光 + 环境光），不给的话雾不会被照亮、只剩自发光。
	env.volumetric_fog_ambient_inject = 0.5
	env.volumetric_fog_gi_inject = 0.0
	# 各向异性偏前向：朝月亮看时雾会亮一点，雾的"发光感"来自这里。
	env.volumetric_fog_anisotropy = 0.35
	# 影响天空的量。⚠️ **不能给 1.0**：那会把整个天球一起糊成雾色，
	# 星空的对比度和海天分界会一起丢。给 0.35 只让地平线附近那圈亮起来。
	env.volumetric_fog_sky_affect = 0.35
	env.volumetric_fog_emission_energy = 1.0
	# 雾的最大渲染距离。⚠️ 这是 froxel 网格的**深度范围**：
	# 每层厚度 ≈ 这个值 / 64，所以给太大薄雾板会被切成一两层（出现水平色带）、
	# 给太小则几公里外就没有体积雾了。4000 m ⇒ 每层 62.5 m，薄雾板 160 m 有 2~3 层。
	# 远处（>4 km）仍由全局 `fog_density` 的指数雾接手，两者在大约同一个色系上，
	# 所以交界处不会出现"雾突然消失"。这一项与板厚是一对，改一个要复核另一个。
	env.volumetric_fog_length = 4000.0
	env.volumetric_fog_temporal_reprojection_enabled = true
	env.volumetric_fog_temporal_reprojection_amount = 0.9

	_env = env
	var we := WorldEnvironment.new()
	we.name = "WorldEnvironment"
	we.environment = env
	add_child(we)


## 建**唯一的**那块贴海薄雾板（1.2.3 批 J）。
##
## 只建节点、不写参数 —— 参数全部由 `apply_time_of_day()` 按时段/地图灌进去。
## 这样"海雾"就是**数据**（`TimeOfDay.sea_mist_*`）而不是散在各处的常量，
## 而且天然按地图生效：另外三张图的 `sea_mist_density` 是 0 ⇒ 这里 `visible = false`。
##
## ⚠️ 枚举常量**在 `RenderingServer` 上，不在 `FogVolume` 上**：
## `FogVolume.FOG_VOLUME_SHAPE_BOX` 会让 `--check-only` 报
## `Cannot find member "FOG_VOLUME_SHAPE_BOX" in base "FogVolume"`（实测踩过）。
## `RenderingServer.FOG_VOLUME_SHAPE_BOX = 3`；`FogVolume.shape` 的默认值本来就是 3，
## 但这里**显式写出来**：将来 Godot 改默认值的话，显式的那一份不会跟着变。
## 另一条路是直接写字面量 3 —— 不采用，魔数读不出意图。
func _build_sea_mist() -> void:
	if not supports_local_fog():return
	_sea_mist = FogVolume.new()
	_sea_mist.name = "SeaMist"
	_sea_mist.shape = RenderingServer.FOG_VOLUME_SHAPE_BOX
	var fm := FogMaterial.new()
	_sea_mist.material = fm
	_sea_mist.visible = false
	add_child(_sea_mist)


## 把当前时段的薄雾参数灌进雾板与体积雾的全局参数。
##
## ⚠️ 与 `_sea_mist.visible` 一起才是完整开关：`volumetric_fog_enabled` 常开
##（见 `_build_environment()`），而"看不见"由 `visible = false` 保证 ——
## 关着的 `FogVolume` 不参与 raymarch，所以非太平洋图**一点代价都不付**。
func _apply_sea_mist(tod: TimeOfDay) -> void:
	if _sea_mist == null or tod == null:
		return
	var on := tod.sea_mist_density > 0.0
	_sea_mist.visible = on
	if not on:
		return
	var h := maxf(tod.sea_mist_top, 4.0)
	var span := maxf(tod.sea_mist_span, 800.0)
	# `FogVolume.size` 是**全尺寸**（不是半尺寸）。底面贴水面 ⇒ 中心在 h/2。
	_sea_mist.size = Vector3(span, h, span)
	_sea_mist.position = Vector3(0.0, h * 0.5, 0.0)
	var fm := _sea_mist.material as FogMaterial
	if fm != null:
		fm.density = tod.sea_mist_density
		fm.albedo = tod.sea_mist_albedo
		fm.emission = tod.sea_mist_emission
		fm.height_falloff = tod.sea_mist_falloff
		fm.edge_fade = tod.sea_mist_edge_fade


func _build_sun() -> void:
	sun = DirectionalLight3D.new()
	sun.name = "Sun"
	sun.light_color = Color(1.0, 0.965, 0.90)
	sun.light_energy = 1.35
	sun.rotation_degrees = Vector3(-38.0, 128.0, 0.0)
	sun.shadow_enabled = Settings.shadow_quality>0
	sun.shadow_bias = 0.04
	sun.shadow_normal_bias = 1.5
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS
	sun.directional_shadow_max_distance = 3200.0
	sun.sky_mode = DirectionalLight3D.SKY_MODE_LIGHT_AND_SKY
	add_child(sun)


# ------------------------------------------------------------ 海面

func _build_ocean() -> void:
	var plane := PlaneMesh.new()
	plane.size = Vector2(OCEAN_SIZE, OCEAN_SIZE)
	# 细分 6 → `OCEAN_SEG`：原来每格 61 km，几何上就是一块**完全平的板**
	#（`ocean.gdshader` 的解析波只改法线、不改几何）。提到 448 段之后
	# 位移才有意义 —— 波长与格距的关系写在 `OCEAN_SEG` 的注释里。
	plane.subdivide_width = OCEAN_SEG
	plane.subdivide_depth = OCEAN_SEG

	var mat := ShaderMaterial.new()
	if ResourceLoader.exists(OCEAN_SHADER):
		mat.shader = load(OCEAN_SHADER)
	_ocean_mat = mat
	plane.material = mat
	mat.set_shader_parameter("adaptive_mesh", environment_detail_enabled)
	mat.set_shader_parameter("surface_detail", 1.0 if environment_detail_enabled else 0.0)
	# 浪尖次表面（1.2.3 批 E）：0.9 是"能看出来、但不会把海面整体提亮一档"的量级。
	# 只有太平洋图有海面（`_build_islands` 建的），所以这一项实质上是给那张图做的 ——
	# 那张图除了海就是天，海面的细节就是它的全部画面。
	#
	# ⚠️ 第一版给的是 0.45 配**三维**逆光公式，像素探针实测**全通道逐位为零**
	#（夜战固定月高 58°，三维点积的水平项被垂直项抵消，权重只剩 0.009）；
	# 改成"只比水平方位"之后同一处权重是 0.281，所以强度也一并从 0.45 提到 0.9 ——
	# 两个乘数合起来约 14 倍，才够越过 8 位量化那一格。详见 `ocean.gdshader` 的推导。
	mat.set_shader_parameter("crest_sss", 0.9)
	# ---- 长涌浪几何（1.2.3 批 H · 轮 1）----
	# 太平洋图**没有地表网格**（`ISLAND_COUNT = 0`），它的"地形"就只剩海面本身。
	# 所以这一张图的"地形细节细化"= 把海面从"一块平的板"变成"有长涌浪起伏的水面"。
	# 幅度与波长的推导见 `ocean.gdshader` 的 `wave_amp` 那一段。
	mat.set_shader_parameter("wave_amp", OCEAN_WAVE_AMP)
	# 水下礁盘（轮 1）：这张图唯一的"地形"（它没有地表网格）。
	mat.set_shader_parameter("shoal_amount", OCEAN_SHOAL)
	# 微波细节（轮 3）：大波给"起伏"，小波给"水"的读感 —— 见 `OCEAN_RIPPLE`。
	mat.set_shader_parameter("ripple_amount", OCEAN_RIPPLE)
	# 距离淡出（批 K · 轮 1）：见 `OCEAN_DETAIL_FADE` —— 原值 0.0022 是
	# "高空看海是一片平板"的原因，实测扫到 0.0002。
	mat.set_shader_parameter("detail_fade", OCEAN_DETAIL_FADE)

	ocean = MeshInstance3D.new()
	ocean.name = "Ocean"
	if environment_detail_enabled:
		ocean.mesh = OCEAN_DETAIL_MESH.build(OCEAN_SIZE * 0.5)
		ocean.material_override = mat
		# Vertex shader follows the active camera, including magnifier views.
		ocean.custom_aabb = AABB(Vector3(-1000000.0, -8.0, -1000000.0), Vector3(2000000.0, 16.0, 2000000.0))
	else:
		ocean.mesh = plane
	ocean.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_terrain_root.add_child(ocean)


# ------------------------------------------------------------ 陆地（沙漠 / 靶场共用）

## 一张按高度函数生成顶点色的地表网格。
##
## 和海面一样**一张贴图都不用**：颜色靠顶点色分带（沙丘脊线亮、洼地暗），
## 光照由 `generate_normals()` 出来的法线交给月光 —— 夜里沙丘的起伏就是靠这个读出来的。
## 高度函数是纯函数 `func(u, v) -> float`（u/v 是 0..1 的网格坐标），
## 于是"沙漠的沙丘"和"靶场的平地"只是两个不同的函数。
func _make_ground_mesh(size: float, seg: int, fn: Callable) -> Array:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	# ---- ⚠️ 2026-09-23（批 H · 轮 2 实拍归因）：smooth group 是**必须**的 ----
	#
	# `_ground_tri` 只 `set_color` + `add_vertex`，**不给顶点法线** ⇒ 法线全靠
	# `generate_normals()` 补。而 SurfaceTool 的默认 `smooth_group = -1` 是
	# **按面算**（flat shading）：每个三角面拿到自己的面法线。
	#
	# 后果在近景是灾难性的：沙漠/靶场格距 316 m、城市 301 m，一块地面的
	# **每一个三角面是一个亮度**，透视下这些面与面的分界就成了**一片平行的斜纹**
	#（实拍 `_pixprobe_h2b_gr_off.png`：700 m 机位下那些收敛到消失点的直线就是它）。
	# 更要命的是它**长得像"地表材质分层"**，于是 A/B 会把几何伪影读成 shader 效果 ——
	# 轮 2 第一版"城市分层偏弱"的结论有一半是被这个伪影搅混的。
	#
	# 高度函数 `fn` 是**连续曲面**，它的法线本来就应该平滑；设 `smooth_group(0)`
	# 之后 SurfaceTool 会按"顶点位置 + 同组号"合并，相邻三角面的共享角点得到
	# 同一根平均法线 ⇒ 从"多面体"变回"曲面"。
	#
	# ⚠️ **只管高度场曲面**。同一份文件里 `_build_box`（第 2108 行那处）是**立方体**，
	# 顶点故意不共享、六个面各要一根硬法线 —— 那里**不能**加这一行，
	# 否则箱体会被磨成球（城市的建筑体量全靠它）。
	st.set_smooth_group(0)
	var verts: Array = []
	var hs: Array = []
	for j in seg + 1:
		for i in seg + 1:
			var u := float(i) / float(seg)
			var v := float(j) / float(seg)
			var h: float = fn.call(u, v)
			verts.append(Vector3((u - 0.5) * size, h, (v - 0.5) * size))
			hs.append(h)
	for j in seg:
		for i in seg:
			var i0 := j * (seg + 1) + i
			var i1 := i0 + 1
			var i2 := i0 + seg + 1
			var i3 := i2 + 1
			_ground_tri(st, verts, hs, i0, i2, i1)
			_ground_tri(st, verts, hs, i1, i2, i3)
	st.generate_normals()
	return [st.commit(), verts, hs]


## 远景地坪：一张几乎纯色的巨大平面，负责"看得见地平线"，细节交给细分网格。
##
## ⚠️ 城市图会传 `top = -600`：海湾/运河那一带的地面是**挖空**的，
## 如果远景地坪还留在 y=0，它会把挖出来的水面盖回去（看着像"水在陆地上方"）。
## 碰撞体仍然留在 `-2`：`FlightBody.CRASH_ALTITUDE` 先一步处理"贴地飞行"，
## 这一层是"从高空砸下来正好漏采一帧"的兜底，海面/地面共用同一条兜底线。
func _build_ground_plane(color: Color, top := 0.0) -> void:
	var plane := PlaneMesh.new()
	plane.size = Vector2(LAND_SIZE, LAND_SIZE)
	plane.subdivide_width = 2
	plane.subdivide_depth = 2
	# PlaneMesh **没有顶点色**，所以颜色走 albedo_tint（`use_vertex_color = false`）
	plane.material = _terrain_material(color, LAND_ROUGH, false, LAND_SPECULAR, 0.0)
	var mi := MeshInstance3D.new()
	mi.name = "GroundFar"
	mi.mesh = plane
	mi.position = Vector3(0.0, top, 0.0)
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_terrain_root.add_child(mi)
	_add_flat_collision("GroundCollision", Vector3.ZERO, Vector3(LAND_SIZE, 4.0, LAND_SIZE), -2.0)


## 一层薄薄的地面碰撞（顶面贴 y=0）。
## 其实 `FlightBody.CRASH_ALTITUDE`（24 m）已经先一步判掉"贴地飞行"了，
## 这一层是给"从高空垂直砸下来、越过 24 m 那一帧却正好没被采到"的兜底，
## 也是"撞地"和"撞海"在结算日志里能区分开的原因。
func _add_flat_collision(node_name: String, center: Vector3, size: Vector3, top_y: float) -> void:
	var body := StaticBody3D.new()
	body.name = node_name
	body.collision_layer = FlightBody.WORLD_LAYER
	body.collision_mask = 0
	body.add_to_group("avoidance_ground")
	body.position = center + Vector3(0, top_y - size.y * 0.5, 0)
	var col := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = size
	col.shape = box
	body.add_child(col)
	_terrain_root.add_child(body)


## 一个方块障碍（残骸 / 废墟墙 / 探照灯塔）：可见件 + 碰撞体一起建。
##
## ⚠️ 它与 `_add_box()` 是**两条不同的路**：这里 `BoxMesh.size = size`（尺寸烘进**网格**），
## 所以模型矩阵的尺度是 1、局部坐标本身就是**米**；`_add_box()` 那边是共用单位立方体、
## 尺寸烘在实例的 `scale` 上。两者对 `city.gdshader` 都成立 —— 那份 shader 算的是
## `局部坐标 × 模型尺度`，两条路的结果都是米。
##
## ⚠️ 2026-09-30 去掉了 `parent` 参数：它唯一的用途是"把海上发射平台的几件
## 归到一个 `LaunchPad` 组下"，而**平台已经被老板砍掉**（「不需要用发射平台，
## 直接从海里面出来就行了」）。留着一个没人用的参数比删掉它危险 ——
## 下一个读到它的人会以为"这上面还有一块板"。
func _add_block(node_name: String, pos: Vector3, size: Vector3, color: Color,
		yaw_deg := 0.0, tilt_deg := 0.0, rot_z_deg := 0.0, emissive := Color(0, 0, 0, 0),
		facade := Facade.NONE) -> MeshInstance3D:
	var body := StaticBody3D.new()
	body.name = node_name
	body.collision_layer = FlightBody.WORLD_LAYER
	body.collision_mask = 0
	body.position = pos
	body.rotation_degrees = Vector3(tilt_deg, yaw_deg, rot_z_deg)
	var mi := MeshInstance3D.new()
	var bm := BoxMesh.new()
	bm.size = size
	# 与 `_add_box()` 同一条规矩：**自发光优先**（立面材质没有自发光）。
	var mat: Material
	if facade != Facade.NONE and emissive.a <= 0.0:
		mat = _city_facade_material(color, facade)
	else:
		var sm := StandardMaterial3D.new()
		sm.albedo_color = _sg(color)
		sm.roughness = 0.94
		sm.metallic = 0.0
		if emissive.a > 0.0:
			sm.emission_enabled = true
			sm.emission = emissive
			sm.emission_energy_multiplier = 2.4
		mat = sm
	bm.material = mat
	mi.mesh = bm
	body.add_child(mi)
	var col := CollisionShape3D.new()
	var sh := BoxShape3D.new()
	sh.size = size
	col.shape = sh
	body.add_child(col)
	_terrain_root.add_child(body)
	return mi


func _ground_tri(st: SurfaceTool, verts: Array, hs: Array, a: int, b: int, c: int) -> void:
	for idx: int in [a, b, c]:
		st.set_color(_land_color(hs[idx]))
		st.add_vertex(verts[idx])


## 陆地表面分带。**按高度分**而不是按位置 —— 于是洼地暗、丘顶亮，
## 月光斜照时起伏一眼能看出来。沙漠与废墟共用这条带谱，
## 只是各自把 base/light 两个颜色传进来（见 _build_desert / _build_range）。
var _land_dark := Color(0.16, 0.09, 0.055)
var _land_mid := Color(0.34, 0.19, 0.11)
var _land_light := Color(0.52, 0.31, 0.18)


## 夜战光照的**每通道增益**（实测标定，见 `_rock_color()` 那段对照实验）。
##
## 月光 `(0.62,0.72,1.0)` + 天空蓝环境光 + 蓝色辉光叠起来，反推出来的每通道增益是
## **红 0.30 / 绿 0.45 / 蓝 0.92** —— 蓝是红的三倍。任何"看起来正常"的红土 albedo
## 乘上它，蓝都会被抬到与红齐平，于是**读成中性灰**；而且压亮度治不了（×0.5 后仍是灰）。
##
## 唯一有效的旋钮是在 albedo 上把蓝压掉，于是"albedo 的 R/B 该给多少"是可以算的：
## 想让渲出来仍是红，就得让 `albedo.r * 0.30 > albedo.b * 0.92` 且留出倍数余量。
##
## ⚠️ 这原本只是注释里的一个数，第十四轮把它**提成常量**：
## `suite_round14` 用它做"沙漠够不够红"的判据 —— 把经验写成可断言的不变量，
## 下次再有人把颜色调回"自然红土"时会立刻红，而不是又靠肉眼发现"有点太白"。
const NIGHT_CHANNEL_GAIN := Color(0.30, 0.45, 0.92)


func _land_color(h: float) -> Color:
	if h < 4.0:
		return _land_dark
	if h < 40.0:
		return _land_dark.lerp(_land_mid, (h - 4.0) / 36.0)
	return _land_mid.lerp(_land_light, clampf((h - 40.0) / 120.0, 0.0, 1.0))


# ------------------------------------------------------------ 沙漠（艾尔斯岩）

## 澳大利亚中部的红土沙漠 + 乌卢鲁巨岩。
##
## 三件事让"沙漠"看起来不像"把海面刷成土黄色"：
##   1. **远景地坪 + 一层 44 km 的细分沙丘**：远处靠雾淡出，近处看得见沙丘脊线；
##   2. **巨岩**：一块长条形的大岩体压在场地上（用户点名的艾尔斯岩），
##      加上另一处几块圆丘（卡塔丘塔那种）—— 它们同时是缠斗中的地标与掩体；
##   3. **散落的岩块**：小尺度的石阵，低空掠过时有参照物，速度感才成立。
func _build_desert() -> void:
	# ---- 绿洲（1.2.3 批 K · 轮 1③）----
	#
	# ⚠️ **必须放在这里（函数最开头），不能挪到末尾**：它烘的 `_veg_mask_tex`
	# 是由下面 `_terrain_material()` 在**建沙丘材质时**灌进 shader 的
	#（`set_shader_parameter("veg_mask_tex", _veg_mask_tex)`）。
	# 放在末尾 ⇒ 材质拿到的永远是 `null`（`hint_default_black` ⇒ 读到 0）
	# ⇒ 画面表现是"**地上一点绿都没有，但树长得清清楚楚**" ——
	# 一个"顺序错了"长得像"阈值调错了"的典型。
	_build_desert_oasis()
	# ---- 第十四轮：为什么这三个数必须"饱和到不自然" ----
	#
	# 老板反馈："艾尔斯岩的地面得是暗红色啊，现在有点太白了"。
	#
	# 真因不是"亮"，是**蓝通道没压掉**。`_rock_color()` 那段注释里记着一次对照实验的
	# 标定结论：这场景的夜光每通道增益是 **红 0.30 / 绿 0.45 / 蓝 0.92**（蓝是红的三倍），
	# 于是任何"看起来正常的红土"渲出来蓝都会被抬到与红齐平 → 读成中性灰；
	# 而且**调亮度治不了**（实算过 ×0.5 之后仍是中性色）。
	#
	# 拿旧值算一遍就清楚了：(0.86,0.47,0.24) → 0.86×0.30 : 0.47×0.45 : 0.24×0.92
	# = 0.258 : 0.212 : 0.221 → **R/B = 1.17，正好是灰**。
	# 实测也是这个数：贴沙丘低飞那张图里沙地均值 R=87 G=67 B=66（R/B = 1.32）。
	#
	# 所以要的是 albedo 的 **R/B ≈ 18**（和已经标定过的巨岩 `BODY`/`TOP` 同一色族，
	# 它们的 R/B = 18.9，实测渲出来正好是暗红橙），整体亮度再压到巨岩的一半左右 ——
	# `_rock_color()` 里写着"岩体亮度约为地面的 2.7 倍"，地标要看得见，这个关系要保住。
	_land_dark = Color(0.105, 0.030, 0.006)     # 洼地：比丘顶再暗一档
	_land_mid = Color(0.230, 0.072, 0.011)      # 主体
	_land_light = Color(0.330, 0.110, 0.018)    # 丘顶
	# 远景地坪：**同一个病，同一条药**。旧值 (0.48,0.23,0.11) 的 R/B 只有 4.4，
	# 在这个增益下同样是灰的（它还占了画面上大半的地面像素）。
	_build_ground_plane(Color(0.200, 0.062, 0.012))

	# ---- ⚠️ 轮 1：这三组噪声的**频率口径换过一次**，换之前它们几乎全是白做 ----
	#
	# 旧版把坐标压进 0..900 的**抽象空间**再乘 frequency。把实际波长算出来就明白了：
	#   · `dunes` 传 `x*0.10`（x∈0..900 ⇒ 0..90）、frequency 0.0016
	#     ⇒ 有效频率 `0.0016 × 0.10 = 1.6e-4`，在 900 个抽象单位上只有 **0.144 个周期**
	#     —— `ridge` 在整张图上几乎是常数，**等于没有**；
	#   · `sand` 好一些：`0.010 × 900 = 9` 个周期，但摊到 101.2 km 的网格上
	#     ⇒ **每个"沙丘"有 11 km 长**，它那 3 个 octave 最细也只到 2.8 km。
	# 再叠上旧细分 84 段（格距 1205 m ⇒ 几何只能表达 λ ≥ 2410 m），
	# 结论就是实拍里那片"沙丘"= **一整块看不出起伏的缓坡**。
	#
	# 现在一律按**真实米**给波长：
	#   大沙垄 λ 3000 m（决定脊线走向）· 中沙丘 λ 850 m
	# 配 `DESERT_SEG = 320`（格距 316 m ⇒ 几何只能表达 λ ≥ **632 m**）。
	#
	# ---- ⚠️ 2026-09-23（批 I · 轮 4 跨图标定）：删掉第三层「细沙纹 λ 210 m」----
	#
	# 旧写法有一位"细沙纹 λ 210 m（幅度 3 m）"，注释里的理由是"顶点色按高度分带，
	# 细沙纹会跟着上色"。那个理由**站不住**：210 m 只有 **0.66 个格距**，
	# 远在奈奎斯特（632 m）之下 —— 逐顶点采样它得到的**不是一个 210 m 的形状**，
	# 而是"相邻顶点各自取到一个随机值"的**走样**（逐顶点抖动）。
	# 也就是说它贡献的不是"细沙纹"，是**噪声**；顶点色跟着它分带 = 跟着噪声分带。
	#
	# 而它想做的事**已经有更合适的承担者**：`terrain.gdshader` 的 `detail` 五层
	# 倍频（λ 1280 → 5 m），第二、三层正好是 320 m / 80 m，采样不受网格密度限制，
	# 而且顺带产出法线与 albedo 颗粒 —— 比"塞进高度函数"完整得多。
	#
	# ⇒ 几何只负责**网格真的表达得出来**的尺度，其余交给 shader 的细节层。
	#   这条分工现在写进了 `CALIB` 表，由 `suite_gfx_map` 用算术检查（不是 grep）。
	# ---- ⚠️ 2026-09-24（批 K · 轮 1③）：两个噪声对象**搬进了
	#      `_desert_dune_height()`**（连同下面 `fn` 里那两段解释常数项的注释）。
	#      搬家的唯一原因是**撒树要落在同一个高度场上**，
	#      而"同一个"必须由**一份代码**保证，不能靠两个地方抄一样的常数。
	var fn := func(u: float, v: float) -> float:
		# ⚠️ `u/v ∈ 0..1` 映射到**真实米**（与网格同坐标系），不再压到 0..900。
		var x := (u - 0.5) * TERRAIN_DETAIL_SIZE
		var z := (v - 0.5) * TERRAIN_DETAIL_SIZE
		return _desert_dune_height(x, z)
	var made: Array = _make_ground_mesh(TERRAIN_DETAIL_SIZE, DESERT_SEG, fn)
	var mi := MeshInstance3D.new()
	mi.name = "Dunes"
	mi.mesh = made[0]
	# 第 10 个参数 `DESERT_VEG`：稀疏植被覆盖（批 I · 轮 5）。
	# 只有这一处传非 0 —— 参照要求是艾尔斯岩，别的图不该长草。
	# 第 11~12 个参数：颜色斑驳（批 I · 轮 7）。沙丘给**最大波长**（40 m）：
	# 风成分选出来的色差是缓的，给 14 m 那种尺度会读成"沙地上撒了盐粒"。
	mi.material_override = _terrain_material(Color.WHITE, LAND_ROUGH, true, LAND_SPECULAR, 1.10, 1280.0,
			0.75, 2.2, 0.42, DESERT_VEG, MOTTLE_DESERT, MOTTLE_DESERT_LEN)
	_terrain_root.add_child(mi)

	# ---- 乌卢鲁：一块 2.6 km 长的大岩体 ----
	_tri_color = _rock_color
	# ⚠️ 1.2 用户实测："艾尔斯巨岩并没有做出来那超大的一块巨岩，只做了红色的土地"。
	# 截图核对之后的结论是**它建出来了，但离交火区太远、太小、又和红沙同色**：
	# 原位置 `(-7800, 0, -5200)` 距中心 9.4 km，520 m 高在 9.4 km 外只有约 40 px，
	# 夜战光下深红赭的岩体和红沙糊成一片。
	# 三处一起改：**拉近到 ~4 km**（`(-3400, 0, -2300)`，|d| ≈ 4.1 km）、
	# **放大到 4000 × 1600 × 720 m**、并把颜色调亮（见 `_rock_color` 里的注释）。
	# ⚠️ 1.2 用户第二次反馈："还是不够大"。再放大一档：
	# **6000 × 2600 × 1200 m**（80° 斜边 → 水平退距 = 1200/tan80° ≈ 212 m，
	# 所以平顶仍占半径的九成，剖面依旧是陡坡 + 大片平顶）。
	# ---- ⚠️ 2026-09-23（批 H · 轮 3）：Uluru 的网格密度 34 → 72 ----
	#
	# 原来的 34 是"远看够用"的算法：6000 m / 33 格 = **176 m 一格**，
	# 而它同时是**上一段那个噪声 bug 的帮凶** —— 6.4 个起伏配 176 m 格距，
	# 每个鼓包摊到 5 个格子，形状完全由网格插值决定，于是近景（`--aim=Uluru:1200`）
	# 就是一块看得出棱的多面体。
	#
	# 72 格 ⇒ 84.5 m 一格，配合自适应噪声（主波长 = 4 格 = 338 m、最细层 = 1 格）
	# 才真正把"风化"刻进几何里。三角形从 2312 涨到 10368 ——
	# 这块是全图唯一的巨型地标，多出来的 8k 面完全值得。
	_build_rock_ridge("Uluru", Vector3(-3400.0, 0.0, -2300.0), 6000.0, 2600.0, 1200.0, 7301, 72)
	# ---- 卡塔丘塔：几块圆丘 ----
	for i in 5:
		var a := 0.6 + float(i) * 0.34
		var r := 1500.0 + float(i) * 260.0
		_build_rock_ridge("KataTjuta%d" % i,
			Vector3(cos(a) * r + 9800.0, 0.0, sin(a) * r + 6400.0),
			380.0 + float(i) * 40.0, 300.0 + float(i) * 30.0, 240.0, 8100 + i * 13)

	# ---- 散落岩块 ----
	# 用低面数的"岩丘"而不是方块：方块在夜里的斜光下就是一只只纸箱，
	# 一眼看出来不是岩石。`_build_rock_ridge` 的网格密度按 n 给，小岩块给 10 就够。
	for i in 46:
		var a := _rng.randf() * TAU
		var r := _rng.randf_range(2200.0, 20000.0)
		var pos := Vector3(cos(a) * r, 0.0, sin(a) * r)
		var s := _rng.randf_range(120.0, 420.0)
		_build_rock_ridge("Rock%d" % i, pos,
			s * _rng.randf_range(1.2, 2.4), s * _rng.randf_range(0.8, 1.6),
			s * _rng.randf_range(0.25, 0.55), 9000 + i * 17, 10)


# ============================================================ 艾尔斯岩绿洲（批 K · 轮 1③）

## 沙丘高度场（米），`x` / `z` 是**世界米**。
##
## ## 为什么它必须是一个函数，而不是 `_build_desert()` 里的一个 lambda
## 因为**撒树要落在同一个面上**。树只高 15~30 m，而沙丘起伏有 **±36 m**
##（`24 + ridge×26 + mid×10`）—— 高度场只要差一点，树就会**浮在丘顶上空**
## 或**整棵埋进沙里**，而在画面上这两者都极显眼。
## 各写一份的话，"两边一样"只能靠抄常数来维持，抄漏一个字符就是上面那个结果。
## ⇒ 一份代码，两处调用。
##
## ## 三个数为什么是这些（都是 1.2~1.3 轮标定过的成品，不是这里新定的）
##   · `seed 977` / `λ 3000 m` / `octaves 2`：大沙垄，决定脊线走向。
##     octaves 2 ⇒ 最细一层 1500 m = 4.7 个格距 ✅（奈奎斯特是 2 格）。
##   · `seed 4111` / `λ 850 m` / **`octaves 1`**：中沙丘。
##     ⚠️ octaves 从 2 降到 1 是刻意的：octaves=2 会多出一层 425 m，
##     而 425 m < 632 m（= 2 × 格距 316 m）⇒ 走样。降到 1 后主波长 850 m = 2.7 格 ✅。
##   · `1 - |noise|` 而不是 `noise`：前者给出**尖脊 + 宽谷**的沙垄剖面，
##     后者只是一条正弦包。沙丘最像沙丘的地方就是那道脊。
##   · 常数项 `24` 把均值拉回**与旧版同一档（≈37）**：旧版是
##     `(1-ridge)*26 + base*34`（均值 ≈ 36.5），而 `_land_color()` 的两条分带阈值
##     （4 / 40）正是按那个量级定的 —— 不标定就会整片地面换色。
func _desert_dune_height(x: float, z: float) -> float:
	if _desert_ridge_n == null:
		_desert_ridge_n = FastNoiseLite.new()
		_desert_ridge_n.seed = 977
		_desert_ridge_n.noise_type = FastNoiseLite.TYPE_SIMPLEX
		_desert_ridge_n.frequency = 1.0 / 3000.0
		_desert_ridge_n.fractal_octaves = 2
		_desert_mid_n = FastNoiseLite.new()
		_desert_mid_n.seed = 4111
		_desert_mid_n.noise_type = FastNoiseLite.TYPE_SIMPLEX
		_desert_mid_n.frequency = 1.0 / 850.0
		_desert_mid_n.fractal_octaves = 1
	var ridge := 1.0 - absf(_desert_ridge_n.get_noise_2d(x, z))
	var mid := _desert_mid_n.get_noise_2d(x, z)
	return 24.0 + ridge * 26.0 + mid * 10.0


## 撒出绿洲的**团**与**串**。每项 `Vector4(x, z, 半径, 核心强度)`。
##
## ## 为什么不能用 `_rng`
## `_rng` 在 `_map_stage_terrain()` 开头被重设为 20260917，之后被沙丘、岩脊、
## 以及 `_build_desert()` 末尾那 46 块散落岩块**依次消耗**。接着用它 ⇒
## 那 46 块岩块的落点会跟着植被一起动 —— 而"只动植被、不动岩块"是调试时
## 最基本的隔离。⇒ 与 `_city_rng` / `CLOUD_SEED` 同一条规矩：**各自一个发生器**。
##
## ## 分布的形状（用户三条要求逐条对应）
##   ① "**有些是随机分布**"         → 团心是蓝噪声（拒绝采样）撒的，位置随机；
##   ② "**高空也能看到的小团**"      → 见 `DESERT_CLUMP_GAP` 的算术：
##      俯视单帧约能看到 **4.3 个团**（原来稀到只剩一两个）；
##   ③ "**也有些是连在一起的小绿洲**" → `DESERT_CLUSTER_CHANCE` 那 **55%** 的母点
##      会长成一条 **3~5 片**的"串"。
##
## ⚠️⚠️ 轮 1 的串是"3 片、间距 0.72~0.92、走向每片抖 ±0.55 rad"，
## 实测结果是**一串分开的珠子**（见 `DESERT_LOBE_STEP_MIN` 上面那一整段）。
## 轮 2 改成：**片更多（3~5）、间距只到 0.55~0.72、走向几乎不抖（±0.16 rad）**。
## 这样一来相邻片的**可见半径必然重度交叠** ⇒ 画面上是一条**连续的**带，
## 而带的总长 = 4 步 × (r0 + lr) × 0.63 ≈ **2.5 × r0**（r0 = 220 时约 1.1 km）
## ⇒ 二阶矩长短轴比落到 **2.5~3.5**，稳稳越过"串"的判据（> 1.6）。
##
## ⚠️ 走向抖动**必须保留一点点**（收到 0 就是一条直线）：
## 直线挂出来的是一根"绿香肠"，一眼看出是程序画的；
## ±0.16 rad 的缓慢弯曲读起来像**干涸河床** —— 而真实的沙漠绿洲就沿着河床长。
func _desert_oasis_sites() -> Array[Vector4]:
	var rngv := RandomNumberGenerator.new()
	rngv.seed = DESERT_VEG_SEED
	var out: Array[Vector4] = []
	var mothers: Array[Vector2] = []
	var gap2 := DESERT_CLUMP_GAP * DESERT_CLUMP_GAP
	var tries := 0
	# ⚠️ 拒绝采样**必须带尝试上限**：`DESERT_MOTHERS` 逼近密堆积上限时
	#（本例面积允许约 375 个，目标 340），循环会在"再也塞不进"之后空转。
	# 不设上限就是一个静默的死循环 —— 换图时表现为"读条卡在 20%"。
	while mothers.size() < DESERT_MOTHERS and tries < 60000:
		tries += 1
		var a := rngv.randf() * TAU
		# ⚠️ `sqrt(u)` 而不是 `u`：前者才是**圆盘上均匀**，
		# 直接用 `u` 会在圆心堆成一坨（面积元是 `r dr dθ`）。
		var rr := sqrt(rngv.randf()) * DESERT_OASIS_R
		var p := Vector2(cos(a) * rr, sin(a) * rr)
		var clash := false
		for q in mothers:
			if p.distance_squared_to(q) < gap2:
				clash = true
				break
		if clash:
			continue
		mothers.append(p)
	for i in mothers.size():
		var p := mothers[i]
		var r0 := rngv.randf_range(DESERT_CLUMP_R_MIN, DESERT_CLUMP_R_MAX)
		# 母点自己永远是一个团（核心强度 1.0 = 最密）
		out.append(Vector4(p.x, p.y, r0, 1.0))
		if rngv.randf() >= DESERT_CLUSTER_CHANCE:
			continue
		var head := rngv.randf() * TAU
		var at := p
		var lobes := rngv.randi_range(3, 5)
		# `prev_r` = 上一片自己的半径。片间距要按**相邻两片各自的半径和**算，
		# 而不是按母片半径 —— 见下面 `step` 那一行的注释。
		var prev_r := r0
		# 走向的**单位向量**单独留着：横向 wobble 要的是它的法向（`_perp`）。
		var dir := Vector2(cos(head), sin(head))
		var perp := Vector2(-dir.y, dir.x)
		# ⚠️ 串根的位置（`at`）与走向（`head`）分开存：`at` 是"上一片的圆心"，
		# 而片间距要按**当前这一片自己的** `(r0 + lr)` 算 —— 用固定的 r0 会在
		# 叶片变小时留下一段缝（这正是轮 1 的珠子感）。
		for k in lobes:
			head += rngv.randf_range(-DESERT_LOBE_JITTER, DESERT_LOBE_JITTER)
			dir = Vector2(cos(head), sin(head))
			perp = Vector2(-dir.y, dir.x)
			# 叶片半径 0.70~0.95 × 母片 ⇒ 后面**缓慢**变小，
			# 读起来像"水越走越少"，而不是一串等大的绿饼、也不是一串递减的珠子。
			var lr := r0 * rngv.randf_range(DESERT_LOBE_MIN, DESERT_LOBE_MAX)
			# `(r0 + lr) × 0.55~0.72`：**两片圆心距 < 半径和** ⇒ 必然交叠，
			# 且交叠量 28%~45% ⇒ 合成一块连续的带，而不是珠子。
			# ⚠️ 这里的 `r0` 用**上一片自己的半径**（`prev_r`），不是母片半径。
			var step := (prev_r + lr) * rngv.randf_range(DESERT_LOBE_STEP_MIN, DESERT_LOBE_STEP_MAX)
			# 横向 wobble：把带的边缘从"两条平行直线"打成不规则的轮廓。
			# ⚠️ 幅度按 `r0` 而**不是**按 `lr` 缩放：按 lr 会让串的末端又细又直。
			var wob := rngv.randf_range(-DESERT_LOBE_WOBBLE, DESERT_LOBE_WOBBLE) * r0
			at += dir * step + perp * wob
			# 叶片核心强度 0.85（比母片淡）：串的末端该比头淡
			out.append(Vector4(at.x, at.y, lr, 0.85))
			prev_r = lr
	return out


## 把绿洲的**团/串**按"是否交叠"连成图，数连通分量 —— 分布的**形状普查**。
##
## ## 为什么这个统计放在工程代码里，而不是写在测试或量测脚本里
## 判据"**也有些是连在一起的小绿洲**"在**数据侧**唯一的定义是
## "**两片圆相交**"（渲染侧还要再叠一层"可见半径"的收缩，见
## `terrain.gdshader` 的 `VEG_MASK_BIAS` 那一段）。
## 测试要断言它、像素量具要解释它 —— 两边各写一份必然出现
## "**测试说连上了、图上是断的**"这种最难查的分歧。
## ⇒ 一份定义、两处消费。
##
## ## ⚠️ 判定用"相交"（`d < r_i + r_j`）而**不是**"包含"（`d < r_i`）
## 叶片中心离母片心只有 `0.55~0.72 × (r0 + lr)`，**落在母片内部**是常态。
## 用"包含"判看似更严，实际上会把**整条串**判成一个点 —— 那就什么也量不到了。
##
## ## 复杂度
## `O(n²)`，n ≈ 700 ⇒ 49 万次，其中绝大多数被 `dx` 的一维早退剪掉。
## **只在被问到时才跑**（测试 / 取证脚本），不进建图路径。
func desert_chain_census() -> Dictionary:
	var n := desert_oasis_sites.size()
	var parent: Array[int] = []
	parent.resize(n)
	for i in n:
		parent[i] = i
	for i in n:
		var a := desert_oasis_sites[i]
		for j in range(i + 1, n):
			var b := desert_oasis_sites[j]
			var rs := a.z + b.z
			var dx := a.x - b.x
			# 一维早退：x 方向就已经比半径和远 ⇒ 不可能相交。
			# ⚠️ 这条不是优化，是**必需**：没有它，49 万次里绝大多数要跑完整开方。
			if dx > rs or dx < -rs:
				continue
			var dz := a.y - b.y
			if dx * dx + dz * dz >= rs * rs:
				continue
			var ri := i
			while parent[ri] != ri:
				ri = parent[ri]
			var rj := j
			while parent[rj] != rj:
				rj = parent[rj]
			if ri != rj:
				parent[ri] = rj
	# ---- 按根分组 ----
	var groups := {}
	for i in n:
		var r := i
		while parent[r] != r:
			r = parent[r]
		if groups.has(r):
			groups[r].append(i)
		else:
			# ⚠️ 先赋给一个**带类型标注**的局部变量再放进字典：
			# `[i] as Array[int]` 这种写法在 Godot 4 里对**类型化数组**不成立
			#（`as` 只做运行时类型转换，不构造带元素类型的数组）。
			var fresh: Array[int] = [i]
			groups[r] = fresh
	var chains := 0
	var biggest := 0
	var span := 0.0
	var chain_span := 0.0
	for r in groups:
		var idx: Array = groups[r]
		if idx.size() > biggest:
			biggest = idx.size()
		var lo := Vector2(INF, INF)
		var hi := Vector2(-INF, -INF)
		for k in idx:
			var s: Vector4 = desert_oasis_sites[k]
			lo = Vector2(minf(lo.x, s.x - s.z), minf(lo.y, s.y - s.z))
			hi = Vector2(maxf(hi.x, s.x + s.z), maxf(hi.y, s.y + s.z))
		# 长边而不是对角线：串是**拉长**的，我们要的正是那个"长"。
		var d := maxf(hi.x - lo.x, hi.y - lo.y)
		span = maxf(span, d)
		# "串"的定义：**3 片及以上**连成一组。
		# ⚠️ 2 片也算的话，母片 + 任意一片"碰巧擦到"都会被算成串 ——
		# 而擦到在数据上很常见、在画面上读不出来，那是**假阳性**。
		if idx.size() >= 3:
			chains += 1
			chain_span = maxf(chain_span, d)
	return {
		"sites": n,
		"groups": groups.size(),
		"chains": chains,
		"biggest_group": biggest,
		"biggest_span_m": span,
		"chain_span_m": chain_span,
		"tree_scale": desert_tree_scale,
		"trees": desert_tree_xf.size(),
	}


## 把绿洲撒布**烘成一张覆盖掩码**，喂给 `terrain.gdshader` 采样。
##
## ## 为什么走**纹理**而不是 uniform 数组
## 团+串实测约 750 个。用 `uniform vec4 sites[1024]` 的话每个片元要过 1024 次距离
## 计算（或者得在 shader 里做空间索引，那是一大坨没人愿意维护的代码）。
## 一张 2048² 的 `R8` 图 = **一次采样**，4 MB 显存，一次上传。
## 代价是"掩码分辨率固定"（29.3 m/px），而这个代价对本效果**没有影响**：
## 团的半径是 70~180 m，29 m/px 只让它多一层 1~2 px 的像素级台阶，
## 而那一层台阶正好被 shader 里的 14 m 细噪声打碎（见 `terrain.gdshader` 的绿洲段）。
##
## ## 为什么用 `max` 累加而不是 `+`
## 叶片之间是**交叠**的（这正是"连在一起"的做法）。用加法会在交叠处出现
## 一条亮缝（掩码值冲高）⇒ 地上会出现一条"绿带中的深绿缝"。
## 用 `max` 则两片平滑地合成一整块 —— 这才是"连在一起"该有的样子。
func _bake_veg_mask(sites: Array[Vector4]) -> void:
	var res := DESERT_OASIS_RES
	var cell := DESERT_OASIS_SPAN / float(res)
	var half := DESERT_OASIS_SPAN * 0.5
	# ⚠️ 用 `PackedByteArray` 而不是 `PackedFloat32Array` + 逐像素 `set_pixel`：
	# 掩码是 `R8`（单通道 8 位），本来就不需要浮点中间量，
	# 而且 2048² = 419 万次 `set_pixel` 是**十几秒**的量级 ——
	# 那一步在 `_build_desert()` 里、也就是**读条界面中间**，不能那么慢。
	var acc := PackedByteArray()
	acc.resize(res * res)
	for s in sites:
		var cx := s.x
		var cz := s.y
		var radius := s.z
		var core := s.w
		# 只扫**该团的外接格框**：300 个母点 + 串叶各扫约 (2r/cell)² 格，
		# 全图 419 万格而实际只写约 30 万次 —— 不这么做就是几十秒的读条。
		var x0 := maxi(0, int(floor((cx - radius + half) / cell)))
		var x1 := mini(res - 1, int(ceil((cx + radius + half) / cell)))
		var z0 := maxi(0, int(floor((cz - radius + half) / cell)))
		var z1 := mini(res - 1, int(ceil((cz + radius + half) / cell)))
		for iz in range(z0, z1 + 1):
			var wz := (float(iz) + 0.5) * cell - half
			var row := iz * res
			var dz := wz - cz
			var dz2 := dz * dz
			for ix in range(x0, x1 + 1):
				var wx := (float(ix) + 0.5) * cell - half
				var dx := wx - cx
				var d2 := dx * dx + dz2
				if d2 >= radius * radius:
					continue
				var f := 1.0 - sqrt(d2) / radius
				# ⚠️ 幂次 1.35（不是 2）：`f^2` 出来是一圈**软斑**，
				# 而绿洲的形状是"核心密、边缘断"。幂次越高核心越平、边缘越陡。
				# 边缘最终由 shader 那层的 14 m 细噪声打碎。
				var v := int(clampf(pow(f, 1.35) * core * 255.0, 0.0, 255.0))
				var idx := row + ix
				if v > acc[idx]:
					acc[idx] = v
	# ⚠️ `acc` 本身就是**字节数据**（`R8` 单通道 8 位 / 像素 1 字节，
	# 行主序、无行距填充）⇒ 可以直接喂给 `create_from_data`，不需要再转一次。
	# 这一步"省掉一个中间数组"是有意的：2048² 的转写要 419 万次操作。
	var img := Image.create_from_data(res, res, false, Image.FORMAT_R8, acc)
	_veg_mask_tex = ImageTexture.create_from_image(img)


## 一棵树的**单位网格**：本地总高**恰好 1.0**，树冠直径 = 0.87 × 高。
##
## ⚠️ "本地总高恰好 1.0"是刻意的：实例变换直接给 `Vector3(s, s, s)` 的**等比缩放**，
## 高就是高，不用在每个调用点乘一个归一化常数（那种常数迟早会漏一处，
## 而漏了的后果是"这片树比那片树矮 15%"——看起来像"随机得太厉害"，不像 bug）。
##
## ## 面数账（它决定了 `DESERT_TREE_CAP`）
## 树干 4 棱 × 1 环 = 8 面；两层树冠各 5 棱锥 = 10 面 ⇒ **28 面/棵**。
## 25.2k 棵 ≈ **70.6 万三角形** —— 与地表网格（320² × 2 = 20.5 万）同量级，
## 而且整个绿洲是**一个 draw call**（MultiMesh）。
## ⚠️ 棱数不能图省事降到 3：三棱锥从 300 m 贴地机位看是一个**明显的多面体**。
func _desert_tree_mesh() -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	# 树干：细四棱锥台（上细下粗）。⚠️ 不封顶底 —— 那 2×2 个三角形在这两个
	# 视角（高空俯视 / 平视）下都看不见，白花。
	var trunk := CylinderMesh.new()
	trunk.top_radius = 0.048
	trunk.bottom_radius = 0.096
	trunk.height = 0.26
	trunk.radial_segments = 4
	trunk.rings = 1
	trunk.cap_top = false
	trunk.cap_bottom = false
	st.append_from(trunk, 0, Transform3D(Basis(), Vector3(0.0, 0.13, 0.0)))
	# 树冠两层：下大上小，上层的棱**转 22.5°**错开 ⇒ 轮廓不是一条直边，
	# 从远处看有"叶簇"的读感（两层对齐的话是一个干净的圆锥，太规整）。
	var yaw := Basis().rotated(Vector3.UP, PI / 8.0)
	var lower := CylinderMesh.new()
	lower.top_radius = 0.0
	lower.bottom_radius = 0.435
	lower.height = 0.478
	lower.radial_segments = 5
	lower.rings = 1
	lower.cap_top = false
	lower.cap_bottom = false
	st.append_from(lower, 0, Transform3D(yaw, Vector3(0.0, 0.499, 0.0)))
	var upper := CylinderMesh.new()
	upper.top_radius = 0.0
	upper.bottom_radius = 0.310
	upper.height = 0.262
	upper.radial_segments = 5
	upper.rings = 1
	upper.cap_top = false
	upper.cap_bottom = false
	st.append_from(upper, 0, Transform3D(yaw, Vector3(0.0, 0.869, 0.0)))
	st.generate_normals()
	return st.commit()


## 建绿洲：烘掩码 + 撒树。
##
## ⚠️ 顺序：**先撒团、再烘掩码、最后撒树** —— 三者用的是同一份 `sites`，
## 所以"地上绿在哪里"与"树长在哪里"在构造上就不可能不一致。
## 树的位置还要**再采一次沙丘高度**（`_desert_dune_height`），
## 因为沙漠的树不长在水平面上。
func _build_desert_oasis() -> void:
	desert_oasis_sites = _desert_oasis_sites()
	_bake_veg_mask(desert_oasis_sites)
	# ---- 树数预算：**先算总量、超了全局等比缩，绝不截断** ----
	#
	# ⚠️⚠️ 轮 1 是 `if xf.size() >= CAP: break`，而实测 `trees` 正好 = 30000
	# ⇒ **真的踩上了**：`desert_oasis_sites` 尾部那些团被整个丢掉，
	# 地上是绿的、树是零（违反用户第一条"要有树木"），而且是**静默**的。
	#
	# 改法的要点是"**没有任何一个团被单独优待或牺牲**"：
	# 超额时按 `CAP / 总量` 把密度**乘着缩**，每个团少撒同样比例 ⇒
	# 覆盖形状（哪些团、多大）完全不变，只有树距均匀变稀一点。
	#
	# ⚠️ 用**浮点总量**而不是 `Σ int(...)` 反推：逐项取整会累积
	# `sites.size()/2` 的误差（700 个团就是 350 棵的余量），
	# 那点余量正好够把总数推回上限之上 ⇒ 缩放白算了。
	var raw_total := 0.0
	for s in desert_oasis_sites:
		raw_total += PI * s.z * s.z * DESERT_TREE_PER_M2 * s.w
	var dens := DESERT_TREE_PER_M2
	desert_tree_scale = 1.0
	if raw_total > float(DESERT_TREE_CAP):
		# 0.995 是给逐项 `int()` 取整留的余量：取整只会让总数变小，不会变大，
		# 所以这个系数保证"乘完之后逐项取整的结果必然 ≤ CAP"。
		desert_tree_scale = float(DESERT_TREE_CAP) / raw_total * 0.995
		dens *= desert_tree_scale
		push_warning("[绿洲] 树数预算超了：理论 %.0f 棵 > 上限 %d ⇒ 全团等比降到 %.1f%%（%.1f m 树距）"
			% [raw_total, DESERT_TREE_CAP, desert_tree_scale * 100.0, 1.0 / sqrt(dens)])
	var rngt := RandomNumberGenerator.new()
	# ⚠️ 与撒团**用不同的种子偏移**：同一个种子会让"团的中心"和"第一棵树"
	# 落在同一个位置上，于是每个团的圆心都有一棵特别显眼的树。
	rngt.seed = DESERT_VEG_SEED + 777
	var xf: Array[Transform3D] = []
	# ⚠️ 循环上**没有** `break`：`dens` 已经保证总量 ≤ CAP，
	# 再放一个 break 只会重新引入"尾部团没树"这个 bug，而且更难发现
	#（因为它永远不会触发 —— 于是它一旦触发就一定是有人改了别处）。
	for s in desert_oasis_sites:
		var cx := s.x
		var cz := s.y
		var radius := s.z
		var core := s.w
		var want := int(PI * radius * radius * dens * core)
		for k in want:
			# `sqrt(u)` = 圆盘上均匀；再乘 `u^0.22` 的偏置 ⇒ 往核心压一点。
			# 只压一点点（指数 0.22 很轻）：压狠了边缘会空成一条明显的环。
			# ⚠️ 最后乘 `DESERT_VEG_VISIBLE_R`：**把树约束在"地上真看得见绿"的范围内**。
			# 不乘的话最外那一圈（0.89~1.0 r）会有树、没草 —— 见那个常数的注释。
			var t := sqrt(rngt.randf()) * pow(rngt.randf(), 0.22) * DESERT_VEG_VISIBLE_R
			var ang := rngt.randf() * TAU
			var wx := cx + cos(ang) * t * radius
			var wz := cz + sin(ang) * t * radius
			var h := rngt.randf_range(DESERT_TREE_H_MIN, DESERT_TREE_H_MAX)
			# ⚠️ 横向 ±14% 的非均匀：全等比的话整片树是"同一个模型复制粘贴"，
			# 从 300 m 低空看过去像一片整齐的锥子。
			var sw := h * rngt.randf_range(0.86, 1.14)
			var b := Basis().rotated(Vector3.UP, rngt.randf() * TAU)
			b = b.scaled(Vector3(sw, h, sw))
			# 树根**沉 1.5 m**：让树干底部埋进沙里，不出现"树浮在丘面上"的缝。
			xf.append(Transform3D(b,
				Vector3(wx, _desert_dune_height(wx, wz) - 1.5, wz)))
	desert_tree_xf = xf
	if xf.is_empty():
		return
	# 单独建一份材质（不走 `_city_material` 的缓存）：那张缓存的键是
	# `颜色|自发光|能量`，语义是"城市那套"，借过来会让将来的调参找不到落点。
	var mat := StandardMaterial3D.new()
	mat.albedo_color = _sg(DESERT_TREE_ALBEDO)
	mat.roughness = 0.95
	mat.metallic = 0.0
	# ⚠️ 不投影：38k 个实例进阴影 pass 的代价与收益完全不成比例，
	# 而且阴天黄昏本来就没有一条像样的投影。
	_add_multimesh("DesertTrees", xf, mat, _desert_tree_mesh())


## 一块"巨岩"：椭圆底面的穹顶 + 竖向纹理，带三轴噪声。
## 艾尔斯岩真正的样子是"陡壁平顶的独石"，这里用"被压扁的穹顶 + 不均匀的侧壁"近似 ——
## 在这个尺度（2.6 km 长、500 m 高）下差异看不出来，但三角形数少一个数量级。
func _build_rock_ridge(node_name: String, center: Vector3, length: float, width: float,
		height: float, seed_val: int, grid_n := 34) -> void:
	var noise := FastNoiseLite.new()
	noise.seed = seed_val
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX
	# ---- ⚠️ 2026-09-23（批 H · 轮 3）：`frequency` 从 0.010 改成 1.0，跨度按格距算 ----
	#
	# 旧写法是 `frequency = 0.010` 配 `get_noise_2d(u * 640.0, v * 640.0)`：
	# 有效周期数 = 640 × 0.010 = **6.4 个** —— 而这是**跨整个巨岩**的 6.4 个起伏，
	# 也就是说 6 km 长的 Uluru 侧壁上只有 6 个大鼓包。格距 176 m，
	# 于是"风化细节"在数学上根本不存在，实拍就是**一块光滑的多面体**。
	#
	# 现在把 frequency 归到 1.0，让**输入的跨度直接等于"要跨多少个主波长"**，
	# 而那个数按这块岩体自己的格距算（见下面的 `n_u` / `n_v`）—— 于是同一个函数
	# 服务 10 格的小岩块与 72 格的巨岩时，风化细节都落在各自网格**恰好能表达**的尺度上。
	noise.frequency = 1.0
	noise.fractal_octaves = 3

	var N := maxi(grid_n, 6)
	# 这块岩体的世界跨度与格距。
	var span_m := maxf(length, width)
	# ⚠️ 主波长必须是一个**世界米数**，而 X / Z 两个方向各自换算成"跨几个周期"
	#（第一版把同一个周期数同时喂给 u 和 v，见下面 `n_u` / `n_v` 的注释）。
	#
	# ⚠️ 主波长取 **8 格**：奈奎斯特下限是 2 格，而 `fractal_octaves = 3`
	# 会让最细那一层 = 主波长 / 4。取 4 格时最细层正好落在 **1 个格距**上 ——
	# 那是**违反奈奎斯特**的，实拍就是岩壁上糊了一层"揉皱的纸"（木纹状走样）。
	# 取 8 格 ⇒ 三层分别是 8 / 4 / 2 格，最细一层正好压在奈奎斯特上。
	#
	# ⚠️ 格距用**最大**那个方向：`N-1` 段要摊满长边（6000 m）也要摊满短边（2600 m），
	# 长边的格距天生比短边粗 —— 按粗的那个定波长，两个方向才都不会走样。
	var cell_max := span_m / float(maxi(N - 1, 1))
	var wl_main := maxf(cell_max * 8.0, 1.0)
	var n_u := length / wl_main
	var n_v := width / wl_main
	# 侧壁的**放射状风化沟**条数。Uluru 最标志性的外观就是那些竖沟，
	# 而它们在穹顶上天然是"从中心放射"的方向（等高线是椭圆 ⇒ 放射方向就是竖向）。
	# 条数跟尺寸走：小岩块 2 条（再多就被切成薯条），巨岩 12 条。
	# ⚠️ 除数 500（不是 250）：`1 - |sin|` 的每个半周期就是一道沟，
	# 所以"视觉上的沟数"是 `grooves` 的两倍 —— 12 条 ⇒ 24 道沟，
	# 在 Uluru 的椭圆周长（约 14.5 km）上间距 605 m。再密就糊成木纹了。
	var grooves := clampi(int(round(span_m / 500.0)), 2, 14)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	# 平滑法线：巨岩是"高度场穹顶"，风化岩面本来就没有硬棱。
	#（为什么这一行必须有 —— 见 `_make_ground_mesh()` 里那段长注释。）
	st.set_smooth_group(0)
	var verts: Array = []
	var hs: Array = []
	for j in N:
		for i in N:
			var u := float(i) / float(N - 1)
			var v := float(j) / float(N - 1)
			var x := (u - 0.5) * 2.0
			var z := (v - 0.5) * 2.0
			# `d` = **归一化半径**（0 中心 → 1 椭圆边界）。
			# ⚠️ 平面形状本来就是**椭圆**（顶点是 (x·长/2, z·宽/2) 且 x²+z²≤1），
			# 所以"俯瞰是椭圆"这一条本来就满足 —— 错的是**侧面剖面**：
			# 原来用 `(1-d)^0.62`，那是个圆包，不是用户要的梯形体。
			var d := clampf(sqrt(x * x + z * z), 0.0, 1.0)
			# ⚠️ **u 和 v 要各自换算** —— 这是第一版"木纹"的根因：
			# 当时 `n_span` 是"长边跨几个周期"，却被同时喂给 u 和 v，
			# 而 u 沿 X 铺满 6000 m、v 沿 Z 只铺 2600 m ⇒ 同一个周期数在
			# **X 方向的波长是 Z 方向的 2.3 倍** ⇒ 噪声被单向拉伸，
			# 岩壁上出现一片**木纹/大理石纹**（实拍确认）。
			# 换成"世界波长相同"之后，两个方向的各向异性就没了。
			var n := noise.get_noise_2d(u * n_u, v * n_v) * 0.5 + 0.5
			# ---- **80° 斜边的梯形体**（1.2 用户给的形状规格）----
			#
			# 斜边的**物理**含义：水平退距 = 高度 / tan(80°) ≈ 0.176 × 高度。
			# 换算到"归一化半径"单位：该角度上的椭圆半径近似为 (长+宽)/4（米），
			# 于是退距的归一化长度 = 退距 / 该半径。内侧 (1-d) 大于它就进入**平顶**。
			# 结果：中心是平的、外围是一圈 80° 的斜坡 —— 这正是 Uluru 的剖面。
			var side_m := height / tan(deg_to_rad(MESA_SLOPE_DEG))
			var radius_m := maxf((length + width) * 0.25, 1.0)
			var side_n := maxf(side_m / radius_m, 1e-4)
			var t := clampf((1.0 - d) / side_n, 0.0, 1.0)
			var h := t * height
			# 顶面给一点起伏（完美的几何体反而假），并且在斜坡上叠一点噪声做风化。
			h += (n - 0.5) * height * (0.05 + 0.05 * (1.0 - t))
			# ---- 放射状风化沟（轮 3）----
			#
			# ⚠️ 沟只刻在**侧壁**上（`(1.0 - t)` 加权）：平顶上 `t = 1` ⇒ 权重 0。
			# 这一条同时顺手解决了"`d → 0` 时角向频率发散"的问题（中心正是 t=1），
			# 所以**不需要**额外的半径保护。
			#
			# ⚠️ `grooves` 必须是**整数**：这样 `sin(θ · grooves)` 在 θ 从 +π 跳回 −π
			# 处的相位差是 `grooves · 2π`，函数值连续 ⇒ **不会留下一条接缝**。
			# 用 `(n - 0.5) * 3.0` 扰动相位，免得 24 条沟像齿轮一样规整。
			#
			# 幅度 3% 高度：Uluru 是 1200 m ⇒ ±36 m 的沟，在 80° 斜壁上就是明暗分明的竖纹；
			# 再大就会把"陡壁平顶"的轮廓啃出缺口。
			var th := atan2(z, x)
			# ---- ⚠️ 沟形用 `1 - |sin|`（凹槽），**不是** `sin`（波浪）----
			#
			# 第一版直接叠 `sin`，实拍出来是**一层木纹/大理石纹** ——
			# 对称的正弦在视觉上读成"波纹"，而侵蚀沟是**只凹不凸**的。
			# `1 - |sin|` 在每个半周期给出一道"尖底宽口"的槽：只减不加，
			# 岩壁轮廓因此是"被啃出来的"而不是"被揉出来的"。
			#
			# `grooves` 是正整数 ⇒ `sin(θ·grooves)` 在 θ 从 +π 跳回 −π 处连续，不留接缝。
			# 相位带 `(n − 0.5) × 2.2` 的噪声扰动：沟位前后摆动，免得像齿轮一样规整。
			#
			# 幅度 5.5% 高度 = 66 m（Uluru）：80° 斜壁的水平退距只有 212 m，
			# 66 m 的深槽足以让每一道沟在月光下拥有自己的亮面与暗面。
			# ⚠️ 用 `absf()` 而**不是** `abs()`：GDScript 的 `abs()` 是"通用数学函数"
			#（对 int / float / Vector2… 都能用），返回类型是 **Variant** ⇒
			# `var gs := abs(...)` 会触发 "type is being inferred from a Variant value"
			# 警告，而本工程把警告当错误 ⇒ **整份脚本编不过**。
			# 症状极具误导性：探针照样"截图成功"，只是截到的是一张纯色空屏
			#（`main.gd` 因为脚本加载失败而没有建世界），而日志里 `SHADER ERROR = 0`
			# —— 只看 shader 错误数是完全看不出来的（批 H · 轮 3 实测踩到）。
			var gs := absf(sin(th * float(grooves) + (n - 0.5) * 2.2))
			h -= (1.0 - gs) * height * 0.055 * (1.0 - t)
			verts.append(Vector3(x * length * 0.5, maxf(h, -height * 0.04), z * width * 0.5))
			hs.append(h)
	for j in N - 1:
		for i in N - 1:
			var i0 := j * N + i
			var i1 := i0 + 1
			var i2 := i0 + N
			var i3 := i2 + 1
			_tri(st, verts, hs, i0, i2, i1)
			_tri(st, verts, hs, i1, i2, i3)
	st.generate_normals()

	var mat := _terrain_material(Color.WHITE, LAND_ROUGH, true, LAND_SPECULAR, 1.30, 320.0,
		0.85, 3.4, 0.15, 0.0, MOTTLE_ROCK, MOTTLE_ROCK_LEN)
	# **双面渲染**（1.2 用户实测："从空中顶上看是可以看到山体内部的"）。
	#
	# 这块岩体是一个 `SurfaceTool` 建的**开放曲面**（只有上表面与侧壁，没有底面），
	# 于是只要任何一处三角形的绕序/法线与视线反向，背面剔除就会把它剔掉 ——
	# 从上方看进去，正好看到远侧那些**朝内**的侧壁，也就是"山体内部"。
	# 与其去逐块修绕序（那要看 `_tri()` 与网格生成的约定，容易越修越偏），
	# 直接关掉剔除：**任何朝向的面都会画出来**，这个症状从根上不可能再出现。
	# 代价只是这块岩体多画一倍三角形（它只有 ~5k 面，可忽略）。
	#
	# ⚠️ 第十四轮换成 `terrain.gdshader` 之后，"关剔除"不再是这里的一个属性，
	# 而是那份 shader 的 `render_mode cull_disabled` —— **整个地表都关着**。
	# 地表网格一共只有一万多个三角形，而且海面 shader 本来就是 cull_disabled，
	# 所以这不是新特例；但"地表也不剔背面"是这次换材质带来的副作用，记在这里。
	var body := StaticBody3D.new()
	body.name = node_name
	body.collision_layer = FlightBody.WORLD_LAYER
	body.collision_mask = 0
	body.position = center
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	mi.material_override = mat
	body.add_child(mi)
	var col := CollisionShape3D.new()
	body.add_to_group("avoidance_ground")
	col.shape = mi.mesh.create_trimesh_shape()
	body.add_child(col)
	_terrain_root.add_child(body)


# ------------------------------------------------------------ 靶场（训练模式）

## 夜里的废墟靶场。地表是平的沥青，重点在"看得清靶子"：
##   - 三个**地面靶环**：同心圆环 + 靶心，自发光，夜里一眼看得见；
##   - 一圈**废墟墙**：给低空机动一点参照物与遮挡（也是撞上去会死的东西）；
##   - 四座**探照灯塔**：塔顶自发光 + 光晕，给场地立起垂直方向的锚点。
func _build_range() -> void:
	# 靶场要"看得清靶子"：地表比沙漠暗一档，但也不能黑到看不见地上的靶环
	# （靶环自己是自发光的，只要地面不是纯黑，环的对比度就够）。
	_land_dark = Color(0.115, 0.120, 0.135)
	_land_mid = Color(0.200, 0.205, 0.225)
	_land_light = Color(0.275, 0.280, 0.300)
	_build_ground_plane(Color(0.175, 0.180, 0.200))

	# ---- ⚠️ 轮 1：同一个病（与沙漠完全一致）----
	# 旧版 `frequency 0.014` × 抽象坐标 0..700 ⇒ 9.8 个周期摊在 101.2 km 上
	# ⇒ **每个"铺装起伏"有 10 km 长**；再配 56 段的格距（1807 m ⇒ λ ≥ 3614 m），
	# 实拍就是"数学意义上的平板 + 一点几乎看不出的缓坡"。
	# 靶场的设定是"看得清靶子"，所以它**就该平** —— 但不该是数学意义上的平：
	# 真实铺装面有浇筑板块的起伏，也有骨料级的颗粒。
	#
	# ---- ⚠️ 2026-09-23（批 I · 轮 4 跨图标定）：两层全部收进几何能力之内 ----
	#
	# 旧写法是「板块 λ 1600 m（octaves 2 ⇒ 最细 800 m）」+「骨料 λ 400 m」，
	# 当时的注释写着"第二层超出几何能力、交给 shader 的法线扰动"。
	# 那句话**半对半错**：它想说的分工是对的，但"塞进高度函数"这件事本身是错的 ——
	# `RANGE_SEG = 160` ⇒ 格距 632 m ⇒ 奈奎斯特 **1265 m**，
	# 而 800 m 与 400 m **都在它之下**：逐顶点采样得到的不是 400 m 的骨料，
	# 是"相邻顶点各自一个随机值"的**走样**。真正交给 shader 的那一层必须是
	# 「**不写进高度函数**」的，写进去了就已经在网格上生效了，撤不回来。
	#
	# ⇒ 现在：板块 λ 1600 m（octaves 1）留在几何里，骨料整层删掉，
	#   由 `detail_wavelength = 250` 的五层倍频接手（它最细到 250/256 ≈ 1 m，
	#   而且不受网格密度限制）。
	var plate := FastNoiseLite.new()
	plate.seed = 5501
	plate.noise_type = FastNoiseLite.TYPE_SIMPLEX
	plate.frequency = 1.0 / 1600.0
	# ⚠️ octaves 2 → 1：第二层 800 m = 1.27 格，在奈奎斯特之下（同上）。
	plate.fractal_octaves = 1
	var fn := func(u: float, v: float) -> float:
		# 靶场要平：总起伏压在 ±3.5 m（"不那么像一张塑料板"，又不至于让靶环歪掉）
		var x := (u - 0.5) * TERRAIN_DETAIL_SIZE
		var z := (v - 0.5) * TERRAIN_DETAIL_SIZE
		# 删掉骨料项**不改均值**（simplex 零均值），只去掉一层走样抖动 ——
		# 幅度从 ±3.5 m 收到 ±2.6 m，正好是"更平"这个方向，与靶场设定一致。
		return 3.0 + plate.get_noise_2d(x, z) * 2.6
	var made: Array = _make_ground_mesh(TERRAIN_DETAIL_SIZE, RANGE_SEG, fn)
	var mi := MeshInstance3D.new()
	mi.name = "Pad"
	mi.mesh = made[0]
	mi.material_override = _terrain_material(Color.WHITE, LAND_ROUGH, true, LAND_SPECULAR, 0.70, 250.0,
		0.55, 1.7, 1.05, 0.0, MOTTLE_RANGE, MOTTLE_RANGE_LEN)
	_terrain_root.add_child(mi)

	# ---- 三个地面靶环 ----
	var targets := [Vector3(0, 0, 0), Vector3(8280, 0, -5980), Vector3(-7360, 0, 7130)]
	for i in targets.size():
		_build_target_ring("TargetRing%d" % i, targets[i], 900.0 - float(i) * 120.0)

	# ---- 废墟墙 ----
	# 1.2.3 批 G：给它们**混凝土立面**（窗格）。理由不是"好看"，是**读得对**：
	# 一段 140~620 m 宽、90~380 m 高的纯色方块，玩家只会读成"一堵墙"；
	# 带上窗格之后它才读成"一栋被毁掉的楼"——而废墟**本来**就是楼的残骸。
	# 这是全工程最省的一处观感改动：沙漠与靶场两张图的地标级参照物，
	# 一次材质替换（零新增几何、零新增 draw call —— 材质仍按颜色+类别缓存）。
	# ⚠️ 抽取顺序**逐字保持**（r → h → 尺寸 x → 尺寸 z → 朝向 → 两个倾角）：
	# `_rng` 是整张图共享的一条序列，这里换一下顺序，16 段废墟的长宽高就全部平移。
	# 把中间量记下来只是为了让下面的破损细节能拿到它们，**没有**多抽也没有少抽。
	var ruins: Array = []
	for i in 16:
		var a := float(i) / 16.0 * TAU + 0.21
		var r := _rng.randf_range(5520.0, 27600.0)
		var h := _rng.randf_range(90.0, 380.0)
		var rpos := Vector3(cos(a) * r, h * 0.5, sin(a) * r)
		var rsize := Vector3(_rng.randf_range(140.0, 620.0), h, _rng.randf_range(60.0, 160.0))
		var ryaw := _rng.randf_range(0.0, 180.0)
		var rtilt := _rng.randf_range(-4.0, 4.0)
		var rroll := _rng.randf_range(-5.0, 5.0)
		_add_block("Ruin%d" % i, rpos, rsize,
			Color(0.18, 0.19, 0.21), ryaw, rtilt, rroll,
			Color(0, 0, 0, 0), Facade.CONCRETE)
		ruins.append({"pos": rpos, "size": rsize, "yaw": ryaw})
	_ruin_damage(ruins)

	# ---- 探照灯塔 ----
	# 塔身走**工业金属**（metallic 0.40 / rough 0.46）：钢构塔在月光下该有一点金属反光，
	# 而灯罩（`Lamp`）自己**带自发光** —— 那条路径在 `_add_block()` 里是"自发光优先"，
	# 所以灯罩仍然走原来的纯色材质，不会因为这次改动丢掉那点光。
	for i in 4:
		var a := float(i) / 4.0 * TAU + 0.6
		var p := Vector3(cos(a) * 15640.0, 0.0, sin(a) * 15640.0)
		_add_block("Tower%d" % i, p + Vector3(0, 210.0, 0), Vector3(70.0, 420.0, 70.0),
			Color(0.21, 0.22, 0.25), 0.0, 0.0, 0.0, Color(0, 0, 0, 0), Facade.METAL)
		_add_block("Lamp%d" % i, p + Vector3(0, 450.0, 0), Vector3(56.0, 56.0, 56.0),
			Color(1.0, 0.96, 0.82), 0.0, 0.0, 0.0, Color(1.0, 0.93, 0.72))


## 废墟的**破损细节**（1.2.3 批 H · 轮 3）。
##
## ## 为什么不是"再加几个盒子"
## 破损要能让一段残墙读成"**一栋塌掉的楼**"，而不是"一堵矮墙"。三件各解决一件事：
##   ① **顶部残块** —— 断口。方盒的顶面是一条笔直的水平线，那是全图最"新"的一笔；
##      让残块在顶上错开、带点倾角，轮廓立刻变成"被扯断的"；
##   ② **斜靠板** —— 倒下的楼板。它给出**方向性**（塌向哪一边）与**时间感**；
##   ③ **基座碎石** —— 堆积。它同时是近景的**尺度参照**：贴地掠过去能读出速度。
##
## ## ⚠️ 绝不碰 `_rng`
## `_rng` 是整张图共享的一条序列（在 `_map_stage_terrain()` 里种下 20260917）。
## 在这里多抽一次，16 段废墟**之后**的所有 `_rng` 消费者全部平移 ——
## 症状是"整张图变了样"，而根因在几百行之外。铁律的出处见 `_city_block_at()` 桅杆那段。
##
## 这里用**按序号派生的局部序列**：种子 = `9100 + i × 7919`（质数步长 ⇒ 相邻两段
## 完全不同），于是每段废墟的破损**可复现、互不相同、且与 `_rng` 无关**。
##
## ## ⚠️ 偏移必须跟着楼体一起转
## 楼是绕 Y 转过 `yaw` 的，所以"朝墙外偏 40 m"在世界里不是一个固定方向。
## 先把局部 +X / +Z 换算到世界方向（`xa` / `za`），再按局部量给偏移 ——
## 否则斜靠板会浮在半空、碎石会跑到墙外面去（和"父节点重复加偏移"是同一类错）。
func _ruin_damage(ruins: Array) -> void:
	for i in ruins.size():
		var r: Dictionary = ruins[i]
		var pos: Vector3 = r["pos"]
		var size: Vector3 = r["size"]
		var yaw: float = r["yaw"]
		var lr := RandomNumberGenerator.new()
		lr.seed = 9100 + i * 7919
		# 楼基（地面上的一点）—— 后面的偏移都以它为原点。
		var ground := Vector3(pos.x, 0.0, pos.z)
		# 楼体绕 Y 转 `yaw` 之后，局部 +X / +Z 在世界里的方向。
		var cy := cos(deg_to_rad(yaw))
		var sy := sin(deg_to_rad(yaw))
		var xa := Vector3(cy, 0.0, -sy)
		var za := Vector3(sy, 0.0, cy)

		# ---- ① 顶部残块：横向偏出去一截（"没倒干净的那半层"）+ 一点倾角 ----
		var cw := size.x * lr.randf_range(0.26, 0.52)
		var cd := size.z * lr.randf_range(0.60, 1.04)
		var ch := size.y * lr.randf_range(0.07, 0.17)
		var cox := size.x * lr.randf_range(0.14, 0.32) * (1.0 if lr.randf() < 0.5 else -1.0)
		var coz := size.z * lr.randf_range(-0.12, 0.12)
		_add_block("Ruin%d_Crown" % i,
			ground + xa * cox + za * coz + Vector3(0.0, size.y + ch * 0.42, 0.0),
			Vector3(cw, ch, cd), Color(0.17, 0.18, 0.20), yaw,
			lr.randf_range(-9.0, 9.0), lr.randf_range(-7.0, 7.0),
			Color(0, 0, 0, 0), Facade.CONCRETE)

		# ---- ② 斜靠板：一面塌下来的楼板斜倚在残墙上 ----
		# ⚠️ 倾角给在 **Z 轴**（`roll`）而不是 X 轴：楼板的长边是局部 X，
		# 绕 Z 转才会"整片板朝墙外倒"；绕 X 转只让板前后点头（看起来像立在原地）。
		var sw := size.x * lr.randf_range(0.42, 0.78)
		var sh := size.y * lr.randf_range(0.42, 0.72)
		var ssign := 1.0 if lr.randf() < 0.5 else -1.0
		var lean := deg_to_rad(lr.randf_range(52.0, 74.0))   # 从竖直到倒下的夹角
		# 板心：从墙面往外挪半个板的水平投影，高度是半个板的垂直投影（+ 一点入土）。
		var sx := size.x * 0.5 + sh * 0.5 * sin(lean)
		_add_block("Ruin%d_Slab" % i,
			ground + xa * (ssign * sx) + Vector3(0.0, sh * 0.5 * cos(lean) + 8.0, 0.0),
			Vector3(sw, sh, 16.0), Color(0.165, 0.175, 0.195), yaw,
			0.0, rad_to_deg(lean) * ssign,
			Color(0, 0, 0, 0), Facade.CONCRETE)

		# ---- ③ 基座碎石：两三块落在墙根 ----
		# 只有两块：再密就从"堆积"变成"地毯"，而且每块都是一个 `StaticBody3D`。
		for k in 2:
			var rw := lr.randf_range(14.0, 34.0)
			var rh := lr.randf_range(8.0, 20.0)
			var rox := size.x * 0.5 * lr.randf_range(1.02, 1.45) * ssign
			var roz := size.z * lr.randf_range(-0.9, 0.9)
			_add_block("Ruin%d_Rubble%d" % [i, k],
				ground + xa * rox + za * roz + Vector3(0.0, rh * 0.42, 0.0),
				Vector3(rw, rh, rw * lr.randf_range(0.6, 1.2)),
				Color(0.16, 0.17, 0.19), yaw + lr.randf_range(-40.0, 40.0),
				lr.randf_range(-14.0, 14.0), lr.randf_range(-18.0, 18.0))


## **奥恩贝利夜城**（1.2 第二十一轮 · **第二十二轮精细化**）。
##
## ## 玩法目标
## 前几张图的看点是"贴地/贴海低飞"，城市图换成**贴楼低空缠斗**：
## 楼是实心的（`WORLD_LAYER` 碰撞），撞上去要掉血 —— 所以"从楼缝里穿过去"
## 是一个真的选择，而不是装饰。**楼必须在竞技场尺度下真的挡路**才会产生这种张力。
##
## ## 第二十二轮：为什么重做（老板："建模太粗糙了"）
## 第一版是**一张均质方盒网格**（16×16 个盒子，高矮随机）。工程上没错，
## 但它读起来是三件东西都不像城市：
##   ① **没有城市**——一块平板上的 256 个抽屉，没有海岸线、没有水系、
##      没有公园/广场/低层住宅的分区，俯瞰读不出"这是座城市"；
##   ② **没有建筑**——每栋楼只有一个长方体，没有裙房、没有退台、没有屋顶机房，
##      低空贴楼飞的时候满屏都是同一个盒子；
##   ③ **没有地标**——中间一根柱子当"识别物"，看不出是哪座城。
##
## 现在的做法：**平面照抄台场（お台場）**，竖向按玩法尺度放大。
##
## ## 参考：台场的城市结构（原作的设定依据）
## 台场是东京湾里的一片**填海造陆的岛**，所以它的城市骨架是：
##
## | 要素 | 台场的实际结构 | 在这张图里 |
## |---|---|---|
## | 水域 | 东京湾 + 一条把商业区切开的人工运河（潮风公园一侧） | **海湾**（+Z 那一侧）+ **运河**（+X 一侧，穿城） |
## | 桥 | 彩虹桥：双层桁架 + 两座主塔，跨东京湾连芝浦 | **彩虹桥**：跨海湾的唯一通路，桥下 560 m 可飞 |
## | 媒体 | 富士电视台本社：两栋塔楼 + 顶部**球体**瞭望室 + 格子外框 | **富士台大楼**（球体是真的球） |
## | 会展 | 东京 Big Sight：四栋塔楼 + **倒金字塔**会议楼 | **会展中心**（塔楼 + 倒锥） |
## | 商业 | DiverCity / Aqua City 一带 + 1:1 高达立像 | **商业裙房 + 地面停车场**（立像 2026-09-28 拆除，见 `_city_parking_lot`） |
## | 交通 | 百合海鸥号单轨（高架环线） | **高架单轨**：420 m 高的梁，可以从底下穿 |
## | 分区 | 北侧商务高层、中部商业/公园、南侧低层 | 四圈分区：downtown / midtown / fringe / waterfront |
##
## ## ⚠️ 尺度：**平面用真实比例，高度用玩法比例**
## 真实台场约 3 km 见方，而竞技场半径 28 km —— 平面必须拉伸。
## 所以：**平面照抄台场的地理关系**（海湾在一侧、运河南北贯通、桥跨湾、
## 地标各就各位），**高度不照抄**（真楼 100~250 m，在 28 km 的竞技场里
## 连一颗石子都不算，贴楼缠斗会变成"在平地上飞"）。
## 竖向按 `ARENA_RADIUS / 3300` ≈ 8.5 倍放大：
## - 商务高层 300 m → 2500 m（市中心最高一档）
## - 彩虹桥主塔 126 m → 1070 m，桥面 52 m → 560 m（**可以从桥下穿过去**）
## - 富士台大楼 123 m → 1050 m，球体直径 32 m → 270 m
## - 停车场车位 2.5 × 5.3 m → 55 × 90 m，车 4.6 × 1.8 × 1.45 m → 40 × 18 × 14 m
##   （同一条 8.5 倍法则；立像 19.7 m → 170 m 的那一档已随立像一起拆掉）
##
## ## ⚠️ 楼数要克制（第一版的血泪）
## 256 栋楼 = 256 个 `StaticBody3D` + 256 份 `BoxMesh`/材质。再密就是几百个
## draw call 与几百个静态体，夜里也看不见更多东西。
## 所以第二十二轮的分工是：
## - **有碰撞的主体**（结构 / 裙房 / 低层 / 地标）走 `_add_box()`：
##   仍是每块一个 `StaticBody3D`，但共用**一个单位立方体网格 + 一个单位 BoxShape3D**
##   （尺寸烘进各自的 `CollisionShape3D` 局部变换），于是不再有几百份几何资源；
## - **纯装饰**（窗带 / 路灯 / 屋顶设备 / 树 / 路面 / 桥索）一律 MultiMesh，
##   **一次 draw call**、**不进碰撞层**。
## ⚠️⚠️ 2026-09-27（达沃重制）：16 → **36**。**格距 4025 m 一个字没改**
##（`ARENA_RADIUS / CITY_GRID = 144 900 / 36 = 4025`，与旧的 `64 400 / 16` 逐位相同）——
## 于是奥恩贝利的**楼 / 街 / 广场绝对尺寸全部不变**，变的只有"能装多少格"。
##
## ## 为什么必须加格数（而不是加格距）
## 见 `ARENA_RADIUS` 那段 ⚠️⚠️：`cblock` 是城市要素绝对尺寸的分母；
## 而块网格半宽 = `CITY_GRID / 2 × 格距`，岛必须落在里面。
## 达沃的岛北缘 70 035 m ⇒ `CITY_GRID ≥ 34.8` ⇒ 取 36。
##
## ## ⚠️ 连带项（改这个数**必须**一起看的两处）
## 1. `CITY_SHAPE[·].zone_hf` —— `city_lot_for()` 的**分区归一化半宽**。
##    它以前就写作 `CITY_GRID * 0.5`（= 8），**恰好是奥恩贝利岛的半宽 7.9 格**。
##    这一轮 `CITY_GRID` 变成 36 ⇒ 那个表达式会变成 18 ⇒ `d` 整体缩到 1/2.25，
