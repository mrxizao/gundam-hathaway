	# 原来是写死的 0.0）：地形起伏 ±7.9 m，1050 m 高的富士台无所谓，但
	# 停车场的 `ParkDeck` 只有 20 m 厚 —— 落在 7.9 m 的洼地上会**浮空 7.9 m**
	#（俯视图看得见）。
	#
	# ⚠️⚠️ 2026-09-28：**① 自由女神那一座已删**（用户「把自由女神删了」），
	# 而 `(-4, 6)` 这一格**仍然占着**（用户在追问里选了「**保持空地**」——
	# 那一格现实里是台场海滨公园的位置，本来就不长楼）。
	# ⇒ 它现在**没有任何几何**，是本函数唯一"占格但不建东西"的一格；
	#   剩下四座（富士台 / 停车场 / 会展 / 中央塔）与格表逐一对应。
	#
	# ⚠️ 节点名一个都没变（`FujiShaft*` / `ParkDeck` / `BigSightTower*` /
	# `LandmarkTower` / `LandmarkCrown`）—— 探针的 `--aim=<前缀>` 与
	# `suite_gfx_map` 的"节点存在"断言都按名字找，改名 = 静默失去两处取证。
	#   ⚠️ 删掉的 `Liberty*` 前缀同理：原来按它取证的两处（`_r5_shots.gd` 的 S7
	#   机位、详规 §I 判据 #4）**一起作废**，不是改名。
	_city_fuji_tv(_city_cell_center(-3, 1))              # ② 主岛中部
	_city_parking_lot(_city_cell_center(4, 2))           # ③ 原立像位
	_city_big_sight(_city_cell_center(-12, -3))          # ④ 有明块内
	# ⑤ 中央地标塔：主岛最内陆（`gz = -5` 那一排），比周围高楼再高一档 ——
	# 它是"回到市中心"的锚点（第一版的遗留设计，保留）。
	# ⚠️ 塔顶那颗橙灯（`LandmarkBeacon`）**已删**：死城不点灯。
	# 但这不削弱它当锚点的能力 —— 顶冠（`LandmarkCrown`）的剪影本身就是识别物。
	# ⚠️ 2026-09-27：高度 **2800 → 3800 m**。理由：这一轮加了 ±24% 的格点噪声
	#（`city_lot_for`），奥恩贝利市中心的**最高**一栋可以到 ~3965 m，
	# 而那超过了原来 2800 的锚点塔 —— "最高的那根柱子"这个身份就没了。
	# 3800 保证它仍全城最高（典型市中心 ~2265 m，离它还有一大截）。
	var tc := _city_cell_center(0, -5)
	_add_box("LandmarkTower", tc + Vector3(0.0, 1900.0, 0.0),
		Vector3(1150.0, 3800.0, 1150.0), Color(0.100, 0.104, 0.120), 0.0)
	_add_box("LandmarkCrown", tc + Vector3(0.0, 3860.0, 0.0),
		Vector3(420.0, 120.0, 420.0), Color(0.090, 0.095, 0.112), 0.0)
	_city_body_count += 2


## 达沃的三座地标：**双塔连船 / 针塔 / 集装箱港区**（设计书 §3.2）。
##
## 母题是「**一个有迪拜塔的新加坡**」：金沙 ↔ 双塔连船、迪拜塔 ↔ 针塔、
## 新加坡港 ↔ 集装箱港区。
##
## ⚠️ 三座的位置**全部由格坐标算出来**，不写死米数 —— 它们必须与
## `_city_landmark_cell(gx, gz, DAVAO)` 占掉的那几格对齐，
## 否则会出现"楼长在地标旁边""地标站在别人的地基上"这类荒唐（而且不报错）。
func _build_city_landmarks_davao() -> void:
	var cblock := ARENA_RADIUS / float(CITY_GRID)
	# ① 双塔连船：格 (-5,-3) 到 (-3,-3)，**横着排成一条线**（顶上的船要横跨三塔）
	var cz := (-3.0 + 0.5) * cblock
	var sands: Array[Vector3] = []
	for gx in [-5, -4, -3]:
		# ⚠️ y 取该点地形（2026-09-27）：三塔的**底面**必须落在格子的地面上，
		# 否则在凹凸地形上会浮空/陷进去（塔基是 ~1 000 m 见方，偏个几米看得出来）。
		var sx0 := (float(gx) + 0.5) * cblock
		sands.append(Vector3(sx0, _city_landform(sx0, cz, map.city_layout), cz))
	_city_sands(sands)
	# ② 针塔：与 `_city_landmark_cell(0, -1, DAVAO)` 占掉的那一格**对齐**
	#（本函数自己的注释就要求"三座的位置全部由格坐标算出来，不写死米数"）。
	# ⚠️ 2026-09-27 修：旧代码写的是 `-CITY_PLAZA_R * 0.30` —— 那是**奥恩贝利
	# 的广场半径**，而达沃的 `plaza_r = 0` ⇒ 塔落在**图心 (0,0)**，与它占掉的
	# 那一格（格心在 (0.5, −0.5) 格）差 2 km。楼不长在那儿所以看不出来，
	# 但"地标站歪了"这件事会一直留在代码里。
	_city_needle_tower(_city_cell_center(CITY_DAVAO_HOTEL_CELL.x,CITY_DAVAO_HOTEL_CELL.y))
	# ③ 集装箱港区：格 (4,1)~(5,2) 这 2×2 场的中心
	var port := Vector3(
		(float(4 + 5) * 0.5 + 0.5) * cblock, 0.0, (float(1 + 2) * 0.5 + 0.5) * cblock)
	port.y = _city_landform(port.x, port.z, map.city_layout)
	_city_container_port(port)


## **双塔连船**（金沙式）：三栋塔 + 顶上一艘横跨三塔的"船"。
##
## 真实比例：金沙三塔高约 200 m、单塔平面约 40 m ⇒ **高宽比 ≈ 5 : 1**；
## 顶上那条"船"长 340 m（≈ 塔高的 1.7 倍）。
##
## ## 1.3 批 M · 轮 2：塔身为什么是"倍率"而不是三个写死的米数
## 第一版只按"高度"放大了竞技场倍率（200 m → 2100 m），**宽度却留在 800 m** ——
## 于是塔身成了 2100 : 800 ≈ **2.6 : 1 的方墩**，而达沃全城的普通塔楼
##（`_city_block_at()`，约 3 : 1）几乎一样粗 ⇒ 地标在剪影里**读不出"细高"**，
## 只剩"三根柱子"。
## 现在两个方向都由 `MapDef` 给：`city_tower_w` 收窄平面、`city_height_mul` 拔高。
## 达沃取 0.62 / 1.15 ⇒ 496 m : 2415 m ≈ **4.9 : 1**，回到金沙的比例；
## 而**同一对倍率也作用在全城普通塔楼上** ⇒ "地标 vs 全城"的相对关系
## 由构造保证不变（不会出现"地标被普通楼淹掉"）。
##
## ## ⚠️⚠️ 2026-09-28 达沃 v2 · G4′（**改写 G4**）：宽度不再独立，改由高宽比反推
## G4 原来的做法是"`sands_mul = 2.1` **只乘 `h`**、不乘 `bw` / `bd`"，
## 理由写的是"高宽比上升 ⇒ `suite_gfx_map.gd:1006` 只会更绿"。**那个理由是错的**，
## 而且错在两处：
##   ① `:1006` 量的是场景里 **`Tower_*`** 那一族（`_nodes_prefixed(…, "Tower_")`），
##      而金沙三塔叫 **`SandsTower*`** —— **根本不在它的分母里**，
##      抬不抬 `h` 对它**一点影响都没有**（3 栋 vs 538 栋，本来就在噪声以下）。
##   ② 真正会被撞的是**另一条**：`suite_gfx_map.gd:1064`
##      `t.between(s_asp, 4.25, 5.75)` —— 那条**绑的是工程外的数**（真实金沙 5 : 1）。
##      实测：`4 410 / 496 = 8.89` ⇒ **当场红**。
## ⇒ 改成 **`bw := h / CITY_SANDS_ASPECT`**：形状由**构造**锁死，
## `sands_mul` 抬高度时宽度自动跟着 ⇒ 高宽比**恒为 5.00**，任何倍率都不会再撞那两条。
##（这条判据是**故意埋的绊线**，不是棘轮 —— 它的注释自己写着"红得有意义，
##  '三塔不再像金沙'本来就是该有人拍板的事"⇒ **不许放宽它**，只能让几何回到 5 : 1。）
##
## 顺带一条**独立**佐证（不依赖上面那条判据）：真实金沙 塔宽/船长 ≈ 40/340 ≈ **0.12**；
## 这张图船长 9 650 m ⇒ 塔宽应当在 ~1 160 m 量级。本式给 **1 014 m（0.105）**，
## 旧式只给 **496 m（0.051）** —— 也就是旧式让三根柱子**比真实金沙细了一半**。
##
## ⚠️ 一处**副作用**（有意接受）：金沙塔从此**不再乘 `city_tower_w`** ——
## 全城"瘦身"是普通楼的政策，而地标的三塔是**复刻真实金沙**的形状要求，
## 不该跟着全城一起变胖变瘦（船上其它件本来也没跟着它走）。
##
## ⚠️ 它是这张图**唯一的高速穿越通道**（设计书 §3.2 的玩法看点：
## "沿'船'底掠过"）：塔顶 `h`、"船"底 `h + 370` ⇒ **370 m 的净空槽**，
## 而塔与塔之间还留着 3.0 km 的横向空档。贴着这条槽飞过去是这张图的签名动作。
## ⚠️ 槽宽用**相对量**写（`h + 520` / 船厚 300）⇒ 槽永远是 370 m，
## 与 `h` 取多少无关 —— 这一轮把 `h` 从 2100 抬到 2415，**玩法参数一个字没动**。

## **金沙三塔的高宽比** = 真实金沙的 **5 : 1**。
## `suite_gfx_map.gd:1064` 的绝对量判据守的就是它 ⇒ 塔身宽度从 `h` 反推，
## 而不是给一个独立的米数（见 `_city_sands()` 上方 G4′ 那一段）。
const CITY_SANDS_ASPECT := 5.0
## 塔身平面 **宽 : 深**（与第一版的 800 : 640 同）—— 形状的第二条。
const CITY_SANDS_DEPTH_RATIO := 1.25


func _city_sands(cs: Array[Vector3]) -> void:
	var glass := Color(0.250, 0.268, 0.300)
	# ⚠️⚠️ 2026-09-28 v3（达沃 v2 · G2）：倍率从 `city_height_mul` 换成
	# **`sands_mul`**（地标专属）。原来走 `city_height_mul = 1.15` ⇒ 三塔只有
	# **2 415 m**，而实测 downtown 塔 **中位 3 505 / p90 5 039 / 最高 5 613**
	# ⇒ 地标**比市中心的中位楼还矮 31%**，连"船底那条 370 m 净空槽"（2 785 m）
	# 也埋在楼群里 —— 而"贴船底掠过"是这张图的**签名动作**。
	# ⇒ `sands_mul = 2.1` ⇒ **5 072 m**（> downtown p90，可识别）。
	# ⚠️ 宽度**不是**独立的一档数，而是**从 `h` 反推**（G4′，见函数上方整段）：
	# `bw = h / 5` ⇒ 高宽比恒 5.00，`sands_mul` 改多少都不会再撞 `:1064`。
	var h := 2100.0 * map.sands_mul
	var bw := h / CITY_SANDS_ASPECT               # 塔身平面（宽）—— 由高宽比反推
	var bd := bw / CITY_SANDS_DEPTH_RATIO         # 塔身平面（深）—— 宽:深 ≈ 1.25 同第一版
	for i in cs.size():
		var c := cs[i]
		# 塔身：金光里的三根细高柱（金沙的塔身是两片弯曲的板，这里用细高盒近似）
		_add_box("SandsTower%d" % i, c + Vector3(0.0, h * 0.5, 0.0),
			Vector3(bw, h, bd), glass, 0.0, 0.0, 0.0,
			Color(0, 0, 0, 0), Facade.GLASS)
		# 塔顶那一节外挑的观景层（金沙顶上那一段其实是**比塔身宽**的）——
		# 外挑量保持第一版的 1.275 倍宽 / 1.25 倍深，跟着塔身一起缩。
		_add_box("SandsProw%d" % i, c + Vector3(0.0, h + 120.0, 0.0),
			Vector3(bw * 1.275, 240.0, bd * 1.25), glass.darkened(0.08), 0.0)
		_city_body_count += 2
	# ---- 船：**船底由净空槽推出来**（1.3 批 M · 轮 5）----
	#
	# `belly` = "船底最下缘"的绝对高度 = 塔顶 + 370 m。**所有往下长的构件，
	# 底面一律落在这个高度上**（横肋 / 纵边梁 / 将来任何东西）——
	# 于是"槽永远是 370 m"是一道**构造保证**，不再是三个数字凑巧对上
	#（轮 5 之前船心写 `h + 520`、船厚写 300，370 是 520 − 150 反推出来的差）。
	var mid := (cs[0] + cs[cs.size() - 1]) * 0.5
	var span := absf(cs[cs.size() - 1].x - cs[0].x) + 1600.0
	var belly := h + CITY_SHIP_CLEAR
	# 船体板的底面**抬高一档**（`RIB_DROP`）：横肋要长在它下面。
	var plate_bot := belly + CITY_SHIP_RIB_DROP
	var ship_cy := plate_bot + CITY_SHIP_THICK * 0.5
	var ship_top := plate_bot + CITY_SHIP_THICK
	var hull := Color(0.300, 0.320, 0.350)
	_add_box("SandsShip", Vector3(mid.x, ship_cy, mid.z),
		Vector3(span, CITY_SHIP_THICK, 1500.0), hull, 0.0)
	# 船头：向 +Z 伸出去的那一截（真实金沙的"船头"悬挑出塔外 65 m）
	_add_box("SandsBow", Vector3(mid.x, ship_cy, mid.z + 1050.0),
		Vector3(span * 0.34, CITY_SHIP_THICK, 900.0), hull, 0.0)
	_city_body_count += 2
	# ---- ⑥ 船底纵边梁（轮 5）：两条沿船长全长的深梁，= 槽的"边线" ----
	#
	# 从槽里往前看，这两条长梁是画面里唯一**延伸到灭点**的参照物。
	# 没有它们的话，"天花板"与"城市"之间没有一条明确的分界，
	# 玩家会分不清自己是在槽里还是在楼群当中。
	for ki in 2:
		var sz := 1.0 if ki == 0 else -1.0
		_add_box("SandsKeel%d" % ki,
			Vector3(mid.x, belly + CITY_SHIP_KEEL_DROP * 0.5,
				mid.z + sz * (750.0 - CITY_SHIP_KEEL_W * 0.5)),
			Vector3(span, CITY_SHIP_KEEL_DROP, CITY_SHIP_KEEL_W),
			CITY_SHIP_RIB_ALBEDO, 0.0)
		_city_body_count += 1
	# ---- ⑦ 船底横肋（轮 5，MultiMesh 一次 draw call）----
	#
	# ⚠️ 横跨船宽（沿 Z）而不顺船长（沿 X）：理由见 `CITY_SHIP_RIB_DROP` 那段
	#（一道道横肋从头顶掠过才是速度感；与飞行方向平行的纵梁读不出位移）。
	# 肋长收到两条纵边梁之内（`- KEEL_W * 2`），免得肋梁端头从边梁下面戳出来。
	var ribs: Array[Transform3D] = []
	for k in CITY_SHIP_RIB_N:
		var rx := mid.x - span * 0.5 + 420.0 \
			+ float(k) * (span - 840.0) / float(CITY_SHIP_RIB_N - 1)
		ribs.append(_sized(
			Vector3(rx, belly + CITY_SHIP_RIB_DROP * 0.5, mid.z),
			Vector3(CITY_SHIP_RIB_W, CITY_SHIP_RIB_DROP,
				1500.0 - CITY_SHIP_KEEL_W * 2.0),
			0.0))
	_add_multimesh("SandsRibs", ribs,
		_city_material(CITY_SHIP_RIB_ALBEDO, Color(0, 0, 0, 0), 2.4))
	# ---- ⑨ 船顶甲板（轮 6）：把"一块素板"变成一座空中花园 ----
	#
	# ⚠️ 几何全部长在 `ship_top` **之上** ⇒ 与净空槽完全无关。
	# `belly` 管的是"往下最远能到哪儿"，这里做的是"往上"，
	# 所以这一整段**一个字都不会动玩法通道**（这正是轮 5 把槽宽提成上游常量换来的自由）。
	#
	# ⚠️ 不逐件复刻金沙的 SkyPark（泳池 / 餐厅 / 观景台 / 绿植……），
	# 只做三样**能给画面提供读数**的：
	#   ① 两侧女儿墙 —— 甲板的"边界"。没有它，俯视时分不清船的边在哪儿，
	#      而"船的边"恰恰是"沿船底掠过"这条玩法里最要紧的一条线；
	#   ② 沿船长的铺装板条 —— 平飞时的**方向读数**。
	#      注意它与船底横肋是**反着**的：船底用横肋读**速度**（一道道掠过），
	#      船顶用纵条读**方向**（与飞行方向平行，指向灭点）；
	#   ③ 泳池与绿岛 —— 打破"整块素板"的均匀度（俯视取证里唯一的问题）。
	var deck_y := ship_top
	var half_z := 1500.0 * 0.5
	for sz: float in [-1.0, 1.0]:
		_add_box("SandsParapet%d" % int(sz),
			Vector3(mid.x, deck_y + CITY_SHIP_DECK_PARAPET_H * 0.5,
				mid.z + sz * (half_z - CITY_SHIP_DECK_PARAPET_W * 0.5)),
			Vector3(span, CITY_SHIP_DECK_PARAPET_H, CITY_SHIP_DECK_PARAPET_W),
			CITY_SHIP_DECK_ALBEDO.darkened(0.10), 0.0)
		_city_body_count += 1
	var strips: Array[Transform3D] = []
	for k in 4:
		var sz2 := -half_z + 300.0 + float(k) * (1500.0 - 600.0) / 3.0
		strips.append(_sized(
			Vector3(mid.x, deck_y + CITY_SHIP_DECK_STRIP_UP * 0.5, mid.z + sz2),
			Vector3(span - 400.0, CITY_SHIP_DECK_STRIP_UP,
				CITY_SHIP_DECK_STRIP_W), 0.0))
	_add_multimesh("SandsDeckStrips", strips,
		_city_facade_material(CITY_SHIP_DECK_ALBEDO, Facade.CONCRETE, 0.0))
	# 泳池：中段一块下沉的深色面（真实 SkyPark 的泳池就在这个位置）
	_add_box("SandsPool", Vector3(mid.x, deck_y + 13.0, mid.z),
		Vector3(span * 0.44, 26.0, 700.0), CITY_SHIP_POOL_ALBEDO, 0.0)
	_city_body_count += 1
	# 绿岛：8 组，泳池两侧各 4 组（`k / 2` 是整数除法 ⇒ 每组两个岛分列两侧）
	var isles: Array[Transform3D] = []
	for k in 8:
		var side := 1.0 if (k % 2) == 0 else -1.0
		isles.append(_sized(
			Vector3(mid.x - span * 0.38 + float(k / 2) * (span * 0.76 / 3.0),
				deck_y + 45.0, mid.z + side * 520.0),
			Vector3(span * 0.055, 90.0, 380.0), 0.0))
	_add_multimesh("SandsSkyGarden", isles,
		_city_facade_material(CITY_SHIP_GREEN_ALBEDO, Facade.CONCRETE, 0.0))
	# 桅杆：两根，分列船长两端。⚠️ 这是**往上长**的，不受净空槽约束（见常量注）。
	for si in 2:
		var sx := 1.0 if si == 0 else -1.0
		_add_box("SandsMast%d" % si,
			Vector3(mid.x + sx * span * 0.30, deck_y + CITY_SHIP_MAST_H * 0.5, mid.z),
			Vector3(70.0, CITY_SHIP_MAST_H, 70.0), Color(0.620, 0.620, 0.645), 0.0)
		_city_body_count += 1
	# 船沿的灯带（"灯火"那一档里点名的"地标顶灯"）。
	# ⚠️ 位置算在**船顶之上 20 m**：船自身是不透光的实体，灯埋在板里就只是一块凸起。
	# ⚠️ 灯头尺寸同吊臂作业灯：用 `CITY_LAMP_DOT`（1.3 批 M · 轮 4）。
	# 第一版这里是 **110×36×110 m** —— 那是"沿船底掠过"这条通道上最大的一个灯头，
	# 250 m 处会摊成 350 px 的白板（整块盖住座舱视野）。理由见 `CITY_LAMP_DOT`。
	if map.city_lights != MapDef.CityLights.FULL:
		return
	var lights: Array[Transform3D] = []
	var n := 14
	var x0 := cs[0].x - span * 0.5 + 200.0
	for k in range(n):
		lights.append(_sized(
			Vector3(x0 + float(k) * (span - 400.0) / float(n - 1),
				ship_top + 20.0, mid.z),
			CITY_LAMP_DOT, 0.0))
	_add_multimesh("SandsShipLights", lights,
		_city_material(CITY_LAMP_ALBEDO, CITY_LAMP_EMISSION, CITY_LAMP_ENERGY))
	# ---- ⑩ 甲板景观灯（轮 6）：与船底是**同一个理由** ----
	#
	# ⚠️ 达沃的夜间环境光是**各向同性**的（`_davao_night()` 把 `sky_contribution`
	# 拧到 0 ⇒ `color × energy` 对任何法线都是同一个常数）。所以"朝上的甲板面"
	# 与"女儿墙的侧面"受到的辐照**完全一样** —— 新加的那批矮构件
	# **不会靠明暗自己显形**，与船底那个病是同一个。
	#（我在写甲板几何时先入为主地以为"朝上的面会被月光照到"，真渲染证明不成立：
	#  各向同性的意思就是**没有"朝上"这回事**。）
	#
	# 与船底唯一的差别是**代价**：船底在玩法上是"天花板"（玩家贴着它飞，
	# 读不出来就是撞上去），船顶只在**俯视**时被看到 ⇒ 这里的灯是给画面提供读数，
	# 不是保命。所以亮度沿用同一套 `CITY_LAMP_*`，不再单独扫剂量表。
	#
	# 两组：
	#   · 泳池两侧各一条通长灯带 ⇒ 把泳池这条**中轴**勾出来；
	#   · 两侧女儿墙内沿各一条 ⇒ 把甲板的**边界**勾出来。
	#     边界这条才是真正有用的那个：船的边在哪儿，决定了"沿船底掠过"的**入槽线**。
	var deck_lights: Array[Transform3D] = []
	var nd := clampi(int(round(span / 700.0)), 6, 26)
	for k in range(nd):
		var lx := mid.x - span * 0.5 + 260.0 \
			+ float(k) * (span - 520.0) / float(nd - 1)
		for pp in 2:
			var pz := (350.0 + 40.0) if pp == 0 else -(350.0 + 40.0)
			deck_lights.append(_sized(
				Vector3(lx, deck_y + 24.0, mid.z + pz), CITY_LAMP_DOT, 0.0))
		for s3 in 2:
			var wz := (half_z - CITY_SHIP_DECK_PARAPET_W - 40.0) if s3 == 0 \
				else -(half_z - CITY_SHIP_DECK_PARAPET_W - 40.0)
			deck_lights.append(_sized(
				Vector3(lx, deck_y + CITY_SHIP_DECK_PARAPET_H + 12.0, mid.z + wz),
				CITY_LAMP_DOT, 0.0))
	_add_multimesh("SandsDeckLights", deck_lights,
		_city_material(CITY_LAMP_ALBEDO, CITY_LAMP_EMISSION, CITY_LAMP_ENERGY))
	# ---- ⑧ 船底作业灯（轮 5）：**夜间唯一能让这条槽读出来的东西** ----
	#
	# ⚠️ 为什么灯不能省：各行同性环境光下（`sky_contribution = 0`），肋梁的侧面
	# 与船底的底面**受到的辐照相同** ⇒ 肋梁自己不会靠明暗显形（见 `CITY_SHIP_RIB_ALBEDO`）。
	# 所以"给船底加了几何"这件事，在**夜里**必须由灯把它翻译成画面 ——
	# 否则肋梁只是一堆看不见的碰撞体。
	#
	# 两组灯各管一件事：
	#   · 横肋底缘（每道 3 盏）⇒ 贴槽飞时**一条条从头顶掠过** = 速度感；
	#   · 纵边梁（每边一排）⇒ 往前看**两条向灭点收敛的灯线** = 方向感 / 车道线。
	var belly_lights: Array[Transform3D] = []
	var bz := 1500.0 * 0.5 - CITY_SHIP_KEEL_W
	var nk := clampi(int(round(span / 1100.0)), 4, 24)
	for k in range(nk):
		var lx := mid.x - span * 0.5 + 300.0 \
			+ float(k) * (span - 600.0) / float(nk - 1)
		for ki in 2:
			var lz := (bz - 60.0) if ki == 0 else (-(bz - 60.0))
			belly_lights.append(_sized(
				Vector3(lx, belly - 14.0, mid.z + lz), CITY_SHIP_BELLY_LIGHT, 0.0))
	for k in CITY_SHIP_RIB_N:
		for j in 3:
			belly_lights.append(_sized(
				Vector3(mid.x - span * 0.5 + 420.0
						+ float(k) * (span - 840.0) / float(CITY_SHIP_RIB_N - 1),
					belly - 14.0,
					mid.z + (float(j) - 1.0) * 430.0),
				CITY_SHIP_BELLY_LIGHT, 0.0))
	_add_multimesh("SandsBellyLights", belly_lights,
		_city_material(CITY_LAMP_ALBEDO, CITY_LAMP_EMISSION, CITY_LAMP_ENERGY))


## **针塔**（迪拜塔式）：四段收分的塔身 + 一根长针，**远高于市中心**。
##
## 总高 4200 m（塔身）+ 700 m（针）= 4900 m，是市中心最高那档
##（`city_lot_for` 的 downtown：1350~3050 m）的 1.6 倍以上
## ⇒ "最高的那根柱子"一眼可辨，也正是它当锚点的理由。
##
## ⚠️ 收分必须是**真几何**（每段一个盒），不能用一根等宽柱子拉高 ——
## 迪拜塔的识别性全在"台阶式收分"的剪影上；等宽柱子在夜空的剪影里
## 与一栋普通高楼没有区别。
## ★ **内阁下榻的酒店**（轮 50 · 2026-09-30）—— 这座针塔的**组名**。
##
## 老板：「任务目标应该是**对着联邦内阁下榻的酒店**使用光束步枪射击……
## 可以是达沃中心最高的楼，就是我让你参考迪拜塔建的那个。」
## 那座楼就是 `_city_needle_tower()` 建出来的针塔（全图最高，9 065 m）。
##
## ⚠️ 它是**剧情数据与建图数据之间唯一的那条线**：`Mission.landmark_group`
##（`mission_script.gd`）写的就是这个字符串，`suite_campaign` 有一条跨模块断言
## 把两边钉在一起。改名字要**两边一起改** —— 只改一边的表现是
## "打中了但目标永远不完成"，**一处都不报错**。
const HOTEL_GROUP := "davao_hotel"

## 酒店的 **HUD 只读信标**所在的组名（2026-09-30，老板：「你把要对着迪拜塔
## （游戏内名字"内阁成员所在酒店"）也设置一个类似柯西运输仓的锁定」）。
##
## ⚠️⚠️ **它和 `HOTEL_GROUP` 是两个组，绝不许合并** —— 两者的"位置语义"不同：
##   · `HOTEL_GROUP` 管**打中判定**：登记的是 4 段塔身 + 塔尖那 5 只 `StaticBody3D`
##     （弹体扫掠打到的就是它们）。组员的坐标是**各段盒体的中心** ⇒ 塔身最下段
##     的中心在几千米高处、且塔尖那只又高出一截，**取任意一只都是错的高度**；
##   · `HOTEL_TAG_GROUP` 管**显示**：一只**没有网格**的 `Marker3D`，钉在**塔尖顶**。
## 合并的后果是"框画在塔腰上"，而一切照常运行、**一处都不报错**。
##
## ⚠️ 名字**刻意不以 `Pod` 开头**（同 `CargoTarget` 那条理由：
## `suite_space_map._pods_aabb()` 是按 `begins_with("Pod")` 扫节点量外框的，
## 而信标没有网格 ⇒ `_subtree_aabb()` 给出空 AABB、把合并结果拉回原点）。
##
## ⚠️ 与运输仓的信标同一条**结构性保证**：它不在 `units` 组、没有 `take_damage` /
## `is_hostile_to` ⇒ 武器与 AI 都够不到它。「可显示但不可被攻击」不是靠一个开关，
## 是靠它根本不在武器门的判定链上。（不信 `pod_tag`，`hud.gd._beacon_tag()` 按组找。）
const HOTEL_TAG_GROUP := "hotel_target"

## 把 `_add_box()` 建出来的那一件几何**登记进 `group`**。
##
## ⚠️ 必须登记它的**父节点**：`_add_box()` 返回的是 `MeshInstance3D`，
## 而弹体扫掠打到的是那个 `StaticBody3D`（碰撞体挂在它身上）。
## 登记错了对象 = 组永远匹配不上，而这一切**不会报错**。
func _tag_box(mi: MeshInstance3D, group: String) -> void:
	if mi == null or group.is_empty():
		return
	var body := mi.get_parent()
	if body is Node:
		(body as Node).add_to_group(group)


func _city_needle_tower(c: Vector3) -> void:
	# ⚠️ 2026-09-27：整体乘 `needle_mul`（按图给）。达沃把市中心楼高抬到
	# 典型 4 000 / 最高 7 500 m 之后，原来的 4 900 m 针塔会被楼群淹掉 ——
	# 而它是这张图的**方位锚点**（"回到市中心"的参照物）。
	# 达沃取 1.85 ⇒ 7 770 + 1 295 = **9 065 m**，重新回到"最高的东西"这个位置。
	# 奥恩贝利不走这一支（它的锚点是 `LandmarkTower`），`needle_mul` 给 1.0。
	var mul := float(CITY_SHAPE[map.city_layout].needle_mul)
	# [截面宽, 该段高]，四段共 4200 m（× `mul`）
	var segs := [[900.0, 1250.0], [640.0, 1300.0], [420.0, 1050.0], [210.0, 600.0]]
	var col := Color(0.235, 0.252, 0.292)
	var y := 0.0
	for i in segs.size():
		var w: float = segs[i][0] * mul
		var sh: float = segs[i][1] * mul
		# ★ 四段塔身**每一段**都进酒店组：玩家的弹从任何高度打上去都算命中。
		_tag_box(_add_box("NeedleSeg%d" % i, c + Vector3(0.0, y + sh * 0.5, 0.0),
			Vector3(w, sh, w * 0.86), col.lightened(0.018 * float(i)), 0.0, 0.0, 0.0,
			Color(0, 0, 0, 0), Facade.GLASS), HOTEL_GROUP)
		y += sh
		_city_body_count += 1
	# 塔尖那根针
	var spire := _add_box("NeedleSpire", c + Vector3(0.0, y + 350.0 * mul, 0.0),
		Vector3(52.0 * mul, 700.0 * mul, 52.0 * mul), Color(0.32, 0.34, 0.38), 0.0)
	_tag_box(spire, HOTEL_GROUP)
	_city_body_count += 1
	# 针尖上的顶灯（地标顶灯）。⚠️ 用**障碍灯的红色**而不是路灯的暖黄：
	# 4900 m 高的塔尖，在真实世界里必须是红色航空障碍灯。
	if map.city_lights == MapDef.CityLights.FULL:
		_add_box("NeedleTipLight", c + Vector3(0.0, y + 730.0 * mul, 0.0),
			Vector3(70.0, 70.0, 70.0), CITY_BEACON_ALBEDO, 0.0, 0.0, 0.0,
			CITY_BEACON_EMISSION)
	# ---- ★ 酒店的 **HUD 只读信标**（见 `hud.gd._draw_beacons()`）----
	#
	# ⚠️ **挂在塔尖那件几何自己身上**，不做 `_terrain_root` 的直接子节点。两个理由：
	#   ① 语义：它是"这座塔的顶"的标志，塔动它跟着动；
	#   ② ★★ **实测（2026-09-30）**：`suite_round` 有一条「酒店确实是**全城最高的楼**」
	#      判据，它扫的是 `_terrain_root` 的**直接子节点**取最高的那个，
	#      并且只排掉 `HOTEL_GROUP` 成员与以 `Needle` 开头的名字。信标在塔尖**之上**
	#      700×mul ⇒ 挂在根上就会**把它自己**算成"全城最高的东西"，
	#      于是那条断言必红、且红得莫名其妙（读数变成"酒店 8418 < 信标 9065"）。
	#      挂进塔身之后它根本不进那次扫描。
	#      ⇒ **凡"只用来显示"的锚点，先问一句"谁会来扫这棵子树"**。
	#      （同类先例：运输仓信标的名字**不许以 `Pod` 开头**，见 `_build_transport_pod()`。）
	#
	# ⚠️ 本地坐标 = 塔尖盒**中心 → 盒顶**的那半个高（盒高 700×mul ⇒ +350×mul）。
	# 盒心在 `y + 350×mul` ⇒ 世界高度 = `y + 700×mul` = 塔身 4200×mul + 针 700×mul，
	# 也就是**真正的针尖顶**。顶灯（`y + 730×mul`）比它再高 30×mul，那 55 m 是灯罩，
	# 不该算进"那座塔"。
	var hotel_tag := Marker3D.new()
	hotel_tag.name = "HotelTarget"
	hotel_tag.position = Vector3(0.0, 350.0 * mul, 0.0)
	hotel_tag.add_to_group(HOTEL_TAG_GROUP)
	spire.get_parent().add_child(hotel_tag)


## **集装箱港区**：码头面 + 货柜堆 + 一排龙门吊。
##
## 设计书 §3.2 把它定义为**低空穿越障碍**："贴海面进港 → **穿吊臂**"。
## 所以吊臂的高度是**刻意的**：腿高 720 m、横臂在 780 m，两腿间距 900 m ——
## 机体从两腿之间穿过去是这张图的第二个签名动作。
##
## ⚠️ 用一个**局部的** `RandomNumberGenerator`（种子写死），不碰 `_city_rng` ——
## 那个发生器是整座城共享的一条序列，地标在 `_build_city_blocks()` **之后**才建，
## 但"以后有人在中间插一个调用"就会静默挪走全城的楼高。局部的没有这个风险。
## 港区堆场的**纯布局**：每一节货柜一个 `{pos, size, row}`。
##
## ## 为什么抽成纯函数（1.3 批 M · 轮 7）
##
## 轮 7 的全部内容就是**这块几何的排布**（行 + 道 + 车道对齐吊腿），
## 而它恰恰是 `suite_gfx_map` **原本量不到**的东西：货柜走 `MultiMesh`，
## 而 `MultiMesh.get_instance_transform()` 在无头模式下**读回来全是单位变换**
##（本套件别处已记过这条限制）⇒ "排到哪儿去了"在测试里完全不可见，
## 只能退回源码 `contains` 断言（那正是"全是接线断言"的老毛病）。
##
## 抽成纯函数之后：**布局可以被单测**（确定性、不建场景、不依赖无头渲染），
## 于是"车道落在吊腿下面"、"块是长条"、"臂下净空为正"这几条不变量
## 才真正**可执行**。手法与 `city_is_land()` / `city_lot_for()` 一致。
##
## 港区 **8 台龙门吊**的构件布局（**纯函数**，可被单测）。
##
## 返回 `Array[Dictionary]`，每台一份，每个构件都是 `{pos, size}`：
##
## ```
##   {crane, legs[2], bogies[2], boom, portal, trolley, cable, spreader, cab, house}
## ```
##
## ⚠️ 为什么必须抽成纯函数（与 `port_yard_layout()` 逐字同一条理由）：
## 构件走的是 `_add_box()`（节点**能**被读回来），但读回来的只有"它在哪"，
## **没有尺寸关系**；而这一轮要钉的不变量全是**关系**：
## "小车在臂跨之内""吊具在小车正下方""吊具底面高于最高箱顶""通道净高够"。
## 把布局抽成数据之后，这些就变成了可执行的算术 —— 而且**改一处不会只改一半**：
## 缆绳的两端是从小车与吊具的常量里**解出来**的，不是写死的。
static func port_crane_layout(c: Vector3) -> Array:
	var out: Array = []
	var cx := c.x + PORT_CRANE_CX
	# ⚠️ 缆绳的两头：小车的**底面**（不是顶面 —— 顶面贴的是吊臂）与吊具的顶面。
	# 轮 8 第一版就在这儿接错了面：缆绳从"小车顶面"（= 吊臂底面，735）垂到吊具，
	# 于是它**穿过整个小车**、还比常量注释里写的 110 m 长了 100 m。
	# 抓到它的是 `suite_gfx_map` 那条"两端严丝合缝"的算术断言（缝 = 100.0 m）——
	# **注释里写着的数与代码算出来的数对不上时，只有算术断言会说话。**
	var trl_bot := PORT_CRANE_TROLLEY_Y - PORT_CRANE_TROLLEY_H * 0.5
	var sp_top := PORT_CRANE_SPREADER_Y + PORT_CRANE_SPREADER_H * 0.5
	for k in PORT_CRANE_N:
		var cz := c.z + PORT_CRANE_Z0 + float(k) * PORT_CRANE_DZ
		var trolley_x := cx + float(PORT_CRANE_TROLLEY_DX[k])
		var legs: Array = []
		var bogies: Array = []
		for s: float in [-1.0, 1.0]:
			legs.append({
				"pos": Vector3(cx + s * PORT_CRANE_LEG_DX, PORT_CRANE_LEG_H * 0.5, cz),
				"size": Vector3(PORT_CRANE_LEG_W, PORT_CRANE_LEG_H, PORT_CRANE_LEG_D),
			})
			# 台车：贴着腿的底面（轮组坐在地上）。
			bogies.append({
				"pos": Vector3(cx + s * PORT_CRANE_LEG_DX, PORT_CRANE_BOGIE_H * 0.5, cz),
				"size": Vector3(PORT_CRANE_BOGIE_W, PORT_CRANE_BOGIE_H, PORT_CRANE_BOGIE_D),
			})
		out.append({
			"crane": k,
			# 腿的**序号**沿用老命名 `_−1 / _+1`（探针机位 `PortCraneLeg0_-1` 在用）。
			"legs": legs,
			"bogies": bogies,
			"boom": {
				"pos": Vector3(cx + PORT_CRANE_BOOM_DX, PORT_CRANE_BOOM_Y, cz),
				"size": Vector3(PORT_CRANE_BOOM_L, PORT_CRANE_BOOM_H, PORT_CRANE_BOOM_D),
			},
			# 门框横梁：X 方向跨到两条腿的**外侧面**（`2 × LEG_DX + LEG_W` = 1030），
			# Y 方向顶面贴 `boom_bot` ⇒ **通道净高 = boom_bot − PORTAL_H**。
			"portal": {
				"pos": Vector3(cx, PORT_CRANE_PORTAL_Y, cz),
				"size": Vector3(PORT_CRANE_LEG_DX * 2.0 + PORT_CRANE_LEG_W,
					PORT_CRANE_PORTAL_H, PORT_CRANE_PORTAL_D),
			},
			"trolley": {
				"pos": Vector3(trolley_x, PORT_CRANE_TROLLEY_Y, cz),
				"size": Vector3(PORT_CRANE_TROLLEY_W, PORT_CRANE_TROLLEY_H,
					PORT_CRANE_TROLLEY_D),
			},
			# 缆绳：小车**底面** → 吊具顶面。两端都是解出来的（见函数头那条 ⚠️）。
			#
			# ⚠️ 名字用 `Rope` 而**不是** `Cable`：`PortCraneCable` 以 `PortCraneCab`
			# 开头 —— 两个名共享前缀会让前缀查询（`--aim` / 测试的
			# `_nodes_prefixed`）**静默把两批一起收进来**：数司机室会数出 16 件。
			# 轮 8 当场踩到（第三回了：轮 6 的 `PortLightMast` vs 灯头批次同一族）。
			"rope": {
				"pos": Vector3(trolley_x, (trl_bot + sp_top) * 0.5, cz),
				"size": Vector3(PORT_CRANE_ROPE_W, trl_bot - sp_top, PORT_CRANE_ROPE_W),
			},
			"spreader": {
				"pos": Vector3(trolley_x, PORT_CRANE_SPREADER_Y, cz),
				"size": Vector3(PORT_CRANE_SPREADER_W, PORT_CRANE_SPREADER_H,
					PORT_CRANE_SPREADER_D),
			},
			"cab": {
				"pos": Vector3(cx + PORT_CRANE_CAB_DX, PORT_CRANE_CAB_Y, cz),
				"size": Vector3(PORT_CRANE_CAB_W, PORT_CRANE_CAB_H, PORT_CRANE_CAB_D),
			},
			"house": {
				"pos": Vector3(cx + PORT_CRANE_HOUSE_DX, PORT_CRANE_HOUSE_Y, cz),
				"size": Vector3(PORT_CRANE_HOUSE_W, PORT_CRANE_HOUSE_H,
					PORT_CRANE_HOUSE_D),
			},
		})
	return out


## 港区龙门吊上的**作业灯**位置（沿臂排列的 5 个白点）。
##
## ⚠️ 抽出来的理由不是"洁癖"，是**轮 8 加机器房时踩到的一条**：
## 旧版灯排的第一个点在 `cx − 700`，而机器房落在 `cx − 1180 … cx − 620`、高度
## 795 … 955 —— 灯的 y（855）**正落在机器房的区间里** ⇒ 第一盏灯被盖进盒子里。
## 那不会报错、不会变暗，只是"少了一个亮点"，肉眼与"灯没接线"完全一样。
## 现在灯排整体移到臂的**海侧**（`+300 … +2300`），与机器房隔开 920 m，
## 并由 `suite_gfx_map` 钉住"每一盏都在臂跨内、且都不在机器房的盒子里"。
static func port_crane_lights(c: Vector3) -> Array:
	var out: Array = []
	var cx := c.x + PORT_CRANE_CX
	for k in PORT_CRANE_N:
		var cz := c.z + PORT_CRANE_Z0 + float(k) * PORT_CRANE_DZ
		for j in PORT_CRANE_LIGHT_N:
			out.append(Vector3(
				cx + PORT_CRANE_LIGHT_X0 + float(j) * PORT_CRANE_LIGHT_DX,
				PORT_CRANE_LIGHT_Y, cz))
	return out


## 港区堆场的排布（**纯函数**，可被单测）：每块一条沿 Z 的长条 + 块间的车道。
##
## ⚠️ 它自带 `prng`（种子写死）：布局必须确定 —— 每次建图两样的话，
## 上面那些断言就永远在另一种几何上跑（这条比"少抽一次随机数"重要得多）。
static func port_yard_layout(c: Vector3) -> Array:
	var prng := RandomNumberGenerator.new()
	prng.seed = 20260325
	var out := []
	var bay_l := PORT_BAY_L * PORT_BAY_FILL
	var z0 := c.z - PORT_YARD_L * 0.5
	for kk in range(PORT_YARD_K0, PORT_YARD_K0 + PORT_YARD_ROWS):
		var bx := c.x + PORT_YARD_ANCHOR_X + float(kk) * PORT_PITCH
		# 层数**每块抽一次底 + 每节抽一次扰动**，理由见 `_city_container_port()`。
		var base := prng.randi_range(PORT_LAYER_MIN + 1, PORT_LAYER_MAX)
		for i in PORT_BAY_N:
			var layers := clampi(base + prng.randi_range(-1, 1),
				PORT_LAYER_MIN, PORT_LAYER_MAX)
			var bh := float(layers) * PORT_LAYER_H
			out.append({
				"row": kk,
				"pos": Vector3(bx, PORT_APRON_TOP + bh * 0.5,
					z0 + PORT_BAY_L * (float(i) + 0.5)),
				"size": Vector3(PORT_BLOCK_W, bh, bay_l),
			})
	return out


func _city_container_port(c: Vector3) -> void:
	# 码头面：一块抬高的平台（港区地面本来就比城区高一点）
	# ⚠️ 反照率 0.135 → 0.165（轮 5）：与货柜堆同一条理由（见下）。
	_add_box("PortApron", c + Vector3(0.0, 30.0, 0.0),
		Vector3(7600.0, 60.0, 7400.0), Color(0.165, 0.165, 0.172), 0.0)
	_city_body_count += 1
	# ---- 货柜堆：**成排的长条块 + 块间车道**（1.3 批 M · 轮 7）----
	#
	# 几何的推导全写在 `PORT_*` 那组常量里，这里只记三件**在代码里才看得出来**的事：
	#
	# ① ⚠️ **朝向硬编码 0**（旧版是 `randf_range(-6, 6)`）—— 对齐是"行"的前提。
	# ② ⚠️ 层数是**每块抽一次底 + 每节抽一次扰动**，不是每节全随机。
	#    真实的堆场是"一条块一个高度"；每节全随机又会退回"随机撒盒"的观感
	#   （块与块之间的差别才该大，块内部只该有轻微起伏）。
	# ③ ⚠️ 排布本身在 `port_yard_layout()`（**纯函数**，可被单测）——
	#    这里只把它翻译成 `Transform3D`。这样"车道落在吊腿下面"那条不变量
	#    才有一条**可执行的**断言（`MultiMesh` 的实例变换在无头模式下读不回来）。
	var stacks: Array[Transform3D] = []
	for b: Dictionary in port_yard_layout(c):
		var p: Vector3 = b["pos"]
		var s: Vector3 = b["size"]
		stacks.append(_sized(p, s, 0.0))
	# 货柜走**港区金属面**（`Facade.METAL` 的材质参数 + `facade_strength = 0`）：
	# 货柜上当然没有窗格，借的只是"金属 / 粗糙 0.46"那两个参数（与码头岸壁同一手法）。
	#
	# ⚠️ 反照率 0.175 → 0.255（1.3 批 M · 轮 5）。轮 5 的真渲染量出来
	# `--aim=PortStacks:1100 --pitch=26` 的整帧 `dark_ratio = 0.9757`
	#（97.6% 的像素低于暗阈）、`mean_lum = 0.0168` —— 货柜堆在夜里是
	# **一堆贴在黑场地上的黑盒子**，整幅画面只有一个白色灯点。
	# 而这片堆场的设计用途是**低空穿越障碍**（"贴海面进港 → 穿吊臂"）：
	# 看不见的东西不是障碍，是坑。0.255 是"工业黄 / 铁灰集装箱"该有的反照率
	#（原来的 0.175 是**岸壁**的量级 —— 那是个垂直的、常年背光的立面，
	# 而货柜是水平堆场上一排排朝上朝侧的面）。
	_add_multimesh("PortStacks", stacks,
		_city_facade_material(Color(0.255, 0.262, 0.275), Facade.METAL, 0.0))
	# ---- 龙门吊：**一台岸桥该有的构件全在**（1.3 批 M · 轮 8）----
	#
	# 布局全部来自纯函数 `port_crane_layout()`（推导与三条硬约束写在 `PORT_CRANE_*`
	# 那组常量里），这里只做三件事：**取数 → `_add_box()` → 命名**。
	#
	# ⚠️ 为什么必须这么做，而不是"在循环里再多写几个 `_add_box`"：
	# 那些断言要钉的是**构件之间的关系**（小车在臂跨内、吊具在小车正下方、
	# 门框不能把通道堵上）。关系写在循环里就是一堆局部变量，测试只能靠
	# **源码字符串**去猜；写进纯函数就是数据，测试可以真的算一遍。
	var boom_lights: Array[Transform3D] = []
	var bogies: Array[Transform3D] = []
	var crane_leg_col := Color(0.200, 0.200, 0.212)
	var crane_boom_col := Color(0.220, 0.220, 0.235)
	# 机器件统一一个色，与腿/臂略分开 —— 一眼能分出"结构"与"装在结构上的东西"。
	var crane_fit_col := Color(0.248, 0.248, 0.262)
	var crane_fits := [
		["portal", "Portal"], ["trolley", "Trolley"], ["rope", "Rope"],
		["spreader", "Spreader"], ["cab", "Cab"], ["house", "House"],
	]
	for cr: Dictionary in port_crane_layout(c):
		var k: int = cr["crane"]
		for i in 2:
			var lg: Dictionary = cr["legs"][i]
			# ⚠️ 腿的序号是 `−1 / +1`（老命名，探针机位 `--aim=PortCraneLeg0_-1` 在用）。
			_add_box("PortCraneLeg%d_%d" % [k, i * 2 - 1], lg["pos"], lg["size"],
				crane_leg_col, 0.0)
			_city_body_count += 1
			# 台车（走行轮组）：**收在腿的 footprint 之内**、走 MultiMesh 零碰撞。
			# 这不是省事，是"宽出去就得有碰撞"那条硬约束的结果 —— 见常量注释。
			var bg: Dictionary = cr["bogies"][i]
			bogies.append(_sized(bg["pos"], bg["size"], 0.0))
		var bp: Dictionary = cr["boom"]
		_add_box("PortCraneBoom%d" % k, bp["pos"], bp["size"], crane_boom_col, 0.0)
		_city_body_count += 1
		for fp: Array in crane_fits:
			var f: Dictionary = cr[fp[0]]
			_add_box("PortCrane%s%d" % [fp[1], k], f["pos"], f["size"],
				crane_fit_col, 0.0)
			_city_body_count += 1
	if not bogies.is_empty():
		_add_multimesh("PortCraneBogies", bogies, _city_material(crane_leg_col))
	if map.city_lights == MapDef.CityLights.FULL:
		# 吊臂上的作业灯（一排白点）：既是灯火，也是"这条臂有多长"的读数。
		# ⚠️ 灯头尺寸用 `CITY_LAMP_DOT` 而**不是** `CITY_LAMP_HEAD`：
		# 这一处是**贴脸构件**（玩法是"从两腿之间穿过去"），
		# 大灯头在这个距离上会烧成一块白板 —— 完整推理见那个常数的注释。
		# 位置来自 `port_crane_lights()`：⚠️ 轮 8 把整排移到臂的海侧，
		# 因为机器房会把旧位置的第一盏灯盖进盒子里（见那个函数的注释）。
		for p: Vector3 in port_crane_lights(c):
			boom_lights.append(_sized(p, CITY_LAMP_DOT, 0.0))
	if not boom_lights.is_empty():
		_add_multimesh("PortCraneLights", boom_lights,
			_city_material(CITY_LAMP_ALBEDO, CITY_LAMP_EMISSION, CITY_LAMP_ENERGY))
	# ---- 高杆灯（1.3 批 M · 轮 5）：港区夜里的**照明主体** ----
	#
	# ## 为什么必须加
	# 轮 5 的真渲染把这件事量出来了（`_pix_m12.sh` 的 A/B 那一组）：
	# `--aim=PortStacks:1100 --pitch=26` 的整帧 `dark_ratio = 0.9757`、
	# `mean_lum = 0.0168`，而关掉环境光只掉到 0.0087 ——
	# 也就是说这片堆场**有一半的亮度来自各向同性的环境光**（"不漏光"的均匀底噪），
	# 另一半几乎是零。画面里只有一个白色灯点（吊臂作业灯）是真正"亮"的东西。
	#
	# ## 为什么是"几座高杆灯塔"而不是"给每个箱子加灯"
	# 真实的集装箱港区夜里就是靠几座**高杆灯**照亮整片堆场的 —— 所以这既是最便宜的
	# 做法（6 座 × 5 个灯头 = 30 个 instance，一次 draw call），也是唯一像真的做法：
	# 被照亮的是**地面与箱体**，明暗分布由灯的位置决定，不是箱体自己在发光。
	#
	# ⚠️ **不要指望这些自发光灯头去照亮货柜堆**：Godot 的自发光材质**不是光源**
	#（本工程的城市灯火全是这一路——它们是"被看见的灯"，不是"照别人的灯"）。
	# 真正让箱子在夜里读得出来的是上一条改动：反照率 0.175 → 0.255。
	# 这两件事**各管一半**，缺一个都是半成品：只加灯 ⇒ 一堆亮点飘在黑箱子上；
	# 只提反照率 ⇒ 一片灰箱子，没有"这是个正在作业的港区"的读数。
	#
	# ⚠️ 坐标全部由 `c` 推导（**不动 `prng` 序列**）—— 那个发生器决定整片堆场的
	# 分节高度，在这里多抽一次就会把它们整体错位（同 ⑥ 塔顶桅杆那条 ⚠️，
	# 是这套代码里最难查的一类连锁）。
	#
	# ## ⚠️ 轮 7：灯位从"东侧一条线"改成"3 条车道 × 2 个 Z 位"
	#
	# 旧版 6 座全在 `x = c.x + 1800` 这一条线上。轮 7 的堆场从"随机撒盒"变成
	# "沿 Z 的 7 条长块"之后，这个摆法的后果第一次显出来：堆场沿 X 宽 **5740 m**，
	# 灯全在东缘 ⇒ **西半场只剩 1/d² 的尾巴**（`_pixprobe_M22_wide.png` 的左侧
	# 半幅几乎是黑的）。而这张图的设计用途是**低空穿越障碍** ——
	# **看不见的障碍不是障碍，是坑**（同轮 5 加灯那条结论）。
	#
	# 现在 3 条车道 × 2 个 Z 位 = 6 座，**车道号由 `PORT_*` 那张表推出来**，
	# 且**跳过 0 与 1 号车道** —— 那两条正是龙门吊两条腿站的位置
	#（`x = c.x − 1650 / − 750`），也就是"穿吊臂"那条玩法通道，
	# 灯杆站进去就是把通道变窄。
	if map.city_lights == MapDef.CityLights.FULL:
		var mast_lights: Array[Transform3D] = []
		var head_offs := [
			Vector2(0.0, 0.0), Vector2(110.0, 0.0), Vector2(-110.0, 0.0),
			Vector2(0.0, 110.0), Vector2(0.0, -110.0),
		]
		# ---- 真光源的容器（1.3 批 M · 轮 6）----
		#
		# ⚠️ 用一个**带位置的容器** 而不是把 6 盏灯直接摊在 `_terrain_root` 下，两条理由：
		#   ① 取证：探针的 `--aim=<前缀>:<距离>` 对空容器取 `global_position`，
		#      所以容器的位置设成**港区中心** ⇒ `--aim=PortFloodLights:3000` 就是
		#      "站在 3 km 外看这片被照亮的堆场"，不需要知道任何一盏灯的坐标；
		#   ② 开关：`--portlights=0` 只要 `visible = false` 一次就关掉整批
		#     —— 逐盏找名字做 A/B 是"给未来埋坑"（第 7 盏灯加进来就漏掉）。
		var flood := Node3D.new()
		flood.name = "PortFloodLights"
		flood.position = Vector3(c.x, 600.0, c.z)
		for k in PORT_MAST_LANES.size() * PORT_MAST_ZS.size():
			# 车道号 → 绝对 X：`lane(kk) = ANCHOR + (kk + 0.5) × PITCH`。
			# ⚠️ 一律走这个式子，**不写绝对坐标** —— 车道表变了它自动跟着走。
			var lane: int = PORT_MAST_LANES[k % PORT_MAST_LANES.size()]
			var mx := c.x + PORT_YARD_ANCHOR_X + (float(lane) + 0.5) * PORT_PITCH
			var mz := c.z + float(PORT_MAST_ZS[k / PORT_MAST_LANES.size()])
			_add_box("PortLightMast%d" % k, Vector3(mx, CITY_PORT_MAST_H * 0.5, mz),
				Vector3(60.0, CITY_PORT_MAST_H, 60.0),
				Color(0.240, 0.240, 0.252), 0.0)
			# 灯架：两片 24 厚的**十字悬臂**。
			# ⚠️ 旧版是 `PortLightHead` = 300×36×300 的**板**、架在灯上方 40 m ——
			# 那个朝下的面正对着下方的点光（法线与光线夹角 ≈ 0）⇒ 全亮，
			# 5 km 外的广角里就是一把把"发光的伞"。完整推导见常量块。
			var arm: Array[Vector3] = [
				Vector3(CITY_PORT_ARM_L, CITY_PORT_ARM_T, CITY_PORT_ARM_W),
				Vector3(CITY_PORT_ARM_W, CITY_PORT_ARM_T, CITY_PORT_ARM_L),
			]
			for ax in 2:
				_add_box("PortLightArm%d_%d" % [k, ax], Vector3(mx, CITY_PORT_ARM_Y, mz),
					arm[ax], Color(0.300, 0.300, 0.318), 0.0)
			_city_body_count += 3
			# ⚠️ 灯头坐在**悬臂之上**（旧版在灯架之下 40 m —— 那正是"伞"的来源）；
			# 但也不能埋进悬臂里，埋进去就只是一块凸起、亮点读不出来
			#（同金沙船沿灯那条 ⚠️）。中心 + 四角 = 5 盏。
			for o in head_offs:
				mast_lights.append(_sized(
					Vector3(mx + o.x, CITY_PORT_LAMP_Y, mz + o.y), CITY_LAMP_DOT, 0.0))
			# ---- 真正照亮堆场的那一颗（见 `CITY_PORT_FLOOD_*`）----
			#
			# ⚠️ 位置与那 5 个自发光灯头**同高**：自发光灯头是"被看见的灯"，
			# 这颗是"照别人的灯"，两者是同一盏灯的两半 —— 错开高度会得到
			# "光从灯架下面照出来、但亮点在上面"的错位（夜里很显眼）。
			var lamp := OmniLight3D.new()
			lamp.name = "PortFloodLight%d" % k
			lamp.position = Vector3(mx - c.x, CITY_PORT_LAMP_Y - 600.0, mz - c.z)
			lamp.light_color = CITY_PORT_FLOOD_COLOR
			lamp.light_energy = CITY_PORT_FLOOD_ENERGY
			lamp.omni_range = CITY_PORT_FLOOD_RANGE
			lamp.shadow_enabled = false
			# ⚠️ **这个 `false` 是量出来的结论，不是省事**（1.3 批 M · 轮 7 实测）：
			#   `--portshadow=1` 三机位 A/B ⇒ 平均亮度 **−18.5 / −7.5 / −16.5**，
			#   变化像素（|Δ|>8）**64% / 27% / 41%** —— 整片堆场连同灯杆柱面一
			#   起掉进黑，近景还带出**条纹状 shadow acne**。开销却只有
			#   `wall_ms` +0.03~0.05 ms（`draw_calls`/`primitives` 逐位不变，
			#   阴影 pass 不计入这两个计数器 ⇒ **只能用钟表时间量**）。
			#
			#   病根是**几何**，不是性能：灯（`CITY_PORT_LAMP_Y` = 656）比它自己
			#   的 `PortLightArm` 十字架（`CITY_PORT_ARM_Y` = 632）只高 24 m，
			#   而灯杆在同一个 XZ 上 —— 360 m 长的悬臂被投影到 656 m 下的地面
			#   **放大 ≈ 656/24 ≈ 27 倍**，等于一把 ±4.4 km 的巨伞盖住全港区。
			#   灯**必须**待在悬臂之上（悬臂顶 644、灯杆顶 620，再低就钻进灯杆里），
			#   所以在"灯在杆顶"这个布局下**开阴影必然全黑**。
			#
			#   真要继续追（本批不做）：把真光源挪到**悬臂末端**（沿 X 偏 ~160 m）
			#   —— 现实里的高杆灯也是灯装在臂端、不是杆顶；那时灯杆只剩一条
			#   60 m 宽的细影，阴影才有意义。当前的药方是**不开**。
			flood.add_child(lamp)
		_terrain_root.add_child(flood)
		# ⚠️ 灯头的 MultiMesh 从 `PortLightMasts` 改名成 `PortFloodHeads`（轮 6）：
		# 原来的名字与灯杆 `PortLightMast%d` **共享前缀 `PortLightMast`** ⇒
		# 探针 `--aim=PortLightMast` 会同时命中"6 根杆 + 1 个灯头批次"，
		# 距离统计与质心全被污染。这类重名**不报错、只给一个看起来正常的错机位**。
		_add_multimesh("PortFloodHeads", mast_lights,
			_city_material(CITY_LAMP_ALBEDO, CITY_LAMP_EMISSION, CITY_LAMP_ENERGY))


