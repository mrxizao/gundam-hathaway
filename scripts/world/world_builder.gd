## 换一次云量就把整个城市的布局打乱。
var _city_rng := RandomNumberGenerator.new()


func _build_city() -> void:
	_prepare_city()
	_build_city_terrain()
	_city_prepare_placement()
	_build_city_blocks()
	_build_city_park()
	_build_city_landmarks()
	_build_city_street_infra()
	# ⚠️ 高架桥**必须在 `_build_city_street_infra()` 之后**：它沿的是同一条格线，
	# 而地面主干道先铺 ⇒ 高架正好叠在主干道上方，读起来是"高架 + 地面辅道"。
	_build_city_viaducts()
	_build_city_monorail()
	_build_city_bridge()
	_build_city_water()
	# ---- 路灯（**三档** · 2026-09-28 v3 · M6）----
	# ⚠️⚠️ 路灯与"窗灯"是**两件事**，必须**分开**：
	#   · **路灯 = 市电 / 基础设施** ⇒ **死城也该有**（用户原话："路灯灯柱得建，
	#     但是灯不亮"）—— 杆与人头都建出来，光全关；
	#   · **窗带 / 障碍灯 / 泛光灯 = 居民活动** ⇒ 死城不该有（那是"有人活着"的信号）。
	# ⇒ 上一版那**一个** `if map.city_lights:` 开关在这里**裂成两条**。
	# `NONE` 档由 `_build_city_street_lamps()` 自己早退（返回 null）。
	_city_lights = _build_city_street_lamps(map.city_lights)
	# ---- 窗带 / 障碍灯 / 泛光灯：**只有 `FULL`** ----
	if map.city_lights == MapDef.CityLights.FULL:
		_build_city_lights()


func _prepare_city() -> void:
	# 沥青灰：比靶场更暗、更中性。
	#
	# ⚠️ 三档**都带一点暖**（R ≈ B）：第一版用了纯中性灰，结果在夜色的冷光下
	# 整片地面泛蓝（截图实测），看着像结冰的湖面而不是沥青。
	# 暖一点点就能把它拉回"夜间路面"的观感。
	#
	# ⚠️ **第二十二轮下半：整体提亮约 2.4 倍**。这三档是给"夜城"配的
	#（0.105 这一档在夜里刚好），而现在是**阴天黄昏**、是一张**死城**：
	# 全城没有一盏灯，唯一的亮源是**阴天的散射天光**。地面再压在 0.10 一档，
	# 整张图就是一片黑 —— 提亮之后沥青才读得出"路"。
	#
	# ⚠️⚠️ **1.3 批 M：城市的地面色已改成按图给的参数**（`MapDef.city_land_*`，
	# 由 `_city_land_color()` 读）。达沃是**夜城**，要的正是"提亮之前"那一组 ——
	# 同一组数喂给两张图，总有一张是错的（死城会全黑、夜城会亮得像黄昏）。
	#
	# ⚠️ 这三行 `_land_*` 与城市的实际配色**无关**：`_make_ground_mesh()`（唯一读
	# `_land_color()` 的路径）只被沙漠图与靶场用，城市自己铺一层 `_city_land_color()`。
	# 保留赋值只是为了"如果哪天有别的代码读它，拿到的不是上一张图的残留"。
	_land_dark = Color(0.240, 0.232, 0.228)
	_land_mid = Color(0.312, 0.300, 0.294)
	_land_light = Color(0.386, 0.372, 0.364)
	# 远景地坪压到水面**以下**：海湾/运河挖掉的地面不该被一个大平面盖回去。
	_build_ground_plane(map.city_far_ground, -600.0)

	# ⚠️⚠️ B7（2026-09-28）：**这个发生器现在一次都不抽**。
	# 楼体尺寸的随机源全部改成了"由子地块坐标派生"的独立 rng
	#（`_build_city_blocks()` 里的 `srng`）—— 那是"一格 N 栋"能成立的前提：
	# 同一个子地块在任何一次建城里都必须长出同一栋楼，而顺序序列做不到
	#（调用次数从 547 变成 ~2 700，序列整体错位）。
	# 这里保留 seed 只是**为了让"改图就重建"这件事仍然有个单点** ——
	# 不要往它上面加新的抽取（见 `DESIGN-…-城市肌理-详规.md` §G.1）。
	_city_rng.seed = map.city_seed
	_city_cube = _make_unit_cube()
	_city_cube_shape = BoxShape3D.new()
	_city_cube_shape.size = Vector3.ONE


func _build_city_staged() -> void:
	_prepare_city()
	build_stage.emit(0.22,"生成城市地形……")
	await get_tree().process_frame
	await _build_city_terrain(true)
	build_stage.emit(0.29,"规划道路与建筑……")
	await get_tree().process_frame
	_city_prepare_placement()
	build_stage.emit(0.34,"建造城市街区……")
	await get_tree().process_frame
	await _build_city_blocks(true)
	_build_city_park()
	_build_city_landmarks()
	build_stage.emit(0.48,"铺设道路……")
	await get_tree().process_frame
	await _build_city_street_infra(true)
	build_stage.emit(0.57,"建造桥梁与轨道……")
	await get_tree().process_frame
	_build_city_viaducts()
	_build_city_monorail()
	_build_city_bridge()
	_build_city_water()
	build_stage.emit(0.62,"布置城市照明……")
	await get_tree().process_frame
	_city_lights = _build_city_street_lamps(map.city_lights)
	if map.city_lights == MapDef.CityLights.FULL:
		_build_city_lights()


# ------------------------------------------------------------ 城市：地形（岛 / 海 / 运河）

## 这一格是不是**建成区**（岛）。纯函数 ⇒ 可以单测。
##
## ## 岛的形状（2026-09-27 起按图给）
## `|u|^n + |v|^n ≤ 1`，其中 `u = gx / rx`、`v = (gz − cz) / rz`，`n` 由 `CITY_SHAPE` 给：
##
## - **`n = 2`** —— 椭圆（奥恩贝利/台场：沿海岸线铺开的一条）；
## - **`n = 4`** —— 超椭圆（达沃）：**圆角矩形**，南岸是一条近似的长直岸线。
##
## ## ⚠️ 为什么达沃必须是 `n = 4`（不是审美，是放不下）
## 港区要沿南岸铺 **3 个泊位**（x = −36 000 / −24 000 / −12 000，每个跨 ±5 000）
## ⇒ **在 z = −25 000 … −18 000 这条带上，岛必须有 ≥ 41 000 m 的半宽**。
## 实测（`RX 60 375 / RZ 49 910 / 岛心 +20 125`）：
##
## | z | 椭圆 n=2 | 超椭圆 n=4 | 需要 41 000 |
## |---|---|---|---|
## | −25 000 | **25 796** | 45 822 | 椭圆 ❌ / 超椭圆 ✓ |
## | −23 000 | **30 393** | 49 245 | 椭圆 ❌ / 超椭圆 ✓ |
## | −20 000 | **35 905** | 52 739 | 椭圆 ❌ / 超椭圆 ✓ |
##
## ⇒ 椭圆下这条 41 000 m 的跨度**从 z = −16 512 往南就放不下了** ——
## 也就是 14.0 km 深的港区带里**只有最北 0.7 km 能用**，最西那个泊位会立在海上
##（不报错，只是错）。**附带好处**：椭圆是旋转对称的（从任何角度看剖面都一样），
## 超椭圆不是 —— 这从根上缓解了"均质椭圆"那个观感问题。
##
## ## ⚠️ 抖动用**格坐标的确定性哈希**，而不是 `randf()`
## 同一个格永远是同一片水/陆，换图重建也不会漂。
static func city_is_land(gx: float, gz: float,
		layout := MapDef.CityLayout.OENBELLI) -> bool:
	# ---- ① 奥恩贝利：**四块人工岛**（2026-09-28 · 用户"照详规做四块岛"）----
	#
	# ⚠️ 进来的是**格坐标**（`gx + 0.5` 那种，见 `_build_city_blocks`），
	# 也有人传**裸格坐标**（`p.x / cblock`，见 `_build_city_street_infra`）。
	# 两种写法 `floor()` 之后都能落到正确的格 —— 与旧椭圆判据"边界上的点算右/下那一格"
	# 的语义一致。所以**不要**在这里再 ±0.5。
	#
	# ⚠️ 这里**没有岸线抖动**了（`CITY_SHORE_JITTER` 只给达沃）：人工填海地的岸线
	# 就是码头与突堤，本来就该是直的；"让岸线不整齐"的活由 `_city_landform()`
	# 的 ±7.9 m 起伏干（详规 §G.2 的原话）。
	if layout != MapDef.CityLayout.DAVAO:
		return _oenbelli_land(int(floor(gx)), int(floor(gz)))
	var p: Dictionary = CITY_SHAPE[layout]
	var jitter := sin(gx * 12.9898 + gz * 78.233) * 43758.5453
	jitter = jitter - floor(jitter)              # 0..1 的确定性伪随机
	var j := 1.0 - CITY_SHORE_JITTER + jitter * CITY_SHORE_JITTER * 2.0
	# ⚠️ 类型必须**显式标注**：`p.rx` 是 `Variant`（字典取值），
	# `var u := a / p.rx` 会因为"推不出类型"直接**解析失败**（整份脚本编译不过）。
	var u: float = (gx - 0.0) / p.rx
	var v: float = (gz - p.cz) / p.rz
	if p.n == 2.0:
		# ⚠️⚠️ **`n = 2` 必须走 `Vector2.length()`，不能改写成 `u*u + v*v <= j*j`。**
		# 两式在边界上**不保证逐位等价**，而 `city_is_land` 是被"逐格相同"断言的
		#（`suite_round20` 的"海岸线逐格相同"）—— 边界上翻一格那条断言就红，
		# 而且极难查。这一支与 1.3 批 M 之前的写法**逐字符等价**
		#（`cz = 0` ⇒ `gz − 0.0 ≡ gz`）。
		return Vector2(u, v).length() <= j
	# n = 4：超椭圆。`pow` 的浮点结果与乘法不同，但这一支**没有历史包袱**
	# （达沃是新增的），所以直接用 pow 就好。
	return pow(absf(u), p.n) + pow(absf(v), p.n) <= pow(j, p.n)


## 奥恩贝利的陆地判据：**点在不在四块人工岛里的任意一块上**（格索引）。
##
## 真源是 `OENB_BLOCKS` 一张表 —— 运河（块间空隙）与海湾都不在这里判，
## 它们由 `_oenbelli_water()` 用"盒内取补集"给出。
##
## ⚠️ 单独抽出来（而不是写在 `city_is_land` 里）是为了让它能被**单独断言**：
## "四块的格数合计 = 587"这类算术判据必须在**块的层面**核，而不是在
## "某一点的返回值"层面核 —— 后者只能抽样，前者才是完整的。
static func _oenbelli_land(gi: int, gj: int) -> bool:
	for b: Array in OENB_BLOCKS:
		if gi >= int(b[0]) and gi <= int(b[1]) \
				and gj >= int(b[2]) and gj <= int(b[3]):
			return true
	return false


## 地表细节网格的细分段数：**按地形给**。
## 城市需要 `CITY_GROUND_SEG` 段（海岸线 / 运河壁），其它三张图沿用原来的 56 段
##（沙漠沙丘和岛屿不需要那么细，翻四倍只是白烧顶点）。
func _detail_segments() -> int:
	return CITY_GROUND_SEG if map != null and map.terrain == MapDef.Terrain.CITY else 56


## 这一点是不是水面（海湾 / 运河）。纯函数 ⇒ 可以单测；**地形网格与城市规划共用**。
##
## ⚠️ 波幅不能用 `_rng`：它会被调用几万次（每个网格顶点一次），
## 用随机数生成器会让"同一个点两次问出两个答案"，地形就会裂开。
##
## ## ⚠️ 方向：水在 +Z 还是 −Z（2026-09-27 起按图给）
## 奥恩贝利的水在 **+Z**（`-Z` 是 Godot 默认前向，所以 +Z 在俯瞰图下方 = 前景，
## "一眼看出这是座海湾城市"）；达沃的水在 **−Z**（夜袭从南侧外海进场）。
## 这件事全部由 `CITY_SHAPE[·].bay_side` 表达，判据写成 `(z − 岸线) × bay_side > 0`。
## ⚠️ `bay_side = +1` 时 `a × 1.0 > 0` 与 `a > 0` 在 IEEE754 下**恒等** ⇒ 奥恩贝利逐位不变。
##
## ⚠️ **正弦波长也要随岛给**（`bay_lam`）：不跟的话岸线在 120 km 宽的达沃岛上
## 会抖出 12 个波峰，读起来像"花边"而不是"海岸"。
##
## ## ⚠️⚠️ 2026-09-28：奥恩贝利这一支**不再有"一条写死的运河"**
## 旧判据是 `|x − canal_x| < canal_half`（一条直槽）。四块岛之后运河**变成了
## 三条**（`gx = −7` / `gx = +7` / `gz = −8` 这三条格线），而它们的**位置与宽度
## 全部由 `OENB_BLOCKS` 决定** —— 再写三个数就等于把"块表"抄了第二遍，
## 改一处忘一处的结果是"楼建到水里"。
## ⇒ 改成 **盒内取补集**：盒子里不是岛的地方就是水（详规 §B.4）。
##
## ⚠️ **海湾那一跳仍然在最前面**，且两座城共用它：四块岛的最外一排只到
## `z = 32 200`，而岸线最低点是 `CITY_BAY_Z − CITY_BAY_WAVE = 34 550`
## ⇒ 岸线永远切不到岛。顺序反过来的话，`ARENA×0.9` 那一带的远海会被判成陆地。
static func is_water_at(x: float, z: float,
		layout := MapDef.CityLayout.OENBELLI) -> bool:
	var p: Dictionary = CITY_SHAPE[layout]
	# ---- ⚠️ 径向门（2026-09-28 · 用户「改成四面环山」）----
	#
	# **水只存在于 `water_r` 之内** —— 这一行必须与 `_city_landform()` 末尾那道门
	# **同一个常量、同一条规则**。两个函数分叉过一次（"规划说水、地形说陆"那对
	# 老毛病），代价是用户报的"房子/公路/路灯在水上"。
	#
	# ⚠️ 门在这里是**硬**的（地形那边是**淡出带**插值）——判据方向刻意选过：
	# 门外地形 = `grit + hills ≥ −8.3 m` > 水面 −12 m ⇒ **门外恒为陆地**，
	# 于是"说陆、却在水下"这个**危险方向**在门外不可能出现；门内那半个淡出带
	# 会出现"说水、其实已露出水面"（无害方向），由 `city_is_dry()` 兜住。
	# 反过来把硬门开在 `R − FADE` 就会重新引入危险方向的假陆 —— 不能那样选。
	# ⚠️ `water_r <= 0` 是"不设门"的哨兵（达沃），**不是** 0 米的意思。
	var wr: float = p.water_r
	if wr > 0.0 and x * x + z * z >= wr * wr:
		return false
	# ⚠️ 显式标注：字典取值是 `Variant`，`:=` 推不出类型 ⇒ 整份脚本解析失败。
	var coast: float = p.bay_z + p.bay_wave * sin(x / p.bay_lam)
	if (z - coast) * p.bay_side > 0.0:
		return true
	if layout != MapDef.CityLayout.DAVAO:
		var gi := int(floor(x / CITY_CBLOCK))
		var gj := int(floor(z / CITY_CBLOCK))
		if gi < int(OENB_BOX[0]) or gi > int(OENB_BOX[1]) \
				or gj < int(OENB_BOX[2]) or gj > int(OENB_BOX[3]):
			return false                    # 盒外 ⇒ 城郊陆地（外围丘陵在那边）
		return not _oenbelli_land(gi, gj)   # 盒内非岛 ⇒ 运河 / 外圈
	return absf(x - p.canal_x) < p.canal_half and z < p.canal_end_z


## 城市地形高度（米）。**纯函数**：同一坐标永远同一个高度。
##
## - 平地上 ±6 m 的起伏（够让路面不"死平"，又不至于让楼悬空）；
## - 海湾往下挖到 `CITY_BAY_DEPTH`，岸线是一条正弦的缓坡；
## - 运河是一条直切的槽（0～`canal_half` 从岸顶降到水底）。
##
## ⚠️ **所有城域坐标从 `CITY_SHAPE` 读**（2026-09-27）：海湾的基准 z / 波幅 / 波长、
## 运河的 x / 半宽 / 延伸端点、以及"水在哪一侧"，两座城各有一套。
static func _city_landform(x: float, z: float,
		layout := MapDef.CityLayout.OENBELLI) -> float:
	var p: Dictionary = CITY_SHAPE[layout]
	# ---- ⚠️ 轮 1：逐层波长按**米**读一遍 ----
	#   sin(x*0.00037) ⇒ λ = 2π/0.00037 = **17.0 km**（大尺度地势）
	#   sin(x*0.0011)  ⇒ λ = **5.7 km**（缓丘）
	# 城市格距 301 m（`CITY_GROUND_SEG`），几何其实**撑得住更短的波**，
	# 但上面两层已经在几何能力的上限附近晃 —— 画面里就是"一整块微倾的灰地"。
	# 补两层（λ 1.9 km / 700 m），让地面有**可以读出"这里高、那里低"**的中尺度起伏：
	#   1.9 km 层在 301 m 格上是 6.3 格/周期（干净）；700 m 层是 2.3 格/周期（接近奈奎斯特，
	#   幅度刻意只给 0.7 m —— 它的作用是"让轮廓不整齐"，不是提供主起伏）。
	#
	# ⚠️ 幅度**刻意压在 ±2.3 m**：`_city_land_color()` 的分带阈值是 3.5 m（岸线色），
	# 起伏再大就会有成片的城市地面被染成"湿沙色"，看起来像满地水洼。
	#
	# ⚠️ 2026-09-27：这几层的**波长没有跟着岛放大**，是刻意的 ——
	# 它们的作用是"让灰地不整齐"，而 17 km 的波在 120 km 宽的达沃岛上仍有 7 个周期，
	# 够用；改了反而要重算 `CALIB` 的奈奎斯特裕度。
	var grit := sin(x * 0.00037 + 1.7) * cos(z * 0.00041 - 0.6) * 4.0 \
		+ sin(x * 0.0011 - 2.3) * cos(z * 0.0009 + 1.1) * 2.0 \
		+ sin(x * 0.0033 - 0.4) * cos(z * 0.0029 + 2.1) * 1.6 \
		+ sin(x * 0.0091 + 0.8) * cos(z * 0.0084 - 1.4) * 0.7
	# ---- 外围山谷丘陵 ----
	# ⚠️ **顺序敏感**：丘陵必须在**海湾之前**加进 `grit`，然后在海湾那一跳里
	# 乘 `(1 − 湾)` 退掉 —— 因为水那一侧（海湾之外）是**海**，不是山谷。
	# 现有代码对"过了岸线"是**一路返回海底**（`− CITY_BAY_DEPTH`），
	# 也就是"海湾之外全是海、一直到 `TERRAIN_DETAIL_SIZE` 的边缘"。
	# 所以丘陵在那里必须归零，否则会从水面下顶出一排山。
	var hills := _city_hills(x, z, layout)
	# ---- 海湾 ----
	var coast: float = p.bay_z + p.bay_wave * sin(x / p.bay_lam)
	# ⚠️⚠️ 2026-09-27 修一处**对称性 bug**：那 1400 m 的"提前起坡"偏移
	# **没有按 `bay_side` 给符号**。
	#
	# 写法是 `start = coast − 1400`，意思是"从**岸线往陆地一侧**退 1400 m 开始下坡"。
	# 但"往陆地一侧"对两座城是**相反的方向**：
	#   · 奥恩贝利 `bay_side = +1`（水在 +Z）⇒ 陆地是 z < coast ⇒ `coast − 1400` ✓ 对；
	#   · 达沃 `bay_side = −1`（水在 −Z）⇒ 陆地是 z > coast ⇒ 正确的是 `coast + 1400`，
	#     而旧代码写的是 `coast − 1400` ⇒ 起坡点落到了**水里 1400 m 处**。
	#
	# 后果（不报错，只是"岸线不在它该在的地方"）：
	#   · 奥恩贝利：有一条 **1.4 km 宽的带**，`is_water_at()` 说"陆"而地形已经在水下
	#     ⇒ 在那儿建的楼**泡在水里**（用户报的"房子在水上"）；
	#   · 达沃：反过来 —— 有一条 1.6 km 宽的带 `is_water_at()` 说"水"而地形还是干的
	#     ⇒ 海湾比设计的**小了**一圈（一片假滩涂）。
	#
	# ⇒ 偏移改成 `coast − 1400 × bay_side`，`tt` 也乘 `bay_side`。
	# `bay_side = +1` 时两处都是 `× 1.0` ⇒ **奥恩贝利逐位不变**（IEEE754 恒等）。
	# ⚠️ 显式标注：`p.bay_side` 是 `Variant`（字典取值），`:=` 推不出类型 ⇒ 解析失败。
	var bay_side: float = p.bay_side
	var start: float = coast - 1400.0 * bay_side
	# ---- 水体（海湾 / 运河）----
	#
	# ⚠️ 2026-09-28：这一支从"直接 `return`"改成**算出一个 `dug`**。
	# 原因是后面还要过一道**径向门**（`CITY_WATER_R`），而门要在
	# "水体"与"陆地"之间**插值** —— 插值要求两边都是值，不能是一串提前返回。
	var dug := grit + hills
	if (z - start) * bay_side > 0.0:
		var tt := clampf((z - start) * bay_side / 2200.0, 0.0, 1.0)
		var sw := tt * tt * (3.0 - 2.0 * tt)
		dug = grit + hills * (1.0 - sw) - CITY_BAY_DEPTH * sw
	elif layout != MapDef.CityLayout.DAVAO:
		# ---- 运河（2026-09-28：两座城**分道**了）----
		#
		# 达沃仍是"一条写死的直槽"（新加坡河）；奥恩贝利改成**块间取补集**：
		# 盒子里不是岛的地方一律切下去（详规 §B.4）。理由与 `is_water_at()` 那边一样 ——
		# 运河的位置与宽度由 `OENB_BLOCKS` 唯一决定，**不能再抄第二遍**。
		#
		# ⚠️⚠️ 这一支是详规**没写、但不做就会破**的一处：`is_water_at()` 只说
		# "这块地按规划是水"，而**地形是另一回事**。不挖的话块间那 4 025 m 会是
		# 和岛一样高的**干地**，而水面在 −12 m ⇒ 从任何角度看都是灰色的地；
		# 于是路网与地块筛选（都过 `is_water_at`）会在那几条带上什么都不放，
		# 画面上就是**几条莫名空着的缝**。不报错，只是错。
		dug = _oenbelli_canal_dig(grit, hills, x, z)
	else:
		var dx := absf(x - p.canal_x)
		if dx < p.canal_half + CITY_CANAL_RAMP and z < p.canal_end_z:
			var ct := clampf(1.0 - (dx - p.canal_half) / CITY_CANAL_RAMP, 0.0, 1.0)
			dug = grit - CITY_CANAL_DEPTH * (ct * ct * (3.0 - 2.0 * ct))
	# ---- 径向门：**水只在 `water_r` 之内**（见 `CITY_WATER_R`）----
	#
	# 出了门就是"起伏 + 丘陵"这块**干燥基准面**。两条性质保证这样做是安全的：
	#   ① 淡出带（`R − FADE` … `R` = 70 … 78 km）**整段落在山脚 82 km 之内**
	#      ⇒ 带宽里 `hills ≡ 0` ⇒ 插值两端都是"平地 vs 挖坑"，**不可能出现断崖**；
	#   ② 门外 `grit + hills` 的下界是 −8.3 m > 水面 −12 m ⇒ **门外恒为陆地**，
	#      "说陆却在水下"这个危险方向在门外不可能发生。
	# ⚠️ `water_r <= 0` 是"不设门"的哨兵（达沃）——**不是** 0 米的意思。
	var wr: float = p.water_r
	if wr > 0.0:
		var rr := sqrt(x * x + z * z)
		if rr >= wr:
			return grit + hills
		var wf: float = p.water_fade
		if rr > wr - wf:
			var q := (rr - (wr - wf)) / wf
			dug = lerpf(grit + hills, dug, 1.0 - q * q * (3.0 - 2.0 * q))
	return dug


## 奥恩贝利的运河挖方：**盒内非岛**的地方切到河床标高。
##
## - 落在任意一块岛上 ⇒ 原样返回（岛面就是地形）；
## - 盒外 ⇒ 城郊陆地（丘陵在那边，原样返回）；
## - 盒内非岛 ⇒ 从岸壁起 `CITY_CANAL_RAMP` 米内 smoothstep 过渡到 −`CITY_CANAL_DEPTH`。
##
## ⚠️ **丘陵在挖方里必须退掉**（`hills * (1 − sw)`），与海湾那一支同一个道理：
## 否则 r > `CITY_HILL_IN` 那一段的"外圈水道"里会从水下**顶出一排山**
##（四块岛的盒子角点半径 96 764 m，已经伸进丘陵环带了）。
##
## ⚠️ **一格 = 4 025 m** 就是河宽：块与块之间只隔一格 ⇒ 旧运河（半宽 2 070 ⇒ 宽 4 140）
## 与它几乎一样宽。这是"格距钉死"顺带的好处。
static func _oenbelli_canal_dig(grit: float, hills: float, x: float, z: float) -> float:
	var gi := int(floor(x / CITY_CBLOCK))
	var gj := int(floor(z / CITY_CBLOCK))
	if gi < int(OENB_BOX[0]) or gi > int(OENB_BOX[1]) \
			or gj < int(OENB_BOX[2]) or gj > int(OENB_BOX[3]):
		return grit + hills                       # 盒外 ⇒ 城郊陆地
	var d := _oenbelli_block_dist(x, z)
	if d <= 0.0:
		return grit + hills                       # 岛上
	var t := clampf(d / CITY_CANAL_RAMP, 0.0, 1.0)
	var sw := t * t * (3.0 - 2.0 * t)
	return grit + hills * (1.0 - sw) - CITY_CANAL_DEPTH * sw


## 点到**最近一块岛**的距离（米）。落在任意一块内 ⇒ 0。
##
## ⚠️ 用**矩形到点的距离**而不是"格心距离"：运河的岸壁必须落在格**边界**上
##（`gi = −7` 那条格的两侧就是两块岛），而格心距离在边界处是 2 012 m —— 用它的话
## 河宽会莫名其妙地少 4 km。
static func _oenbelli_block_dist(x: float, z: float) -> float:
	var best := 1.0e18
	for b: Array in OENB_BLOCKS:
		var x0 := float(int(b[0])) * CITY_CBLOCK
		var x1 := float(int(b[1]) + 1) * CITY_CBLOCK
		var z0 := float(int(b[2])) * CITY_CBLOCK
		var z1 := float(int(b[3]) + 1) * CITY_CBLOCK
		var dx := maxf(maxf(x0 - x, x - x1), 0.0)
		var dz := maxf(maxf(z0 - z, z - z1), 0.0)
		best = minf(best, sqrt(dx * dx + dz * dz))
	return best


## 这一点是否**干燥陆地** —— 即"能不能往上面盖东西"。纯函数。
##
## ## ⚠️⚠️ 为什么不能只用 `is_water_at()`（这是"房子在水上"的第二层原因）
## `is_water_at()` 判的是**几何岸线**（`(z − bay_z − wave·sin) × bay_side > 0`），
## 与**地形高度**是两件独立的事。海湾那一段从岸线往海里是 `smoothstep` 渐降
## `CITY_BAY_DEPTH`（480 m，跨 2200 m），于是岸线两侧各有一条**宽约 1.3 km 的带**：
## 那里的地形已经被挖到水面以下，而 `is_water_at()` 仍然回答"陆"。
## 在这条带上建的楼、铺的路、点的灯 —— 就是用户报的"房子/公路/路灯在水上"。
##
## ⇒ **能不能盖，由地形说了算**：`_city_landform() > CITY_WATER_Y + CITY_DRY_MARGIN`。
## 判据只有一个真源（地形函数），水面的改变、海湾坡度参数的改变都会自动跟上。
##
## ⚠️ 它**不是** `is_water_at()` 的替代品，而是**第二道**闸门：
## `is_water_at()` 管"这块地按规划就是水面（海湾/运河）"，
## `city_is_dry()` 管"这块地按地形看有没有露出水面"。两个都要过。
## 前者够快（两次乘加），后者是一次四层 sin/cos —— 所以先用前者粗筛。
static func city_is_dry(x: float, z: float,
		layout := MapDef.CityLayout.OENBELLI) -> bool:
	return _city_landform(x, z, layout) > CITY_WATER_Y + CITY_DRY_MARGIN


## 外围丘陵的高度（米，**只向上**：0 … `CITY_HILL_AMP`）。纯函数。
##
## 形态与理由见 `CITY_HILL_IN` 那段常数注释（尤其 V2 的根因表）。这里只讲实现：
##
## - **径向淡入**用 `smoothstep`，因为线性斜坡会在 `CITY_HILL_IN` 处留一条
##   笔直的一圈折线（那是从天上最容易认出"程序画的"的一种瑕疵）；
## - **三个八度**（λ 60 / 26 / 11 km），权重 0.50 / 0.32 / 0.18。
##   ⚠️ 最短那层的**脊距是 λ/4 = 2.75 km ≈ 9.1 格**，离奈奎斯特（2 格）很远 ——
##   这正是 V1 那排锯齿的来源（V1 的 λ 700 m 脊距只有 0.58 格，在格点上等于噪声）。
##   `CALIB` 里有一条算术断言核"波长 / 格距"的比；
## - ⚠️ **不再有"谷底平台"**：V1 用 `clampf((rid − FLOOR)/(1 − FLOOR), 0, 1)` 把
##   低于阈值的 **22.8% 面积压成绝对平地**，这就是"平地上插着一排针"那个观感
##   的来源。现在 `rid` **直通**（它的连续性原样传给高度），谷底落在 30% 幅度
##   附近 ⇒ 山体连成一片；
## - **峰顶用软绝对值**（`_city_ridge_smooth()`）：硬 `|sin·cos|` 在零点是一阶
##   折角，**每个折角就是一根"刀锋"**；换成软绝对值后峰顶是**圆**的。
static func _city_hills(x: float, z: float,
		layout := MapDef.CityLayout.OENBELLI) -> float:
	var p: Dictionary = CITY_SHAPE[layout]
	var r := sqrt(x * x + z * z)
	# ⚠️ `hill_in` 是**径向**淡入的内缘。达沃的岛半宽 60 375 m，沿用奥恩贝利的
	# 40 000 会让这条环带**落在岛上** ⇒ 城里长出一排山。所以它按图给（达沃 90 000）。
	if r <= p.hill_in:
		return 0.0
	var t := clampf((r - p.hill_in) / (p.hill_out - p.hill_in), 0.0, 1.0)
	t = t * t * (3.0 - 2.0 * t)                      # smoothstep 淡入
	# k 由 λ = 2π/k 反算：60 000 / 26 000 / 11 000 m。
	# `kz` 沿用 V1 的各向异性比（kz/kx = 0.000790/0.000850 = 0.9294），
	# 让山不呈正方网格（正方的等值线在天上看是"程序画的"）。
	var rid := _city_ridge_smooth(x, z, 0.000104720, 0.000097316, 0.7, -1.2) * 0.50 \
		+ _city_ridge_smooth(x, z, 0.000241661, 0.000224608, -1.9, 0.4) * 0.32 \
		+ _city_ridge_smooth(x, z, 0.000571199, 0.000530875, 2.6, -0.9) * 0.18
	return t * rid * p.hill_amp


## 一格 **ridged** 噪声（**软绝对值版**）：`1 − sa(sin(kx·x+ox)·cos(kz·z+oz))`。
##
## ## 为什么不直接用 `absf()`（V1 就是硬绝对值，已并入本函数）
## 硬绝对值 `|v|` 在 `v = 0` 处一阶不连续（折角）⇒ `1 − |v|` 有一排**尖顶**。
## W6 机位实拍就是"平原上插着一排刀锋"。软绝对值
##   `sa(v) = (sqrt(v² + EPS²) − EPS) / (sqrt(1 + EPS²) − EPS)`
## 在 `v = 0` 处**导数为 0** ⇒ 峰顶是圆顶；`|v| = 1` 处仍取 1 ⇒ 谷深不变。
## ⚠️ 分母那一步不能省：少了它，峰顶只能到 `1 − EPS = 0.90`，
## 两层加权后峰值被砍到 **51%**（实测图上读成"整座山变矮了"）。
##
## ## ⚠️ 为什么**保留** `1 − |·|` 这个形状（而不是换成 `1 − v²`）
## `sin·cos = ±1` 的轨迹是一条**互相连通的网格**，所以 `1 − |·|` 的谷底是
## **连成片**的；而普通正弦和的等值线是闭合椭圆 ⇒ 出来的是"一堆圆包"，
## 读不成"山谷丘陵"。这一条是 V1 定下来的，V2 只换了峰顶的局部形状，没动它。
static func _city_ridge_smooth(x: float, z: float, kx: float, kz: float,
		ox: float, oz: float) -> float:
	var v := sin(x * kx + ox) * cos(z * kz + oz)
	return 1.0 - (sqrt(v * v + CITY_HILL_SOFT_EPS * CITY_HILL_SOFT_EPS) \
		- CITY_HILL_SOFT_EPS) / CITY_HILL_SOFT_DEN


## 地形网格。**不用 `_make_ground_mesh`**，见下。
##
## ⚠️ `_make_ground_mesh()` 的顶点色来自 `_land_color(h)`，那是**沙丘/沙漠**的
## 色板（红土、沙脊），而且高度非负 —— 直接拿来画海湾会得到一片"红土海底"。
## 所以城市自己铺一层：**按海拔选色**（水下暗、岸线湿沙、陆地沥青灰），
## 高度由 `_city_landform()` 给。
func _build_city_terrain(staged := false) -> void:
	var slice_started := Time.get_ticks_usec()
	var seg := _detail_segments()
	var size := TERRAIN_DETAIL_SIZE
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	# 平滑法线。城市地面格距 301 m，**分片法线在近景就是一片平行的直线明暗块**
	#（700 m 机位实拍肉眼可见；而且它长得很像 shader 的材质分层，会污染 A/B 归因）。
	#（为什么这一行必须有 —— 见 `_make_ground_mesh()` 里那段长注释。）
	st.set_smooth_group(0)
	# 顶点先全算出来存成网格，再拼三角 —— 每个顶点只问一次高度函数。
	var grid: Array = []
	grid.resize(seg + 1)
	for j in seg + 1:
		if staged and Time.get_ticks_usec()-slice_started>8000:
			await get_tree().process_frame
			slice_started=Time.get_ticks_usec()
		var row: Array = []
		row.resize(seg + 1)
		for i in seg + 1:
			var x := (float(i) / float(seg) - 0.5) * size
			var z := (float(j) / float(seg) - 0.5) * size
			row[i] = Vector3(x, _city_landform(x, z, map.city_layout), z)
		grid[j] = row
	# 一个格子拆两个三角。两种对角线交替，免得起伏噪声整齐地"拧"成同一方向。
	for j in seg:
		if staged and Time.get_ticks_usec()-slice_started>8000:
			await get_tree().process_frame
			slice_started=Time.get_ticks_usec()
		var ra: Array = grid[j]
		var rb: Array = grid[j + 1]
		for i in seg:
			var a: Vector3 = ra[i]
			var b: Vector3 = ra[i + 1]
			var c: Vector3 = rb[i + 1]
			var d: Vector3 = rb[i]
			if (i + j) % 2 == 0:
				_tri_col(st, a, b, c)
				_tri_col(st, a, c, d)
			else:
				_tri_col(st, b, c, d)
				_tri_col(st, b, d, a)
	st.generate_normals()
	# Deduplicate identical vertices after smoothing; preserve geometry and colors.
	st.index()
	var mi := MeshInstance3D.new()
	mi.name = "CityGround"
	mi.mesh = st.commit()
	# ⚠️⚠️ 2026-09-25（轮 9）：`mat_blend` **0.60 → 0.0**，关掉城市地面的层理。
	#
	# 症状：港区近景（`--aim=PortCraneLeg0_-1:400 --pitch=30`）的**暗地面**上
	# 有一层读起来像水面／大理石的**涡旋纹**；正上方俯视（`--pitch=89`）则读成
	# 一层 45° 细晶格。而 `PortApron` 是纯色盒子（`Facade.NONE`）—— 本该没有纹。
	#
	# 归因（每一发都是同机位 A/B；量具是 ROI 内的平均相邻像素梯度 `grad_h`，
	# 单位 /255。⚠️ **量具粒度必须匹配被测对象**：整帧 `stddev_lum` 对这件事是瞎的，
	# `--matblend=0` 下它 0.0884 → 0.0884 **一动都不动**）：
	#
	# | 旋钮 | ROI-A `grad_h` | 结论 |
	# |---|---|---|
	# | 基线（全开） | 2.6903 | 100.0% |
	# | `--waves=0` / `--ripple=0` | **逐位相同** | 不是海面 |
	# | `--facade=0` / `--veg=0` | **逐位相同** | 不是窗格／植被 |
	# | `--deband=0` | 2.5320（−6%），但 PNG 1 301 868 → 790 589 B（**−39%**） | **只解释压缩率** |
	# | `--adjust=0` | 2.6113，且 `mean` 48.7 → 52.6（**升**） | 只负责放大 8/255 |
	# | `--cel=0` | **逐位相同** | cel_post 面片当前**没参与渲染** |
	# | **`--matblend=0`** | **1.6820（−37.5%）** | **就是它（本行参数）** |
	# | `--matblend=0 --detail=0` | 1.3630 | detail 另有 17.6% |
	# | `--matblend=0 --mottle=0` | 1.3910 | mottle 另有 16.0% |
	# | `--matblend=0 --detail=0 --mottle=0` | **0.8740（−67.5%）** | 剩下的 0.8740 是**正常的光照明暗渐变**，不是纹 |
	#
	# ⚠️ **上一轮把这件事归给了 `--deband`，那是错的**：`--deband=0` 的画面
	# 与基线**肉眼无差别**（1:1 裁图里漩涡一模一样），它只改了 PNG 的压缩率。
	# 教训与 v2.8 ㉛ 同族但方向相反：**不能拿"体积差 39%"当成"画面变了"**。
	#
	# 剂量表（`--matblend` 扫档、同机位）：0.60→100.0% / 0.45→96.1% / 0.30→90.9%
	# / 0.15→79.4% / 0.00→62.5%。**这个杠杆很钝** —— 减半只降 9%，
	# 因为 `k = mix(1.0, 1.0/mat_stretch, mask*blend)` 的偏离幅度本来就只有 1/3
	# ⇒ 只有「0」和「不动」两个实际可选的档，**没有"调轻一点"的中间档**。
	#
	# 机理在 `terrain.gdshader::_mat_warp()`：它把世界坐标沿 `mat_angle` 压缩 `k` 倍，
	# 而 `k` 由一层**随空间连续变化**的掩码调制 ⇒ 坐标映射的雅可比逐点不同
	# ⇒ 挂在它上面的细节噪声被**揉成涡旋**。近景走 `_mat_mask` 的 small 层（λ≈60 m），
	# 在 400 m 贴脸的 ~480 m 视场里只有 8 个周期、屏幕上 ~200 px/周期
	# ⇒ 掩码梯度整个落在可见波段 —— 这正是"漩涡"的尺度。
	#
	# **为什么改调用点、不改 shader**：层理对沙丘／岩体／靶场／岛是**正资产**
	#（风成地貌、岩层走向），只有**城市地面**不对 —— 沥青与混凝土是**人造铺装**，
	# 本来就不该有地质层理。改 `_mat_mask` 的波长会同时动**五张**带层理的图、
	# 作废它们的画质基线；改这一个参数只影响**两张城市图**，因为
	# `_build_city_terrain()` 是**达沃与奥恩贝利共用的路径**。
	# ⚠️ 影响面要写准（第一版这里写的是"只影响达沃"，是错的）：实测两张图的 md5
	# **都变了** —— 奥恩贝利变化像素 6.83%、达沃全城 4.58%，两者的包围盒都落在
	# **画面下半部的地面上**（y 302..714 / 291..587）且横跨整个画面宽度，
	# 而 `mean_lum` 只动 **−0.5% / −2.5%** ⇒ **只改了地面的纹理，没有改亮度**。
	# 而 `0.0` 就是**轮 1 的出厂状态**（零风险）。
	# 探针仍可用 `--matblend=0.6` 把现场**还原**出来做对比取证
	#（v2.7 ㉘：否掉的参数保留旋钮当取证工具，注释留"量了什么、为什么否掉"）。
	mi.material_override = _terrain_material(Color.WHITE, LAND_ROUGH, true, LAND_SPECULAR, 1.05, 160.0,
		0.0, 1.5, 0.0, 0.0, MOTTLE_CITY, MOTTLE_CITY_LEN)
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_terrain_root.add_child(mi)
	print("[city] 地形 %d 段（每格 %.0f m）" % [seg, size / float(seg)])


## 一个三角面的三个顶点，颜色由**海拔**决定。
func _tri_col(st: SurfaceTool, a: Vector3, b: Vector3, c: Vector3) -> void:
	for p: Vector3 in [a, b, c]:
		st.set_color(_city_land_color(p.y))
		st.add_vertex(p)


## 城市地表按海拔分色。
##
## ⚠️ 全部**中性偏暖**（R ≳ B）：夜色的月光偏冷，纯中性灰会被照成"结冰的湖"
##（第一版实测踩过）。水下那几档压到很暗就行 —— 反正上面还有水面。
func _city_land_color(h: float) -> Color:
	# ---- ⚠️ 2026-09-23（批 I · 轮 6）：整块地表提亮 ~1.75 倍 ----
	#
	# 用户："**奥恩贝利的地面质感太黑了，看不清**"。
	# 这是个**光照 × 反照率**的乘法问题，量一下很清楚：
	# 夜战每通道增益是 红 0.30 / 绿 0.45 / 蓝 0.92，而陆地反照率是
	# `(0.128, 0.124, 0.120)`（中性灰）—— 乘完变成 `(0.038, 0.056, 0.110)`：
	# **红绿两通道被压掉三分之二，只剩蓝** ⇒ 地面读成"一块很暗的蓝灰"，
	# 亮度只有 0.056（线性），加上雾与色调映射之后就是"看不清"。
	#
	# ⚠️ 修法**不能**只加蓝（那会变成夜景蓝滤镜），也不能只加绿：
	# 要按**各通道的增益反着补**，把中性灰变回中性灰。
	# 这次是把三个通道**等比提高**到 1.75 倍 —— 它保证色相不变（还是沥青灰），
	# 只是把"看不清"变成"看得清"。
	#
	# 为什么不是更高：`_city_land_color()` 的分带阈值同时决定**海岸线**读不读得出来
	#（岸线比陆地亮一档才有"海岸线"），提得太狠会让陆地与岸线的差被雾吃掉。
	# ⚠️⚠️ **1.3 批 M：下面每一个颜色都改从 `map.city_land_*` 读**，不再写死字面量。
	# 原因见 `MapDef.city_land_*` 的说明：奥恩贝利（阴天黄昏死城）与达沃（夜袭活城）
	# 需要**完全不同**的地面亮度，而这两组数以前是同一个函数里的字面量。
	# 分带阈值（-6 / 3.5 / 24 / 180 m）一个字没动 —— 它们由几何决定，与配色无关。
	# ⚠️⚠️ 2026-09-27：前两条分带**从"绝对米数"改成"相对水面"**。
	#
	# 旧值是 `h < -6` → 海底、`h < 3.5` → 岸线。那两个数隐含"水面在 0 附近"，
	# 而水面其实是 `CITY_WATER_Y`（这一轮从 0.2 降到 −12）。不改的话会出现
	# **两件反向的错**：
	#   ① 陆地最低点 −7.9 落进 `h < -6` ⇒ 深谷被染成**水下暗蓝** （"满地水洼"）；
	#   ② 陆地 65% 落进 `h < 3.5` ⇒ 大半个城被染成**岸线湿沙色**（"一片滩涂"）。
	# 这两件事合起来正是"看起来像泡在水里"的**第二层**原因（第一层是水面高度本身）。
	#
	# ⇒ 判据改成相对 `CITY_WATER_Y`："水下"与"岸线"的分界**必须与水面重合**。
	#   于是岸线色只出现在**真正靠近水的地方**（海湾的 smoothstep 过渡带 + 运河两岸），
	#   而全城地面统一走 `city_land_street` 那一档。
	# 分带阈值本身（3.5 / 24 / 180 m）一个数没动 —— 它们由几何决定，与配色无关。
	if h < CITY_WATER_Y - 40.0:
		var t := clampf((CITY_WATER_Y - 40.0 - h) / 400.0, 0.0, 1.0)
		return map.city_land_seabed.lerp(map.city_land_deep, t)
	if h < CITY_WATER_Y + 3.5:
		# 岸线：湿沙/混凝土护岸，比陆地表亮一档 —— 这就是"海岸线"读得出来的原因。
		return map.city_land_coast
	if h < 24.0:
		return map.city_land_street
	if h < 180.0:
		return map.city_land_mid
	# ---- 丘陵带（批 K · 轮 4）----
	#
	# ⚠️ 前两条分带（3.5 / 24 m）**一个像素都没动**：城区地面只有 ±8 m
	#（`_city_landform()` 的四层 sin/cos），山脚也在 24 m 以下 ⇒ 城区配色不变。
	# 上面那个 `h < 180` 也只是把原来"24 m 以上"那一档**原样延长**到山腰。
	#
	# 180 m 以上按海拔**渐暗、渐冷**。没有这一层时丘陵是一条纯色灰带：
	# 起伏的形状完全靠法线明暗读，而阴天黄昏是**散射光**，明暗差本来就小
	# ⇒ 山看起来是一片平灰的纸。按海拔分带之后"哪边高"才直接读得出来。
	#
	# ⚠️ 另一端取 `city_land_high` —— **比陆地暗、且 B > R**（偏冷灰）。
	# 理由：高处受天光更充分 ⇒ 该更接近天空色。反过来（高处更暖）会读成
	# "被夕阳照亮的山脊"，与"阴天"这个前提自相矛盾；夜战同理（天光更冷）。
	var t2 := clampf((h - 180.0) / 520.0, 0.0, 1.0)
	return map.city_land_mid.lerp(map.city_land_high, t2)


## 水面：把 `_build_ocean()` 那张 160 km 的海面**缩到竞技场尺度**。
##
## ⚠️ 为什么不直接复用 160 km 的海面：它会盖住**整张图的地面**
##（城市就在 y≈0 附近），于是陆地全被泡进水里。
## 城市要的是"陆地上挖出两片水"，所以水面只铺在挖过的地方，
## 高度取 0.2 m —— 比远景地坪（-600 m）高、比陆地（y≈0…6 m）低。
func _build_city_water() -> void:
	_build_ocean()
	if ocean == null:
		return
	var plane := PlaneMesh.new()
	plane.size = Vector2(LAND_SIZE, LAND_SIZE)
	plane.subdivide_width = 2
	plane.subdivide_depth = 2
	plane.material = _ocean_mat
	ocean.mesh = plane
	# ⚠️⚠️ 2026-09-27：**0.2 → `CITY_WATER_Y`（−12）**。见那个常量的完整推导 ——
	# 0.2 m 时 53% 的陆地在水下，整座城读成"泡在浅水里"（用户报的"房子在水上"）。
	ocean.position = Vector3(0.0, CITY_WATER_Y, 0.0)
	# ⚠️ **必须把长涌浪位移关掉**（1.2.3 批 H · 轮 1）：这里的网格是 460 km 铺 2×2 段
	# ⇒ 格距 230 km，位移会把四个角各抬一段，整片水面**倾斜成一块斜板**。
	# 城市的海湾/运河是人工水面（岸壁 + 运河壁直切出来的），平的才对。
	_ocean_mat.set_shader_parameter("adaptive_mesh", false)
	_ocean_mat.set_shader_parameter("surface_detail", 0.25 if environment_detail_enabled else 0.0)
	_ocean_mat.set_shader_parameter("wave_amp", 0.0)
	# 同理关掉**水下礁盘**：这里是人工海湾与运河，底下长一片珊瑚礁不合理。
	# （两项目前都只在 `_build_ocean()` 里开，城市这处是唯一的例外，所以显式写出来。）
	_ocean_mat.set_shader_parameter("shoal_amount", 0.0)
	# 微波细节（轮 3）也关掉：城市的这批水面与海面共用 `_ocean_mat`，
	# 而 `_build_ocean()` 刚把它开成了 1.0。这里是**人工**海湾与运河 ——
	# 开微波确实更"像水"，但那会顺带改变城市图的亮度读数（`detail_fade` 一样、
	# 而城市水面的机位比太平洋近得多 ⇒ `keep` 更接近 1 ⇒ 影响不小）。
	# 这一轮的重点在太平洋，城市水面维持"平静的人工水面"这个语义，不夹带改动。
	_ocean_mat.set_shader_parameter("ripple_amount", 0.0)
	print("[city] 水面：海湾 + 运河（海面 shader，铺满全图；长涌浪已关）")


## 一个地块 → 楼栋标高/形态/配色。**纯函数**，可以单测。
##
## `shape` 决定"这栋楼长什么样"，`profile` 决定"楼层的窗带怎么打"。
## 分区（zone）按到市中心的距离：
##   | 距离 | 分区 | 建筑形态 | 高度 |
##   |---|---|---|---|
##   | d < 0.34 | downtown | 高塔 + 裙房 + 退台 + 屋顶机房 | 1350~2500 |
##   | d < 0.62 | midtown | 塔楼密度低一档 | 900~1650 |
##   | d < 0.82 | fringe | 中低层连续街墙 | 420~1000 |
##   | 其余 | waterfront | 低层住宅 + 坡屋顶 | 160~620 |
##
## ⚠️ 高度得**够挡路**：机体 22~28 m 高、转弯半径按 km 计。
## 四圈的高度落差同时是**导航**：贴着楼顶飞时，楼群的轮廓线就是地图。
##
## ⚠️ `seed_value`（1.3 批 M）：只用来派生"立面类别"那个独立 rng 的种子，
## 默认值 = 老的常量 `CITY_SEED`。带上它是为了**两座城的立面分布也不同** ——
## 立面类别影响的是"玻璃幕墙 / 混凝土 / 港区金属"的比例，
## 而达沃是**海港都市**（金属更多）、奥恩贝利是内陆都市。
## ⚠️ 它与 `rng` 是**两个不同的东西**：`rng` 是调用方传进来的那条顺序序列
##（楼高/配色/朝向），`seed_value` 只喂给 `frng`。混用会让两座城的楼高一起变。
## **一个街廓（城市格）的"种"**：大格还是小格、铺多满、几栋、几行几列。**纯函数**。
##
## ## 为什么必须是纯函数 + 坐标哈希
## ① `_city_rng` 是**整座城共享的一条顺序序列**（`DESIGN-…-城市肌理-详规.md` §G.1）：
##    在它上面多抽一次，后面每一次抽取都会整体平移（楼高 / 配色 / 偏心全变），
##    而 `suite_worldscale` 的"市中心楼高 1 300~3 200"正是拿那条序列在断言。
##    ⇒ 这里用一个**由格坐标派生**的独立 rng，序列不可能被影响。
## ② 纯函数 ⇒ 可以直接单测（`suite_round20` 里那两条：两城混起来的
##    "大格 + 小格"必须都存在、且大格真的比小格大、栋数真的落在 7~8 / 2~3）。
##
## ## 行列怎么定（`nx × nz`）
## 让"沿街那一排"更长（`nx ≥ nz`）：一个街廓的**正面**是最可读的一条边，
## `nx` 就是那条边上排几栋。`n = 7` 时槽位有 8 个（4×2），**少摆一个** ——
## 少的那个由哈希挑，于是不同大格缺的位置也不同（"不规则"的第二个来源）。
static func city_block_grade(gx: int, gz: int, seed_value := CITY_SEED,
		nr_big: Vector2i = CITY_BLOCK_BIG_N,
		nr_small: Vector2i = CITY_BLOCK_SMALL_N,
		span_x: int = CITY_BLOCK_SPAN_X,
		fill_big: Vector2 = CITY_BLOCK_BIG_FILL,
		fill_small: Vector2 = CITY_BLOCK_SMALL_FILL) -> Dictionary:
	# ⚠️⚠️ 2026-09-28 晚：`nr_big` / `nr_small` **按图给**（`MapDef.city_block_big_n`
	# / `city_block_small_n`），默认值就是那两个全局常量 ⇒ 奥恩贝利逐位不变。
	# ⚠️⚠️ 2026-09-28 深夜：再按图给 `span_x` / `fill_big` / `fill_small` —— 这三项
	# 都是"大格**地块本身**多大"的旋钮（`nx` 那条路已经在 555 m 撞墙，见 map_def 的判决）。
	# ⚠️ **哈希键是组首格 `gx0`**：`span = 1` 时 `gx0 == gx` ⇒ 与改前逐位相同。
	# 所有默认值都是 **const**，所以 `WorldBuilder.city_block_grade(7, -3)` 这种老调用
	# （测试里就有）拿到的仍是奥恩贝利的那一组 ⇒ 那条"纯函数"断言照旧绿。
	var sp := maxi(1, span_x)
	var gx0 := gx - posmod(gx, sp)
	var rng := RandomNumberGenerator.new()
	rng.seed = _city_lot_seed(gx0, gz, seed_value) ^ 0x2C71A5E3
	var big := rng.randf() < CITY_BLOCK_BIG_P
	var fr := fill_big if big else fill_small
	var nr := nr_big if big else nr_small
	var n := rng.randi_range(nr.x, nr.y)
	# ⚠️ n → nx 的映射（真源就在这里；`MapDef.city_block_big_n` 的注释抄了一份）：
	#   n ≥ 6 → 4×2 ／ n 4…5 → **3×2** ／ n = 3 → 3×1 ／ n = 2 → 2×1 ／ n ≤ 1 → 1×1
	# ⚠️ 想降 `nx` 到 3 必须把 n 压到 **4…5**；写 6 会落进 4×2 ⇒ 塔宽一字不变。
	var nx := 1
	var nz := 1
	if n >= 6:
		nx = 4
		nz = 2
	elif n >= 4:
		nx = 3
		nz = 2
	elif n == 3:
		nx = 3
		nz = 1
	elif n == 2:
		nx = 2
		nz = 1
	# 槽位 `nx × nz` 里要**跳过**几个（`n = 7` 时跳 1 个）。跳过哪几个由哈希定。
	var skip: Array[int] = []
	var slots := nx * nz
	if slots > n:
		var pick := rng.randi_range(0, slots - 1)
		for k in range(slots - n):
			skip.append((pick + k * 3 + 1) % slots)
	return {"big": big, "fill": rng.randf_range(fr.x, fr.y), "n": n,
		"nx": nx, "nz": nz, "skip": skip, "gx0": gx0, "span": sp}


## 一块街廓的**边长上限**（米）：`[g_lo, g_hi]` 是它跨的**格索引区间**（`g_hi − g_lo` 格），
## 上限 = 跨距 − 两侧格线里更宽的那条路 − `CITY_BLOCK_ROAD_MARGIN`。
##
## ## ⚠️ 为什么必须有它（而不是继续用一个全局 `0.86`）
## 改前"铺满比 ≤ 0.86"是一个**全局常量**兜住所有格 —— 它其实是"最坏情况"（格线是
## 460 m 主干道）倒推出来的，对"四条格线全是 110 m 支路"的格（占 36%）白白浪费了 11%。
## 现在按**每格两侧的实际路宽**算，于是：
##   · `fill ≤ 0.86` 时算出来的上限**处处 ≥ 现值** ⇒ **奥恩贝利逐位不变**；
##   · 达沃大格可以安全地往上顶（全是支路的格能到 0.960，次干道旁 0.923）。
## ⚠️ 这条只保证"路不啃进楼"，**不**保证"街够宽"—— 那是 `shrink` 0.84 的职责，两者别混。
static func city_block_ceiling(cblock: float, g_lo: int, g_hi: int) -> float:
	return cblock * float(g_hi - g_lo) \
		- 2.0 * maxf(city_road_half_extent(g_lo), city_road_half_extent(g_hi)) - CITY_BLOCK_ROAD_MARGIN


static func city_lot_for(gx: int, gz: int, rng: RandomNumberGenerator,
		seed_value := CITY_SEED,
		layout := MapDef.CityLayout.OENBELLI) -> Dictionary:
	var p: Dictionary = CITY_SHAPE[layout]
	# ⚠️⚠️ 归一化半宽**必须从表里读**，不能再用 `CITY_GRID * 0.5`。
	# 那个表达式这一轮从 8 变成了 18，而它**恰好**就是奥恩贝利岛的半宽（rx = 7.9 格）——
	# 分母一变，`d` 整体缩到 1/2.25 ⇒ 奥恩贝利**只剩 downtown/midtown 两档**
	#（fringe / waterfront 消失，楼高全线跳到 1 350~2 500），
	# 而它是被 `suite_worldscale` 的"市中心楼高 1 300~3 200"钉着的。
	var hf: float = p.zone_hf
	# ⚠️ **格心 → 世界的映射必须和 `_build_city_blocks` 里那一条完全一致**：
	# 地块中心 = `(gx + 0.5) * block`，所以归一化坐标就是 `(gx + 0.5) / hf`。
	# 这里**不能**再减一个 `hf` —— 那等于把整座城平移半张图，
	# 结果是"市中心"落到图角、而图角正好在海湾里（实测踩过：147 个地块全被
	# 判成 waterfront，downtown 一栋都没有，"超高塔"断言当场红）。
	var u := (float(gx) + 0.5) / hf
	# ⚠️ `v` 要**减去岛心**：达沃的岛北移了 5 格（`cz`），不减的话分区圆心会留在图心
	#（也就是岛上偏南的位置），"市中心"与地标对不上。
	# ⚠️ 奥恩贝利 `cz = 0` ⇒ `gz + 0.5 − 0.0 ≡ gz + 0.5`，**逐位不变**。
	var v := (float(gz) + 0.5 - float(p.cz)) / hf
	var d := sqrt(u * u + v * v)
	# ---- ⚠️⚠️ 2026-09-27：把"同心圆"打散成**错落** ----
	#
	# 用户："达沃和奥恩贝利**房子没有做到错落有致**"。根因就在上面那一行 ——
	# `d = sqrt(u² + v²)` 是**到分区中心的距离**，于是分区是**严格的同心圆**：
	# 同一圈上的每一栋楼抽的是同一个 `[h_min, h_max]`，从任何方位看剖面都一样。
	# ⇒ 这不是"分带不够多"，是"分带是圆的"（阶段一设计稿只说对了"均质"这个现象）。
	#
	# 修法两件，**缺一件都不够**：
	#   ① **方位调制**（下面这行）：让分区边界不是圆。用**两个**谐波而不是一个 ——
	#      单谐波出来的是"三瓣花"（一眼看得出是程序画的），两个谐波叠加才是有机形状。
	#   ② **格点噪声**（`h` 抽完之后那一段）：把**相邻地块**的高度差拉开。
	#      只有 ① 的话，同一条径线上的楼还是等高的 —— "错落"读不出来。
	var ang := atan2(v, u)
	d *= 1.0 + 0.11 * sin(2.0 * ang + float(p.dir_ph1)) \
		+ 0.07 * sin(3.0 * ang + float(p.dir_ph2))
	var zone := "waterfront"
	# ⚠️ 四个下界在 2026-09-27 **整体上调**（160/420/900/1350 → 200/520/1110/1620）。
	# 理由不是"想更高"，而是**为了容纳下面那个 ±24% 的噪声**：
	# 噪声下界 0.82 会把抽到最矮的楼压到 82% ⇒ 不抬下界的话
	# `suite_round20` 的"楼高 > 150 m"与"市中心 > 1300 m"两条会红，
	# 而它们守的是**真不变量**（楼要挡得住路 / 市中心要真是高层）——
	# 该动的是下界，不是断言。抬完之后的典型高度基本不变（噪声均值 1.0）。
	var h_min := 200.0
	var h_max := 620.0
	if d < 0.34:
		zone = "downtown"
		h_min = 1620.0
		h_max = 2500.0
	elif d < 0.62:
		zone = "midtown"
		h_min = 1110.0
		h_max = 1650.0
	elif d < 0.82:
		zone = "fringe"
		h_min = 520.0
		h_max = 1000.0
	var h := rng.randf_range(h_min, h_max)
	if zone == "downtown":
		h *= 1.0 + rng.randf_range(0.0, 0.22)     # 市中心再拉一档
		# ⚠️ 按图的"市中心额外倍率"。达沃要**更高的摩天大楼**（用户原话），
		# 但这一档**只该作用在市中心** —— 整城一起乘会把组屋区也拔成高楼，
		# 那就没有"错落"了（用户同时还在要错落，两条要求不能互相抵消）。
		# ⚠️ 乘在**已经抽出来的**数上 ⇒ 不改 `rng` 的序列（同 `_city_block_at` 那条规矩）。
		h *= float(p.dt_mul)
	# ---- ② 格点噪声：把"相邻地块的高度差"拉开（错落的另一半）----
	#
	# 由格坐标哈希派生 ⇒ 确定性（同一格永远同一个值，换图重建不漂）。
	# 范围 [0.82, 1.30]、**均值 1.03**，所以它几乎不改整城的平均高度，
	# 改的是"邻居之间的差" —— 从空中看，楼顶连线因此不再是一条光滑的等值线，
	# 而是**相邻高低差几百米**的参差轮廓。
	# ⚠️ 用它**不能**去抽 `rng`：那是整座城共享的顺序序列（同 ⑥ 那条 ⚠️），
	# 多抽一次后面每一次抽取都会整体移位。
	var nrng := RandomNumberGenerator.new()
	nrng.seed = _city_lot_seed(gx, gz, seed_value) ^ 0x1F2E3D4C
	h *= 0.82 + 0.48 * nrng.randf()
	# shape：0 塔+裙房 1 退台塔 3 低层连续 4 低层坡顶
	var shape := 3
	if zone == "downtown":
		shape = 0 if rng.randf() < 0.62 else 1
	elif zone == "midtown":
		shape = 0 if rng.randf() < 0.40 else (1 if rng.randf() < 0.55 else 3)
	elif zone == "fringe":
		shape = 3 if rng.randf() < 0.70 else 1
	else:
		shape = 4 if rng.randf() < 0.78 else 3
	# 配色：商务区偏冷（玻璃幕墙），住宅区偏暖（混凝土/砖）。
	#
	# ⚠️ **电平原值调亮过一档**（0.09~0.14 → 0.12~0.19）。第一版太暗，
	# 夜景里只剩"黑色的楼体 + 一圈窗带"，楼与楼之间的体量差完全读不出来；
	# 而 `_build_city` 里那点暖色自发光只够把楼"从纯黑里拉出来"，
	# 真正让楼有立体感的是**天光打在楼顶和迎风面**上的那点电平原色。
	# ⚠️ 第二十二轮下半：从"夜城的冷蓝玻璃"（0.10~0.15）改成
	# **阴天黄昏的暖灰混凝土**（0.24~0.30）—— 全城没有一盏灯，
	# 楼只能靠天光被看清，albedo 就是它唯一的亮度来源。
	var col := Color(0.300, 0.288, 0.274)
	if zone == "downtown":
		col = Color(0.268, 0.280, 0.300) if rng.randf() < 0.42 \
			else Color(0.240, 0.246, 0.262)
	elif zone == "midtown":
		col = Color(0.272, 0.276, 0.288)
	elif zone == "fringe":
		col = Color(0.284, 0.276, 0.266)
	var tone := rng.randf_range(-0.015, 0.022)
	col = Color(
		clampf(col.r + tone, 0.0, 1.0),
		clampf(col.g + tone * 0.55, 0.0, 1.0),
		clampf(col.b + tone * 0.25, 0.0, 1.0))
	# ⚠️ 把颜色**量化到 1/200**。
	# 楼体颜色本来几乎连续（每个地块都不一样），而 `_city_material()` 是按颜色字符串
	# 缓存材质的 —— 连续色会让缓存堆出几百份"看起来差不多"的材质。
	# 量化之后整座城只剩几十份材质，而 0.005 的色阶在这个尺度上根本看不出来
	#（真正的差别来自高度与剪影，不是这一档色差）。
	col = Color(
		snappedf(col.r, 0.005), snappedf(col.g, 0.005), snappedf(col.b, 0.005))
	# 窗带：
	#   ribbon —— 自下而上等距环绕（写字楼，玻璃幕墙）
	#   bands  —— 顶部若干条横向亮带（商业塔楼）
	#   sparse —— 只在楼顶几层亮（低层住宅/仓库）
	#   none   —— 不点灯
	#
	# ⚠️ 密度也是"城市才像城市"的一部分：**市中心几乎栋栋亮**（写字楼），
	# 外围才是黑的（仓库/住宅）。第一版市中心只有一半亮 ribbon，
	# 俯瞰时高楼群反而比外围更黑（实测截图）。
	var profile := "sparse"
	if zone == "downtown":
		profile = "ribbon" if rng.randf() < 0.72 else "bands"
	elif zone == "midtown":
		profile = "ribbon" if rng.randf() < 0.42 else "bands"
	elif zone == "fringe":
		profile = "bands" if rng.randf() < 0.45 else "sparse"
	else:
		profile = "sparse" if rng.randf() < 0.7 else "none"
	var lot := {
		"gx": gx, "gz": gz, "zone": zone, "shape": shape,
		"h": h, "rot": rng.randf_range(-7.0, 7.0), "color": col,
		"profile": profile,
	}
	# ---- 立面类别（1.2.3 批 G）----
	#
	# ⚠️⚠️ **用的是一个新建的、由格坐标派生的 rng，而不是传进来的 `rng`。**
	#
	# 传进来的那个 `rng` 是**顺序抽**的：从它身上多抽一次，**它后面所有的抽取
	# 全部移位** —— 楼高、配色、朝向都会跟着变（而 `suite_round20` 的
	# "市中心地块是高层"、`suite_worldscale` 的"最高一档仍在 2500~3050"
	# 正是拿这套序列在断言）。"把新抽取写到函数末尾"也能躲开，但那是一条
	# **只有读注释才知道的约定**；换一个独立的 rng 则是**结构性**的：
	# 只要不去碰 `rng`，序列就不可能被影响，谁在哪儿加代码都一样。
	# 派生种子用一次异或，保证与"地块自身的随机性"同源但互不相关。
	var frng := RandomNumberGenerator.new()
	frng.seed = _city_lot_seed(gx, gz, seed_value) ^ 0x5BF03635
	var roll := frng.randf()
	if zone == "downtown":
		lot["facade"] = Facade.GLASS if roll < 0.66 else Facade.CONCRETE
	elif zone == "midtown":
		lot["facade"] = Facade.GLASS if roll < 0.38 else Facade.CONCRETE
	elif zone == "fringe":
		# 外圈掺一点工业金属：港区/仓库那一片（1.3 的达沃空袭要在这类地形上交火）
		lot["facade"] = Facade.METAL if roll < 0.18 else Facade.CONCRETE
	else:
		# 滨水低层住宅（含坡顶小楼）：普通窗格
		lot["facade"] = Facade.CONCRETE
	return lot


## 地标占掉的格，别的楼不往这儿长。**按 `CityLayout` 分派**（1.3 批 M）。
##
## ⚠️ 原来是写死的一张静态表（奥恩贝利的台场四格）。加第二座城时那是最刺眼的一个
## 写死点：达沃的三个地标（双塔连船 / 针塔 / 集装箱港区）只能挤进奥恩贝利的格子，
## 或者改这张共享表顺带改坏老图（设计书 §3.2 的写死点 #3）。
##
## ⚠️ `layout` **带默认值 = 奥恩贝利**，这是刻意的：所有既有调用点
##（`_build_city_blocks()` 与测试）不改也能编译，而且默认值**就是"奥恩贝利"**——
## 于是那批纯函数断言从"测最后被 apply 的那张图"变成**显式在测奥恩贝利**。
## 这正是设计书 §3.6 要的那件事：断言必须指名测的是哪座城，不能靠执行顺序。
static func _city_landmark_cell(gx: int, gz: int,
		layout := MapDef.CityLayout.OENBELLI) -> bool:
	if layout == MapDef.CityLayout.DAVAO:
		# ① 双塔连船（金沙式：三塔一排）—— 格 (-5,-3) (-4,-3) (-3,-3)，
		#    即世界坐标 (-18112, -10062) (-14087, -10062) (-10062, -10062)。
		#    ⚠️ 三个格**必须相邻成一条直线**：顶上的"船"是**一条**横跨三塔的长板，
		#    塔错开一格，那条板就横不过来（而"从船底下穿过"是这张图的核心玩法）。
		if gz == -3 and gx >= -5 and gx <= -3:
			return true
		# ② 针塔（迪拜塔式）：广场北缘那一个格。
		if Vector2i(gx,gz) == CITY_DAVAO_HOTEL_CELL:
			return true
		# ③ 集装箱港区：2×2 的四个格 —— 它要的是一整片**场地**（货柜堆 + 一排龙门吊），
		#    单个格（4 km）放不下"一排吊臂"这种线性结构。
		if gx >= 4 and gx <= 5 and gz >= 1 and gz <= 2:
			return true
		return false
	# ---- 奥恩贝利（台场）----
	#
	# ⚠️⚠️ 2026-09-28：这张表从 **4 格扩到 7 格**（详规 §E.4 给的是 6 格，
	# 多出来的那一格见下面 ⚠️）。**格表与几何必须一起改** —— 这条规矩就是
	# 本函数注释里那条"分派用一个枚举、而不是设计书里那个
	# `city_landmarks: Array` 字段"：分开成两张表必然分叉。
	#
	# | 格 | 谁 | 依据 |
	# |---|---|---|
	# | `(-4, 6)`   | 自由女神 + 海滨公园（**新增**） | 详规 §E.1 #2（主岛最靠海那一排） |
	# | `(-3, 1)`   | 富士电视台（从 `(-3500, -3500)` 挪来） | 详规 §E.1 #3 |
	# | `( 4, 2)`   | **地面停车场**（原独角兽立像位） | 2026-09-28 用户"拆像换场" |
	# | `(-12,-3)`  | 东京国际展示场（从 `(-7200, -9500)` 挪远） | 详规 §E.1 #5（有明块内） |
	# | `(-1,-5)` `(0,-5)` `(1,-5)` | 中央塔 + **两侧各留一格空地** | 详规 §E.1 #6 |
	#
	# ⚠️ **详规 §E.4 只列了 `[-1,-5] [1,-5]` 两格，漏了塔自己站的 `(0,-5)`**：
	# `_add_box("LandmarkTower", …, -18112.5)` 的塔心正好是 `(0,-5)` 的格心
	#（`(0 + 0.5) × 4 025 = 2 012.5`、`(-5 + 0.5) × 4 025 = -18 112.5`）。
	# 漏掉那一格的后果是**楼会长进塔身上**（那一格不被压抑），而这与 §E.4
	# 自己那句"它周围要留广场级空地"正相反。⇒ 取**三格**：塔自己 + 两侧。
	#
	# ⚠️ `(4, 2)` 是**独角兽立像本来该在的位**（详规 §E.2 诊断"原来那台方位反了
	# 180°"）。用户这一轮的口径是"**拆了换成停车场**"，所以换上去的是停车场、
	# 但**站位不动** —— 于是"拆像"不会顺带把那一格还给住宅楼。
	return (gx == -4 and gz == 6) or (gx == -3 and gz == 1) or (gx == 4 and gz == 2) \
		or (gx == -12 and gz == -3) \
		or (gz == -5 and gx >= -1 and gx <= 1)


## 这一格**能不能建城**（岛内 / 不在水上 / 不在中央广场 / 不在公园 / 不在例外矩形 /
## 不是地标格）。**逐格纯判据** —— `_build_city_blocks()` 与道路的"内部线让位"
##（`_city_road_inner_suppressed()`）**共用同一份**：两边分开写迟早会分岔，
## 那种分岔的表现是"某条街在某块地中间断了一截"，看图很难归因。
##
## ⚠️ 判据的顺序与内容与"拆出来之前"**完全一致**（岛外 → 水 → 广场 → 公园 → 例外 → 地标）：
## 拆函数只是**为了复用**，不是趁机调整顺序或口径（那会让奥恩贝利的格集合变）。
## ⚠️ 干燥判据**不在这里**：它在子地块那一层（每栋楼查自己的 1 个中心 + 4 个角）——
## 一格 2~8 栋时"整格丢"会把岸线附近整片削光，因为岸线是正弦、不与格线对齐。
func _city_cell_buildable(gx: int, gz: int) -> bool:
	var px := (float(gx) + 0.5) * CITY_CBLOCK
	var pz := (float(gz) + 0.5) * CITY_CBLOCK
	if not city_is_land(float(gx) + 0.5, float(gz) + 0.5, map.city_layout):
		return false                          # 岛外
	if is_water_at(px, pz, map.city_layout):
		return false                          # 海湾 / 运河
	# ⚠️ `y` 只给"中央广场半径"那条判据用；楼本身的落位标高由**每个子地块自己**算
	#（宁可埋进去一点，也不能悬空 —— 悬空在俯瞰图上会看到楼下的地面透出来）。
	var py := _city_landform(px, pz, map.city_layout)
	if Vector3(px, py, pz).length() < float(CITY_SHAPE[map.city_layout].plaza_r):
		return false                          # 中央广场（达沃 = 0 ⇒ 不挖）
	var park: Array = CITY_PARK[map.city_layout]
	if park.size() == 3 and pz > float(park[0]) and pz < float(park[1]) \
			and absf(px) < float(park[2]):
		return false                          # 滨水公园
	for rect: Array in CITY_EXCLUDE[map.city_layout]:
		if px > float(rect[0]) and px < float(rect[1]) \
				and pz > float(rect[2]) and pz < float(rect[3]):
			return false                      # 例外矩形（绿地 / 机场）
	if _city_landmark_cell(gx, gz, map.city_layout):
		return false                          # 地标地块
	return true


## 大格组（`span` 格）**每一格**都满足：可建，且**内部那条格线是支路**。
##
## ⚠️ 为什么要检查"内部是支路"：跨格会把内部那条路**吃掉**
##（`_city_road_inner_suppressed()`）。吃干道会让路网骨架断掉 ——
## 运河桥、街角铺装、高架主线全都挂在干道上。
## 内部是干道时这一组**不合并**：退回"每格各自成块"（`used = 1`），两条路都留着，
## 读起来就是"大格被一条大道切成两半"，符合真实城市。
##
## ## ⚠️⚠️ 2026-09-28 本轮修：**组首格自己也要查**
## 原实现只 `for k in range(1, span)` 查 `ax + 1 … ax + span - 1`，**漏了 `ax` 自己** ——
## 于是文档写的"**每一格**"是假的。后果是一条**只在海岸边才出现**的静默失效：
## 组首格 `ax` 不可建（水/岸/绿地）而 `ax+1` 可建时，
##   · 建块那边：`city_block_plan(ax)` → `ok = false` ⇒ 不建；
##     `city_block_plan(ax+1)` → `merged = true`、`big = true`、`anchor = (ax+1 == ax) = false` ⇒ **也不建**
##     ⇒ **整组一栋楼都没有**；
##   · 建街那边：`_city_road_inner_suppressed()` 复用**同一个**（漏检的）函数 ⇒ 返回 `true`
##     ⇒ **内部那条街被吃掉**。
## 净效果 = "**这里没楼，但路凭空断了一截**"。
## 实测达沃有 **2 截**（`gi = -13, gz = -6 / 15`，组首格 `gx0 = -14` 不可建）。
## ⇒ 修复就是**把 `ax` 也纳入检查**（一行），让"组内每一格"这句话真的成立 ——
## 一处判据、两个消费者（建块 / 建街）同时被纠正。
func _city_group_buildable(ax: int, gz: int, span: int) -> bool:
	if not _city_cell_buildable(ax, gz):
		return false                      # ⚠️ 组首格自己（原实现漏了这一行）
	for k in range(1, span):
		if city_road_width(ax + k) != CITY_ROAD_W_LOCAL:
			return false
		if not _city_cell_buildable(ax + k, gz):
			return false
	return true


## 一格 → 它的**块计划**（组首格 / 跨几格 / 大格还是小格 / 块的边长与中心）。
##
## ## ⚠️⚠️ 这个函数存在的唯一理由：**让"划分"只有一份真源**
## `_build_city_blocks()` 与诊断工具（`tools/_b8_zone_dump.gd` 出的"划分图"）必须
## **共用同一份**判定。分开写迟早会分岔，而分岔的表现是
## "探针画出来的划分图与真正建出来的城对不上" —— **看图看不出来**，
## 只能靠逐格对账，代价极高（这正是 `_city_cell_buildable()` 被抽出来的同一个理由）。
##
## 返回（`ok = false` = 这一格不建城）：
## | 键 | 含义 |
## |---|---|
## | `anchor` | `gx` 是不是本块的**主角**（不是就该 `continue`，它已被主角盖住） |
## | `gx0` | **块首格**（大格 = 组首格；小格 = **自己**；`span = 1` 时恒 == `gx`） |
## | `used` | 这块地**跨几格**（大格 = `span`，小格 = 1） |
## | `big` | 大格 / 小格 |
## | `grade` | `city_block_grade()` 的整份返回（`n / nx / nz / skip / fill` 都在里面） |
## | `edge` / `edge_z` | 块的**边长**（x 向已含跨格；两向都被 `city_block_ceiling()` 夹过） |
## | `pos` | 块心（y = 0，落位标高由各子地块自己算） |
##
## ## ⚠️⚠️ "哈希键"与"块首格"是**两个不同的东西**（这一条踩过一次）
## 哈希键是**组首格**：小格组里的每一格都拿**同一个** `grade`（否则组内两格会
## 一个高一个矮，而"组"这个概念就没意义了）。
## 块首格在小格时是**自己** —— 写错成"组首格"的后果是：
## **小格组的第 2 格拿 `gx0 != gx` ⇒ 被当成"已被主角盖住"而整格跳过**
##（实测：达沃街廓 459 → 358、栋楼 1987 → 1756，而大格数 198 一字不变 ⇒
##  极具迷惑性：粗看只像是"小格变少了"）。
##
## ## ⚠️⚠️ 同一天更晚：**`_city_group_buildable()` 漏检组首格**（第二个坑）
## 那个函数原实现只查 `ax + 1 … ax + span - 1`，**没查 `ax` 自己**。
## 于是"组首格不可建（水/岸/绿地）、第 2 格可建"的组会出现：
##   · 建块：`plan(gx0)`=`ok false`、`plan(gx0+1)` 虽 `merged = true` 但
##     `big` 时 `anchor = (gx0+1 == gx0) = false` ⇒ **整组一栋不建**；
##   · 建街：`_city_road_inner_suppressed()` 复用同一个（漏检的）函数
##     ⇒ 内部那条街**照样被吃掉** ⇒ 净效果 = **没楼的地方路断了一截**。
## 修好后（`_city_group_buildable` 第一行补 `_city_cell_buildable(ax, gz)`）：
## 达沃 459 → **461**（大 198 → **202** / 小 261 → **259**），内部街 120 → **119** 截，
## 反向违例 **2 → 0**。奥恩贝利一个数都没动（`span = 1` ⇒ 这条路根本不走）。
## 2026-10-08: replaces the historical x-only, fixed-slot plan described above.
## A single cached ownership map keeps streets and building blocks consistent.
## Complete surface-road envelope: asphalt plus both sidewalk slabs.
static func city_road_half_extent(gi: int) -> float:
	var width := city_road_width(gi)
	return width*0.5+maxf(90.0,width*0.38)

## Dense footprint test shared by roads and buildings. Planned water and actual
## terrain elevation both apply; checking a centreline alone is insufficient.
func _city_surface_rect_clear(center: Vector2, size: Vector2, yaw: float, margin := 0.0) -> bool:
	var extent := size+Vector2.ONE*margin*2.0
	var nx := maxi(1,int(ceil(extent.x/96.0)))
	var nz := maxi(1,int(ceil(extent.y/96.0)))
	var angle := -deg_to_rad(yaw)
	for ix in range(nx+1):
		for iz in range(nz+1):
			var q := center+Vector2((float(ix)/nx-0.5)*extent.x,(float(iz)/nz-0.5)*extent.y).rotated(angle)
			if is_water_at(q.x,q.y,map.city_layout) or not city_is_dry(q.x,q.y,map.city_layout): return false
	return true

## Prepare every street and transport reservation before placing any house.
## Local streets and buildings use cached copies of the same urban plan.
func _city_prepare_placement() -> void:
	_city_placement=CityPlacement.new()
	_city_urban_cache.clear()
	_city_placement_dropped.clear()
	_city_placement_relocated=0
	var cb := float(CITY_CBLOCK)
	var half := CITY_GRID/2
	for axis in 2:
		for gi in range(-half,half+1):
			for gk in range(-half,half):
				if _city_road_inner_suppressed(axis,gi,gk): continue
				var a := Vector2(gi*cb,gk*cb) if axis==0 else Vector2(gk*cb,gi*cb)
				var b := a+(Vector2(0,cb) if axis==0 else Vector2(cb,0))
				_city_placement.add_segment(a,b,city_road_half_extent(gi)*2.0,"surface")
	for x in range(-half,half):
		for z in range(-half,half):
			var plan := city_block_plan(x,z)
			if not plan.get("ok",false) or not plan["anchor"]: continue
			var ax: int=plan["gx0"]; var az: int=plan["gz0"]
			var nx: int=plan["used"]; var nz: int=plan["used_z"]
			var lo := Vector2(ax*cb+city_road_width(ax)*0.5,az*cb+city_road_width(az)*0.5)
			var hi := Vector2((ax+nx)*cb-city_road_width(ax+nx)*0.5,(az+nz)*cb-city_road_width(az+nz)*0.5)
			plan["street_bounds"]=Rect2(lo,hi-lo)
			var safe := Vector2(city_block_ceiling(cb,ax,ax+nx),city_block_ceiling(cb,az,az+nz))
			var urban := CityUrbanPlan.make(plan,map.city_layout,map.city_seed,safe)
			_city_urban_cache[Vector2i(ax,az)]=urban
			for lane: Dictionary in urban["lanes"]:
				_city_placement.add_segment(lane["a"],lane["b"],lane["width"]+3.0,"local")
	_city_reserve_transport()

## Try moving within the same allocated plot, then reduce footprint modestly.
## A failed plot remains open rather than placing a building in a transport lane.
func _city_fit_parcel(urban: Dictionary, parcel: Dictionary) -> Dictionary:
	var at: Vector2=parcel["pos"]
	var size: Vector2=parcel["size"]
	var yaw: float=parcel["yaw"]
	var reason: String=_city_placement.conflict(CityPlacement.footprint(at,size,yaw))
	if reason=="" and _city_surface_rect_clear(at,size,yaw,12.0):
		return {"ok":true,"pos":at,"size":size,"relocated":false}
	if reason=="": reason="water"
	var plot: Rect2=parcel["plot"]
	var origin: Vector2=Rect2(urban["root"]).get_center()
	var angle := deg_to_rad(float(urban["heading"]))
	var local_angle := deg_to_rad(yaw-float(urban["heading"]))
	var ca := absf(cos(local_angle)); var sa := absf(sin(local_angle))
	for scale_factor: float in [1.0,0.86,0.72]:
		var candidate_size := size*scale_factor
		var extent := Vector2(ca*candidate_size.x+sa*candidate_size.y,sa*candidate_size.x+ca*candidate_size.y)
		var room := (plot.size-extent)*0.5-Vector2.ONE*12.0
		if room.x<0 or room.y<0: continue
		for offset: Vector2 in [Vector2.ZERO,Vector2(-0.9,-0.9),Vector2(0.9,-0.9),Vector2(-0.9,0.9),Vector2(0.9,0.9),Vector2(-0.9,0),Vector2(0.9,0),Vector2(0,-0.9),Vector2(0,0.9)]:
			var local_at := plot.get_center()+room*offset
			var candidate := origin+(local_at-origin).rotated(-angle)
			if _city_placement.conflict(CityPlacement.footprint(candidate,candidate_size,yaw))!="": continue
			if _city_surface_rect_clear(candidate,candidate_size,yaw,12.0):
				return {"ok":true,"pos":candidate,"size":candidate_size,"relocated":true}
	return {"ok":false,"reason":reason}

func _city_reserve_transport() -> void:
	var shape: Dictionary=CITY_SHAPE[map.city_layout]
	for line: Array in shape.via_lines:
		var along_z := str(line[0])=="z"
		var pos := float(line[1])
		var a := Vector2(pos,float(line[2])) if along_z else Vector2(float(line[2]),pos)
		var b := Vector2(pos,float(line[3])) if along_z else Vector2(float(line[3]),pos)
		_city_placement.add_segment(a,b,CITY_VIA_W+48.0,"viaduct")
	var r := float(shape.via_ring_r)
	if r>0: _city_reserve_ring(r,CITY_VIA_W+80.0,72,"viaduct")
	r=float(shape.monorail_r)
	if r>0: _city_reserve_ring(r-250.0,800.0,96,"monorail")
	var along_z := str(shape.bridge_axis)=="z"
	var pos := float(shape.bridge_pos)
	var start := float(shape.bridge_center)-float(shape.bridge_span)*0.5
	var end := float(shape.bridge_center)+float(shape.bridge_span)*0.5
	var a := Vector2(pos,start) if along_z else Vector2(start,pos)
	var b := Vector2(pos,end) if along_z else Vector2(end,pos)
	_city_placement.add_segment(a,b,float(shape.bridge_w)+48.0,"bridge")
	var ramps: Array[Transform3D]=[]
	var piers: Array[Vector3]=[]
	if map.city_layout==MapDef.CityLayout.OENBELLI:
		_build_bridge_ramps_oenbelli(shape.bridge_center,shape.bridge_span,shape.bridge_deck_y,pos,ramps,piers)
	else:
		_build_bridge_ramps_davao(shape.bridge_center,shape.bridge_span,shape.bridge_deck_y,pos,ramps,piers)
	for ramp: Transform3D in ramps:
		_city_placement.add_polygon(CityPlacement.transformed_footprint(ramp),"ramp")

func _city_reserve_ring(radius: float, width: float, segments: int, kind: String) -> void:
	for i in segments:
		var a := TAU*float(i)/segments
		var b := TAU*float(i+1)/segments
		_city_placement.add_segment(Vector2(cos(a),sin(a))*radius,Vector2(cos(b),sin(b))*radius,width,kind)

func _city_macro_blocks() -> Dictionary:
	var key := "%s:%s" % [map.city_layout,map.city_seed]
	if key != _city_macro_key:
		var valid: Dictionary = {}
		var half := CITY_GRID/2
		for x in range(-half,half):
			for z in range(-half,half):
				if _city_cell_buildable(x,z): valid[Vector2i(x,z)]=true
		_city_macro_owners=CityUrbanPlan.blocks(valid,map.city_seed,half)
		_city_macro_key=key
	return _city_macro_owners

func city_block_plan(gx: int, gz: int) -> Dictionary:
	var owners := _city_macro_blocks()
	if not owners.has(Vector2i(gx,gz)): return {"ok":false}
	var block: Rect2i = owners[Vector2i(gx,gz)]
	var ax := block.position.x
	var az := block.position.y
	var used := block.size.x
	var used_z := block.size.y
	var area := used*used_z
	var rng := RandomNumberGenerator.new()
	rng.seed=_city_lot_seed(ax,az,map.city_seed) ^ 0x159E5A43
	var zone := CityUrbanPlan.district(ax,az,map.city_layout,map.city_seed)
	var kind: String = zone["kind"]
	var density := Vector2i(3,5)
	if kind=="campus": density=Vector2i(2,3)
	elif kind=="waterfront": density=Vector2i(2,4)
	elif kind=="courtyard": density=Vector2i(4,6)
	elif kind=="lanes": density=Vector2i(5,7)
	var n := rng.randi_range(density.x*area,density.y*area)
	var fill := rng.randf_range(0.76,0.94)
	if kind=="waterfront": fill=rng.randf_range(0.68,0.86)
	var grade := {"big":area>1,"fill":fill,"n":n,"gx0":ax,"span":used}
	var cb := float(CITY_CBLOCK)
	var edge := minf(cb*used*fill,city_block_ceiling(cb,ax,ax+used))
	var edge_z := minf(cb*used_z*fill,city_block_ceiling(cb,az,az+used_z))
	return {"ok":true,"anchor":gx==ax and gz==az,"gx0":ax,"gz0":az,
		"used":used,"used_z":used_z,"big":area>1,"merged":area>1,
		"grade":grade,"edge":edge,"edge_z":edge_z,"span":used,
		"pos":Vector3((ax+used*0.5)*cb,0,(az+used_z*0.5)*cb)}


## Build variable street blocks, then unequal parcels in each block. Internal
## roads, setbacks and buildings share one plan; lamps remain map-specific.
func _build_city_blocks(staged := false) -> void:
	var slice_started := Time.get_ticks_usec()
	var half := CITY_GRID / 2
	var cblock := ARENA_RADIUS / float(CITY_GRID)
	var local_roads: Array[Transform3D] = []
	var local_kerbs: Array[Transform3D] = []
	var pocket_greens: Array[Transform3D] = []
	_city_parcel_summary.clear()
	var built := 0
	var big_n := 0
	var small_n := 0
	var mech: Array[Transform3D] = []         # 屋顶设备箱（MultiMesh）
	var roofs: Array[Transform3D] = []        # 坡屋顶（MultiMesh）
	var bands: Array[Transform3D] = []        # 横向线脚（MultiMesh，批 K · 轮 4）
	_city_window_xf = []
	_city_beacon_xf = []
	_city_lot_h = {}
	_city_body_count = 0
	_city_lot_built = 0
	for gx in range(-half, half):
		for gz in range(-half, half):
			if staged and Time.get_ticks_usec()-slice_started>8000:
				build_stage.emit(0.34+0.12*float(gx+half)/CITY_GRID,"建造城市街区……")
				await get_tree().process_frame
				slice_started=Time.get_ticks_usec()
			var plan: Dictionary = city_block_plan(gx, gz)
			if not bool(plan["ok"]):
				continue                          # 岛外 / 水 / 广场 / 公园 / 绿地 / 地标
			if not bool(plan["anchor"]):
				continue                          # 已被本组的主角（`gx0`）盖住
			var gx0: int = plan["gx0"]
			var used: int = plan["used"]
			var gz0: int = plan["gz0"]
			var used_z: int = plan["used_z"]
			var grade: Dictionary = plan["grade"]
			var lot_rng := RandomNumberGenerator.new()
			lot_rng.seed = _city_lot_seed(gx0, gz0, map.city_seed)
			var lot := city_lot_for(gx0, gz0, lot_rng, map.city_seed, map.city_layout)
			for gk in used:
				for zk in used_z:
					_city_lot_h[Vector2i(gx0 + gk, gz0 + zk)] = lot.h * map.city_height_mul
			if bool(grade["big"]): big_n += 1
			else: small_n += 1
			var safe := Vector2(city_block_ceiling(cblock,gx0,gx0+used),city_block_ceiling(cblock,gz0,gz0+used_z))
			var street_min := Vector2(gx0*cblock+city_road_width(gx0)*0.5,gz0*cblock+city_road_width(gz0)*0.5)
			var street_max := Vector2((gx0+used)*cblock-city_road_width(gx0+used)*0.5,(gz0+used_z)*cblock-city_road_width(gz0+used_z)*0.5)
			plan["street_bounds"] = Rect2(street_min,street_max-street_min)
			var urban: Dictionary = _city_urban_cache[Vector2i(gx0,gz0)]
			var kind: String = urban["kind"]
			_city_parcel_summary[kind] = int(_city_parcel_summary.get(kind,0))+1
			for lane: Dictionary in urban["lanes"]:
				_append_city_parcel_lane(lane,local_roads,local_kerbs)
			for green: Rect2 in urban["greens"]:
				_append_city_pocket_green(green,pocket_greens)
			for parcel: Dictionary in urban["parcels"]:
				var slot: int = parcel["slot"]
				var fit := _city_fit_parcel(urban,parcel)
				if not fit["ok"]:
					var reason: String=fit["reason"]
					_city_placement_dropped[reason]=int(_city_placement_dropped.get(reason,0))+1
					continue
				var at: Vector2=fit["pos"]
				var footprint: Vector2=fit["size"]
				if fit["relocated"]: _city_placement_relocated+=1
				var bounds := CityPlacement.bounds(CityPlacement.footprint(at,footprint,parcel["yaw"]))
				var srng := RandomNumberGenerator.new()
				srng.seed=_city_lot_seed(gx0*CITY_SUB_SLOTS+slot,gz0*CITY_SUB_SLOTS,map.city_seed) ^ 0x7A31B5C9
				var gy := -1.0e9
				for ix in 3:
					for iz in 3:
						var sample := bounds.position+bounds.size*Vector2(ix*0.5,iz*0.5)
						gy=maxf(gy,_city_landform(sample.x,sample.y,map.city_layout))
				var sub := lot.duplicate()
				sub["slot"] = slot
				sub["rot"] = parcel["yaw"]
				sub["h"] = minf(float(lot["h"]),maxf(160.0/map.city_height_mul,float(lot["h"])*float(parcel["height"])))
				if bool(parcel["lowrise"]):
					sub["shape"]=4 if kind=="courtyard" else 3
					sub["facade"]=Facade.CONCRETE
					sub["profile"]="sparse"
				_city_block_at(Vector3(at.x,gy,at.y),footprint.x,footprint.y,sub,srng,mech,roofs,bands)
				built+=1

	_city_lot_built = built
	print("[city] transport placement: relocated=",_city_placement_relocated," rejected=",_city_placement_dropped)
	if not local_roads.is_empty():
		_add_multimesh("CityLocalStreets",local_roads,_city_material(Color(0.055,0.053,0.052)))
	if not local_kerbs.is_empty():
		_add_multimesh("CityLocalKerbs",local_kerbs,_city_material(Color(0.18,0.18,0.19)))
	if not pocket_greens.is_empty():
		_add_multimesh("CityPocketGreens",pocket_greens,_city_material(Color(0.105,0.135,0.10)))
	print("[city] urban districts ",_city_parcel_summary," local street pieces=",local_roads.size()," green pieces=",pocket_greens.size())
	if not mech.is_empty():
		_add_multimesh("CityRoofMech", mech,
			_city_material(Color(0.075, 0.078, 0.086)))
	if not roofs.is_empty():
		_add_multimesh("CityRoofs", roofs,
			_city_material(Color(0.105, 0.098, 0.092)))
	if not bands.is_empty():
		_add_multimesh("CityBands", bands,
			_city_material(CITY_BAND_ALBEDO, Color(0, 0, 0, 0), 2.4, true),
			_city_band_shell())
	print("[city] %s: %d variable blocks (%d merged / %d single), %d buildings, %d bodies"
		% [map.name_cn,big_n+small_n,big_n,small_n,built,_city_body_count])


func _append_city_parcel_lane(lane: Dictionary, transforms: Array[Transform3D], kerbs: Array[Transform3D]) -> void:
	var a: Vector2 = lane["a"]
	var b: Vector2 = lane["b"]
	var delta := b-a
	var length := delta.length()
	if length<1: return
	var width: float = lane["width"]
	var normal := Vector2(-delta.y,delta.x).normalized()*width*0.5
	var count := maxi(1,int(ceil(length/250.0)))
	var yaw := rad_to_deg(atan2(delta.x,delta.y))
	for n in count:
		var p := a+delta*float(n)/count
		var q := a+delta*float(n+1)/count
		var safe := true
		for sample: Vector2 in [p,q,(p+q)*0.5,p+normal,p-normal,q+normal,q-normal]:
			if is_water_at(sample.x,sample.y,map.city_layout) or not city_is_dry(sample.x,sample.y,map.city_layout):
				safe=false
				break
		if not safe or not _city_surface_rect_clear((p+q)*0.5,Vector2(width,p.distance_to(q)+0.5),yaw,8.0): continue
		var y0 := _city_landform(p.x,p.y,map.city_layout)
		var y1 := _city_landform(q.x,q.y,map.city_layout)
		var center := (p+q)*0.5
		var run := p.distance_to(q)
		var pitch := rad_to_deg(-atan2(y1-y0,run))
		var road := _sized_pitch(Vector3(center.x,(y0+y1)*0.5+CITY_ROAD_LIFT,center.y),
			Vector3(width,CITY_ROAD_T,sqrt(run*run+(y1-y0)*(y1-y0))+0.5),yaw,pitch)
		transforms.append(road)
		for side: float in [-1.0,1.0]:
			var kerb := road
			kerb.origin+=road.basis.x*side*0.48+Vector3.UP*2.0
			kerb.basis.x=road.basis.x.normalized()*3.0
			kerb.basis.y*=0.3
			kerbs.append(kerb)

func _append_city_pocket_green(rect: Rect2, transforms: Array[Transform3D]) -> void:
	var nx := maxi(1,int(ceil(rect.size.x/500)))
	var nz := maxi(1,int(ceil(rect.size.y/500)))
	var size := rect.size/Vector2(nx,nz)
	for ix in nx:
		for iz in nz:
			var center := rect.position+(Vector2(ix,iz)+Vector2.ONE*0.5)*size
			var height := -1.0e9
			var safe := true
			for dx: float in [-0.5,0.0,0.5]:
				for dz: float in [-0.5,0.0,0.5]:
					var p := center+Vector2(dx,dz)*size
					if is_water_at(p.x,p.y,map.city_layout) or not city_is_dry(p.x,p.y,map.city_layout):
						safe=false
						break
					height=maxf(height,_city_landform(p.x,p.y,map.city_layout))
				if not safe: break
			if safe: transforms.append(_sized(Vector3(center.x,height+0.8,center.y),Vector3(size.x,1.2,size.y),0))

func _city_block_at(pos: Vector3, bw: float, bd: float, lot: Dictionary,
		rng: RandomNumberGenerator, mech: Array[Transform3D],
		roofs: Array[Transform3D], bands: Array[Transform3D]) -> void:
	# ⚠️ 楼体量**按图给**（1.3 批 M · 轮 2）：`city_height_mul` / `city_tower_w`
	# 是 `MapDef` 上的两个倍率，默认 1.0 ⇒ 奥恩贝利的几何**逐位不变**。
	#
	# ⚠️⚠️ 只乘在**已经抽出来的随机数**上 —— **绝不**在 `_city_rng` 上多抽一次。
	# 那个发生器是整座城共享的一条序列（同 ⑥ 塔顶桅杆那段 ⚠️）：多抽一次，
	# 它后面每一次抽取都会整体平移（楼高 / 配色 / 偏心 / 退台尺寸全跟着变），
	# 而 `suite_worldscale` 的"市中心楼高 1300~3200"正是拿这条序列在断言。
	# 乘一个标量则**不改序列**：同一个格号永远算出同一栋楼。
	var h: float = lot.h * map.city_height_mul
	var shape: int = lot.shape
	var col: Color = lot.color
	var yaw: float = lot.rot
	# ⚠️ B7：名字里带上**子地块序号** —— 一格现在有 2~8 栋楼，
	# 不带序号就会重名，而 Godot 4.7 会把重名节点改成 `@StaticBody3D@1346`
	#（丢掉原名，所有按前缀扫场景的探针当场失明）。
	var tag := "%d_%d_%d" % [lot.gx, lot.gz, int(lot.get("slot", 0))]
	# ⚠️ B7：同一街廓里每栋楼**颜色微调**一档 ——
	# 否则 8 栋楼共用一个 `lot.color`，俯视读起来还是一整块大板。
	# 微调后**照旧量化到 1/200**（`_city_material()` 按颜色字符串缓存材质）。
	var tint := rng.randf_range(-0.030, 0.030)
	col = Color(clampf(col.r + tint, 0.0, 1.0), clampf(col.g + tint, 0.0, 1.0),
		clampf(col.b + tint, 0.0, 1.0))
	col = Color(snappedf(col.r, 0.005), snappedf(col.g, 0.005),
		snappedf(col.b, 0.005))
	var sx := bw * rng.randf_range(0.72, 0.96)
	var sz := bd * rng.randf_range(0.72, 0.96)
	# ---- ① 裙房（podium）----
	# 高度只有塔楼的 4%~9%，但**占地比塔楼大** —— 街道两侧因此有了实体的"墙脚"。
	var pod_h: float = clampf(h * rng.randf_range(0.04, 0.09), 60.0, 240.0)
	_add_city_body("Podium_%s" % tag,
		pos + Vector3(0.0, pod_h * 0.5, 0.0), Vector3(sx, pod_h, sz),
		col.darkened(0.18), yaw, Facade.PODIUM)
	_city_body_count += 1
	# ---- ② 塔楼 ----
	# ⚠️ `city_tower_w` 乘在**抽出之后**（同函数开头那条 ⚠️）：默认 1.0 时
	# 奥恩贝利这两行与加倍率之前**逐位相同**。
	#
	# ## ⚠️ 它**可以 > 1**（2026-09-28：达沃 `0.62 → 1.55`，"太细"那条）
	# 乘数上界由**裙房**兜着，不是一个拍脑袋的数：
	#   塔宽 = `[0.30, 0.46] × 1.55` = **`[0.465, 0.713]`** < 裙房下限 `0.72`
	# ⇒ 塔楼**恒在裙房之内**。谁再往上调这个倍率（或调 `0.30/0.46` 那对系数），
	#   **必须重算这条不等式**：越过 `0.72` 之后塔楼会突到裙房外面，
	#   而它是一根几千米高的柱子 —— 悬挑几十米在俯视图上只是一圈亮边，
	#   在贴地视角却是一整面悬空的墙，**很难查到是这个数引起的**。
	var tw := bw * rng.randf_range(0.30, 0.46) * map.city_tower_w
	var td := bd * rng.randf_range(0.30, 0.46) * map.city_tower_w
	var tower_h := h - pod_h
	# 塔心在裙房上有轻微偏心：每栋都不一样，楼群因此不是"千篇一律"
	var off := Vector3(
		rng.randf_range(-0.11, 0.11) * sx, 0.0,
		rng.randf_range(-0.11, 0.11) * sz).rotated(Vector3.UP,deg_to_rad(yaw))
	# 立面类别由 `city_lot_for()` 按分区定（市中心多半是玻璃幕墙）。
	# 这个字段**只影响材质**，不参与任何 rng 抽取 —— 所以它不影响楼高/配色/几何。
	var facade: int = lot.get("facade", Facade.CONCRETE)
	_add_city_body("Tower_%s" % tag,
		pos + Vector3(off.x, pod_h + tower_h * 0.5, off.z), Vector3(tw, tower_h, td),
		col, yaw, facade)
	_city_body_count += 1
	# ---- ③ 退台 + 顶冠 ----
	# 塔顶再收一层：黄昏里的剪影因此有"脖子"，不是一根等宽的柱子。
	var top_y := pod_h + tower_h
	if shape == 0 or shape == 1:
		var sh := tower_h * rng.randf_range(0.10, 0.20)
		var sw := tw * 0.68
		var sd := td * 0.68
		# 退台跟着塔楼用同一类立面（否则一栋楼的上下两截会"突变材质"）；
		# 顶冠太小，窗格在它上面只会变成噪点，一律纯色。
		_add_city_body("Setback_%s" % tag,
			pos + Vector3(off.x, top_y + sh * 0.5, off.z),
			Vector3(sw, sh, sd), col.darkened(0.10), yaw, facade)
		_add_box("Crown_%s" % tag,
			pos + Vector3(off.x, top_y + sh + 14.0, off.z),
			Vector3(sw * 0.45, 28.0, sd * 0.45), col.darkened(0.25), yaw)
		top_y += sh
		_city_body_count += 2
	# ---- ④ 屋顶设备箱（MultiMesh，纯装饰）----
	mech.append(_sized(
		pos + Vector3(off.x + tw * 0.16, top_y + 22.0, off.z - td * 0.16),
		Vector3(tw * 0.26, 44.0, td * 0.26), yaw))
	if shape >= 3 and rng.randf() < 0.6:
		mech.append(_sized(
			pos + Vector3(off.x - tw * 0.20, top_y + 18.0, off.z + td * 0.18),
			Vector3(tw * 0.20, 36.0, td * 0.22), yaw))
	# ---- ⑤ 低层住宅的坡屋顶（MultiMesh）----
	if shape == 4:
		roofs.append(_sized(pos + Vector3(off.x, top_y + 30.0, off.z),
			Vector3(tw * 0.95, 56.0, td * 0.95), yaw))
	# ---- ⑥ 塔顶桅杆（批 H · 轮 3）----
	#
	# 天际线剪影里最便宜、也最一眼可辨的一项是"针"：高楼顶上立一根细杆。
	# 只给高塔加（`h > 900`）—— 矮楼也加针的话，整座城像集体长了天线，反而假。
	#
	# ⚠️ **刻意不用 `_city_rng`**：那个发生器是**整座城共享的一条序列**，
	# 在这里多抽一次，它后面每一次抽取的结果都会整体平移 —— 楼高、配色、偏心、
	# 退台尺寸全部跟着变（`suite_worldscale` 里"最高一档仍在 2500~3050"
	# 那类断言会立刻红，而根因藏在几百行之外，极难查）。
	# 改用格坐标算一个确定性的伪随机高度：**不动那条序列**，每栋楼也各不相同。
	# `37 / 71` 是两个质数，`mod 97` 把相邻地块的高度彻底打散。
	if h > 900.0:
		# ⚠️ 这一行**必须让 `float(lot.gx * 37 + lot.gz * 71)` 出现在**同一行**上：
		# `suite_gfx_map.gd:424` 是按**源码子串**钉着它的（换行会让它找不到 ⇒ 假红）。
		var gsum := float(lot.gx * 37 + lot.gz * 71)
		var jitter := fmod(absf(gsum + float(int(lot.get("slot", 0)) * 23)), 97.0)
		var mast_h := 70.0 + jitter
		mech.append(_sized(
			pos + Vector3(off.x, top_y + mast_h * 0.5, off.z),
			Vector3(3.6, mast_h, 3.6), yaw))
		# ---- 航空障碍灯（1.3 批 M）----
		#
		# 桅杆尖上那颗红星。它给"塔顶"这件事一个**从任何角度都读得出**的读数：
		# 侧视时桅杆是剪影里的一根细针（几公里外只有一两个像素宽），
		# 而一颗自发光红点在夜里一眼就能定位 —— 夜航城市最便宜也最有效的灯。
		#
		# ⚠️ 位置用 `top_y + mast_h + 16`（在桅杆**之上**）：桅杆本身是 MultiMesh 里的
		# 一个 instance，灯若与它同心就会**埋在杆里**（杆宽 3.6 m、灯 30 m，看起来像"灯笼"）。
		# ⚠️ 同 ⑥⑦：**一次 `_city_rng` 都不抽**。
		if map.city_lights == MapDef.CityLights.FULL:
			_city_beacon_xf.append(_sized(
				pos + Vector3(off.x, top_y + mast_h + 16.0, off.z),
				Vector3(30.0, 30.0, 30.0), yaw))
	# ---- ⑦ 横向线脚（批 K · 轮 4，MultiMesh，纯装饰）----
	#
	# 用户："楼房地面的褶皱" → 方向定为「楼体线脚（几何）」，理由见
	# `CITY_BAND_PITCH` 那段常数注释（一句话：**线脚是几何，不吃窗格淡出**）。
	#
	# ⚠️⚠️ **一次 `_city_rng` 都不抽**（同 ⑥ 塔顶桅杆）。抖动由格坐标算（见 ② 的 `jit`）。
	# ① **裙房檐口**：一条比裙房大一圈的压顶。它是"墙脚"与"楼身"的分界，
	#    也是整栋楼最粗的一道线 —— 没有它的话裙房与塔楼之间是"直接断掉"的。
	#
	# ⚠️⚠️ **檐口必须整条沉在裙房顶面以下**（`CITY_BAND_DROP`）。
	#    第一版把它放在屋面之上（想让檐口"压"在屋顶上），结果是**它的顶面
	#    把整个屋顶盖成一块亮色大板**，并在与塔楼相交处切出一排规则锯齿 ——
	#    实测占画面 21.8% 的像素。完整推理见 `CITY_BAND_DROP` 的常数注释。
	bands.append(_sized(
		pos + Vector3(0.0, pod_h - CITY_BAND_DROP - CITY_BAND_H * 0.5, 0.0),
		Vector3(sx + CITY_BAND_OUT * 2.0, CITY_BAND_H, sz + CITY_BAND_OUT * 2.0), yaw))
	# ② **塔身腰线**：**均分铺满**塔身（不是"按固定间距铺到某个高度就停"）。
	#
	# ⚠️ 循环上界用**塔身高度**（`pod_h + tower_h`），不是 `top_y` ——
	#    后者在 ③ 里被退台加高过，拿它当界会让最上面两道线脚飘在退台外面。
	var tower_top := pod_h + tower_h
	# 道数按塔高算，步距 = 塔高 / 道数 ⇒ **整段塔身均分**，不存在"只铺一半"。
	var n := clampi(int(round(tower_h / CITY_BAND_PITCH)), CITY_BAND_MIN, CITY_BAND_MAX)
	var step := tower_h / float(n)
	# 相位抖动**对本栋的步距取模**：只让相邻楼的线脚错开，不改各自的节奏。
	#（不取模的话，31 m 的固定偏移会把步距 25 m 的矮楼第一道顶到第二道的位置上。）
	# ⚠️ 同桅杆那一段：这一行**必须让 `float(lot.gx * 53 + lot.gz * 29)` 在同一行**上
	#（`suite_gfx_map.gd:446` 按源码子串钉着它）。
	var bsum := float(lot.gx * 53 + lot.gz * 29)
	var jit := fmod(absf(bsum + float(int(lot.get("slot", 0)) * 11)), step)
	for k in range(n):
		var by := pod_h + (float(k) + 0.5) * step + jit
		# 收到退台根部就停：再往上塔身已经不在原位了
		if by > tower_top - CITY_BAND_H * 2.0:
			break
		bands.append(_sized(pos + Vector3(off.x, by, off.z),
			Vector3(tw + CITY_BAND_OUT * 2.0, CITY_BAND_H, td + CITY_BAND_OUT * 2.0), yaw))
	# ---- ⑧ 窗户亮带（1.3 批 M，**只有 `map.city_lights` 为真时才收**）----
	#
	# 与线脚（⑦）是**同一个几何**（`_city_band_shell()` 的开口筒），只是换成自发光材质、
	# 密度另算。为什么必须用开口筒见 `CITY_WINDOW_BAND_H` 那一段的 ⚠️⚠️。
	#
	# 密度由 `lot.profile` 决定 —— 那个字段是 `city_lot_for()` 按分区给的
	#（`ribbon` 市中心写字楼 / `bands` 商业塔楼 / `sparse` 外围住宅 / `none` 仓库），
	# 语义正好就是"楼里有没有人"。⚠️ 第二十二轮下半之后它一度**只剩测试在读**；
	# 这一轮它重新有了画面意义（死城那边仍然读不到它 —— 那条路上一个灯都不收）。
	#
	# ⚠️ 同 ⑥⑦：**一次 `_city_rng` 都不抽**。灯的垂直位置全部由已算出的
	# `tower_h / pod_h / tower_top` 推出来，所以"点灯"这件事**不可能**挪动
	# 后面任何一栋楼的高度/配色/偏心（那是最难查的一类连锁）。
	if map.city_lights == MapDef.CityLights.FULL:
		var prof: String = str(lot.get("profile", "sparse"))
		var wh := CITY_WINDOW_BAND_H
		var wsize := Vector3(tw + CITY_WINDOW_OUT * 2.0, wh, td + CITY_WINDOW_OUT * 2.0)
		if prof == "ribbon":
			# 写字楼：**自下而上等距环绕**。道数按塔高算、步距 = 塔高 / 道数
			#（与线脚同一条规矩）⇒ 矮楼高塔都铺满，不会"只亮了下半截"。
			var nw := clampi(int(round(tower_h / CITY_WINDOW_PITCH)), 2, CITY_WINDOW_MAX)
			var ws := tower_h / float(nw)
			for k in range(nw):
				var wy := pod_h + (float(k) + 0.5) * ws
				# 收到塔顶以下就停：再往上塔身已经不在原位（退台/顶冠缩进了一圈）
				if wy > tower_top - wh:
					break
				_city_window_xf.append(_sized(
					pos + Vector3(off.x, wy, off.z), wsize, yaw))
		elif prof == "bands":
			# 商业塔楼：**顶部若干条**横向亮带（自下而上是暗的裙楼 + 亮的高层）。
			# ⚠️ 间距取塔高的 5.5% 而**不是固定米数**：塔高跨 900~2500 m，
			# 固定 90 m 会给矮楼挤出二十几条（糊成一片）、给高塔留出 300 m 的暗缝。
			var pitch := tower_h * 0.055
			for k in range(4):
				var wy2 := tower_top - (float(k) + 0.6) * pitch
				if wy2 < pod_h + wh:
					break
				_city_window_xf.append(_sized(
					pos + Vector3(off.x, wy2, off.z), wsize, yaw))
		elif prof == "sparse":
			# 外围住宅/小楼：只在楼顶亮两层（"顶楼还有人"）。
			# ⚠️ 这里**不判** `wy3 < pod_h`：低层住宅（h 160~620、裙房 60~240）
			# 的塔身本来就只有两三百米，硬判会把它们全滤掉 —— 于是外围一片全黑，
			# 而那正是"这座城市只有市中心亮"的反例（用户要的是"全城灯火"）。
			for k in range(2):
				var wy3 := tower_top - (float(k) + 0.7) * wh * 1.9
				_city_window_xf.append(_sized(
					pos + Vector3(off.x, maxf(wy3, pod_h + wh), off.z), wsize, yaw))


## 中央广场 + 环形绿化 + 浅水池。
##
## 台场的中部就是"公园 + 广场 + 海湾"的组合（潮风公园 / 台场海滨公园），
## 所以城市正中央**不能填楼** —— 一块开阔地既是玩法上的"埋伏点"，
## 也是从空中辨认市中心的方式（四面高、中间凹）。
func _build_city_park() -> void:
	# ⚠️⚠️ 2026-09-27：`CITY_PLAZA_R`（常量）→ `CITY_SHAPE[·].plaza_r`（按图给），
	# 而且 **0 就直接不建**。
	# 旧代码用的是常量 11 960 —— 而达沃表里 `plaza_r = 0`（它的"中心"不在图心，
	# 一块圆形空地只会读成"烂尾"），于是旧代码会在达沃的图心
	# **在楼群中间**铺一块 22.7 km × 18.5 km 的草坪 + 一个水池。
	# 那不报错，只是在城里多出一块说不清的空地。
	var plaza_r := float(CITY_SHAPE[map.city_layout].plaza_r)
	if plaza_r <= 0.0:
		print("[city] %s 无中央公园（plaza_r = 0）" % map.name_cn)
		return
	var g := _city_landform(0.0, 0.0, map.city_layout)
	# ---- 草坪（低矮深绿：夜里不该是亮绿的）----
	_add_box("ParkLawn", Vector3(0.0, g + 1.5, 0.0),
		Vector3(plaza_r * 1.9, 3.0, plaza_r * 1.55),
		Color(0.055, 0.075, 0.050), 0.0)
	_city_body_count += 1
	# ---- 浅水池 ----
	_add_box("ParkPool", Vector3(0.0, g + 3.0, 0.0),
		Vector3(plaza_r * 1.05, 6.0, plaza_r * 0.72),
		Color(0.10, 0.16, 0.21), 0.0)
	_city_body_count += 1
	# ---- 公园里的树（MultiMesh：一次绘制，几百棵）----
	var trees: Array[Transform3D] = []
	var i := 0
	while i < 360:
		i += 1
		var ang := _city_rng.randf() * TAU
		var rr := sqrt(_city_rng.randf()) * plaza_r * 0.98
		var p := Vector3(cos(ang) * rr, g + 40.0, sin(ang) * rr)
		# 池子那一块不放树
		if absf(p.x) < plaza_r * 0.52 and absf(p.z) < plaza_r * 0.38:
			continue
		trees.append(_sized(p, Vector3(120.0, 140.0, 120.0),
			_city_rng.randf() * 180.0))
	if not trees.is_empty():
		_add_multimesh("ParkTrees", trees,
			_city_material(Color(0.070, 0.092, 0.062)))


## 运河两岸的护岸。纯视觉（MultiMesh），高 14 m ——
## 从空中是水边一条亮线，不会挡路（真正挡路的墙是碰撞层里那些楼）。
func _build_city_quays(line_z: float, line_x: float) -> void:
	var shape: Dictionary = CITY_SHAPE[map.city_layout]
	var bay_z: float = shape.bay_z
	var side: float = shape.bay_side
	var xf: Array[Transform3D] = []
	# ⚠️⚠️ 2026-09-27 两处修正（都是"写死了奥恩贝利的坐标"造成的）：
	#
	# ① **标高**：旧值是写死的 `y = 7.0`、高 14 m（隐含"水面在 0 附近"）。
	#    水面改成 `CITY_WATER_Y` 之后它就不再是岸壁了。现在相对水面给：
	#    顶面 `CITY_WATER_Y + 14`、底面 `−26` ⇒ 一道从水里立到陆地上的岸壁。
	# ② **循环边界**：旧版写死 `while z <= CITY_BAY_Z * 0.6`。
	#    那个数对达沃是 **−15 600**，而 `line_z` 是 **+17 000** ⇒
	#    循环**一次都不跑**，达沃的运河护岸根本没建出来（不报错，只是没有）。
	#    现在按 `bay_side` 给方向 ⇒ 两座城都能跑。
	var top := CITY_WATER_Y + 14.0
	var z := line_z
	while (z - bay_z * 0.6) * side <= 0.0:
		xf.append(_sized(Vector3(line_x, top - 14.0, z),
			Vector3(90.0, 28.0, 320.0), 0.0))
		z += 340.0 * side
	if xf.is_empty():
		return
	# 码头岸壁：港区那一类**金属**面（metallic 0.40 / rough 0.46）。
	# `facade_strength = 0` ⇒ 不铺窗格（岸壁上开窗是荒唐的），只借这个类别的**材质参数**。
	# 这条也说明 `_city_facade_material()` 的类别表对"非楼体"同样有用。
	_add_multimesh("Quay", xf, _city_facade_material(Color(0.19, 0.185, 0.178), Facade.METAL, 0.0))


## 四块人工岛**之间那三条运河**的护岸（2026-09-28 · 用户"照详规做四块岛"）。
##
## ## 与达沃那条 `_build_city_quays()` 的关系：同一种构件、**不同的定位法**
## 达沃的运河是一条**直槽**（表里给 `canal_x / canal_half / canal_end_z`），
## 岸壁就是 `x = canal_x ± (canal_half + 140)` 两条直线 —— 一个循环就够了。
##
## 奥恩贝利的运河**没有自己的常量**：它是"四块岛的补集"（详规 §B.4），
## 位置与宽度由 `OENB_BLOCKS` 唯一决定 ⇒ 岸壁必须**从块表推**。
## 再写一张"运河表"就是详规 §B.4 明令禁止的**两处真源**（改块表忘改运河表
## ⇒ 运河与岸壁错开一格，画面上是"岸壁立在岛中间"）。
##
## ## 算法：**看邻居**，而不是"数第几条运河"
## 沿每块的四条边走：某条边**外侧那一列格**若"在包围盒内且不是岛"
##（`_oenbelli_canal_cell()`），那条边就临水 ⇒ 在它外面 `0.6 × CITY_CANAL_RAMP`
## 处放一排岸壁。于是"哪几条边临水"完全由块表决定，改块表会自动跟着走。
##
## ## ⚠️ 为什么**不**贴块边放（这是本函数唯一一个不显然的数）
## 块边处的地形还是**岸顶**（`_oenbelli_canal_dig()` 在 `d = 0` 处 `sw = 0`
## ⇒ 高度 = `grit ± 7.9`），而岸壁构件的竖向范围是 `CITY_WATER_Y ± 14`
##（= −26 … +2）⇒ 贴着块边放会**整条埋进岸里**：不报错、出图也看不见，
## 只是"护岸没了"。沿坡往外走 204 m（`sw = 0.66` ⇒ `8 × 0.34 − 110 × 0.66 ≈ −70`）
## 处地形约为 **−70 m**，岸壁顶面 +2 高出水面 14 m ⇒ 正好读成"水边一条亮线"。
##
## ⚠️ 构件尺寸（90 × 28 × 320）与达沃那一版**逐位相同**：两座城的岸边亮线
## 粗细不同会很明显（同一张图里对比不出来，两张图并排一看就不对）。
## ⚠️ 这里**没有** `_city_rng` 的抽取：落位全部由块表算术给出 ——
## 那条序列是整座城共享的顺序序列（见 `_city_block_at()` 的 ⚠️⚠️）。
func _oenbelli_quays() -> void:
	var cb := ARENA_RADIUS / float(CITY_GRID)
	var off := CITY_CANAL_RAMP * 0.6
	var y := CITY_WATER_Y
	var xf: Array[Transform3D] = []
	for b: Array in OENB_BLOCKS:
		var gx0: int = int(b[0])
		var gx1: int = int(b[1])
		var gz0: int = int(b[2])
		var gz1: int = int(b[3])
		var mid_gx: int = (gx0 + gx1) / 2
		var mid_gz: int = (gz0 + gz1) / 2
		# 两条竖边（岸壁长边朝 Z）：西边 / 东边。⚠️ 取**边中点**那一格判邻居，
		# 不取角格 —— 角格与邻块可能只是对角相邻，判出来的"临水"是假的。
		if _oenbelli_canal_cell(gx0 - 1, mid_gz):
			_quay_run(xf, float(gx0) * cb - off, float(gz0) * cb,
				float(gz1 + 1) * cb, true, y)
		if _oenbelli_canal_cell(gx1 + 1, mid_gz):
			_quay_run(xf, float(gx1 + 1) * cb + off, float(gz0) * cb,
				float(gz1 + 1) * cb, true, y)
		# 两条横边（岸壁长边朝 X）：南边 / 北边
		if _oenbelli_canal_cell(mid_gx, gz0 - 1):
			_quay_run(xf, float(gz0) * cb - off, float(gx0) * cb,
				float(gx1 + 1) * cb, false, y)
		if _oenbelli_canal_cell(mid_gx, gz1 + 1):
			_quay_run(xf, float(gz1 + 1) * cb + off, float(gx0) * cb,
				float(gx1 + 1) * cb, false, y)
	if xf.is_empty():
		return
	# 码头岸壁：与达沃同一个材质参数（金属面、`facade_strength = 0` ⇒ 不铺窗格）。
	_add_multimesh("Quay", xf,
		_city_facade_material(Color(0.19, 0.185, 0.178), Facade.METAL, 0.0))


## 某一格是不是**非岛的水面**（运河 / 外圈）。纯函数。
##
## ⚠️ 它是 `is_water_at()` 里"盒内取补集"那一段的**同一规则**，但**不判海湾**。
## 护岸**不能**直接用 `is_water_at()`：那会把"岸线以北的整片海"也算成运河，
## 于是护岸会沿着**正弦的海岸线**铺一整圈（而不是沿着岸壁的直线走）。
##
## ⚠️ **2026-09-28：它也要过径向门**。理由与 `is_water_at()` 完全一样 ——
## 门外的盒子边缘格**已经不是水了**（`_city_landform()` 在那里返回 `grit + hills`），
## 而这一格如果还报"运河"，护岸就会被铺到**陆地上 80 km 处**
##（实测两格：`(16, −11)` r = 79 800、`(−16, −11)` r = 78 157 —— 都在门外）。
## 护岸是 28 m 高的墙，落在旱地上是一道**凭空出现的墙**。
static func _oenbelli_canal_cell(gi: int, gj: int) -> bool:
	if gi < int(OENB_BOX[0]) or gi > int(OENB_BOX[1]) \
			or gj < int(OENB_BOX[2]) or gj > int(OENB_BOX[3]):
		return false                      # 盒外 ⇒ 城郊陆地
	# 径向门：格心出了 `CITY_WATER_R` 就不再是水（与 `is_water_at()` 同一半径）。
	var x := (float(gi) + 0.5) * CITY_CBLOCK
	var z := (float(gj) + 0.5) * CITY_CBLOCK
	if x * x + z * z >= CITY_WATER_R * CITY_WATER_R:
		return false
	return not _oenbelli_land(gi, gj)


## **运河**（不是海湾）的判据。与 `is_water_at()` 的**运河那一支逐字一致**。
##
## ## 为什么必须是独立的一个函数
## C2 只该给**运河**架地面桥 —— 给海湾架桥会造出一座几百公里长的"跨海地面路"。
## 而 `is_water_at()` 把两者混在一起返回（都是"水"），所以要一层更细的判据。
##
## ⚠️ **不能**写成 `is_water_at() and (不是海湾)`：那两个判据的**语法**不同
##（一个是"点的性质"，一个是"落在哪一格"），混在一处会写出顺序敏感的东西 ——
## 探针 `_drop_reason()` 就踩过这个坑：它的 108 段"运河缺口"里含 **~24 段其实是湾口**
##（先判水、再判类别，两类重叠时归给了运河），真运河段只有 **≈ 84**。
static func city_is_canal(x: float, z: float,
		layout := MapDef.CityLayout.OENBELLI) -> bool:
	if layout != MapDef.CityLayout.DAVAO:
		return _oenbelli_canal_cell(int(floor(x / CITY_CBLOCK)),
			int(floor(z / CITY_CBLOCK)))
	# ⚠️ 达沃这一支与 `is_water_at()` 的最后一行**逐字符相同**（`canal_half`，
	# **不是** `canal_half + CITY_CANAL_RAMP`）—— 后者是地形挖方的过渡带，
	# 不是"规划水面"。判据用规划水面，地形跟随，这个分工不能反。
	var p: Dictionary = CITY_SHAPE[layout]
	return absf(x - p.canal_x) < p.canal_half and z < p.canal_end_z


## 一排岸壁：`fixed` 是**不动的那一维**的坐标，`a0 … a1` 是**沿本身走向**的区间。
##
## ⚠️ 沿 Z 走向时尺寸是 `(90, 28, 320)`、沿 X 走向时是 `(320, 28, 90)` ——
## 长边永远顺着走向（用同一个尺寸再靠 yaw 转 90° 也行，但这里没有 `_sized()` 可用：
## 它是实例方法，而这些落位算术是纯的）。
static func _quay_run(xf: Array[Transform3D], fixed: float, a0: float, a1: float,
		along_z: bool, y: float) -> void:
	var span := a1 - a0
	if span <= 0.0:
		return
	var n := maxi(1, int(ceil(span / 340.0)))
	var size := Vector3(90.0, 28.0, 320.0) if along_z \
		else Vector3(320.0, 28.0, 90.0)
	var b := Basis().scaled(size)
	for i in n:
		var a := a0 + (float(i) + 0.5) * span / float(n)
		var pos := Vector3(fixed, y, a) if along_z else Vector3(a, y, fixed)
		xf.append(Transform3D(b, pos))


## 一个格号 → 该格的**世界中心**（含地形高度）。纯函数。
##
## ⚠️ 这个映射必须与 `_build_city_blocks()` 里那一条**完全一致**（`(grid + 0.5) × cblock`）——
## 地标与它占掉的那几格靠它对齐（"地标站在自己的地基上"）。
## y 取该点地形高度：地标因此**坐在地面上**，不会浮空也不会陷进去。
static func _city_cell_center(gx: int, gz: int,
		layout := MapDef.CityLayout.OENBELLI) -> Vector3:
	var cblock := ARENA_RADIUS / float(CITY_GRID)
	var x := (float(gx) + 0.5) * cblock
	var z := (float(gz) + 0.5) * cblock
	return Vector3(x, _city_landform(x, z, layout), z)


## 地标：**一张图的识别物**（贴楼缠斗时很容易失去方位感，地标就是锚点）。
##
## **按 `map.city_layout` 分派**（1.3 批 M）。原来是写死"奥恩贝利的四座"，
## 而地标是**几何**、不可能放进数据表 —— 所以分派用一个 `CityLayout` 枚举，
## 而不是设计书 §3.2 里那个 `city_landmarks: Array` 字段：
## 表里能放的只有"占哪几格"，而"占哪几格"必须和几何**一起**改，
## 分开成两张表必然分叉。⇒ 格表（`_city_landmark_cell`）与几何（这里）
## 按同一个枚举分派，一处改两处跟着走。
func _build_city_landmarks() -> void:
	match map.city_layout:
		MapDef.CityLayout.DAVAO:
			_build_city_landmarks_davao()
		_:
			_build_city_landmarks_oenbelli()


