class_name WorldBuilder
extends Node3D
const CityUrbanPlan = preload("res://scripts/world/city_urban_plan.gd")
const CityPlacement = preload("res://scripts/world/city_placement.gd")
const CITY_DAVAO_HOTEL_CELL := Vector2i(-1,-1)
## 程序化世界：天空 / 主光 / 海面 / 云层 / 岛屿。
## 程序化场景几何；三城市道路共用 PBR 贴图与稳定的米制磨损 shader。
##
## **时段（白天/黄昏/夜晚）由 apply_time_of_day() 统一切换。**
## 一个时段要同时改五处：天空 shader、主光、环境（雾/曝光/辉光）、
## 海面 shader 的颜色 uniform、三带云的 tint/shade。
## 少改一处就会出现"看着不对但说不上哪不对"——比如天黑了海面还是白天的蓝。

const SEA_FLIGHT_WAKE := preload("res://scripts/world/sea_flight_wake.gd")
const OCEAN_DETAIL_MESH := preload("res://scripts/world/ocean_detail_mesh.gd")
const FFT_OCEAN_DETAIL := preload("res://scripts/world/fft_ocean_detail.gd")
var environment_fft_enabled := true
## Runtime A/B gate: set before map creation. No gameplay/collision changes.
var environment_detail_enabled := true
var _local_cloud_volume: Node3D = null
const LOCAL_CLOUD_VOLUME := preload("res://scripts/world/local_cloud_volume.gd")

const OCEAN_SHADER := "res://shaders/ocean.gdshader"
const CLOUD_SHADER := "res://shaders/cloud.gdshader"
const SKY_SHADER := "res://shaders/sky.gdshader"
## 地表（沙丘 / 地坪 / 岛屿 / 巨岩）共用的一份材质。
## 从 StandardMaterial3D 换成 shader 的**唯一**原因是要给地表加云影，见 `_terrain_material()`。
const TERRAIN_SHADER := "res://shaders/terrain.gdshader"
## 城市建筑**立面**的材质（1.2.3 批 G）。只有"楼体"用它 ——
## 路灯 / 桥索 / 地标那些小构件继续走 `_city_material()`（纯色 StandardMaterial3D）。
const CITY_SHADER := "res://shaders/city.gdshader"

## 城市楼体的立面类别（1.2.3 批 G）。`NONE` = 不做立面（纯色，与 1.2 行为一致）。
##
## 为什么按"类别"而不是按"每栋楼给一组参数"：材质是**按颜色缓存**的
##（`_city_material` 那套量化到 1/200 的做法），参数要是逐栋不同，
## 整座城会退回几百份材质、几百个 draw call。
## 类别只有四个，于是"几十种颜色 × 4 类"仍然是个小数字。
enum Facade {
	NONE,          ## 纯色（旧行为）
	CONCRETE,      ## 混凝土 + 常规窗格（5.6 × 4.0）
	GLASS,         ## 玻璃幕墙：框薄、玻璃板很光滑（反射天空）、板面微压暗
	METAL,         ## 工业金属：港区 / 机库 / 单轨那一类
	PODIUM,        ## 裙房：开口更大的商铺（9.0 × 5.5），混凝土
}

## 竞技场半径（超出后 AI 会被拉回来）。BanditAI 直接引用这个常量，改一处即可。
## 第四轮从 15 km 扩到 26 km：缠斗半径变大后，"脱离再重新接战"才有空间，
## 原来的 15 km 在高难度（敌机 630 m/s）下一分多钟就能穿越全场。
##
## ## 1.2 第十九轮：26 km → **28 km**（起因是"战场扩大"）
## ## 1.2 第二十二轮：28 km → **64.4 km**（老板："所有的地图范围都太小了，
## ## 需要再扩大 2-3 倍"，取 **2.3×**）
##
## ## ⚠️ 第二十二轮的放大**只放大空间，不动任何机体/武器数值**（老板选的方案 B）
## 于是"竞技场更大"是**真的更大**：机体的极速、导弹、锁定距离全部原样，
## 一张图从 56 km 见方变成 **129 km 见方** —— 同样的机体要飞过更远的距离。
##
## **代价是明写在 `suite_round19` 里的新契约**：出击点按同一比例抬到
## 20.7 km，于是"出击 → 接战"从约 16 s 变成约 **36 s**（理想下限）。
## 那条断言（12~26 s）是本轮**主动改掉**的，不是被绕过的 —— 见那边的说明。
##
## ⚠️ 它**不是一个孤立的数**。改它要连着看四处（README §6.2 有完整清单）：
##   - `SPAWN_RADIUS`（出击点必须 < 半径）；
##   - `OCEAN_SIZE` / `LAND_SIZE`（地表必须远大于直径，否则飞到边缘会看见"边"）；
##   - `cloud_field_span`（云影覆盖图跟着半径走）；
##   - 云的三条带 / 岛屿落点 / 相机远平面。
##
## ## 换算备忘（2.25×，2026-09-27 达沃重制）
## | 常数 | 上一档 | 现值 |
## |---|---|---|
## | `ARENA_RADIUS` | 64.4 km | **144.9 km** |
## | `OCEAN_SIZE` | 368 km | **620 km** |
## | `LAND_SIZE` | 460 km | **700 km** |
## | `TERRAIN_DETAIL_SIZE` | 101.2 km | **202.4 km** |
## | `SPAWN_RADIUS` | 20.7 km | **46 575 m** |
## | `TRAINING_PATROL_RADIUS` | 11.96 km | **26 910 m** |
## | `CITY_GRID` | 16 | **36**（⚠️ 格距 **4025 m 不变**） |
## 高度（`PLAYER_START_ALT` / 云的三个高度带）**刻意不放大**：
## 那些是"垂直方向",与地图大小无关，改了会连带改掉云层与俯冲的手感。
##
## ## ⚠️⚠️ 为什么是 `CITY_GRID` 变大、而不是格距变大（这一轮最要紧的一条）
## `cblock = ARENA_RADIUS / CITY_GRID` 是"城市要素**绝对尺寸**"的分母 ——
## 楼高 1 400~4 900 m、龙门吊腿高 720 m、单轨 420 m 全是相对它给的。
## 格距一变，全城的楼 / 街 / 广场比例跟着变 ⇒ **只加格数，不加格距**。
## 而格数有一个硬下限：`_build_city_blocks()` 只跑 `range(-half, half)`，
## `half = CITY_GRID / 2` ⇒ **块网格半宽 = `CITY_GRID/2 × 格距`**。
## 达沃的岛北缘在 `cz + rz = 70 035 m`，要求 `CITY_GRID/2 × 4025 ≥ 70 035`
## ⇒ `CITY_GRID ≥ 34.8` ⇒ **取 36** ⇒ `ARENA_RADIUS = 36 × 4025 = 144 900`。
## ⚠️ 第一版设计稿写的是"×2 ⇒ 128 800（`CITY_GRID` 32）"，那个**满足不了**这条
## （半宽 64 400 < 70 035）⇒ 岛的最北 5.6 km 一栋楼都没有。
const ARENA_RADIUS := 144900.0
## 空间放大系数。**凡是"跟地图大小走"的距离都乘它**，
## 免得把这个魔数抄得到处都是（抄错了就会出现"地表的边露出来"这类问题）。
##
## ## ⚠️ **它只管"对局尺度"，不管"城域坐标"**（2026-09-27 拆开）
## | 组 | 成员 | 跟着谁 |
## |---|---|---|
## | **对局尺度** | `ARENA_RADIUS` / `SPAWN_RADIUS` / `TRAINING_PATROL_RADIUS` / `seeker_range` | **本常量** |
## | **城域坐标** | 岛形 / 海湾 / 运河 / 广场 / 单轨 / 丘陵 | **`CITY_SHAPE` 表（按图给，默认 = 现值）** |
## 上一轮把两者绑在一起同倍放大（因为当时"岛和竞技场一起变大"），
## 于是 `MAP_SCALE` 一改，奥恩贝利的城域坐标就会跟着漂。这一轮必须拆开。
const MAP_SCALE := 2.25
## 海面平面尺寸。必须远大于竞技场直径，否则玩家飞到竞技场边缘会**看见海面的边**。
## 144.9 km 半径 ⇒ 直径 289.8 km，判据是 `> ARENA × 4 = 579.6 km`：
## 620 km 的平面 ⇒ 最近的海面边缘还有 165 km，再叠上雾，边缘完全看不见。
const OCEAN_SIZE := 620000.0

## ---- 对局尺度（1.2 第十九轮从 `main.gd` 挪过来的）----
#
# ⚠️ **为什么挪到这里**：它们与 `ARENA_RADIUS` 是同一组"数"，必须一起改、一起被断言。
# 原先它们写在 `main.gd` 里，而 `main.gd` **没有 `class_name`**（它是挂在场景根节点上的
# `extends Node3D`），于是**测试里根本读不到** `Main.SPAWN_RADIUS` ——
# `suite_round19` 第一版就是这么红的（`Identifier "Main" not declared`）。
# 放在有 `class_name` 的 `WorldBuilder` 上，测试与新会话都能直接读。
#
# 而"出击点到战场中心有多远"必须与**量产机的极速 × 燃料槽时长**一起算，
# 那组不等式是"必须依靠飞行踏板才能赶到战场"的全部依据（见 `suite_round19::_math`）。
## 出击点到战场中心的距离（米）。
##
## 9000 m 是拿量产机**极速**反推的：梅萨M01 579 m/s ⇒ 9000/579 ≈ **15.5 s**
## （全程按死加速的理想下限）；实际会被燃料槽限制得更久 —— 这正是"必须靠踏板"的来源。
## 第四轮起是 5200，第十九轮按"先飞 20 秒左右才能到战场"抬到 9000。
## 第二十二轮跟着 `MAP_SCALE` 抬到 **20700**（≈ 1.44 倍半径 —— 与旧值同一个比例）。
##
## ⚠️ **为什么不是"半径变大、出击点不动"**：那样出击点会缩到半径的 14%，
## 玩家等于"在战场中央出生"，前两张图赖以存在的"赶路 → 接战"节奏就没了。
##
## ⚠️ 2026-09-27（达沃重制）：跟着 `MAP_SCALE` ×2.25 ⇒ 20 700 → **46 575**。
## 比例 46 575 / 144 900 = **0.3214**，与旧值一字不差（这才叫"守住"）。
const SPAWN_RADIUS := 46575.0
## 玩家出生高度（米）。**不随 `MAP_SCALE` 变**：这是垂直方向的量。
##
## ⚠️ 2026-09-28 起它只是**下限**，不再是最终值 —— 见 `SPAWN_CLEARANCE`。
const PLAYER_START_ALT := 3200.0
## 敌机出生高度（米）。是**绝对下限**（海上用得到），"比玩家高"那件事见
## `ENEMY_ABOVE_PLAYER`。
const ENEMY_START_ALT := 3450.0
## 敌机相对**玩家实际出生标高**的高差（米）：开局"从上方压下来"的姿态。
##
## ⚠️⚠️ 这一条 2026-09-28 从**绝对值**改成了**相对值**，理由值得记下来：
## 它原来是隐含在 `ENEMY_START_ALT − PLAYER_START_ALT = 3 450 − 3 200 = 250` 里的。
## 而玩家标高改成由地形派生之后（见 `SPAWN_CLEARANCE`），奥恩贝利那一局的玩家
## 会升到 **4 004 m** —— 若敌机仍写死 3 450 m，**它反而在玩家下方**，
## 于是"从上方压下来"那句话在代码里就变成了假话，而且**不会有任何断言报错**。
## ⇒ 差必须表达成差，不能继续藏在两个绝对数的减法里。
const ENEMY_ABOVE_PLAYER := 250.0
## 出生标高相对**正下方地形**的最小余量（米）。
##
## ## ⚠️ 为什么需要它（用户："奥恩贝利的出生点放到丘陵上面"）
## 出生半径现在是**按图给**的（`CITY_SHAPE[·].spawn_r`，奥恩贝利 **90 000 m**），
## 而丘陵是**径向环带** `CITY_HILL_IN/OUT = 82 000 / 96 000 m`
## ⇒ 出生环落在环带**中段**，"脚下是山"是**常态而不是例外**。
##
## 探针实测（`tools/_spawn_probe.tscn`，环上 72 个方位，丘陵 `AMP = 6 600 m`）：
##
## | 项 | 值 |
## |---|---|
## | 出生环上的地形高度 | **−484 … 3 687 m**（−484 是 +Z 那半边在海面上） |
## | 玩家出生点（−95°）脚下 | **3 385.3 m**（其中丘陵项 3 391.8） |
## | 写死的 `PLAYER_START_ALT` 3 200 m | 离地 **−185.3 m** ⇒ **直接埋在地下** |
## | 实际出生标高 | **4 885.3 m**（= 3 385.3 + 本常量） |
## | 环上**埋在山里**的方位数 | **0 / 72**（余量被拉平成 1 500 m，最薄处也是 1 500） |
## | 敌机（成对） | **5 135.3 m**（高差正好 `ENEMY_ABOVE_PLAYER = 250`） |
##
## ⚠️ 这张表是 **2026-09-28 四块岛那一轮**重测的。上一版（环带 40…54 km、
## 出 46 575 m）读到的是"环上 −485 … 2 722 m、脚下 2 504 m、余量 696 m" ——
## **那组数已经作废**：丘陵与出生环一起外移之后，脚下的山反而**更高**
##（3 385 > 2 504），于是 3 200 m 这个写死的绝对值从"余量太薄"恶化成
## **"整个埋进山体"**。这就是本常量必须存在的更硬的理由。
##
## ⇒ 3 200 m 这个绝对值是**照着"地面 ≈ 0 m"给的**，而它不可移植：
## 以后再改一次丘陵高度 / 出生半径，得有人记得回来重算这个数（没人会记得）。
##
## ## 为什么是"**只抬不降**"
## 敌机出生点在 +Z 的海面上（脚下 **−484 m**）。若改成"无条件贴地 + 余量"，
## 它会掉到离海面 1 km 处 —— "从上方压下来"的开局姿态就没了。
## 所以判据写成 `max(请求标高, 脚下地形 + 本常量)`。
##
## ⚠️ 这一条由 `suite_round20` 的「出生点搬到丘陵上面」那一节守着
##（四条：环在山陵内缘之外 / 环在山陵外缘之内 / 环在四块岛之外 / 环下真的有丘陵
##  + 开局方位 −95° 不是水且在山坡上）。
const SPAWN_CLEARANCE := 1500.0
## 训练模式靶机绕圈巡逻的半径（米）。`main.gd` 的同名常量就是读它（**单一真源**），
## 放在这边只为让测试也读得到（测试读不到 `Main.*`，见上面那段）。
##
## ## ⚠️ 这个数**跟着 `MAP_SCALE` 放大**（2026-09-21 拍板，把第二十二轮的决定反过来）
##
## 第二十二轮一度把它**压回 5200 不放大**，理由是"靶机必须落进 `seeker_range`，
## 5200 就够" —— 那条推理**只对了一半**：它确实保住了"出生点锁得上靶机"，
## 但代价是把**训练靶场占半径的比例**改掉了（5200/64400 = 8.1%，旧值 18.6%），
## 于是 `suite_worldscale` 的「比例一致」那一条**一直红着**。
## 两个不变量互相打架 —— 而它们本来可以同时成立。
##
## 2026-09-21 拍板取 **(b)：两端一起按 `MAP_SCALE` 放大**：
##   - `TRAINING_PATROL_RADIUS` 5200 → **11960** ⇒ 比例回到 18.6%（Round22 绿）
##   - `LockOnSystem.seeker_range` 9000 → **20700** ⇒ 11960 < 20700（Round19 绿）
##
## 而且**相对手感一个字没变**：
##   靶机距离 / 锁定距离 = 11960/20700 ≈ **0.578**，与旧值 5200/9000 ≈ 0.578 相同。
##   换句话说寻的头的"相对够得着多远的敌人"跟以前一样，只是尺子换了单位。
##
## ⚠️ **这两个数是一条不变量的两端，必须一起改**：
## 判据是 `它必须小于 seeker_range`（断言在 `suite_round19`，见那里的注释）。
##
## ⚠️ 2026-09-27（达沃重制）：跟着 `MAP_SCALE` ×2.25 ⇒ 11 960 → **26 910**。
## 比例 26 910 / 144 900 = **0.1857**，与旧值一字不差。
const TRAINING_PATROL_RADIUS := 26910.0
## 陆地地图的"远景地坪"尺寸。和海面同一个理由：必须远大于竞技场直径。
## 艾尔斯岩那张图的地表细节（沙丘/巨岩）另有一层细分网格叠在它上面。
const LAND_SIZE := 700000.0
## 地表细分网格的边长（米）。**必须跟着 `MAP_SCALE` 走**：
## 它决定"沙丘/巨岩/海岸线铺多远"，不跟着变的话，放大地图后飞出细分网格
## 就会看见一张纯色的远景地坪（等于回到了"没有地形"）。
##
## ⚠️ **它的判据不是"盖住竞技场"**（2026-09-27 改口径）：`ARENA_RADIUS` 在
## 达沃那张图上已经不代表"需要地形的地方"了 —— 半径 144.9 km 里有 65 km 是
## **外海**（水面不需要细分地形）。判定改成与**城域**比（取表里最大的那座城）。
## 不改口径的话它得抬到 217 km 以上，顶点代价从 ×4 涨到 **×5.2**。
const TERRAIN_DETAIL_SIZE := 202400.0
## 巨型独石的**斜边角度**（度）。用户给的形状规格："一个在地面上凸出来的巨大梯形体
## （斜边角度为 80°），俯瞰形状为椭圆形"。80° 换算成水平退距 = 高度 / tan(80°)。
const MESA_SLOPE_DEG := 80.0

## ---- 地形网格分段数（1.2.3 批 H · 轮 1）----
##
## ⚠️ **分段数不是"越细越好"，也不是"越大越粗"——它由"格距不变"这一条反推**：
## 几何能表达的最短波长 = **格距的 2 倍**（奈奎斯特），格距 = `TERRAIN_DETAIL_SIZE / seg`。
##
## ## ⚠️ 2026-09-27（达沃重制）：**size 翻倍，seg 必须跟着翻倍**
##
## `TERRAIN_DETAIL_SIZE` 从 101 200 → 202 400（×2）。三个用它的网格
##（沙漠 / 靶场 / 城市）如果只改 size 不改 seg，**格距就整体翻倍**：
##
## | 图 | seg 不动时的新格距 | 奈奎斯特 | 高度函数最短 λ | 后果 |
## |---|---|---|---|---|
## | 沙漠 | 316 → **633 m** | 1 265 m | **850 m** | ❌ **破** |
## | 靶场 | 632 → **1 265 m** | 2 530 m | **1 600 m** | ❌ **破** |
##
## 后果**不是"细节变少"，是走样** —— 比奈奎斯特短的波在顶点上被采成逐顶点随机值，
## 画面变噪点。所以三个 seg 一起 ×2 ⇒ **格距逐位不变** ⇒ 沙漠 / 靶场 / 城市的地形
## **一个顶点都不动**（顶点坐标是 `-size/2 + i × 格距`，格距相同就是同一套格点）。
##
## ⚠️ 顶点代价（唯一要认的账）：城市 `336² → 672²`（112 896 → 451 584，×4.0）；
## 沙漠 / 靶场同幅（顶点 ×4）。这也是"改口径省 1.3 倍"那条判据的由来。
##
## ### 之前三个数是凭图给的（沙漠 84 / 靶场 56 / 城市 336）
## 于是三轮前出过一次同类事故：
##
## | 图 | 旧格距 | 几何能表达的 λ | 高度函数里的最短 λ | 读起来 |
## |---|---|---|---|---|
## | 沙漠 | 1205 m | ≥ 2410 m | ≈ 2800 m | 勉强，只剩一整片缓坡 |
## | 靶场 | 1807 m | ≥ 3614 m | ≈ 5000 m | 只有"微微不平" |
##
## ⇒ 修法是**按真实米给波长**（旧版用的是抽象坐标 0..900，见 `_build_desert`）
## 并让 seg 提到"几何真的能表达那个波长"为止。只提 seg 是白烧顶点（采到的还是同一个
## 缓坡，只是更密）；只改波长会走样成噪点。
const OCEAN_SEG := 755       # 620 km / 755 ⇒ 格距 821 m ⇒ 几何可表达 λ ≥ 1642 m
const DESERT_SEG := 640      # 202.4 km / 640 ⇒ 格距 316 m ⇒ λ ≥ 632 m
const RANGE_SEG := 320       # 202.4 km / 320 ⇒ 格距 632 m ⇒ λ ≥ 1265 m

## ---- 几何层的**奈奎斯特账**（1.2.3 批 I · 轮 4「跨图标定」）----
##
## 上面那段讲的是"分段数要按波长倒推"，这张表就是**倒推的结果被核过一遍**的地方。
##
## ## 为什么要有这张表，而不是把数字散在各函数里
## 各函数的注释里都已经写了"λ ≥ 2 × 格距"，但**没有人核对过** ——
## 上一轮就是这么漏掉的：沙漠第三层 λ 210 m（格距 316 m）、
## 靶场两层 800 / 400 m（格距 632 m）、海面第二条涌浪 λ 1400 m（格距 821 m），
## **三张图各有一处违反**，而且都在注释里自称"交给 shader 了"。
##
## ⇒ 一张表 + 一条算术断言（`suite_gfx_map`），比六处散文注释可靠。
##
## ## 判据
## `min(waves) >= 2 * size / seg`。违反的后果不是"细节变少"，而是**走样**：
## 比奈奎斯特更短的波在网格顶点上采样成**逐顶点随机值** ⇒ 网格拿到的不是形状，
## 是噪声（顶点色还会跟着它分带）。"交给 shader 承担"**只有一种合法做法**：
## 那一层**不写进高度函数**（写进去了就已经在网格上生效了，撤不回来）。
##
## `waves` 列的是**高度函数里每一个分量各自的波长**（含 `fractal_octaves`
## 展开之后的最细一层，所以 `octaves = n` 的那一项要写成 `λ / 2^(n-1)`）。
## ⚠️ **`size` 一栏必须引用常量，不能抄数字**（2026-09-27 修）：
## 它以前写的是字面量 `101200.0`，而代码早就在用 `TERRAIN_DETAIL_SIZE` ——
## 于是 size 一改，**表不动** ⇒ 这张自检表算出来的格距还是旧值，
## 断言照样绿，而实际渲染已经破了（"表与代码脱节"就是这么来的）。
const CALIB := [
	# 名称          场地边长(m)     分段      高度函数各分量的波长(m)
	{"name": "沙漠沙丘", "size": TERRAIN_DETAIL_SIZE, "seg": DESERT_SEG,
		"waves": [3000.0, 850.0]},
	{"name": "靶场地坪", "size": TERRAIN_DETAIL_SIZE, "seg": RANGE_SEG,
		"waves": [1600.0]},
	{"name": "城市地面", "size": TERRAIN_DETAIL_SIZE, "seg": CITY_GROUND_SEG,
		# 两部分，都要列：
		#
		# ① `_city_landform()` 城内那四层 `sin(k·x)·cos(k·z)`，波长 = 2π/k：
		#    0.00037 → 17.0 km · 0.0011 → 5.7 km · 0.0033 → 1.9 km · 0.0091 → 690 m
		# ② **外围丘陵** `_city_hills()` 那三个 ridged 八度
		#   （V2 · 2026-09-28：7.4 / 3.1 / 1.25 / 0.70 km ⇒ **60 / 26 / 11 km**）：
		#    0.000105 → 60 km · 0.000242 → 26 km · 0.000571 → 11 km
		#
		# 最短的仍是城区那层 **690 m**，对 301 m 格距是 **2.3 格** —— 刚好越过
		# 奈奎斯特（2 格）；它**刻意只给很小的幅度**（0.7 m）：贴边通过的层不该
		# 承担主起伏，它只负责"让轮廓不整齐"。
		# ⚠️ 丘陵那边在 V2 之前最短的是 700 m —— 它的**脊距只有 0.58 格**，
		# 在格点上等于纯噪声，正是用户看到的"一排尖刺"（见 `CITY_HILL_AMP` 的根因表）。
		# 现在最短一层 11 km ⇒ 脊距 2.75 km ≈ **9.1 格**，离奈奎斯特很远。
		# ⚠️ 这就是这张表和上面那段散文注释存在的理由 —— 加了新八度**必须回来补一行**，
		# 忘了补就等于"新细节在网格上走了样而没人知道"。
		# ⚠️ **降序**（末项 = 最短的一条）—— `suite_gfx_ledger` 有一条断言核这个顺序，
		# 因为"末项"就是决定奈奎斯特裕度的那条，顺序错了那条断言会去比一个错的值。
		"waves": [60000.0, 26000.0, 16981.0, 11000.0, 5712.0, 1904.0, 690.0]},
	{"name": "海面长涌浪", "size": OCEAN_SIZE, "seg": OCEAN_SEG, "waves": [3600.0, 1900.0]},
]

## 艾尔斯岩沙丘的**植被覆盖强度**（1.2.3 批 I · 轮 5）。
##
## 用户参照要求："地上还是要有 **7% 左右不均匀**的植被覆盖"。
## ⚠️ 这个 1.0 **不是"覆盖率"**，是"要不要这一层"的总开关。
##
## ---- ⚠️ 2026-09-24（批 K · 轮 1③）：覆盖率**换了来源**，这条注释随之改口 ----
##
## 旧口径：覆盖率由 `terrain.gdshader` 里两个"分位数反解"的阈值常数决定 ——
## 而那个做法在**分布**上是不合格的。用户的原话是：
##   "艾尔斯岩的绿洲覆盖**过于难看随机**了……要有树木，其次是有些是随机分布，
##    但是**高空也能看到的小团**，也有些是**连在一起的小绿洲**。"
## 旧做法的场是"一个全局阈值 + 慢调制（λ 5.9 km）"，它的统计是**各向同性**的 ——
## 也就是说它天然产生不了"团"，更产生不了"连在一起的团"。
## 而且它**没有任何几何**：整层植被是一张贴图般的色块，一棵树也没有。
##
## 新口径：覆盖率由 `_desert_oasis_sites()` 撒出来的**团/串**决定，
## 烘焙成掩码纹理（`_veg_mask_tex`）喂给 shader。⇒ **树长在哪里、地上绿在哪里，
## 是同一份数据**（这是这一轮唯一重要的架构决定：两处各算一次必然对不上，
## 而"对不上"在画面上表现成"树站在裸沙上 / 绿斑里没有树"，且极难查）。
## 所以覆盖率请改 `DESERT_CLUMP_*` / `DESERT_CLUSTER_CHANCE` 那几个常数，
## **不要**改这个 1.0。
const DESERT_VEG := 1.0

## ---- 艾尔斯岩「绿洲」分布（1.2.3 批 K · 轮 1③）----
##
## 用户："绿洲覆盖要有树木……有些是随机分布但是高空也能看到的小团，
## 也有些是连在一起的小绿洲"。
##
## ## 为什么必须上**几何**（而不是把色块调好看一点）
## 判据里有"**要有树木**"一条，色块在定义上就不可能满足它。
## 而且单纯加细节也没用：一个 3.2 km 高空机位下 `0.416 px/m`
##（`--topcam` 的 62° FOV / 1600 px 实测），一棵 20 m 的树 = **8.3 px** ——
## 只有真几何才在这个尺度上留下"树"这个形状。
##
## ## ⚠️ 第一版把撒布半径定成 15 km，**结果出生点什么都看不到**（本轮实测）
## 出生点是 `main.gd` 的 `world.spawn_point(-95.0, SPAWN_RADIUS, PLAYER_START_ALT)`
## ⇒ 玩家在**离原点 20.7 km 的环上**。而 `--topcam=3200`（也是玩家最常用的
## "高空看地面"那个机位）是以**玩家 x/z 为中心**垂直往下看的，
## 视场只有 3.85 × 2.17 km ⇒ 那一帧落在离原点 18.8~22.6 km 的环带里。
## 15 km 的圈外 5.7 km —— 于是**出生点俯视一棵树、一块绿斑都没有**，
## 而 `--seacam=300`（平视、能看到几公里外）里树又清清楚楚。
## 两个机位给出相反结论，根因不在 shader、不在掩码，**在几何**。
## ⇒ `DESERT_OASIS_R` 现在**按 `SPAWN_RADIUS` 派生**，不再写死一个数 ——
##    写死的话下次有人改出生半径，植被会再"莫名消失"一次。
##
## ## 三个量的取舍（都是"凑到刚好能读"的算术，不是审美）
##   · `DESERT_OASIS_R = SPAWN_RADIUS × 1.16 ≈ 24 km`：出生环（20.7 km）
##     落在 0.86 R 处 ⇒ 出生点俯视看到的是**正常密度**，不是边缘。
##   · `DESERT_CLUMP_GAP = 1150 m`：**团心最小间距**（蓝噪声拒绝采样）。
##     俯视单帧 8.35 km² × 0.37 团/km² ≈ **3 个团** —— 这就是
##     "高空也能看到的小团"的兑现口径（第一版 `gap = 2200` 时单帧只剩一两个）。
##   · `DESERT_CLUMP_R = 140~300 m`：**团半径**。⚠️ 上限被**掩码分辨率**卡住：
##     25.4 m/px 下 300 m 半径 = 11.8 px，边缘过渡还有 3~4 px 可用；
##     半径再放大到 600 m 就会读到多边形边。
##     下限被"高空可读"卡住：140 m 半径 = 直径 280 m = 高空 **116 px**，够。
##
## ## ## 树数预算（硬约束）
## 树是**真几何**（`MultiMesh`，一次 draw call），三角形数 = 树数 × 28。
## 轮 2 的理论值（`CANOPY_FILL = 0.19`、300 母点、55% 串、每串 3~5 片）：
##   （`TREE_PER_M2` = 0.19 / (π · 13.5²) = **3.318e-4 棵/m²**）
##   · 母点 300 个，E[r²] = (140² + 140·300 + 300²)/3 = 50 533 m²
##     ⇒ 300 × π × 50 533 = 47.6e6 m² × 3.318e-4 = **15.8k 棵**
##   · 叶片 165 串 × 4 片 = 660 片，lr = r0 × U(0.70, 0.95) ⇒ E[lr²] = 34 655 m²
##     ⇒ 660 × π × 34 655 × 0.85(核心) = 61.1e6 m² × 3.318e-4 = **20.3k 棵**
##   · 合计 **36.1k 棵** ⇒ 101 万三角形，落在 `DESERT_TREE_CAP = 38k` 之下（余量 5%）。
const DESERT_VEG_SEED := 20260924
const DESERT_OASIS_R := SPAWN_RADIUS * 1.16   ## 团心撒布半径（米）
const DESERT_CLUMP_GAP := 1150.0              ## 团心之间的最小间距（米）
const DESERT_CLUMP_R_MIN := 140.0
const DESERT_CLUMP_R_MAX := 300.0
const DESERT_MOTHERS := 300                   ## 母点数上限（实测 300）
const DESERT_CLUSTER_CHANCE := 0.55           ## 母点变成"小绿洲串"的概率

## ---- 「串」的形状（1.2.3 批 K · 轮 2，本轮新增）----
##
## ## 第一版为什么量出 **0 条串**（实测，不是推测）
## `J_top` 三层差分 + 二阶矩长短轴比量出来：11 个连通块**全是单团**（比 1.05~1.10），
## 一条串都没有 —— 而"也有些是**连在一起的小绿洲**"是用户的第三条要求。
##
## 直接看图（`_pixprobe_J_top.png`）才看清真正的形态：**串在数据里是有的**
##（左中有一条 6 连珠的斜串），但它渲染出来是**一串分开的珠子、珠间有缝**，
## 于是眼睛读到的是"随机撒的点"，不是"连在一起的小绿洲"。
##
## 根因是**两道半径收缩叠在一起**，而第一版只算了前一道：
##   · 数据侧：片间距 = (r0 + lr) × 0.72~0.92，半径和 (r0+lr) 是"接触"条件
##     ⇒ 系数 0.92 时两片**刚好相切**，0.72 时才交叠 ⇒ 大部分片只擦边。
##   · 渲染侧（第一版**漏掉的那一道**）：shader 里 `cov = m × GAIN − BIAS` 的
##     仿射重映射会把掩码外围一圈**压到 0 以下**（当时 GAIN 1.30 / BIAS 0.16）
##     ⇒ 地面上的**可见**半径只有掩码半径的 **0.788 倍**。
## 两道乘起来，"数据上刚好相切"在画面上就是**一条明显的缝**。
## ⇒ 间距系数压到 **0.55~0.72**（两片**必然重度交叠**），
##   同时把 shader 的 BIAS 从 0.16 降到 0.06（可见半径 0.788 r → **0.890 r**）。
##
## ## ⚠️ 走向抖动从 ±0.55 rad 收到 ±0.16 rad
## 第一版每挂一片就抖 ±0.55 rad，而片数只有 2~4 ⇒ 那是一条**随机游走**，
## 4 步的游走不会走远，只会**卷成一坨**（这本身就是长短轴比量到 1.05 的一半原因）。
## 收到 ±0.16 rad 后，串是一条**缓慢弯曲的线** —— 读起来像干涸河床，
## 而真实的沙漠绿洲就沿着河床长。（直线是最难看的，所以留一点弯。）
const DESERT_LOBE_MIN := 0.70                 ## 叶片半径 / 母片半径 的下限
const DESERT_LOBE_MAX := 0.95                 ## 上限。⚠️ 不能小到 0.55：叶片太小
											  ## 会让"串"读成一串**递减的珠子**
const DESERT_LOBE_STEP_MIN := 0.55            ## 片间距 / (r0 + lr)
const DESERT_LOBE_STEP_MAX := 0.72            ## ⚠️ 不能 > 0.89（可见半径之比）
const DESERT_LOBE_JITTER := 0.16              ## 走向每片抖动的幅度（弧度）
const DESERT_LOBE_WOBBLE := 0.18              ## 垂直走向的横向偏移 / r0（把直边打弯）
## 团内**树冠盖度**。树数 = `盖度 × 团面积 / 单棵树冠面积`。
##
## ⚠️ 这个数**不是"越密越好"**，它有一个上界和一个下界，而两端都失败得很难看：
##   · 给到 0.55（"密到看不见地"）⇒ 团是一整块**深绿实心斑**，
##     恰恰**看不出"有树木"**（用户三条要求里的第一条就没了）；
##   · 给到 0.08 ⇒ 沙地上撒了一把绿点，读不成"团"。
##   0.24 时树距 ≈ `√(树冠面积/盖度)` = **49 m**，而树冠直径 27 m ⇒
##   高空下是"看得见空隙、读得出是一丛一丛"的样子 —— 这才是"有树木"。
##
## ⚠️ **轮 2 从 0.24 降到 0.19**，原因是**预算**，不是审美：串变长变粗之后
## 树数的理论值从 32.6k 涨到 **45k**，而 `DESERT_TREE_CAP` 是硬约束。
## 降盖度是**唯一能把成本按面积等比摊掉**的旋钮 —— 降团半径会改变"高空可见"
## 的兑现口径，降母点数会改变"团可数"，都不行。
## 0.19 ⇒ 树距 55 m（原 49 m）。**这个差在高空看不出来**（55 m = 13 px），
## 而它把树数压回 36.1k，留出 5% 余量。
const DESERT_CANOPY_FILL := 0.19
## 单棵树冠半径（米）—— 取**高度中位**那棵的横向半径。只用来反解树数密度：
## 真正每棵树自己的树冠由实例的等比缩放给（见 `_desert_tree_mesh()`）。
const DESERT_CANOPY_R := 13.5
const DESERT_TREE_PER_M2 := DESERT_CANOPY_FILL / (PI * DESERT_CANOPY_R * DESERT_CANOPY_R)
## **地面上真正看得见的**绿斑半径 / 团半径。
##
## ## 这个数是从 shader 那两个常数**反解**出来的，不是拍出来的
## `terrain.gdshader` 里 `cov = mask × VEG_MASK_GAIN − VEG_MASK_BIAS`，而掩码沿半径是
## `f^1.35`（`f = 1 − d/r`）⇒ `cov > 0` 要求 `mask > BIAS/GAIN`，反解得
## `可见半径 = r × [1 − (BIAS/GAIN)^(1/1.35)] = r × [1 − (0.06/1.18)^0.7407] = 0.890 r`。
##
## ## ⚠️ 它存在的唯一理由：**树不能站在完全没有草的地方**
## 树的位置原本撒在**整个**团半径内，而绿斑在 `0.890 r` 处**归零**
## ⇒ 最外那 11% 的环形里会有树、脚下一丝绿都没有。
## 特写（`K10_oasis`，260 m 机位）里就是"一片树孤零零站在沙上" ——
## 而"树长在哪里、绿在哪里"是同一份数据本来要保证的事。
##
## ## ⚠️ 诚实记账：这个约束**只保证"有绿"，不保证"绿得够"**
## `cov` 是沿半径的软过渡（`0.89 r` 处 0、`0.5 r` 处 0.40、`0.6 r` 处 0.28、`0.8 r` 处 0.07），
## 所以**靠近边缘的那一圈树脚下仍然只有 5%~15% 的绿**。
## 这不是没修，而是**修不动**：掩码是 **25.4 m/px**，最小团半径 140 m ⇒ 半径只有 5.5 texel。
## 把边缘做陡（提高 `GAIN` / 降 `BIAS`）会让过渡区缩到 1~2 texel，
## 那时地上读出的是**多边形硬边**（这个坑在 `DESERT_OASIS_RES` 的注释里记着）。
## ⇒ 真正的升级路径是**把掩码分辨率提到 4096**（12.7 m/px，16 MB），
##    那样才腾得出地方同时做"平顶 + 定宽边缘"，让可见半径 ≈ 团半径。
##    本轮**不做**：代价（16 MB + 建图变重）与"用户没提这个"不成比例，
##    而且当前这一改已经把"脚下完全没有绿"的极端情形消掉了。
##
## ⚠️⚠️ 所以改 `terrain.gdshader` 的 `VEG_MASK_GAIN` / `VEG_MASK_BIAS` **必须同时改这里**。
## 这条耦合没法靠类型系统挡住，所以 `suite_gfx_map` 里有一条**算术断言**：
## 它把 shader 源码里那两个数抓出来、按同一个公式算一遍，与这个常数比对。
## ⇒ 不同步就是一条红，而不是"某天发现边缘的树站在沙上"。
const DESERT_VEG_VISIBLE_R := 0.89
## 树数硬上限。**它不是预算，是保险丝** —— 见 `_build_desert_oasis()`：
## 超了会**全局等比降密度**（每个团按同一比例少撒几棵），
## 而不是把数组尾部截掉。
##
## ## ⚠️⚠️ 轮 1 那个版本就是"截掉"，而且**真的踩上了**（实测 `trees: 30000`）
## 原来的写法是 `if xf.size() >= CAP: break`，于是树数正好停在 30000，
## **排在 `desert_oasis_sites` 末尾的那些团一棵树都没有** ——
## 地上是绿的、树是零，而这恰恰违反用户的第一条要求"**要有树木**"。
## 更糟的是它是**静默**的：日志里只看到一个整数，"等于上限"这件事
## 和"刚好这么多"长得一模一样，**不查不会发现**。
## ⇒ 两道修：① 密度先算总量、超了等比缩；② 缩减量记进 `desert_tree_scale`，
##    由 `suite_gfx_map` 断言它必须 ≥ 1.0（= 根本没触发缩放）。
##
## ## 面数账
## 38,000 棵 × 28 面 = **106 万三角形**，而整个绿洲是**一个 draw call**
##（`MultiMesh`，无碰撞、不投影）。对照：地表网格 320² × 2 = 20.5 万。
const DESERT_TREE_CAP := 38000
## 掩码覆盖范围：**±58.5 km**。
##
## ## ⚠️ 它必须**盖住撒布范围**，而撒布范围是**派生量**
## `DESERT_OASIS_R = SPAWN_RADIUS × 1.16` —— 它跟着地图尺度走，本常量不走。
## `ARENA_RADIUS` 那一轮 ×2.25 之后，这笔账变成：
##   撒布半径 46 575 × 1.16 = **54 027 m**，最远片心还要再加最大团半径 300 m
##   ⇒ 覆盖图半宽必须 > **54 327 m**。
## 取 **117 000 = 52 000 × 2.25**（与竞技场同比），半宽 58 500 ⇒ 余量 4.2 km。
