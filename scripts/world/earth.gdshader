shader_type spatial;

// ============================================================ 地球（近地轨道的下方天体）
//
// ## 它是干什么的
// 老板：「**要能分辨出脚底下是地球**」。改前那张图的向下机位拍出来是**一整块均匀深蓝**
//（`tools/_b2_leo_shots.gd` 的 04 号：`p50 = 0.1493` / `p99 = 0.1521` —— 分布宽度
// 只有 0.0028，那是一块**没有任何细节的纯色**，认不出任何东西）。
//
// ## 为什么是**程序化**的（不挂贴图）
// 本工程的地球半径是 6 371 km、玩家在 550 km 高 —— 一张 2k 贴图摊到整个球面上，
// 每像素 ≈ 3 km，**比一个城市还大**；而任何真实地球贴图都会带来"这图从哪来的"这个问题。
// 用 3D 值噪声叠出「海洋 / 大陆 / 沙漠 / 极冠 / 云」五层，零外部资源、零加载时间，
// 而且**参数全在文件里**（改大陆比例不用重新找素材）。
//
// ## 为什么 unshaded
// 两条：
//   ① 场景里主光是**太阳**（`TimeOfDay.space()` 的 `sun_rotation_deg`）。走普通光照的话，
//      地球会有一半落在黑夜里 —— 而夜半球是纯黑 ⇒ 判据图里"向下看"会拍到一块近黑，
//      **与真空背景分不开**（那正是本条需求要解决的问题）。这里的"昼夜"用
//      `sun_dir` 与地表法线自己算一个**可读**的明暗，暗面压到 0.42 而不是 0。
//   ② 大气临边（下面那段）必须**朝视线方向**做加亮，那是光照模型给不出来的。
render_mode unshaded, cull_back;

// ⚠️ **不要写 `SUN_DIR`** —— 那是 sky shader 的内置量，spatial 里没有它
//（写了会静默变成 0 向量，`dot()` 恒为 0 ⇒ 整个地球落在同一个明暗上，不报错）。
// 太阳方向由 `WorldBuilder._earth_material()` 从本图的时段算好传进来。
uniform vec3 sun_dir = vec3(0.42, 0.55, -0.72);

// ---- 噪声（3D 值噪声 + 6 阶 fbm）----
//
// ⚠️ **必须先放大再取整**：`floor()` 的格边长是 1.0。地球的输入是**单位方向向量**
//（分量 −1…1），直接喂进去只有 3³ 个格子 ⇒ 整个球面被切成 27 块大方砖。
// 所以下面每个 fbm 都乘了一个 ≥ 25.0 的倍率，最细的一阶到 `×25×2.03⁵ ≈ ×862`。
//
// ⚠️⚠️ **倍率不是「好看」选的，它由可见画面的张角定死**（本轮第二轮改的）：
// 从 550 km 高、fov 60 往正下方看，画面里的 `d` 只走 **0.19** —— 球面上 **6.2°**。
// 而初版的基准倍率是 **4.0**（格子 0.25）⇒ **整幅画面还不到一个格子**：
// 画面是一团没有任何结构的糊，掩码恒等于那一格的值（实测 ≈0.55，恰好压在
// `LAND_HI` 之上 ⇒ 判据读出「94.1% 陆地 / 0.3% 云」）。光看代码看不出来，
// 是把 `d` 从 GPU 渲染回读、量了张角才发现的（`tools/_earth_dbg.gd`）。
// 现在基准 **25.0**（格子 0.040 ≈ 255 km），画面横向约 **4.8 格**。
//
// ⚠️ **哈希函数要数值稳健**（这是本轮做过 pixel 判据之后才换掉的）：
// 第一版用的是 `fract(p * 0.3183099 + …)` 那一族 —— 它 `p *= 17.0` 之后
// `p.x * p.y * p.z * (p.x + p.y + p.z)` 的量级到 **2.5 × 10⁵**，而 float32 的尾数是 24 位
// ⇒ 那个乘积的 `fract()` 只剩 **≈ 34 个可取值**（ulp ≈ 0.029）⇒ 哈希退化成阶梯，
// 噪声沿格子面**跳变**。后果是球面上出现笔直的子午线接缝（相机正好从极点上方往下看）。
// 现在换成 D. Hoskins 的 "hash without sine"（中间量始终在 0…~40 量级）。
float hash31(vec3 p) {
	p = fract(p * vec3(0.1031, 0.1030, 0.0973));
	p += dot(p, p.yzx + 33.33);
	return fract((p.x + p.y) * p.z);
}

float vnoise(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hash31(i + vec3(0.0, 0.0, 0.0)), hash31(i + vec3(1.0, 0.0, 0.0)), f.x),
				   mix(hash31(i + vec3(0.0, 1.0, 0.0)), hash31(i + vec3(1.0, 1.0, 0.0)), f.x), f.y),
			   mix(mix(hash31(i + vec3(0.0, 0.0, 1.0)), hash31(i + vec3(1.0, 0.0, 1.0)), f.x),
				   mix(hash31(i + vec3(0.0, 1.0, 1.0)), hash31(i + vec3(1.0, 1.0, 1.0)), f.x), f.y), f.z);
}

float fbm6(vec3 p) {
	float a = 0.5;
	float s = 0.0;
	for (int i = 0; i < 6; i++) {
		s += a * vnoise(p);
		p *= 2.03;
		a *= 0.5;
	}
	return s;
}

// ---- ★ 域扭曲（domain warp）----
//
// 把采样点沿三轴各推一点（一层低频值噪声）⇒ 噪声的**格子面不再是平面**。
//
// ⚠️ 这一步不是"锦上添花"，它修的是一条**静默的**可见缺陷：
// `vnoise` 的格子面在输入 `p` 的整数坐标处。若某个 `fbm6` 的偏移量恰好是频率的**整数倍**
//（第一版就是这样：`d * 8.0 + vec3(41, 7, 13)`、`d * 5.0 + vec3(71, 19, 33)`、
//  `d * 7.0 + vec3(5, 5, 5)` … ），格子面就**正落在 `x = 0` / `z = 0`** 上。
// 而本工程的相机是**从极点正上方往下看**的（竞技场摊在球面上只有 0.42°，法线就是 +Y）
// ⇒ 那两个平面与视线轴**共面** ⇒ 它们投影成**过画面中心的直线**。于是球面上出现两条
// 笔直的子午线：颜色沿着它**跳变** ——
// 实测（fov 60 正下方机位）：画面正中行有一道 **0.114** 的台阶，
// 而整幅图的平均行梯度只有 0.0015（75 倍）。出图上就是"海岸线是一条直线"。
//
// 扭曲之后格子面弯掉了；所有偏移量另取**非整数倍**（见各调用点），双保险。
vec3 warp(vec3 d) {
	vec3 w = vec3(vnoise(d * 3.1 + vec3(1.7, 9.3, 5.1)),
				  vnoise(d * 3.1 + vec3(7.9, 2.3, 8.7)),
				  vnoise(d * 3.1 + vec3(4.1, 6.7, 3.3)));
	return d + 0.20 * (w - 0.5);
}

// ---- 表面参数 ----
//
// ⚠️ 这几个是**判据的刻度**，不是随手调的装饰：`suite_space_map` 会断言
// 「向下机位拍到的像素里同时存在**海洋色相**与**陆本色相**」，
// 而那件事成立的前提是 `land` 掩码**两端都够宽**（陆地约占 39%）。
// 把 `LAND_LO/HI` 收窄成一个尖峰 ⇒ 陆地会退化成零星小岛 ⇒ 那条断言会（正确地）变红。
//
// ⚠️ 过渡带（`LAND_HI − LAND_LO`）**不能宽**：掩码的空间尺度由最低频那层
//（`fbm6(q * 25.0)`，一格 ≈ 0.040 ≈ 255 km）决定，过渡带每宽 0.01 就是
// 海岸线模糊约 (0.01/σ≈0.086) × 1400 km ≈ 160 km。第一版是 0.44→0.52（**1300 km 宽的一圈渐变**），
// 出图就是「水彩晕开」，一点海岸线都读不出来。现在 0.480→0.520（带宽 0.04，
// 画面内陆地 ≈ 39%），
// 并把中频/高频两层的权重加起来到 42% 让海岸碎起来。
const float LAND_LO = 0.480;
const float LAND_HI = 0.520;
const vec3 OCEAN_DEEP = vec3(0.012, 0.043, 0.132);
const vec3 OCEAN_SHELF = vec3(0.035, 0.115, 0.262);
const vec3 LAND_WET = vec3(0.075, 0.180, 0.075);
const vec3 LAND_DRY = vec3(0.400, 0.322, 0.168);
const vec3 ICE = vec3(0.900, 0.930, 0.965);
const vec3 CLOUD = vec3(0.955, 0.970, 1.000);
const vec3 AIRGLOW = vec3(0.180, 0.400, 0.900);

// ---- ★ 自转轴：极冠的"纬度"以哪根轴为准 ----
//
// 这**不是**装饰参数，它是本条需求能不能成立的前提：
// 竞技场半径只有 46 575 m，摊在 6 371 km 的球上不到 **0.42°** ——
// 整场战斗发生在球面上的**一个点**。而球心摆在 `y = -R` ⇒ 战斗点的法线**就是 +Y**。
// 于是若极冠按 `abs(d.y)` 判（轴 = +Y），正下方看到的正是**球面北极的冰盖**：
// 可见盘整体落在 `abs(d.y) ∈ [0.92, 1.0]` ⇒ `ice ≈ 1` ⇒ 画面上是一颗**纯白的球**，
// 与老板那句「要能分辨出脚底下是地球」正好相反（白球上没有海、没有陆、没有云可认）。
//
// 把自转轴斜过来 ⇒ 战斗点落在**中纬度**（本例 42.0°N），可见盘覆盖 19°…65° 纬度：
// 主体是海洋 / 大陆 / 云，只在最靠近极点的那条边上露出一小片极冠
//（那反而是"这是个真行星"的加分项）。
//
// ⚠️ 轴一改，`abs(d.y)` 的分布跟着变。把 `SPIN` 拨回 `(0,1,0)` ⇒ 极冠立刻吞掉整个可见盘
//（`suite_space_map` 里那条"陆本色相占比 > 3%"会（正确地）变红）。
const vec3 SPIN = vec3(0.629, 0.743, 0.229);   // 42.0°N，方位 20°

// ---- 地表整体增益 ----
//
// 本 shader 是 `unshaded` ⇒ `ALBEDO` **就是**出射辐亮度，没有光照与自动曝光替我们抬；
// 而本图的环境是 **ACES + `tonemap_white = 6.0`**（见 `world_builder._env`），
// 高亮端压得很厉害 —— 增益给大了整颗球会**洗成一片粉彩**：
// 第一版给了 **2.4**，出图实测：海、陆、云全挤进 ACES 的肩部，饱和度掉光，
// 1600×900 的正下方机位只剩"蓝一片、淡黄绿一片、白一片"三团色阶晕在一起，
// 「一眼认出是地球」反而更差。降到 **1.35** 之后海更沉、陆更实、云更白。
//
// ⚠️ 于是地表会比**地平线以下那片亮雾**（`TimeOfDay.space().sky_ground`，亮度 ≈ 0.16）**暗**。
// 那是对的不是缺陷：真实从轨道拍的照片里，临边那一圈大气辉光本来就比暗色的洋面亮。
const float SURFACE_GAIN = 1.35;

varying vec3 v_dir;

void vertex() {
	// 球心在模型空间原点 ⇒ `VERTEX` 就是"球面上这一点"的方向（长度 = 半径）。
	v_dir = normalize(VERTEX);
}

void fragment() {
	vec3 d = normalize(v_dir);
	// ★ 域扭曲后的采样方向。**不加这一步**球面上会出现两条笔直的子午线接缝（见 `warp()`）。
	vec3 q = warp(d);

	// ---- ① 大陆掩码 ----
	// **三层**不同频率的掩码相加：低频（`4.0`）定大陆形状，中频（`11.0`）碎海岸线，
	// 高频（`27.0`）给半岛与岛链。
	// ⚠️ 中高频那两层**不能省**：只有低频的话海岸线是一圈几百公里宽的光滑渐变，
	// 一眼就是程序画的（第一版是两层、过渡带还宽，出图就是"水彩晕开"）。
	// ⚠️ 偏移量一律取**非整数倍**（11.317 / 4.0 = 2.829 …）—— 见 `warp()` 的说明。
	float n = fbm6(q * 25.0 + vec3(11.317, 4.719, 21.933));
	float n2 = fbm6(q * 68.8 + vec3(3.107, 27.413, 8.601));
	float n3 = fbm6(q * 168.8 + vec3(19.703, 6.311, 44.107));
	float land = smoothstep(LAND_LO, LAND_HI, n * 0.58 + n2 * 0.28 + n3 * 0.14);
	// 大陆内部的干湿分化（沙漠 / 雨林）
	float dry = fbm6(q * 50.0 + vec3(41.03, 7.11, 13.07));

	// ---- ② 海洋 ----
	// 深浅两层：`shelf` 定大陆架，`bank` 给浅滩 / 海峡的碎纹。
	float shelf = fbm6(q * 43.8 + vec3(5.03, 5.11, 5.07));
	float bank = fbm6(q * 137.5 + vec3(13.03, 9.11, 2.07));
	vec3 ocean = mix(OCEAN_DEEP, OCEAN_SHELF,
		smoothstep(0.24, 0.62, shelf * 0.75 + bank * 0.25));

	// ---- ③ 陆地 ----
	// ★ 多乘一层**地形明暗**：不然大陆内部是一块平涂的色块（第一版的出图就是这样），
	// 而"山脊 / 平原 / 高原"的明暗正是"这是陆地、不是色板"最直接的读数。
	float rough = fbm6(q * 112.5 + vec3(53.03, 2.11, 7.07));
	vec3 land_c = mix(LAND_WET, LAND_DRY, smoothstep(0.34, 0.70, dry));
	land_c *= 0.70 + 0.62 * rough;

	// ---- ④ 极冠 ----
	// 纬度以 `SPIN` 为轴（见上面那条说明）；再加一点噪声让冰缘不是一条直线。
	float ice = smoothstep(0.80, 0.92, abs(dot(d, SPIN)) + 0.11 * (dry - 0.5));

	// ---- ⑤ 云 ----
	// 云是**独立一层**（不像陆地那样与海洋互斥）：它盖在两者之上，
	// 这正是"从轨道上一眼认出地球"最有效的那个特征。
	// ⚠️ 大尺度（`cl`，天气系统）必须再乘一层小尺度（`cl2`）⇒ 云系内部有"细胞"结构。
	// 第一版只有大尺度、覆盖度又高（0.50→0.74），出图是几团巨大的软斑把海陆整个盖糊。
// ⚠️ 阈值段 **0.44→0.70** 也是本轮重标的：画面只覆盖球面 6.2° 的**一个固定小片**，
// 云覆盖随频率是「抽签」（实测基准 18 抽到 0.0%、25 抽到 10.2%）⇒
// 阈值段必须放宽，把全局云量抬上去，任何一片都看得到云（判据 ⑤ 不再是运气）。
	// ⚠️ 小尺度的那个系数段 `0.62 + 0.55 * …` **不能低**：下限太低时云是**半透明**的，
	// 0.55 × 白 + 0.45 × 洋面 ⇒ 像素仍是蓝的（饱和度 0.34），于是
	// 「低饱和亮部」这类判据读成 0% —— 出图上云也永远"糊在海上"而不是一朵朵白云。
	// 取到 1.17 的上限（再 `clamp` 到 1）⇒ 云可以真正不透明。
	float cl = fbm6(q * 31.3 + vec3(71.03, 19.11, 33.07));
	float cl2 = fbm6(q * 106.3 + vec3(29.03, 61.11, 5.07));
	float cloud = smoothstep(0.44, 0.70, cl) * (0.62 + 0.55 * smoothstep(0.40, 0.72, cl2));

	vec3 c = mix(ocean, land_c, land);
	c = mix(c, ICE, ice);
	c = mix(c, CLOUD, clamp(cloud, 0.0, 1.0) * 0.95);

	// ---- ⑥ 昼夜（自己的"太阳"，暗面压到 0.42 而不是 0）----
	// 见文件头 ②：夜半球纯黑会让判据图里"向下看"拍出一块与真空分不开的黑。
	vec3 nrm = normalize(NORMAL);
	float lit = clamp(dot(nrm, normalize(sun_dir)), -1.0, 1.0);
	float day = 0.42 + 0.58 * smoothstep(-0.35, 0.45, lit);
	c *= day;

	// ---- ⑦ 大气临边 ----
	// `NORMAL`（世界空间法线）与 `VIEW`（世界空间视线方向）越接近垂直 ⇒ 越靠近球的剪影边缘
	// ⇒ 视线穿过的大气越厚 ⇒ 越亮。这一圈**冷蓝**是"这是个有大气层的行星"最直接的读数，
	// 也是本 shader 唯一一件光照模型给不出来的事。
	//
	// ★ 它同时是本轮**判据的几何标记**：这一圈恒在剪影上（`mu = 0`），与昼夜无关
	//（加法项，加在 `c *= day` 之后）⇒ 从画面边缘向内扫，第一个"亮于天空"的采样点
	// 就是地球的临边。`tools/leo_earth_shot.gd` 的 `_limb_radius()` / `_ring_row()` 找的就是它。
	//
	// ⚠️ **指数要够大、强度要够小**：`pow(1−mu, n)` 里的 `n` 决定这一圈有多厚。
	// 第一版 `n = 3.2`、强度 `1.35`（再乘当时 2.4 的增益）⇒ 出图是一圈**巨大的白晕**，
	// 吃掉盘半径的四分之一，整颗球读成"一颗发光的珍珠"而不是行星。
	// 现在 `n = 7.0`、强度 `0.90` ⇒ 贴着剪影的一圈**细蓝弧**，与真实轨道照片一致。
	float mu = abs(dot(nrm, normalize(VIEW)));
	float limb = pow(1.0 - mu, 7.0);
	c += AIRGLOW * limb * 0.90;

	// ---- ⑧ 整体增益（见 `SURFACE_GAIN`）----
	ALBEDO = c * SURFACE_GAIN;
}
